# ==============================================================================
#  ZOTHOS LINUX — SOVEREIGN GITIGNORE SPECIFICATION
#  Guarantees zero leak of secrets, credentials, dotfiles, tokens & build outputs
# ==============================================================================

# ── 1. SECRETS, API KEYS & ENVIRONMENT CONFIGS ───────────────────────────────
.env
.env.*
.envrc
!.env.example
*.env
*.env.*
*.secret
*.secrets
*.secrets.*
*.key
*.pem
*.pkcs12
*.pfx
*.asc
*.cer
*.crt
*.der
*.p7b
*.p7c
*.ca-bundle

# Whitelist public APT / vendor archive signing keys required for live-build:
!config/archives/*.key*
!config/includes.chroot/etc/apt/trusted.gpg.d/*.gpg
!config/includes.chroot/etc/apt/trusted.gpg.d/*.asc

# Tokens, Auth & Service Account Credentials
*auth.json
*credentials.json
*credential*.json
*client_secret*.json
*service_account*.json
*service-account*.json
*.token
*token*.txt
*token*.json
*.keyfile
*.secretfile

# Whitelist dummy template configuration
!config/includes.chroot/etc/skel/.streamlit/credentials.toml

# Password Managers & Vault Databases
*.kdbx
*.kdb
*.vault
.zoth-vault*
bw_session*
*.bw_session
keepass*.key
agent-layer.state

# ── 2. SSH, GPG & CRYPTOGRAPHIC KEYS ─────────────────────────────────────────
id_rsa*
id_ed25519*
id_ecdsa*
id_dsa*
known_hosts*
authorized_keys*
.ssh/
**/.ssh/
secring.*
pubring.*
.gnupg/
**/.gnupg/
*.gpg
*.pgp

# Re-allow public APT keyrings
!config/includes.chroot/etc/apt/trusted.gpg.d/*.gpg

# SSH host keys inside chroot
config/includes.chroot/etc/ssh/ssh_host_*
etc/ssh/ssh_host_*

