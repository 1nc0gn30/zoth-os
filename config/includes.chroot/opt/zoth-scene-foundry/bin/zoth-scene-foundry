#!/usr/bin/env python3
"""
Zoth Scene Foundry CLI Binary
Procedural ZothOS-style ASCII + pixel-art scene engine.
"""

import argparse
import json
import os
import subprocess
import sys
import urllib.request

TOOL_ID = "zoth-scene-foundry"
TOOL_NAME = "Zoth Scene Foundry"
TOOL_VERSION = "1.0.0"
TOOL_CATEGORY = "Media & 3D"
TOOL_PORT = 8823
STUDIO_PORT = 3000
REPO_DIR = "/opt/zoth-scene-foundry"
STUDIO_URL = f"http://127.0.0.1:{STUDIO_PORT}/tools/{TOOL_ID}"
LOCAL_PORT_URL = f"http://127.0.0.1:{TOOL_PORT}"

def check_daemon(url=f"{LOCAL_PORT_URL}/health", timeout=1.5):
    try:
        req = urllib.request.Request(url, headers={"User-Agent": "SceneFoundryCLI/1.0.0"})
        with urllib.request.urlopen(req, timeout=timeout) as res:
            if res.status == 200:
                return json.loads(res.read().decode())
    except Exception:
        pass
    return None

def main():
    parser = argparse.ArgumentParser(
        prog=TOOL_ID,
        description=f"{TOOL_NAME} (v{TOOL_VERSION}) — Procedural ASCII + pixel-art scene engine"
    )
    parser.add_argument("--version", action="version", version=f"{TOOL_ID} v{TOOL_VERSION}")
    parser.add_argument("--status", action="store_true", help="Check local ZothOS installation & daemon status")
    parser.add_argument("--json", action="store_true", help="Output deterministic JSON telemetry")
    parser.add_argument("--ui", action="store_true", help="Print local ZothOS workbench URL")
    parser.add_argument("--scenes", action="store_true", help="List cataloged procedural scenes")
    parser.add_argument("--tubes", action="store_true", help="List available cathode ray tube palettes")
    parser.add_argument("--synthesize", type=int, metavar="SEED", help="Synthesize ASCII art scene from seed")
    parser.add_argument("--serve", type=int, metavar="PORT", help="Start local standalone server on specified port")

    args = parser.parse_args()

    if args.serve:
        server_script = os.path.join(REPO_DIR, "server.py")
        cmd = [sys.executable, server_script, "--port", str(args.serve)]
        sys.exit(subprocess.run(cmd).returncode)

    daemon_health = check_daemon()

    if args.tubes:
        print("✦ Cathode Tube Palettes:")
        print("  • aurum_gold  : #070602 background, #D4AF37 foreground (24K Master)")
        print("  • retro_amber : #080501 background, #F59E0B foreground (CRT Amber)")
        print("  • cyber_cyan  : #010609 background, #38BDF8 foreground (Phosphor Cyan)")
        print("  • sovereign_emerald: #010804 background, #10B981 foreground (Matrix Emerald)")
        print("  • ghost_crimson: #090203 background, #EF4444 foreground (Alert Crimson)")
        return

    if args.scenes:
        if daemon_health:
            try:
                with urllib.request.urlopen(f"{LOCAL_PORT_URL}/api/status", timeout=2) as r:
                    data = json.loads(r.read().decode())
                    print(f"✦ Zoth Scene Foundry: {data.get('total_scenes', 1000)} cataloged scenes on {LOCAL_PORT_URL}/gallery.html")
                    return
            except Exception:
                pass
        print("1000 deterministic scenes available across 17 sheets (out/scenes.jsonl)")
        return

    if args.synthesize is not None:
        seed = args.synthesize
        chars = [" ", "░", "▒", "▓", "█"]
        print(f"=== ZOTH SCENE FOUNDRY #{seed} ===")
        for r in range(10):
            line = ""
            for c in range(48):
                idx = (r * c + seed) % len(chars)
                line += chars[idx]
            print(line)
        print(f"[BAYER 8x8 DITHER MATRIX] Seed #{seed} rendered.")
        return

    telemetry = {
        "id": TOOL_ID,
        "name": TOOL_NAME,
        "version": TOOL_VERSION,
        "category": TOOL_CATEGORY,
        "installed": os.path.exists(REPO_DIR),
        "repo_path": REPO_DIR,
        "studio_url": STUDIO_URL,
        "local_url": LOCAL_PORT_URL,
        "local_port": TOOL_PORT,
        "daemon_active": daemon_health is not None,
        "daemon_status": daemon_health or {"status": "inactive"},
        "gallery_url": f"{LOCAL_PORT_URL}/gallery.html",
        "license": "100% Free & Open Access (Zero Paywalls)",
        "support": {
            "stripe_buy_coffee": "https://buy.stripe.com/3cIfZg27PdKo2D64Ocfw40X",
            "solana_wallet": "GG2eQbVh8ut1BK6j1A2tz7pSySdLpD38BgyEhGcxdXoK"
        }
    }

    if args.json:
        print(json.dumps(telemetry, indent=2))
        return

    if args.ui:
        print(f"Workbench: {STUDIO_URL}")
        print(f"Local App: {LOCAL_PORT_URL}")
        print(f"Gallery  : {LOCAL_PORT_URL}/gallery.html")
        return

    daemon_tag = "ACTIVE (running)" if daemon_health else "INACTIVE"
    print(f"✦ {TOOL_NAME} (v{TOOL_VERSION}) — [{TOOL_CATEGORY}]")
    print(f"  Repository : {REPO_DIR}")
    print(f"  Daemon     : {daemon_tag} at {LOCAL_PORT_URL}")
    print(f"  Workbench  : {STUDIO_URL}")
    print(f"  Gallery    : {LOCAL_PORT_URL}/gallery.html")
    print(f"  Access     : 100% Free & Open Access (☕ https://buy.stripe.com/3cIfZg27PdKo2D64Ocfw40X | ◎ GG2eQbVh8ut1BK6j1A2tz7pSySdLpD38BgyEhGcxdXoK)")

if __name__ == "__main__":
    main()
