#!/usr/bin/env python3
"""
agent-mock-twin-tui: Live terminal monitor for Agent Mock Twin (:8097).
Queries /health, /api/stats, /api/routes, and /api/hits over loopback with offline SQLite fallback.
Engineered by Neal Frazier Tech (@1nc0gn30) • NullAI Platform.
"""

from __future__ import annotations

import argparse
import json
import os
import sqlite3
import sys
import time
import urllib.request
from typing import Any, Dict, List, Optional

VERSION = "2.6.0"


def _default_db_path() -> str:
    for base in ("/opt/agent-mock-twin", os.path.expanduser("~/NullAITech/agent-mock-twin"), os.getcwd()):
        candidate = os.path.join(base, "agent_mock.db")
        if os.path.isfile(candidate):
            return candidate
    return os.path.expanduser("~/NullAITech/agent-mock-twin/agent_mock.db")


def _fetch_json(url: str, timeout: float = 1.5) -> Optional[Dict[str, Any]]:
    try:
        with urllib.request.urlopen(url, timeout=timeout) as resp:
            if resp.status == 200:
                return json.loads(resp.read().decode("utf-8"))
    except Exception:
        return None
    return None


def _read_sqlite_snapshot(db_path: str) -> Dict[str, Any]:
    stats: Dict[str, Any] = {
        "total_hits": 0,
        "total_tokens_saved": 0,
        "total_usd_saved": 0.0,
        "avg_latency_ms": 0.0,
        "routes_count": 0,
        "providers": [],
        "matches_by_type": {},
    }
    routes: List[Dict[str, Any]] = []
    hits: List[Dict[str, Any]] = []

    if not os.path.isfile(db_path):
        return {"stats": stats, "routes": routes, "hits": hits}

    conn = sqlite3.connect(db_path, timeout=2.0)
    conn.row_factory = sqlite3.Row
    try:
        cur = conn.cursor()
        tables = {r[0] for r in cur.execute("SELECT name FROM sqlite_master WHERE type='table'").fetchall()}
        if "mock_routes" in tables:
            r_rows = cur.execute(
                "SELECT id, method, path, provider, response_status, token_estimate, description FROM mock_routes ORDER BY rowid ASC LIMIT 20"
            ).fetchall()
            routes = [dict(r) for r in r_rows]
            all_p = cur.execute("SELECT DISTINCT provider FROM mock_routes ORDER BY provider ASC").fetchall()
            stats["routes_count"] = int(cur.execute("SELECT COUNT(*) FROM mock_routes").fetchone()[0])
            stats["providers"] = [str(r[0]) for r in all_p if r[0]]
        if "mock_hits" in tables:
            agg = cur.execute(
                "SELECT COUNT(*) AS c, COALESCE(SUM(tokens_saved),0) AS t, COALESCE(SUM(usd_saved),0.0) AS u, COALESCE(AVG(latency_ms),0.0) AS l FROM mock_hits"
            ).fetchone()
            stats["total_hits"] = int(agg["c"])
            stats["total_tokens_saved"] = int(agg["t"])
            stats["total_usd_saved"] = round(float(agg["u"]), 4)
            stats["avg_latency_ms"] = round(float(agg["l"]), 1)
            mt = cur.execute("SELECT match_type, COUNT(*) AS cnt FROM mock_hits GROUP BY match_type").fetchall()
            stats["matches_by_type"] = {str(r["match_type"]): int(r["cnt"]) for r in mt}
            h_rows = cur.execute(
                "SELECT id, method, path, match_type, status_code, latency_ms, tokens_saved, provider FROM mock_hits ORDER BY id DESC LIMIT 10"
            ).fetchall()
            hits = [dict(r) for r in h_rows]
    finally:
        conn.close()
    return {"stats": stats, "routes": routes, "hits": hits}


def collect_snapshot(port: int, db_path: str) -> Dict[str, Any]:
    base = f"http://127.0.0.1:{port}"
    health = _fetch_json(f"{base}/health")
    if health and health.get("status") == "ok":
        stats_res = _fetch_json(f"{base}/api/stats") or {}
        routes_res = _fetch_json(f"{base}/api/routes") or {}
        hits_res = _fetch_json(f"{base}/api/hits?limit=10") or {}
        cfg_res = _fetch_json(f"{base}/api/config") or {}
        return {
            "service": "agent-mock-twin",
            "version": health.get("version", VERSION),
            "mode": "live",
            "online": True,
            "port": port,
            "health": health,
            "config": cfg_res.get("config", {}),
            "stats": stats_res.get("stats", {}),
            "routes": (routes_res.get("routes") or [])[:20],
            "hits": (hits_res.get("hits") or [])[:10],
        }

    offline = _read_sqlite_snapshot(db_path)
    return {
        "service": "agent-mock-twin",
        "version": VERSION,
        "mode": "offline-sqlite",
        "online": False,
        "port": port,
        "db_path": db_path,
        "health": None,
        "config": {},
        "stats": offline["stats"],
        "routes": offline["routes"],
        "hits": offline["hits"],
    }


def render_text(snap: Dict[str, Any]) -> str:
    s = snap.get("stats") or {}
    cfg = snap.get("config") or {}
    status_label = f"ONLINE http://127.0.0.1:{snap['port']}" if snap["online"] else f"OFFLINE (SQLite: {snap.get('db_path', 'agent_mock.db')})"
    lines = [
        "=" * 74,
        f"  AGENT MOCK TWIN v{snap['version']} — LIVE NETWORK TWIN MONITOR",
        f"  Status: {status_label}",
        "=" * 74,
        f"  Active Routes : {s.get('routes_count', 0):<8}  Intercepted Hits : {s.get('total_hits', 0):,}",
        f"  Tokens Saved  : {s.get('total_tokens_saved', 0):<8,}  USD Saved        : ${float(s.get('total_usd_saved', 0.0)):.4f}",
        f"  Avg Latency   : {s.get('avg_latency_ms', 0.0)} ms       Providers        : {', '.join(s.get('providers') or []) or 'none'}",
    ]
    if cfg:
        lines.append(
            f"  Sim Config    : base={cfg.get('base_latency_ms', 0)}ms jitter=±{cfg.get('jitter_ms', 0)}ms chaos={float(cfg.get('chaos_rate', 0.0))*100:.0f}% ({cfg.get('chaos_type', '429_rate_limit')})"
        )
    lines.append("-" * 74)
    lines.append("  INDEXED ROUTES (up to 8):")
    routes = snap.get("routes") or []
    if not routes:
        lines.append("    (no routes loaded — run `agent-mock-twin import <spec>` or POST /api/upload)")
    else:
        for r in routes[:8]:
            lines.append(
                f"    {str(r.get('method', 'GET')):<6} {str(r.get('path', '/')):<34} [{str(r.get('provider', 'custom')).upper():<9}] ~{r.get('token_estimate', 0)} tok"
            )
    lines.append("-" * 74)
    lines.append("  RECENT REPLAY HITS (up to 6):")
    hits = snap.get("hits") or []
    if not hits:
        lines.append("    (awaiting agent traffic on 127.0.0.1:" + str(snap["port"]) + ")")
    else:
        for h in hits[:6]:
            lines.append(
                f"    [{h.get('status_code', 200)}] {str(h.get('method', 'POST')):<5} {str(h.get('path', '/')):<28} {str(h.get('match_type', '')).upper():<9} {h.get('latency_ms', 0)}ms · {h.get('tokens_saved', 0)} tok"
            )
    lines.append("=" * 74)
    lines.append("  Engineered by Neal Frazier Tech (@1nc0gn30) • NullAI Platform")
    return "\n".join(lines)


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="agent-mock-twin-tui",
        description="Live Terminal Monitor for Agent Mock Twin (127.0.0.1:8097)",
    )
    parser.add_argument("-v", "--version", action="version", version=f"agent-mock-twin-tui {VERSION}")
    parser.add_argument("--port", type=int, default=8097, help="Daemon loopback port (default: 8097)")
    parser.add_argument("--db", default=_default_db_path(), help="SQLite fallback database path")
    parser.add_argument("--once", action="store_true", help="Render a single telemetry frame and exit")
    parser.add_argument("--status", action="store_true", help="Print single status snapshot and exit")
    parser.add_argument("--json", action="store_true", help="Output structured JSON snapshot")
    parser.add_argument("--interval", type=float, default=1.5, help="Refresh interval in seconds (default: 1.5)")
    args = parser.parse_args()

    snap = collect_snapshot(port=args.port, db_path=args.db)
    if args.json:
        print(json.dumps(snap, indent=2))
        return 0
    if args.once or args.status or not sys.stdout.isatty():
        print(render_text(snap))
        return 0

    try:
        while True:
            sys.stdout.write("\033[2J\033[H")
            sys.stdout.write(render_text(collect_snapshot(port=args.port, db_path=args.db)) + "\n")
            sys.stdout.flush()
            time.sleep(max(0.25, args.interval))
    except KeyboardInterrupt:
        return 0


if __name__ == "__main__":
    sys.exit(main())
