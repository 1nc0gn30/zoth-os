#!/usr/bin/env python3
"""CWV Speed Engine v2.6.0 — Unified ZothOS CLI Launcher.

Dynamically resolves runtime root (/opt/cwv-speed-engine -> script-relative repo -> $CWV_SPEED_HOME)
with zero hardcoded user home paths.
"""

from __future__ import annotations

import argparse
import json
import os
import shutil
import socket
import subprocess
import sys
from pathlib import Path

TOOL_ID = "cwv-speed-engine"
TOOL_REPO = "cwv-speed-engine"
TOOL_NAME = "CWV Speed Engine"
TOOL_VERSION = "2.6.0"
TOOL_DESC = "Core Web Vitals diagnostic engine, HTML AST speed transformer, Speculation Rules, Budget Simulator, and 8-tool MCP server."
TOOL_CATEGORY = "Autonomous Web"
TOOL_PORT = 8128
STUDIO_URL = f"http://127.0.0.1:3000/tools/{TOOL_ID}"
LOCAL_PORT_URL = f"http://127.0.0.1:{TOOL_PORT}"


def resolve_runtime_root() -> Path:
    """Resolve runtime root dynamically without literal user home paths."""
    candidates = []
    env_home = os.environ.get("CWV_SPEED_HOME")
    if env_home:
        candidates.append(Path(env_home).expanduser())

    opt_dir = Path("/opt/cwv-speed-engine")
    candidates.append(opt_dir)

    script_parent = Path(__file__).resolve().parent.parent
    candidates.append(script_parent)

    candidates.append(Path.home() / "NullAITech" / "cwv-speed-engine")

    for cand in candidates:
        if (cand / "src" / "cwv_speed_engine" / "cli.py").is_file():
            return cand.resolve()
    return opt_dir


def _portable_path(p: Path) -> str:
    """Return a portable display path without leaking /home/<user>/ literals."""
    s = str(p)
    home_str = str(Path.home())
    if home_str and s.startswith(home_str):
        return "~" + s[len(home_str):]
    return s


def _port_listening(port: int = TOOL_PORT) -> bool:
    try:
        with socket.create_connection(("127.0.0.1", port), timeout=0.25):
            return True
    except OSError:
        return False


def _run_module(root: Path, mod_args: list[str]) -> int:
    src_dir = root / "src"
    env = os.environ.copy()
    env["PYTHONPATH"] = str(src_dir) + (os.pathsep + env["PYTHONPATH"] if env.get("PYTHONPATH") else "")
    res = subprocess.run([sys.executable, "-m", "cwv_speed_engine.cli"] + mod_args, cwd=str(root), env=env)
    return res.returncode


def main() -> None:
    root = resolve_runtime_root()
    args = sys.argv[1:]

    if args and args[0] in ("desktop", "electron", "--electron"):
        rem = [a for a in args[1:] if a != "--electron"] if args[0] in ("desktop", "electron") else [a for a in args if a != "--electron"]
        elec = shutil.which("electron") or "/usr/local/bin/electron"
        electron_main = root / "electron" / "main.cjs"
        if electron_main.is_file() and os.path.exists(elec):
            sys.exit(subprocess.run([elec, str(electron_main)] + rem, cwd=str(root)).returncode)
        # Fallback to launching local server if electron binary absent
        sys.exit(_run_module(root, ["serve", "--host", "127.0.0.1", "--port", str(TOOL_PORT)]))

    if args and args[0] in ("tui", "--tui"):
        rem = args[1:]
        tui_bin = shutil.which("cwv-speed-engine-tui") or str(root / "bin" / "cwv-speed-engine-tui")
        sys.exit(subprocess.run([tui_bin] + rem).returncode)

    native_subcommands = {
        "audit", "optimize", "cache", "pwa", "og", "diff",
        "check", "mcp", "serve", "platform", "speculation", "budget", "test",
    }
    if args and (args[0] in native_subcommands or args[0] == "--test"):
        sys.exit(_run_module(root, args))

    parser = argparse.ArgumentParser(
        prog=TOOL_ID,
        description=f"{TOOL_NAME} (v{TOOL_VERSION}) — {TOOL_DESC}",
        epilog=(
            "Subcommands: serve | desktop | tui | audit | optimize | diff | speculation | "
            "budget | cache | pwa | og | check | mcp | platform | test"
        ),
    )
    parser.add_argument("--version", action="version", version=f"{TOOL_ID} v{TOOL_VERSION}")
    parser.add_argument("--status", action="store_true", help="Check local installation & :8128 status")
    parser.add_argument("--json", action="store_true", help="Output deterministic JSON telemetry")
    parser.add_argument("--ui", action="store_true", help="Print local workstation URL")
    parsed, _unknown = parser.parse_known_args(args)

    port_up = _port_listening(TOOL_PORT)
    info = {
        "id": TOOL_ID,
        "repo": TOOL_REPO,
        "name": TOOL_NAME,
        "version": TOOL_VERSION,
        "category": TOOL_CATEGORY,
        "installed": (root / "src" / "cwv_speed_engine").is_dir(),
        "runtime_root": _portable_path(root),
        "studio_workbench_url": STUDIO_URL,
        "local_endpoint": LOCAL_PORT_URL,
        "port_8128_active": port_up,
        "mcp_tools_count": 8,
        "license": "100% Free & Open Access (Zero Paywalls)",
        "support": {
            "stripe_buy_coffee": "https://buy.stripe.com/3cIfZg27PdKo2D64Ocfw40X",
            "solana_wallet": "GG2eQbVh8ut1BK6j1A2tz7pSySdLpD38BgyEhGcxdXoK",
        },
        "status": "ACTIVE" if port_up else "READY_ON_DEMAND",
    }

    if parsed.ui:
        print(LOCAL_PORT_URL)
        return

    if parsed.json:
        print(json.dumps(info, indent=2))
        return

    print(f"✦ {TOOL_NAME} (v{TOOL_VERSION}) — [{TOOL_CATEGORY}]")
    print(f"  Runtime    : {_portable_path(root)}")
    print(f"  Workbench  : {STUDIO_URL}")
    print(f"  Local Port : {LOCAL_PORT_URL} ({'ACTIVE' if port_up else 'IDLE / ON-DEMAND'})")
    print("  Subcmds    : serve | desktop | tui | audit | optimize | diff | speculation | budget | mcp | test")
    print("  Access     : 100% Free & Open Access (☕ https://buy.stripe.com/3cIfZg27PdKo2D64Ocfw40X)")


if __name__ == "__main__":
    main()
