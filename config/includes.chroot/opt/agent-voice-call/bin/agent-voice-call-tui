#!/usr/bin/env python3
"""Agent Voice Call — Live Voice Cockpit TUI (v2.6.0).

Polls real loopback telemetry from 127.0.0.1:8114 (/health + /api/call/history).
Zero fabricated sine-wave metrics or placeholder audio LUFS values.
Engineered by Neal Frazier Tech (@1nc0gn30) • NullAI Platform.
"""

from __future__ import annotations

import argparse
import json
import os
import sys
import time
import urllib.request
from pathlib import Path
from typing import Any, Dict, Optional

VERSION = "2.6.0"


def _fetch_json(url: str, timeout: float = 1.5) -> Optional[Dict[str, Any]]:
    try:
        with urllib.request.urlopen(url, timeout=timeout) as resp:
            if resp.status == 200:
                return json.loads(resp.read().decode("utf-8"))
    except Exception:
        return None
    return None


def _collect_snapshot(host: str, port: int) -> Dict[str, Any]:
    health = _fetch_json(f"http://{host}:{port}/health")
    history = _fetch_json(f"http://{host}:{port}/api/call/history?limit=5") if health else None
    return {
        "tool": "agent-voice-call",
        "title": "Agent Voice Call",
        "version": VERSION,
        "architect": "Neal Frazier Tech (@1nc0gn30) • NullAI Platform",
        "endpoint": f"http://{host}:{port}",
        "daemon_online": health is not None,
        "health": health,
        "recent_debriefs": (history or {}).get("debriefs", []),
    }


def _render_panel(snap: Dict[str, Any]) -> str:
    h = snap.get("health") or {}
    online = snap["daemon_online"]
    status_str = "\033[32mONLINE\033[0m" if online else "\033[33mSTANDBY\033[0m"
    tts = h.get("tts_engine", "local-first")
    active = h.get("active_sessions", 0)
    max_s = h.get("max_sessions", 128)
    voices = ", ".join(h.get("available_voices", ["azoth", "ghostbyte", "athena", "mercury", "kitsune", "chronos"]))
    debriefs = snap.get("recent_debriefs") or []

    lines = [
        "\033[1;33m╭──────────────────────────────────────────────────────────────────────────╮\033[0m",
        f"\033[1;33m│\033[0m \033[1;37mAgent Voice Call v{VERSION}\033[0m  │  \033[36mNeal Frazier Tech (@1nc0gn30) • NullAI\033[0m      \033[1;33m│\033[0m",
        "\033[1;33m├──────────────────────────────────────────────────────────────────────────┤\033[0m",
        f"\033[1;33m│\033[0m  Endpoint:        {snap['endpoint']:<28} Status: {status_str}         \033[1;33m│\033[0m",
        f"\033[1;33m│\033[0m  TTS Engine:      {str(tts):<28} Sessions: {active}/{max_s:<12}\033[1;33m│\033[0m",
        f"\033[1;33m│\033[0m  Kokoro (:9394):  {'ONLINE' if h.get('kokoro_online') else 'STANDBY':<28} Cloud Opt-In: {str(bool(h.get('cloud_tts_opt_in'))):<8}\033[1;33m│\033[0m",
        f"\033[1;33m│\033[0m  Voices (6):      {voices[:54]:<54} \033[1;33m│\033[0m",
        "\033[1;33m├──────────────────────────────────────────────────────────────────────────┤\033[0m",
        f"\033[1;33m│\033[0m  Persisted Debriefs ({len(debriefs)} recent):                                            \033[1;33m│\033[0m",
    ]
    if not debriefs:
        lines.append("\033[1;33m│\033[0m    (no completed call transcripts recorded yet)                          \033[1;33m│\033[0m")
    else:
        for d in debriefs[:3]:
            row = f"  • {d.get('session_id', '')} [{d.get('voice', '')}] {d.get('total_turns', 0)} turns ({d.get('duration_sec', 0)}s)"
            lines.append(f"\033[1;33m│\033[0m  {row[:70]:<70}  \033[1;33m│\033[0m")
    lines.append("\033[1;33m╰──────────────────────────────────────────────────────────────────────────╯\033[0m")
    return "\n".join(lines)


def main(argv=None) -> int:
    ap = argparse.ArgumentParser(prog="agent-voice-call-tui", description="Agent Voice Call Live Voice Cockpit TUI")
    ap.add_argument("-v", "--version", action="version", version=f"agent-voice-call-tui {VERSION}")
    ap.add_argument("--host", default="127.0.0.1", help="Daemon host (default: 127.0.0.1)")
    ap.add_argument("--port", type=int, default=8114, help="Daemon port (default: 8114)")
    ap.add_argument("--status", action="store_true", help="Print live snapshot once and exit")
    ap.add_argument("--json", action="store_true", help="Output live JSON telemetry and exit")
    ap.add_argument("--watch", action="store_true", help="Continuously refresh live telemetry every 2s")
    ap.add_argument("--interval", type=float, default=2.0, help="Refresh interval in seconds for --watch")
    args, _unknown = ap.parse_known_args(argv)

    snap = _collect_snapshot(args.host, args.port)
    if args.json:
        print(json.dumps(snap, indent=2))
        return 0

    if args.watch and not args.status:
        try:
            while True:
                sys.stdout.write("\033[2J\033[H")
                sys.stdout.write(_render_panel(_collect_snapshot(args.host, args.port)) + "\n")
                sys.stdout.write("Press Ctrl+C to exit live monitor.\n")
                sys.stdout.flush()
                time.sleep(max(0.5, args.interval))
        except KeyboardInterrupt:
            return 0

    print(_render_panel(snap))
    return 0


if __name__ == "__main__":
    sys.exit(main())
