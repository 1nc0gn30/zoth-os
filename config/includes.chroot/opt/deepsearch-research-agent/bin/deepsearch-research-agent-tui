#!/usr/bin/env python3
"""
DeepSearch Research Agent & Studio v2.6.0 — Real Unicode U+2800 Braille TUI.

Imports deepsearch_research_agent directly, executes a live QueryPlanner +
EvidenceGraph TrustRank & DFS cycle-detection pass, renders a 2x4 sub-pixel
Braille citation-topology canvas, probes live http://127.0.0.1:8122/health,
and supports --once and --json modes with zero literal home-directory leaks.
"""

from __future__ import annotations

import argparse
import json
import math
import os
import sys
import time
import urllib.request
from pathlib import Path
from typing import Dict, List, Tuple

BRAILLE_BASE = 0x2800
VERSION = "2.6.0"
DEFAULT_PORT = 8122


def _ensure_src_on_path() -> Path:
    candidates = [
        Path("/opt/deepsearch-research-agent"),
        Path(__file__).resolve().parent.parent,
    ]
    env_home = os.environ.get("DEEPSEARCH_HOME")
    if env_home:
        candidates.insert(0, Path(env_home).expanduser())
    for c in candidates:
        src = c / "src"
        if (src / "deepsearch_research_agent").is_dir():
            if str(src) not in sys.path:
                sys.path.insert(0, str(src))
            return c
    return candidates[0]


def _probe_health(port: int = DEFAULT_PORT) -> Dict[str, object]:
    url = f"http://127.0.0.1:{port}/health"
    t0 = time.perf_counter()
    try:
        with urllib.request.urlopen(url, timeout=1.2) as resp:
            data = json.loads(resp.read().decode("utf-8", errors="replace"))
            return {
                "online": resp.status == 200,
                "status_code": resp.status,
                "version": data.get("version"),
                "latency_ms": round((time.perf_counter() - t0) * 1000.0, 2),
            }
    except Exception:
        return {"online": False, "status_code": 0, "version": None, "latency_ms": None}


def _render_braille_topology(nodes: List[Dict], edges: List[Dict], width_cells: int = 34, height_cells: int = 8) -> List[str]:
    """Render directed citation graph topology onto a 2x4 sub-pixel Unicode Braille canvas."""
    px_w = width_cells * 2
    px_h = height_cells * 4
    grid = [[False] * px_w for _ in range(px_h)]

    def plot(x: int, y: int) -> None:
        if 0 <= x < px_w and 0 <= y < px_h:
            grid[y][x] = True

    def draw_line(x0: int, y0: int, x1: int, y1: int) -> None:
        steps = max(abs(x1 - x0), abs(y1 - y0), 1)
        for s in range(steps + 1):
            t = s / steps
            plot(int(round(x0 + (x1 - x0) * t)), int(round(y0 + (y1 - y0) * t)))

    def draw_node(cx: int, cy: int) -> None:
        for dy in (-1, 0, 1):
            for dx in (-1, 0, 1):
                plot(cx + dx, cy + dy)

    coords: Dict[str, Tuple[int, int]] = {}
    n_count = max(1, len(nodes))
    cx_mid, cy_mid = px_w / 2.0, px_h / 2.0
    rx, ry = px_w * 0.38, px_h * 0.36
    for idx, node in enumerate(nodes):
        angle = (2.0 * math.pi * idx) / n_count - math.pi / 2.0
        nx = int(round(cx_mid + rx * math.cos(angle)))
        ny = int(round(cy_mid + ry * math.sin(angle)))
        coords[node["node_id"]] = (nx, ny)

    for edge in edges:
        a = coords.get(edge["source_id"])
        b = coords.get(edge["target_id"])
        if a and b:
            draw_line(a[0], a[1], b[0], b[1])

    for nx, ny in coords.values():
        draw_node(nx, ny)

    dot_bits = (
        (0, 0, 0x01), (0, 1, 0x02), (0, 2, 0x04), (0, 3, 0x40),
        (1, 0, 0x08), (1, 1, 0x10), (1, 2, 0x20), (1, 3, 0x80),
    )
    lines: List[str] = []
    for cy in range(height_cells):
        row = []
        for cx in range(width_cells):
            mask = 0
            for dx, dy, bit in dot_bits:
                if grid[cy * 4 + dy][cx * 2 + dx]:
                    mask |= bit
            row.append(chr(BRAILLE_BASE | mask))
        lines.append("".join(row))
    return lines


def run_snapshot(topic: str, depth: str, port: int) -> Dict[str, object]:
    _ensure_src_on_path()
    from deepsearch_research_agent.mcp_server import deepsearch_execute, deepsearch_plan

    t0 = time.perf_counter()
    plan = deepsearch_plan(topic=topic, depth=depth)
    report = deepsearch_execute(topic=topic, depth=depth, format="json", max_sources=5)
    elapsed_ms = round((time.perf_counter() - t0) * 1000.0, 2)
    daemon = _probe_health(port)

    ev = report.get("evidence_graph", {})
    nodes = ev.get("nodes", [])
    edges = ev.get("edges", [])
    braille_rows = _render_braille_topology(nodes, edges)

    return {
        "tool": "deepsearch-research-agent",
        "version": VERSION,
        "topic": topic,
        "depth": depth,
        "elapsed_ms": elapsed_ms,
        "daemon": daemon,
        "plan_angles": len(plan.get("angles", [])),
        "sub_queries": len(plan.get("sub_queries", [])),
        "sources_analyzed": report.get("metrics", {}).get("sources_analyzed", 0),
        "avg_credibility": report.get("metrics", {}).get("avg_source_credibility", 0.0),
        "consensus_score": report.get("metrics", {}).get("confidence_score", 0.0),
        "graph_nodes": ev.get("total_nodes", 0),
        "graph_edges": ev.get("total_edges", 0),
        "circular_cycles": len(ev.get("circular_cycles", [])),
        "authority_scores": ev.get("authority_scores", {}),
        "braille_topology": braille_rows,
    }


def main() -> int:
    ap = argparse.ArgumentParser(description=f"DeepSearch Research Agent v{VERSION} — Unicode Braille Citation-DAG TUI")
    ap.add_argument("--topic", default="Fault-Tolerant Quantum Surface Codes", help="Topic for query plan & citation graph pass")
    ap.add_argument("--depth", choices=["quick", "deep", "exhaustive"], default="quick")
    ap.add_argument("--port", type=int, default=DEFAULT_PORT, help="Local daemon port to probe (default: 8122)")
    ap.add_argument("--once", action="store_true", help="Render single dashboard snapshot and exit")
    ap.add_argument("--json", action="store_true", help="Emit JSON snapshot and exit")
    ap.add_argument("--benchmark", action="store_true", help="Run real planner+graph latency pass")
    args = ap.parse_args()

    snap = run_snapshot(args.topic, args.depth, args.port)
    if args.json:
        print(json.dumps(snap, indent=2, ensure_ascii=False))
        return 0

    daemon = snap["daemon"]
    status_str = f"ONLINE :{args.port} ({daemon['latency_ms']} ms)" if daemon["online"] else f"OFFLINE (:{args.port})"
    print("╭──────────────────────────────────────────────────────────────────────────╮")
    print(f"│ DeepSearch Research Agent v{VERSION} · Citation-DAG Braille Dashboard         │")
    print("├──────────────────────────────────────────────────────────────────────────┤")
    print(f"│ Topic   : {str(snap['topic'])[:62]:<62} │")
    print(f"│ Daemon  : {status_str:<32}  Pipeline : {snap['elapsed_ms']:>6.2f} ms       │")
    print(f"│ Plan    : {snap['plan_angles']} angles / {snap['sub_queries']} sub-queries       Sources  : {snap['sources_analyzed']} (α={snap['avg_credibility']})    │")
    print(f"│ DAG     : {snap['graph_nodes']} nodes / {snap['graph_edges']} edges               Cycles   : {snap['circular_cycles']} (DFS Verified) │")
    print("├──────────────────────────────────────────────────────────────────────────┤")
    print("│ Unicode U+2800 2x4 Sub-Pixel Citation Topology:                          │")
    for line in snap["braille_topology"]:
        print(f"│   {line:<68}   │")
    print("╰──────────────────────────────────────────────────────────────────────────╯")
    return 0


if __name__ == "__main__":
    sys.exit(main())
