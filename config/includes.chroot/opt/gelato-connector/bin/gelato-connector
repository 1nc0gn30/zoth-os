#!/usr/bin/env python3
"""Gelato Connector Executable Launcher (v2.6.0).

Engineered by Neal Frazier Tech (@1nc0gn30) • NullAI Platform.
100% Python Standard Library — Zero External Runtime Dependencies.
"""

from __future__ import annotations

import os
import sys
from pathlib import Path


def _resolve_src_dir() -> Path:
    """Resolve gelato_connector src/ via ZOTH_REPO_DIR, /opt/gelato-connector, or script-relative layout."""
    candidates = []
    env_repo = os.environ.get("ZOTH_REPO_DIR", "").strip()
    if env_repo:
        candidates.append(Path(env_repo) / "src")
    here_root = Path(__file__).resolve().parent.parent
    candidates.append(here_root / "src")
    candidates.append(Path("/opt/gelato-connector/src"))

    for cand in candidates:
        if (cand / "gelato_connector").is_dir():
            return cand
    return candidates[0]


SRC_DIR = _resolve_src_dir()
if str(SRC_DIR) not in sys.path:
    sys.path.insert(0, str(SRC_DIR))

from gelato_connector.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
