#!/usr/bin/env python3
"""Gelato Connector v2.6.0 — Terminal Summary, Daemon Probe & Local Benchmark.

Runs the real FX-safe margin and shipping engines for one product across all 10 bundled
hub countries, probes local :8116 health, times the work, and renders a Unicode braille sparkline.
Engineered by Neal Frazier Tech (@1nc0gn30) • NullAI Platform (https://nullai.tech)
"""

from __future__ import annotations

import argparse
import json
import os
import sys
import time
import urllib.request
from pathlib import Path


def _resolve_src_dir() -> Path:
    candidates = []
    env_repo = os.environ.get("ZOTH_REPO_DIR", "").strip()
    if env_repo:
        candidates.append(Path(env_repo) / "src")
    here_root = Path(__file__).resolve().parent.parent
    candidates.append(here_root / "src")
    candidates.append(Path("/opt/gelato-connector/src"))

    for cand in candidates:
        if (cand / "gelato_connector").is_dir():
            return cand
    return candidates[0]


SRC_DIR = _resolve_src_dir()
if str(SRC_DIR) not in sys.path:
    sys.path.insert(0, str(SRC_DIR))

from gelato_connector import __version__  # noqa: E402
from gelato_connector.catalog import GELATO_PRODUCTS, get_product  # noqa: E402
from gelato_connector.margin_engine import calculate_multi_channel_margins  # noqa: E402
from gelato_connector.mcp_server import TOOLS as MCP_TOOLS  # noqa: E402
from gelato_connector.shipping_engine import LOCAL_HUBS, get_shipping_quote  # noqa: E402

BRAILLE_BASE = 0x2800


def braille_sparkline(vals):
    if not vals:
        return ""
    lo, hi = min(vals), max(vals)
    span = (hi - lo) or 1.0
    norm = [(v - lo) / span for v in vals]
    if len(norm) % 2:
        norm.append(norm[-1])
    out = []
    for i in range(0, len(norm), 2):
        v1 = max(0, min(3, int(norm[i] * 3.99)))
        v2 = max(0, min(3, int(norm[i + 1] * 3.99)))
        out.append(chr(BRAILLE_BASE | (0x40, 0x04, 0x02, 0x01)[v1] | (0x80, 0x20, 0x10, 0x08)[v2]))
    return "".join(out)


def probe_daemon(host: str = "127.0.0.1", port: int = 8116):
    url = f"http://{host}:{port}/health"
    try:
        with urllib.request.urlopen(url, timeout=1.5) as resp:
            return json.loads(resp.read().decode("utf-8"))
    except Exception:
        return None


def run(product_id: str, price: float, iterations: int):
    countries = list(LOCAL_HUBS)
    margins = []
    t0 = time.perf_counter()
    for _ in range(iterations):
        margins = []
        for cc in countries:
            res = calculate_multi_channel_margins(
                product_id=product_id,
                retail_price=price,
                currency="USD",
                destination_country=cc,
            )
            margins.append(float(res["channels"]["etsy"]["profit_margin_pct"]))
            get_shipping_quote(product_id, cc, False)
    elapsed_ms = (time.perf_counter() - t0) * 1000.0
    return countries, margins, elapsed_ms


def main() -> int:
    ap = argparse.ArgumentParser(description="Gelato Connector terminal summary, daemon status & local benchmark")
    ap.add_argument("--status", action="store_true", help="Show daemon status and bundled engine summary")
    ap.add_argument("--once", action="store_true", help="Run a single non-interactive pass and exit")
    ap.add_argument("--json", action="store_true", help="Output JSON summary and exit")
    ap.add_argument("--host", default="127.0.0.1", help="Daemon host to probe (default: 127.0.0.1)")
    ap.add_argument("--port", type=int, default=8116, help="Daemon port to probe (default: 8116)")
    ap.add_argument("--product", default="acrylic_print_16x24", help="Product ID (default: acrylic_print_16x24)")
    ap.add_argument("--price", type=float, default=68.0, help="Retail price in USD (default: 68.0)")
    ap.add_argument("--iterations", type=int, default=50, help="Benchmark iterations (default: 50)")
    args = ap.parse_args()

    daemon = probe_daemon(args.host, args.port)

    if args.status and not args.once:
        status_payload = {
            "tool": "gelato-connector-tui",
            "service": "gelato-connector",
            "version": __version__,
            "status": "online" if daemon else "standby",
            "endpoint": f"http://{args.host}:{args.port}",
            "products": len(GELATO_PRODUCTS),
            "hub_countries": len(LOCAL_HUBS),
            "mcp_tools": len(MCP_TOOLS),
            "api_key_configured": bool(os.environ.get("GELATO_API_KEY")),
            "daemon": daemon,
        }
        if args.json:
            print(json.dumps(status_payload, indent=2))
            return 0
        print(f"Gelato Connector TUI v{__version__}  |  Neal Frazier Tech (@1nc0gn30)")
        print(f"Daemon:   {status_payload['status'].upper()} ({status_payload['endpoint']})")
        print(f"Catalog:  {status_payload['products']} products  |  Hubs: {status_payload['hub_countries']} countries  |  MCP: {status_payload['mcp_tools']} tools")
        return 0

    product = get_product(args.product)
    if not product:
        print(f"Unknown product: {args.product}", file=sys.stderr)
        return 2

    iters = max(1, args.iterations)
    countries, margins, elapsed_ms = run(product["id"], args.price, iters)
    calcs = len(countries) * iters * 2
    summary = {
        "tool": "gelato-connector",
        "version": __version__,
        "status": "online" if daemon else "standby",
        "endpoint": f"http://{args.host}:{args.port}",
        "products": len(GELATO_PRODUCTS),
        "hub_countries": len(LOCAL_HUBS),
        "mcp_tools": len(MCP_TOOLS),
        "product": product["id"],
        "product_uid": product["product_uid"],
        "retail_price_usd": args.price,
        "etsy_net_margin_pct_by_country": dict(zip(countries, margins)),
        "benchmark": {
            "calculations": calcs,
            "elapsed_ms": round(elapsed_ms, 3),
            "per_calc_us": round(elapsed_ms * 1000.0 / calcs, 2) if calcs else None,
        },
        "braille_margin_sparkline": braille_sparkline(margins),
        "daemon": daemon,
    }
    if args.json:
        print(json.dumps(summary, indent=2))
        return 0

    print(f"Gelato Connector v{__version__}  |  Neal Frazier Tech (@1nc0gn30) • NullAI Platform")
    print(f"Daemon: {summary['status'].upper()} ({summary['endpoint']})  |  Products: {summary['products']}  |  Hubs: {summary['hub_countries']}  |  MCP: {summary['mcp_tools']}")
    print(f"Product: {product['title']} @ ${args.price:.2f} USD")
    print(f"Etsy net margin by destination: {summary['braille_margin_sparkline']}")
    for cc, m in zip(countries, margins):
        print(f"  {cc:<4} {LOCAL_HUBS[cc]['country']:<16} {m:7.2f}%")
    b = summary["benchmark"]
    print(f"Benchmark: {b['calculations']} calculations in {b['elapsed_ms']} ms ({b['per_calc_us']} us/calc)")
    return 0


if __name__ == "__main__":
    sys.exit(main())
