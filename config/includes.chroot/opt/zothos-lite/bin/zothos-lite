def get_status():
    live = {}
    online = False
    try:
        with urllib.request.urlopen("http://127.0.0.1:8145/api/system-status", timeout=2) as r:
            live = json.loads(r.read().decode())
            online = True
    except Exception:
        live = {"ok": True, "mode": "standalone"}

    total_models = sum(len(p["models"]) for p in SUPPORTED_PROVIDERS.values())
    return {
        "id": "zothos-lite",
        "os": "ZothOS-Lite v1.2 (Tails-Style Amnesic Monotone OS)",
        "theme": "Paper Ivory #F7F7F4 / Black Ink #000000 / Bayer Dither / Unicode U+2800 Braille",
        "kernel": "Linux 6.12.x amd64 (toram noswap)",
        "port": 8145,
        "url": "http://127.0.0.1:8145",
        "production_url": "https://zothos-lite.nullai.tech",
        "daemon_active": online,
        "hardware_support": "Universal x86_64 (Intel, AMD, NVIDIA, DRM/KMS, Mesa LLVMpipe)",
        "ai_providers_count": len(SUPPORTED_PROVIDERS),
        "ai_models_count": total_models,
        "built_in_tools_count": len(IN_BROWSER_TOOLS),
        "guide_topics_count": len(GUIDE_TOPICS),
        "os_cli_utilities": [
            "zothos-lite",
            "zothos-lite-tui",
            "zoth-lite-models",
            "zoth-lite-welcome",
            "zoth-lite-storage",
            "zoth-lite-pkg",
        ],
        "system_status": live,
        "engineered_by": "1nc0gn30 (@1nc0gn30) • NullAI Platform",
        "support": {
            "buy_us_a_coffee_stripe": "https://buy.stripe.com/3cIfZg27PdKo2D64Ocfw40X",
            "solana_tip_address": "GG2eQbVh8ut1BK6j1A2tz7pSySdLpD38BgyEhGcxdXoK",
        },
        "license": "100% Free & Open Access (Zero Paywalls)",
    }


def main():
    parser = argparse.ArgumentParser(description="ZothOS-Lite v1.2 — Amnesic Monotone OS & 56-Model AI CLI (:8145)")
    parser.add_argument(
        "action",
        nargs="?",
        choices=["status", "models", "providers", "tools", "guide", "welcome", "storage", "pkg", "serve", "desktop", "tui"],
        help="Action command",
    )
    parser.add_argument("--status", action="store_true", help="Query ZothOS-Lite (:8145) live status and OS metadata")
    parser.add_argument("--models", action="store_true", help="List all 56 curated models across 8 providers")
    parser.add_argument("--providers", action="store_true", help="List all 8 supported AI providers and endpoints")
    parser.add_argument("--tools", action="store_true", help="List built-in browser & OS utilities")
    parser.add_argument("--guide", action="store_true", help="Display the 5-topic onboarding & amnesic guide")
    parser.add_argument("--port", type=int, default=8145, help="Port to bind when serving")
    parser.add_argument("--json", action="store_true", help="Output deterministic JSON")
    parser.add_argument("--version", "-v", action="store_true", help="Show version")
    args = parser.parse_args()

    if args.version:
        print("zothos-lite v1.2 (Amnesic Monotone OS • 56 AI Models / 8 Providers • :8145)")
        return

    if args.action == "serve":
        env = os.environ.copy()
        env["PORT"] = str(args.port or 8145)
        sys.exit(subprocess.run(["node", str(REPO_DIR / "server.js")], cwd=str(REPO_DIR), env=env).returncode)

    if args.models or args.action == "models":
        if args.json:
            print(json.dumps(SUPPORTED_PROVIDERS, indent=2))
        else:
            total = sum(len(p["models"]) for p in SUPPORTED_PROVIDERS.values())
            print(f"=== ZothOS-Lite v1.2 • {total} Curated AI Models Across {len(SUPPORTED_PROVIDERS)} Providers ===")
            for pid, prov in SUPPORTED_PROVIDERS.items():
                print(f"\n[{prov['name']} ({pid})] Endpoint: {prov['endpoint']}")
                for m in prov["models"]:
                    print(f"  • {m}")
        return

    if args.providers or args.action == "providers":
        if args.json:
            print(json.dumps([{"id": k, **v} for k, v in SUPPORTED_PROVIDERS.items()], indent=2))
        else:
            print("=== ZothOS-Lite v1.2 Supported AI Providers (8) ===")
            for pid, prov in SUPPORTED_PROVIDERS.items():
                print(f"  • {pid:12s} | {prov['name']:<29} ({len(prov['models']):>2} models) -> {prov['endpoint']}")
        return

    if args.tools or args.action == "tools":
        if args.json:
            print(json.dumps(IN_BROWSER_TOOLS, indent=2))
        else:
            print("=== ZothOS-Lite v1.2 Workstation Utilities ===")
            for t in IN_BROWSER_TOOLS:
                print(f"  • {t['id']:18s} | {t['name']}\n    {t['desc']}")
        return

    if args.guide or args.action == "guide":
        if args.json:
            print(json.dumps(GUIDE_TOPICS, indent=2))
        else:
            print("=== ZothOS-Lite v1.2 Amnesic Onboarding Guide ===")
            for g in GUIDE_TOPICS:
                print(f"\n[ {g['title']} ]")
                print(f"  {g['summary']}")
        return

    data = get_status()
    if args.json or args.status or args.action == "status" or args.action is None:
        print(json.dumps(data, indent=2))
    else:
        parser.print_help()


if __name__ == "__main__":
    main()
