import os as _z_os, sys as _z_sys, shutil as _z_sh, subprocess as _z_sp

_BIN_DIR = _z_os.path.dirname(_z_os.path.abspath(__file__))

if "--electron" in _z_sys.argv[1:] or (_z_sys.argv[1:] and _z_sys.argv[1] in ("desktop", "electron")):
    _z_rem = [a for a in _z_sys.argv[1:] if a not in ("--electron", "desktop", "electron")]
    _z_cand = _z_os.path.abspath(_z_os.path.join(_BIN_DIR, ".."))
    _z_rdir = _z_cand if _z_os.path.exists(_z_os.path.join(_z_cand, "electron", "main.cjs")) else (
        _z_os.path.expanduser("~/NullAITech/zothos-lite")
        if _z_os.path.exists(_z_os.path.expanduser("~/NullAITech/zothos-lite/electron/main.cjs"))
        else "/opt/zothos-lite"
    )
    _z_el = _z_sh.which("electron") or "/usr/local/bin/electron"
    _z_sys.exit(_z_sp.run([_z_el, _z_os.path.join(_z_rdir, "electron", "main.cjs")] + _z_rem, cwd=_z_rdir).returncode)

if "--tui" in _z_sys.argv[1:] or (_z_sys.argv[1:] and _z_sys.argv[1] == "tui"):
    _z_rem = [a for a in _z_sys.argv[1:] if a not in ("--tui", "tui")]
    _z_tui = _z_os.path.join(_BIN_DIR, "zothos-lite-tui") if _z_os.path.exists(_z_os.path.join(_BIN_DIR, "zothos-lite-tui")) else (_z_sh.which("zothos-lite-tui") or "/usr/local/bin/zothos-lite-tui")
    _z_sys.exit(_z_sp.run([_z_tui] + _z_rem).returncode)

for _sub_name, _bin_target in (("welcome", "zoth-lite-welcome"), ("storage", "zoth-lite-storage"), ("pkg", "zoth-lite-pkg")):
    if _z_sys.argv[1:] and _z_sys.argv[1] == _sub_name:
        _target = _z_os.path.join(_BIN_DIR, _bin_target) if _z_os.path.exists(_z_os.path.join(_BIN_DIR, _bin_target)) else (_z_sh.which(_bin_target) or f"/usr/local/bin/{_bin_target}")
        _z_sys.exit(_z_sp.run([_target] + _z_sys.argv[2:]).returncode)

