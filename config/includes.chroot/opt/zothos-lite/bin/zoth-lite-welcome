import json
import os
import shutil
import sys
from pathlib import Path

CHAPTERS = [
    {
        "step": 1,
        "id": "models",
        "title": "1. AI Agents: 56+ Models Across 8 Providers & LAN Endpoints",
        "summary": "Connect cloud frontier models or local/LAN Ollama & vLLM servers with RAM-only API keys.",
        "details": [
            "ZothOS-Lite ships pre-configured for 56 curated models across 8 providers:",
            "  OpenRouter, OpenAI, Anthropic Claude, Google Gemini, DeepSeek, xAI Grok, Groq LPU, and Ollama / LAN Local.",
            "API keys live strictly in volatile RAM (/run/user/$UID/zoth-keys.env or /dev/shm) with 0600 permissions.",
        ],
        "commands": [
            "zoth-lite-models --list",
            "zoth-lite-models --set-key openrouter",
            "zoth-lite-models --set-endpoint ollama http://192.168.1.50:11434/v1/chat/completions",
            'zoth-lite-models --run deepseek/deepseek-r1 "Audit this bash script"',
        ],
    },
    {
        "step": 2,
        "id": "shutdown",
        "title": "2. Power-Off, Lid Close & Amnesic RAM Hygiene (toram noswap)",
        "summary": "Understand exactly what disappears when you shut down, reboot, or pull the USB.",
        "details": [
            "ZothOS-Lite boots entirely into volatile system RAM using Debian Live `toram noswap`.",
            "Once the desktop appears, you can physically unplug the boot USB drive.",
