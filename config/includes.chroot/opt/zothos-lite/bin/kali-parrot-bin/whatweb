#!/usr/bin/env python3
import sys, urllib.request

url = sys.argv[1] if len(sys.argv) > 1 and not sys.argv[1].startswith("-") else "http://127.0.0.1:8145"
if not url.startswith("http"):
    url = "http://" + url
try:
    req = urllib.request.Request(url, headers={"User-Agent": "WhatWeb/0.5.5 (Kali/Parrot Security OS)"})
    with urllib.request.urlopen(req, timeout=4) as r:
        hdrs = dict(r.headers)
        body = r.read(4096).decode("utf-8", errors="ignore")
        title = body.split("<title>")[1].split("</title>")[0].strip() if "<title>" in body else "N/A"
        srv = hdrs.get("Server", "Node.js/ZothOS-Amnesic")
        xfo = hdrs.get("X-Frame-Options", "NONE")
        print(f"{url} [{r.status} OK] Country[LOCAL-RAM] Server[{srv}] X-Frame-Options[{xfo}] Title[{title}]")
except Exception as e:
    print(f"{url} [ERROR: {e}]")
