def load_state():
    if STATE_FILE.exists():
        try:
            return json.loads(STATE_FILE.read_text(encoding="utf-8"))
        except Exception:
            pass
    default_state = {
        "pulledTools": {
            "promptmaster-security-lab": {"mode": "RAM_TMPFS", "pulledAt": "2026-10-26T16:50:00Z"},
            "webmcp-protocol-inspector": {"mode": "RAM_TMPFS", "pulledAt": "2026-10-26T16:50:00Z"}
        },
        "amnesiaConfig": {
            "ramOnlyMode": True,
            "torStrictKillswitch": True,
            "macSpoofing": True,
            "spoofedMac": "02:42:ac:11:00:7f",
            "luksPersistenceUnlocked": False,
            "usbKillswitchArmed": True,
            "baseIsoSizeMb": 840
        }
    }
    STATE_FILE.parent.mkdir(parents=True, exist_ok=True)
    STATE_FILE.write_text(json.dumps(default_state, indent=2), encoding="utf-8")
    return default_state


def save_state(state):
    STATE_FILE.parent.mkdir(parents=True, exist_ok=True)
    STATE_FILE.write_text(json.dumps(state, indent=2), encoding="utf-8")


def main():
    parser = argparse.ArgumentParser(description="ZothOS-Lite Modular Tool Puller (zoth-lite-pkg)")
    sub = parser.add_subparsers(dest="cmd")
    sub.add_parser("list", help="List core pre-installed security/dev tools and optional pullable tools")
    pull_p = sub.add_parser("pull", help="Pull an optional Zoth tool into RAM tmpfs or LUKS persistence")
    pull_p.add_argument("tool_id", help="Tool ID to pull")
    pull_p.add_argument("--persist", action="store_true", help="Store in LUKS2 persistent vault instead of volatile RAM")
    purge_p = sub.add_parser("purge", help="Remove a pulled optional tool from RAM/persistence")
    purge_p.add_argument("tool_id", help="Tool ID to purge")

    args = parser.parse_args()
    state = load_state()

    if args.cmd == "pull":
        tool = next((t for t in OPTIONAL_PULLABLE_TOOLS if t["id"] == args.tool_id), None)
        if not tool:
            print(f"[!] Unknown tool ID: {args.tool_id}")
            sys.exit(1)
        mode = "LUKS_PERSIST" if args.persist else "RAM_TMPFS"
        state["pulledTools"][tool["id"]] = {
            "mode": mode,
            "pulledAt": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
        }
        save_state(state)
        digest = hashlib.sha256(tool["id"].encode()).hexdigest()[:24]
        print(f"░░▒▒▓▓██ PULLED {tool['id']} ({tool['sizeMb']} MB) -> {mode} [SHA256:{digest}…] ██▓▓▒▒░░")
        return

    if args.cmd == "purge":
        if args.tool_id in state.get("pulledTools", {}):
            del state["pulledTools"][args.tool_id]
            save_state(state)
            print(f"░░▒▒▓▓██ PURGED {args.tool_id} FROM VOLATILE OVERLAYFS ██▓▓▒▒░░")
        else:
            print(f"[i] Tool {args.tool_id} is not currently pulled.")
        return

    print("┌──────────────────────────────────────────────────────────────────────────────┐")
    print("│ ░░▒▒▓▓██ ZOTHOS-LITE v1.1 // AMNESIC MONOTONE SECURITY & DEV ARSENAL ██▓▓▒▒░░ │")
    print("└──────────────────────────────────────────────────────────────────────────────┘")
    print("\n[CORE PRE-INSTALLED ZOTH SECURITY & DEV TOOLS — ALWAYS ON ISO]")
    for t in CORE_SECURITY_DEV_TOOLS:
        print(f"  █ {t['id']:<30} ({t['sizeMb']:>3} MB)  [{t['binary']}] — {t['description'][:48]}…")

    print("\n[MODULAR ON-DEMAND ZOTH TOOLS — PULL ONLY WHAT YOU NEED]")
    pulled = state.get("pulledTools", {})
    for t in OPTIONAL_PULLABLE_TOOLS:
        status = f"▓ PULLED ({pulled[t['id']]['mode']})" if t["id"] in pulled else "░ AVAILABLE"
        print(f"  {status:<24} {t['id']:<30} ({t['sizeMb']:>3} MB) — {t['category']}")


if __name__ == "__main__":
    main()
