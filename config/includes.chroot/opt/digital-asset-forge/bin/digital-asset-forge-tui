#!/usr/bin/env python3
"""Digital Asset Forge — Unicode U+2800 Braille 5-Ratio Print Frame & :8118 Dashboard TUI.
Engineered by Neal Frazier Tech (@1nc0gn30) • NullAI Platform
Zero third-party dependencies (100% Python Standard Library).
"""

import argparse
import json
import os
import sys
import urllib.request
from pathlib import Path


def _resolve_src_dir() -> str:
    candidates = []
    env_home = os.environ.get("DIGITAL_ASSET_FORGE_HOME")
    if env_home:
        candidates.append(Path(env_home) / "src")
    env_repo = os.environ.get("ZOTH_REPO_DIR")
    if env_repo:
        candidates.append(Path(env_repo) / "src")
    script_root = Path(__file__).resolve().parent.parent
    candidates.append(script_root / "src")
    candidates.append(Path("/opt/digital-asset-forge/src"))
    for cand in candidates:
        if (cand / "digital_asset_forge" / "__init__.py").is_file():
            return str(cand)
    return str(Path("/opt/digital-asset-forge/src"))


_src = _resolve_src_dir()
if _src not in sys.path:
    sys.path.insert(0, _src)

from digital_asset_forge import __version__
from digital_asset_forge.ratios import RATIO_FAMILIES, RatioCalculator
from digital_asset_forge.pack_generator import ArtPackGenerator
from digital_asset_forge.etsy_copywriter import EtsyCopywriter

BRAILLE_BASE = 0x2800
DOT_BITS = (
    (0x01, 0x08),
    (0x02, 0x10),
    (0x04, 0x20),
    (0x40, 0x80),
)


def probe_health(port: int = 8118, timeout: float = 0.8) -> dict:
    url = f"http://127.0.0.1:{port}/health"
    try:
        req = urllib.request.Request(url, headers={"Host": f"127.0.0.1:{port}"})
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            data = json.loads(resp.read().decode("utf-8"))
            return {"online": resp.status == 200, "http_status": resp.status, "health": data}
    except Exception:
        return {"online": False, "http_status": 0, "health": None}


def render_nested_ratio_braille(cols: int = 34, rows: int = 9) -> list[str]:
    """Render all 5 nested print ratios (2:3, 3:4, 4:5, 11:14, ISO) onto a U+2800 Braille grid."""
    px_w = cols * 2
    px_h = rows * 4
    grid = [[False] * px_w for _ in range(px_h)]

    def draw_rect(x0: int, y0: int, x1: int, y1: int) -> None:
        x0, x1 = max(0, min(px_w - 1, x0)), max(0, min(px_w - 1, x1))
        y0, y1 = max(0, min(px_h - 1, y0)), max(0, min(px_h - 1, y1))
        for x in range(x0, x1 + 1):
            grid[y0][x] = True
            grid[y1][x] = True
        for y in range(y0, y1 + 1):
            grid[y][x0] = True
            grid[y][x1] = True

    scales = [
        (RATIO_FAMILIES["2x3"].ratio_decimal, 0.94),
        (RATIO_FAMILIES["3x4"].ratio_decimal, 0.80),
        (RATIO_FAMILIES["4x5"].ratio_decimal, 0.66),
        (RATIO_FAMILIES["11x14"].ratio_decimal, 0.52),
        (RATIO_FAMILIES["iso"].ratio_decimal, 0.38),
    ]
    cx, cy = px_w // 2, px_h // 2
    for ratio_dec, scale in scales:
        h = max(4, int(round((px_h - 2) * scale)))
        w = max(6, int(round(h * ratio_dec * 1.45)))
        x0 = cx - w // 2
        y0 = cy - h // 2
        draw_rect(x0, y0, x0 + w, y0 + h)

    # Center 300 DPI crosshair
    for dx in range(-4, 5, 2):
        if 0 <= cx + dx < px_w:
            grid[cy][cx + dx] = True
    for dy in range(-3, 4, 2):
        if 0 <= cy + dy < px_h:
            grid[cy + dy][cx] = True

    lines = []
    for r in range(rows):
        row_chars = []
        for c in range(cols):
            mask = 0
            for dy in range(4):
                for dx in range(2):
                    if grid[r * 4 + dy][c * 2 + dx]:
                        mask |= DOT_BITS[dy][dx]
            row_chars.append(chr(BRAILLE_BASE | mask))
        lines.append("".join(row_chars))
    return lines


def build_dashboard_state(title: str, port: int) -> dict:
    families = RatioCalculator.get_all_families()
    manifest = ArtPackGenerator.generate_manifest(artwork_title=title, artist_name="1nc0gn30")
    listing = EtsyCopywriter.generate_listing(artwork_title=title, niche="abstract", retail_price_usd=6.99)
    daemon = probe_health(port=port)
    braille_lines = render_nested_ratio_braille()
    return {
        "tool": "digital-asset-forge",
        "title": "Digital Asset Forge",
        "version": __version__,
        "attribution": "Engineered by Neal Frazier Tech (@1nc0gn30) • NullAI Platform",
        "port": port,
        "daemon_online": daemon["online"],
        "daemon_health": daemon["health"],
        "artwork_title": title,
        "ratio_count": len(families),
        "total_files": manifest["total_files"],
        "total_estimated_size_mb": manifest["total_estimated_size_mb"],
        "etsy_delivery_plan": manifest["etsy_delivery_plan"],
        "etsy_tags_count": listing["tags_count"],
        "etsy_net_margin_pct": listing["economics"]["profit_margin_percentage"],
        "braille_frame": braille_lines,
    }


def main() -> int:
    ap = argparse.ArgumentParser(
        prog="digital-asset-forge-tui",
        description="Digital Asset Forge Unicode U+2800 Braille 5-Ratio & :8118 Dashboard TUI",
    )
    ap.add_argument("--version", action="version", version=f"digital-asset-forge-tui {__version__}")
    ap.add_argument("--once", action="store_true", help="Render one dashboard frame and exit")
    ap.add_argument("--status", action="store_true", help="Print concise daemon + pack status summary")
    ap.add_argument("--json", action="store_true", help="Output structured JSON telemetry and exit")
    ap.add_argument("--title", default="Celestial Obsidian Horizon", help="Artwork title for pack preview")
    ap.add_argument("--port", type=int, default=8118, help="Local daemon port to probe (default: 8118)")
    args = ap.parse_args()

    state = build_dashboard_state(args.title, args.port)

    if args.json:
        print(json.dumps(state, indent=2))
        return 0

    plan = state["etsy_delivery_plan"]
    daemon_label = (
        f"ONLINE v{state['daemon_health'].get('version', __version__)}"
        if state["daemon_online"] and state["daemon_health"]
        else "STANDBY"
    )
    viable_label = "PASS" if plan["etsy_direct_upload_viable"] else "CHECK"

    if args.status:
        print(
            f"Digital Asset Forge v{__version__} | :8118 {daemon_label} | "
            f"{state['ratio_count']} Ratios | {state['total_estimated_size_mb']} MB -> "
            f"{plan['total_zip_archives']} ZIPs ({viable_label}) | "
            f"Etsy SEO {state['etsy_tags_count']} tags | Margin {state['etsy_net_margin_pct']}%"
        )
        return 0

    gold = "\033[1;33m"
    cyan = "\033[36m"
    green = "\033[32m"
    white = "\033[1;37m"
    reset = "\033[0m"

    print(f"{gold}╭────────────────────────────────────────────────────────────────────────────╮{reset}")
    print(
        f"{gold}│{reset} {white}DIGITAL ASSET FORGE v{__version__:<8}{reset} │ "
        f"{cyan}300 DPI 5-Ratio Wall-Art Pack Forge{reset}        {gold}│{reset}"
    )
    print(f"{gold}├────────────────────────────────────┬───────────────────────────────────────┤{reset}")

    right_rows = [
        f"Daemon :8118 : {green if state['daemon_online'] else gold}{daemon_label:<22}{reset}",
        f"Artwork      : {args.title[:22]:<22}",
        f"Ratios       : 5 Families @ 300 DPI  ",
        f"Pack Weight  : {state['total_estimated_size_mb']:<5.1f} MB ({state['total_files']} files)   ",
        f"Etsy <=20MB  : {plan['total_zip_archives']} ZIPs [{green}{viable_label}{reset}]           ",
        f"Etsy SEO     : {state['etsy_tags_count']} tags (<=20 chars)   ",
        f"Net Margin   : {state['etsy_net_margin_pct']:<5.1f}% ($6.99 retail) ",
        f"MCP Suite    : 6 forge_* stdio tools ",
        f"Web UI       : http://127.0.0.1:{args.port:<4} ",
    ]

    for left_line, right_line in zip(state["braille_frame"], right_rows):
        print(f"{gold}│{reset} {gold}{left_line}{reset} {gold}│{reset} {right_line} {gold}│{reset}")

    print(f"{gold}├────────────────────────────────────┴───────────────────────────────────────┤{reset}")
    for b in plan["bundles"]:
        line = f"  ZIP: {b['zip_filename']} ({b['bundle_size_mb']} MB, {len(b['contained_files'])} files, <=20MB OK)"
        print(f"{gold}│{reset} {line[:74]:<74} {gold}│{reset}")
    print(f"{gold}├────────────────────────────────────────────────────────────────────────────┤{reset}")
    print(f"{gold}│{reset} Engineered by Neal Frazier Tech (@1nc0gn30) • NullAI Platform               {gold}│{reset}")
    print(f"{gold}╰────────────────────────────────────────────────────────────────────────────╯{reset}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
