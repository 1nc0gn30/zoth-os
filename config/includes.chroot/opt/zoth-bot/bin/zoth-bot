#!/usr/bin/env python3
"""
Zoth Bot CLI Binary
Local-first, always-on 3D WebGL desk companion for Zoth OS.
"""

import argparse
import json
import os
import subprocess
import sys
import urllib.request

TOOL_ID = "zoth-bot"
TOOL_NAME = "Zoth Bot Desktop Companion"
TOOL_VERSION = "1.0.0"
TOOL_CATEGORY = "Swarm & Core"
TOOL_PORT = 8146
STUDIO_PORT = 3000
REPO_DIR = "/opt/zoth-bot"
STUDIO_URL = f"http://127.0.0.1:{STUDIO_PORT}/tools/{TOOL_ID}"
LOCAL_PORT_URL = f"http://127.0.0.1:{TOOL_PORT}"

def check_daemon(url=f"{LOCAL_PORT_URL}/health", timeout=1.5):
    try:
        req = urllib.request.Request(url, headers={"User-Agent": "ZothBotCLI/1.0.0"})
        with urllib.request.urlopen(req, timeout=timeout) as res:
            if res.status == 200:
                return json.loads(res.read().decode())
    except Exception:
        pass
    return None

def main():
    parser = argparse.ArgumentParser(
        prog=TOOL_ID,
        description=f"{TOOL_NAME} (v{TOOL_VERSION}) — Sovereign 3D Desk Companion"
    )
    parser.add_argument("--version", action="version", version=f"{TOOL_ID} v{TOOL_VERSION}")
    parser.add_argument("--status", action="store_true", help="Check local ZothOS installation & daemon status")
    parser.add_argument("--json", action="store_true", help="Output deterministic JSON telemetry")
    parser.add_argument("--ui", action="store_true", help="Print local ZothOS workbench URL")
    parser.add_argument("--rings", action="store_true", help="List Security Ring authority levels (Rings 0-3)")
    parser.add_argument("--mcp", action="store_true", help="Query active MCP servers registered with Zoth Bot")
    parser.add_argument("--harnesses", action="store_true", help="List available neural router harnesses")
    parser.add_argument("--serve", type=int, metavar="PORT", help="Start local standalone server on specified port")

    args = parser.parse_args()

    if args.serve:
        server_script = os.path.join(REPO_DIR, "server.py")
        cmd = [sys.executable, server_script, "--port", str(args.serve)]
        sys.exit(subprocess.run(cmd).returncode)

    daemon_health = check_daemon()

    if args.rings:
        if daemon_health:
            try:
                with urllib.request.urlopen(f"{LOCAL_PORT_URL}/api/rings", timeout=2) as r:
                    data = json.loads(r.read().decode())
                    if args.json:
                        print(json.dumps(data, indent=2))
                    else:
                        print("✦ Zoth Bot Security Ring Authority (Rings 0–3):")
                        for ring in data.get("rings", []):
                            active_str = "● ACTIVE" if ring.get("active") else "○"
                            print(f"  {active_str} Ring {ring['ring']}: {ring['name']} — {ring['authority']}")
                    return
            except Exception:
                pass
        print("Ring 0: SOVEREIGN (Root), Ring 1: SYSADMIN, Ring 2: TOOLMASTER (MCP Hub), Ring 3: SPECTRE")
        return

    if args.mcp:
        if daemon_health:
            try:
                with urllib.request.urlopen(f"{LOCAL_PORT_URL}/api/mcp", timeout=2) as r:
                    data = json.loads(r.read().decode())
                    if args.json:
                        print(json.dumps(data, indent=2))
                    else:
                        servers = data.get("mcp_servers", [])
                        print(f"✦ Zoth Bot MCP Server Hub ({len(servers)} servers):")
                        for s in servers:
                            print(f"  • {s.get('name', 'unknown')} [{s.get('status', 'ACTIVE')}] (Ring {s.get('ring', 2)})")
                    return
            except Exception:
                pass
        print("MCP servers: filesystem, memory, zoth-relay, ghidra-bridge, shodan-sentinel")
        return

    if args.harnesses:
        print("✦ Zoth Bot Multi-Harness Neural Engines:")
        print("  • Nous Hermes Agent (stepfun/step-3.7-flash, gemini-4-argon, claude-sonnet-4.5)")
        print("  • xAI Grok CLI (grok-4.7, grok-4.7-build-fast, grok-4.6)")
        print("  • Local Ollama Loop (zoth-model:latest, qwen2.5-coder:1.5b)")
        print("  • Hermes Copilot Provider")
        return

    telemetry = {
        "id": TOOL_ID,
        "name": TOOL_NAME,
        "version": TOOL_VERSION,
        "category": TOOL_CATEGORY,
        "installed": os.path.exists(REPO_DIR),
        "repo_path": REPO_DIR,
        "studio_url": STUDIO_URL,
        "local_url": LOCAL_PORT_URL,
        "local_port": TOOL_PORT,
        "summon_hotkeys": ["Ctrl+Shift+Space", "Super+Shift+Z"],
        "daemon_active": daemon_health is not None,
        "daemon_status": daemon_health or {"status": "inactive"},
        "license": "100% Free & Open Access (Zero Paywalls)",
        "support": {
            "stripe_buy_coffee": "https://buy.stripe.com/3cIfZg27PdKo2D64Ocfw40X",
            "solana_wallet": "GG2eQbVh8ut1BK6j1A2tz7pSySdLpD38BgyEhGcxdXoK"
        }
    }

    if args.json:
        print(json.dumps(telemetry, indent=2))
        return

    if args.ui:
        print(f"Workbench: {STUDIO_URL}")
        print(f"Local App: {LOCAL_PORT_URL}")
        return

    daemon_tag = "ACTIVE (running)" if daemon_health else "INACTIVE"
    print(f"✦ {TOOL_NAME} (v{TOOL_VERSION}) — [{TOOL_CATEGORY}]")
    print(f"  Repository : {REPO_DIR}")
    print(f"  Daemon     : {daemon_tag} at {LOCAL_PORT_URL}")
    print(f"  Workbench  : {STUDIO_URL}")
    print(f"  Hotkeys    : Ctrl+Shift+Space · Super+Shift+Z")
    print(f"  Access     : 100% Free & Open Access (☕ https://buy.stripe.com/3cIfZg27PdKo2D64Ocfw40X | ◎ GG2eQbVh8ut1BK6j1A2tz7pSySdLpD38BgyEhGcxdXoK)")

if __name__ == "__main__":
    main()
