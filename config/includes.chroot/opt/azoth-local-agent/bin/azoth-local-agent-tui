#!/usr/bin/env python3
"""AZOTH Local Archon Agent v3.1.0 — Live Telemetry TUI (:8136).
Queries http://127.0.0.1:8136/health, /api/engines, and /api/modes for genuine runtime telemetry.
Engineered by Neal Frazier Tech (@1nc0gn30) • NullAI Platform
"""
from __future__ import annotations

import argparse
import json
import os
import sys
import time
import urllib.error
import urllib.request
from typing import Any


def _fetch_json(base_url: str, path: str, timeout: float = 2.0) -> tuple[bool, Any, float]:
    t0 = time.perf_counter()
    url = base_url.rstrip("/") + path
    req = urllib.request.Request(url, headers={"Accept": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            raw = resp.read().decode("utf-8", errors="replace")
            elapsed = round((time.perf_counter() - t0) * 1000.0, 2)
            return True, json.loads(raw), elapsed
    except Exception as exc:
        elapsed = round((time.perf_counter() - t0) * 1000.0, 2)
        return False, {"error": str(exc)}, elapsed


def collect_telemetry(base_url: str) -> dict[str, Any]:
    ok_h, health, h_ms = _fetch_json(base_url, "/health")
    ok_e, engines_resp, e_ms = _fetch_json(base_url, "/api/engines")
    ok_m, modes_resp, m_ms = _fetch_json(base_url, "/api/modes")

    engines = engines_resp.get("engines", []) if ok_e and isinstance(engines_resp, dict) else []
    available_engines = [e["id"] for e in engines if isinstance(e, dict) and e.get("available")]
    modes = [m.get("id") for m in (modes_resp.get("modes", []) if ok_m and isinstance(modes_resp, dict) else []) if isinstance(m, dict)]

    return {
        "tool": "azoth-local-agent",
        "title": "AZOTH Local Archon Agent",
        "version": (health.get("version") if ok_h and isinstance(health, dict) else None) or "3.1.0",
        "base_url": base_url,
        "architect": "Neal Frazier Tech (@1nc0gn30) • NullAI Platform",
        "daemon_reachable": ok_h and isinstance(health, dict) and health.get("status") == "healthy",
        "health": health if ok_h else {"status": "offline", "error": health.get("error", "unreachable")},
        "active_engine": (engines_resp.get("active", {}).get("engine") if ok_e and isinstance(engines_resp, dict) else None),
        "available_engines": available_engines,
        "total_engines": len(engines),
        "active_mode": (modes_resp.get("active") if ok_m and isinstance(modes_resp, dict) else None),
        "modes": modes,
        "probe_latency_ms": {
            "health": h_ms,
            "engines": e_ms,
            "modes": m_ms,
        },
    }


def main() -> int:
    ap = argparse.ArgumentParser(description="AZOTH Local Archon Agent Live Telemetry TUI")
    ap.add_argument("--base-url", default=os.environ.get("AZOTH_BASE_URL", "http://127.0.0.1:8136"), help="Loopback daemon URL")
    ap.add_argument("--json", action="store_true", help="Output live telemetry JSON and exit")
    args = ap.parse_args()

    data = collect_telemetry(args.base_url)

    if args.json:
        print(json.dumps(data, indent=2))
        return 0

    status_str = "\033[1;32mONLINE\033[0m" if data["daemon_reachable"] else "\033[1;31mOFFLINE\033[0m"
    print("\033[1;33m╭──────────────────────────────────────────────────────────────────────────╮\033[0m")
    print(f"\033[1;33m│\033[0m ⚡ \033[1;37mAZOTH Local Archon Agent v{data['version']:<6}\033[0m │ \033[36mNeal Frazier Tech • NullAI\033[0m       \033[1;33m│\033[0m")
    print("\033[1;33m├──────────────────────────────────────────────────────────────────────────┤\033[0m")
    print(f"\033[1;33m│\033[0m Endpoint : {data['base_url']:<34} Status : {status_str}          \033[1;33m│\033[0m")
    print(f"\033[1;33m│\033[0m Engine   : {str(data['active_engine'] or 'offline'):<24} Mode   : {str(data['active_mode'] or 'offline'):<16} \033[1;33m│\033[0m")
    print(f"\033[1;33m│\033[0m Engines  : {len(data['available_engines'])}/{data['total_engines']} available ({', '.join(data['available_engines'][:5]) or 'none'})".ljust(83) + "\033[1;33m│\033[0m")
    lat = data["probe_latency_ms"]
    print(f"\033[1;33m│\033[0m Latency  : /health {lat['health']}ms · /api/engines {lat['engines']}ms · /api/modes {lat['modes']}ms".ljust(83) + "\033[1;33m│\033[0m")
    print("\033[1;33m╰──────────────────────────────────────────────────────────────────────────╯\033[0m")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
