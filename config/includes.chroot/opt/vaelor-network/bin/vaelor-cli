#!/usr/bin/env node
/**
 * VAELOR (◈ VLR) — Sovereign Layer-1 Terminal CLI
 * =========================================================================
 * Feeless Account-Lattice DAG • Proof-of-Useful-Work • 5-Validator BFT Quorum
 *
 * Usage:
 *   vaelor-cli status
 *   vaelor-cli balance [@handle]
 *   vaelor-cli send <from> <to> <amount> [memo]
 *   vaelor-cli mine [@handle] [taskType]
 *   vaelor-cli check <@handle>
 *
 * Options:
 *   --rpc <url>   RPC endpoint (default: http://127.0.0.1:8140)
 *   --json        Output raw machine-readable JSON
 *   --offline     Force local direct lattice storage mode
 *
 * Engineered by Neal Frazier Tech (@1nc0gn30) • NullAI Platform
 */

'use strict';

const path = require('path');
const fs = require('fs');

// ANSI Color Tokens
const C = {
  reset: '\x1b[0m',
  bold: '\x1b[1m',
  dim: '\x1b[2m',
  gold: '\x1b[38;2;245;197;66m',
  emerald: '\x1b[38;2;16;185;129m',
  cyan: '\x1b[38;2;6;182;212m',
  purple: '\x1b[38;2;168;85;247m',
  red: '\x1b[38;2;239;68;68m',
  gray: '\x1b[38;2;148;163;184m',
  darkGray: '\x1b[38;2;71;85;105m',
  white: '\x1b[38;2;248;250;252m',
  bgGold: '\x1b[48;2;245;197;66m\x1b[38;2;5;6;11m\x1b[1m'
};

const args = process.argv.slice(2);
let isJson = false;
let isOffline = false;
let rpcUrl = process.env.VAELOR_RPC_URL || 'http://127.0.0.1:8140';

const cleanArgs = [];
for (let i = 0; i < args.length; i++) {
  if (args[i] === '--json') {
    isJson = true;
  } else if (args[i] === '--offline') {
    isOffline = true;
  } else if (args[i] === '--rpc' && args[i + 1]) {
    rpcUrl = args[++i].replace(/\/+$/, '');
  } else {
    cleanArgs.push(args[i]);
  }
}

const command = cleanArgs[0] || 'help';

function printHeader() {
  if (isJson) return;
  console.log(`${C.gold}${C.bold}◈ VAELOR (VLR)${C.reset} ${C.dim}— Sovereign Account-Lattice Layer-1 Terminal CLI${C.reset}`);
  console.log(`${C.darkGray}${'─'.repeat(68)}${C.reset}`);
}

function normalizeHandle(h) {
  if (!h) return '';
  let str = String(h).trim().toLowerCase();
  if (str.startsWith('vlr1_')) return str;
  str = str.replace(/^@+/, '');
  return `@${str}`;
}

// Client Abstraction: Tries RPC first, falls back to direct VaelorLatticeNode
class LatticeClient {
  constructor(url, forceOffline) {
    this.rpc = url;
    this.forceOffline = forceOffline;
    this.localNode = null;
  }

  getLocalNode() {
    if (!this.localNode) {
      const { VaelorLatticeNode } = require('../src/core/lattice');
      const stateFile = process.env.VAELOR_STATE_FILE || path.join(__dirname, '..', 'data', 'vaelor_lattice_state.json');
      this.localNode = new VaelorLatticeNode(stateFile);
    }
    return this.localNode;
  }

  async getSnapshot() {
    if (!this.forceOffline) {
      try {
        const res = await fetch(`${this.rpc}/api/snapshot`, { signal: AbortSignal.timeout(2000) });
        if (res.ok) {
          const data = await res.json();
          return { data, source: 'rpc' };
        }
      } catch (e) {
        // Fall back to local
      }
    }
    const node = this.getLocalNode();
    return { data: node.getNetworkSnapshot(), source: 'local' };
  }

  async getAccount(handle) {
    const clean = normalizeHandle(handle);
    if (!this.forceOffline) {
      try {
        const res = await fetch(`${this.rpc}/api/account/${encodeURIComponent(clean)}`, { signal: AbortSignal.timeout(2000) });
        if (res.ok) {
          const data = await res.json();
          return { data, source: 'rpc' };
        }
      } catch (e) {
        // Fall back to local
      }
    }
    const node = this.getLocalNode();
    const acc = node.resolveAccount(clean);
    if (!acc) throw new Error(`Account '${clean}' not found on lattice`);
    const creditProfile = node.getCreditProfile(clean);
    return {
      data: {
        ok: true,
        account: acc,
        creditProfile,
        snapshot: node.getNetworkSnapshot()
      },
      source: 'local'
    };
  }

  async sendTransfer(from, to, amount, memo) {
    const cleanFrom = normalizeHandle(from);
    const cleanTo = normalizeHandle(to);
    const amt = Number(amount);

    if (!this.forceOffline) {
      try {
        const res = await fetch(`${this.rpc}/api/transfer`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ from: cleanFrom, to: cleanTo, amountVlr: amt, memo }),
          signal: AbortSignal.timeout(3000)
        });
        if (res.ok) {
          const data = await res.json();
          return { data, source: 'rpc' };
        }
      } catch (e) {
        // Fall back to local
      }
    }

    const node = this.getLocalNode();
    const tx = node.transfer({ from: cleanFrom, to: cleanTo, amountVlr: amt, memo });
    return {
      data: {
        ok: true,
        sendBlock: tx.sendBlock,
        receiveBlock: tx.receiveBlock,
        snapshot: node.getNetworkSnapshot()
      },
      source: 'local'
    };
  }

  async minePouw(worker, workType, taskLabel) {
    const cleanWorker = normalizeHandle(worker || '@neal');
    const type = workType || 'SECURITY_ENTROPY_SCAN';
    const label = taskLabel || 'Automated PoUW Node Verification & Entropy Audit';
    const payload = JSON.stringify({
      worker: cleanWorker,
      workType: type,
      timestamp: new Date().toISOString(),
      entropyBits: 256,
      auditVerified: true
    });

    if (!this.forceOffline) {
      try {
        const res = await fetch(`${this.rpc}/api/pouw/mint`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ worker: cleanWorker, workType: type, taskLabel: label, artifactPayload: payload }),
          signal: AbortSignal.timeout(3000)
        });
        if (res.ok) {
          const data = await res.json();
          return { data, source: 'rpc' };
        }
      } catch (e) {
        // Fall back to local
      }
    }

    const node = this.getLocalNode();
    const result = node.submitUsefulWork({ worker: cleanWorker, workType: type, taskLabel: label, artifactPayload: payload });
    return {
      data: {
        ok: true,
        receipt: result.receipt,
        mintBlock: result.mintBlock,
        snapshot: node.getNetworkSnapshot()
      },
      source: 'local'
    };
  }

  async checkHandle(handle) {
    const clean = normalizeHandle(handle);
    if (!this.forceOffline) {
      try {
        const res = await fetch(`${this.rpc}/api/directory/check/${encodeURIComponent(clean)}`, { signal: AbortSignal.timeout(2000) });
        if (res.ok) {
          const data = await res.json();
          return { data, source: 'rpc' };
        }
      } catch (e) {
        // Fall back to local
      }
    }

    const node = this.getLocalNode();
    const safety = node.checkHandleSafety(clean);
    return {
      data: {
        ok: true,
        handle: clean,
        safety,
        snapshot: node.getNetworkSnapshot()
      },
      source: 'local'
    };
  }

  async sendTip(from, creator, amount, message, projectSlug) {
    const cleanFrom = normalizeHandle(from);
    const cleanCreator = normalizeHandle(creator);
    const amt = Number(amount);
    const msg = message || 'Feeless open-source micro-patronage';
    const slug = projectSlug || 'zoth-os';

    if (!this.forceOffline) {
      try {
        const res = await fetch(`${this.rpc}/api/tips/send`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ from: cleanFrom, creator: cleanCreator, amount: amt, message: msg, projectSlug: slug }),
          signal: AbortSignal.timeout(3000)
        });
        if (res.ok) {
          const data = await res.json();
          return { data, source: 'rpc' };
        }
      } catch (e) {
        // Fall back to local
      }
    }

    const node = this.getLocalNode();
    const res = node.sendCreatorTip({
      from: cleanFrom,
      creator: cleanCreator,
      amount: amt,
      message: msg,
      projectSlug: slug
    });
    return {
      data: {
        ok: true,
        tip: res.tip,
        badge: res.badge,
        badgeEmoji: res.badgeEmoji,
        loyaltyTier: res.loyaltyTier,
        cashbackPct: res.cashbackPct,
        cashbackVlr: res.cashbackVlr,
        sendBlock: res.sendBlock,
        cashbackBlock: res.cashbackBlock,
        snapshot: node.getNetworkSnapshot()
      },
      source: 'local'
    };
  }

  async executeMerchantFx(buyer, merchant, amount, memo) {
    const cleanBuyer = normalizeHandle(buyer);
    const cleanMerchant = normalizeHandle(merchant);
    const amt = Number(amount);
    const m = memo || 'Multi-Currency Merchant FX Auto-Sweep';

    if (!this.forceOffline) {
      try {
        const res = await fetch(`${this.rpc}/api/merchant-fx/checkout`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ buyer: cleanBuyer, merchant: cleanMerchant, amount: amt, memo: m }),
          signal: AbortSignal.timeout(3000)
        });
        if (res.ok) {
          const data = await res.json();
          return { data, source: 'rpc' };
        }
      } catch (e) {
        // Fall back to local
      }
    }

    const node = this.getLocalNode();
    const res = node.executeMerchantFxCheckout(cleanBuyer, cleanMerchant, amt, m);
    return {
      data: {
        ok: true,
        ...res,
        snapshot: node.getNetworkSnapshot()
      },
      source: 'local'
    };
  }

  async createEscrow(buyer, merchant, amount, itemTitle, autoReleaseHours) {
    const cleanBuyer = normalizeHandle(buyer);
    const cleanMerchant = normalizeHandle(merchant);
    const amt = Number(amount);
    const title = itemTitle || 'Protected Commerce Order';
    const hrs = Number(autoReleaseHours) || 72;

    if (!this.forceOffline) {
      try {
        const res = await fetch(`${this.rpc}/api/escrows/create`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ buyer: cleanBuyer, merchant: cleanMerchant, amountVlr: amt, itemTitle: title, autoReleaseHours: hrs }),
          signal: AbortSignal.timeout(3000)
        });
        if (res.ok) {
          const data = await res.json();
          return { data: data.result || data, source: 'rpc' };
        }
      } catch (e) {
        // Fall back to local
      }
    }

    const node = this.getLocalNode();
    const res = node.createProtectedEscrow(cleanBuyer, cleanMerchant, amt, title, hrs);
    return {
      data: {
        ok: true,
        ...res,
        snapshot: node.getNetworkSnapshot()
      },
      source: 'local'
    };
  }

  async resolveEscrow(escrowId, resolutionType, refundPct) {
    const id = String(escrowId || '').trim();
    const resType = String(resolutionType || 'RELEASE').toUpperCase();
    const pct = Number(refundPct !== undefined ? refundPct : 0);

    if (!this.forceOffline) {
      try {
        const res = await fetch(`${this.rpc}/api/escrows/resolve`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ escrowId: id, resolutionType: resType, refundPct: pct }),
          signal: AbortSignal.timeout(3000)
        });
        if (res.ok) {
          const data = await res.json();
          return { data: data.result || data, source: 'rpc' };
        }
      } catch (e) {
        // Fall back to local
      }
    }

    const node = this.getLocalNode();
    const res = node.resolveProtectedEscrow(id, resType, pct);
    return {
      data: {
        ok: true,
        ...res,
        snapshot: node.getNetworkSnapshot()
      },
      source: 'local'
    };
  }

  async listEscrows(handle) {
    const h = handle ? normalizeHandle(handle) : null;
    if (!this.forceOffline) {
      try {
        const url = `${this.rpc}/api/escrows${h ? `?handle=${encodeURIComponent(h)}` : ''}`;
        const res = await fetch(url, { signal: AbortSignal.timeout(3000) });
        if (res.ok) {
          const data = await res.json();
          return { data, source: 'rpc' };
        }
      } catch (e) {
        // Fall back to local
      }
    }

    const node = this.getLocalNode();
    const escrows = node.getProtectedEscrows(h);
    return {
      data: {
        ok: true,
        escrows,
        count: escrows.length,
        snapshot: node.getNetworkSnapshot()
      },
      source: 'local'
    };
  }

  async getTaxReport(handle, taxYear = 2026, format = 'json') {
    const cleanHandle = normalizeHandle(handle || '@citizen');
    const year = Number(taxYear) || 2026;

    if (!this.forceOffline) {
      try {
        const url = `${this.rpc}/api/tax-report/${encodeURIComponent(cleanHandle)}?year=${year}&format=${format}`;
        const res = await fetch(url, { signal: AbortSignal.timeout(3000) });
        if (res.ok) {
          if (format === 'csv') {
            const csvText = await res.text();
            return { data: csvText, source: 'rpc' };
          }
          const data = await res.json();
          return { data, source: 'rpc' };
        }
      } catch (e) {
        // Fall back to local
      }
    }

    const node = this.getLocalNode();
    const report = node.getTaxReport(cleanHandle, year);
    if (format === 'csv') {
      return { data: report.csvReport, source: 'local' };
    }
    return {
      data: {
        ok: true,
        ...report,
        snapshot: node.getNetworkSnapshot()
      },
      source: 'local'
    };
  }

  async getCommPeers() {
    if (!this.forceOffline) {
      try {
        const res = await fetch(`${this.rpc}/api/comm/peers`, { signal: AbortSignal.timeout(3000) });
        if (res.ok) {
          const data = await res.json();
          return { data, source: 'rpc' };
        }
      } catch (e) {}
    }
    const node = this.getLocalNode();
    const peers = node.getCommPeers();
    return { data: { ok: true, peers, count: peers.length }, source: 'local' };
  }

  async requestCommHandshake(from, to, passphrase, introNote = '') {
    const cleanFrom = normalizeHandle(from);
    const cleanTo = normalizeHandle(to);
    if (!this.forceOffline) {
      try {
        const res = await fetch(`${this.rpc}/api/comm/handshake`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ from: cleanFrom, to: cleanTo, passphrase, introNote }),
          signal: AbortSignal.timeout(3000)
        });
        if (res.ok) {
          const data = await res.json();
          return { data, source: 'rpc' };
        }
      } catch (e) {}
    }
    const node = this.getLocalNode();
    const res = node.requestCommHandshake(cleanFrom, cleanTo, passphrase, introNote);
    return { data: { ok: true, ...res }, source: 'local' };
  }

  async sendCommMessage(from, to, passphrase, message, attachedVlr = 0, aiTaskPrompt = '') {
    const cleanFrom = normalizeHandle(from);
    const cleanTo = normalizeHandle(to);
    const amt = Number(attachedVlr || 0);
    if (!this.forceOffline) {
      try {
        const res = await fetch(`${this.rpc}/api/comm/send`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ from: cleanFrom, to: cleanTo, passphrase, message, attachedVlr: amt, aiTaskPrompt }),
          signal: AbortSignal.timeout(3000)
        });
        if (res.ok) {
          const data = await res.json();
          return { data, source: 'rpc' };
        }
      } catch (e) {}
    }
    const node = this.getLocalNode();
    const res = node.sendCommMessage({
      from: cleanFrom,
      to: cleanTo,
      passphrase,
      message,
      attachedVlr: amt,
      aiTaskPrompt
    });
    return { data: { ok: true, ...res }, source: 'local' };
  }

  async readCommInbox(handle, passphrase) {
    const cleanHandle = normalizeHandle(handle);
    if (!this.forceOffline) {
      try {
        const res = await fetch(`${this.rpc}/api/comm/inbox`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ handle: cleanHandle, passphrase }),
          signal: AbortSignal.timeout(3000)
        });
        if (res.ok) {
          const data = await res.json();
          return { data, source: 'rpc' };
        }
      } catch (e) {}
    }
    const node = this.getLocalNode();
    const res = node.readCommInbox(cleanHandle, passphrase);
    return { data: res, source: 'local' };
  }
}

async function main() {
  const client = new LatticeClient(rpcUrl, isOffline);

  try {
    switch (command.toLowerCase()) {
      case 'status': {
        const { data: rawData, source } = await client.getSnapshot();
        const data = rawData.snapshot || rawData;
        if (isJson) {
          console.log(JSON.stringify(data, null, 2));
          return;
        }

        printHeader();
        const modeBadge = source === 'rpc' ? `${C.emerald}ONLINE (RPC :8140)${C.reset}` : `${C.purple}LOCAL (Direct Lattice)${C.reset}`;
        console.log(`Node Mode:        ${modeBadge}`);
        console.log(`Protocol & Chain: ${C.white}${data.protocol}${C.reset} ${C.dim}(${data.chainId})${C.reset}`);
        console.log(`Circulating VLR:  ${C.gold}${C.bold}${Number(data.totalSupplyVlr || 0).toLocaleString('en-US', { minimumFractionDigits: 4 })} ◈${C.reset}`);
        console.log(`Total DAG Blocks: ${C.cyan}${data.totalBlocks}${C.reset} blocks`);
        console.log(`Feeless Transfers:${C.emerald}${data.totalFeelessTxCount || 0}${C.reset} ($0.00 gas forever)`);
        console.log(`Total Gas Saved:  ${C.emerald}${C.bold}$${Number(data.totalGasSavedUsd || 0).toFixed(2)} Gas (${data.totalFeelessTxCount || 0} feeless txs)${C.reset}`);
        console.log(`Cashback Emitted: ${C.gold}${data.totalCashbackDistributedVlr || 0} ◈ VLR${C.reset}`);

        const cs = data.consensusSummary || {};
        console.log(`\n${C.bold}🏛️ 5-Validator BFT Quorum Consensus:${C.reset}`);
        console.log(`  Quorum Size:    ${cs.quorumSize || 5} nodes (Threshold: ${cs.bftThreshold || 4} of 5 required)`);
        console.log(`  BFT Finality:   ${C.emerald}${C.bold}${cs.status || '100% BFT FINALITY'}${C.reset} (<20ms latency)`);
        console.log(`  Anchor Nodes:   Norfolk • Virginia Beach • Richmond • Chesapeake • Outer Banks`);

        const sv = data.savingsVaultSummary || {};
        console.log(`\n${C.bold}💰 8.5% APY Zero-Lockup Savings Vault:${C.reset}`);
        console.log(`  Total Staked:   ${C.gold}${Number(sv.totalStakedVlr || data.totalStakedVlr || 0).toLocaleString()} ◈ VLR${C.reset}`);
        console.log(`  Compound APY:   ${C.emerald}${C.bold}${sv.apyPct || 8.5}% APY${C.reset} (0-day unbonding)`);
        console.log(`  Backing Demand: Proof-of-Useful-Work AI Inference & AST Audits`);

        console.log(`\n${C.bold}💳 Merchant & Credit Rails:${C.reset}`);
        console.log(`  Credit Limit:   ${C.cyan}${Number(data.totalCreditLimitVlr || 0).toLocaleString()} ◈ VLR${C.reset} (0% APR, 30d grace)`);
        console.log(`  Active Escrows: ${data.activeEscrowCount || 0} protected transactions`);
        console.log(`  Smart Receipts: ${data.totalReceiptsCount || 0} minted (365d warranties attached)`);
        break;
      }

      case 'balance': {
        const targetHandle = cleanArgs[1] || '@neal';
        const { data, source } = await client.getAccount(targetHandle);

        if (isJson) {
          console.log(JSON.stringify(data, null, 2));
          return;
        }

        printHeader();
        const acc = data.account;
        const cp = data.creditProfile || {};
        const liquidVlr = acc.balanceVlr !== undefined ? acc.balanceVlr : (acc.balanceVael / 1_000_000);
        const liquidVael = acc.balanceVael !== undefined ? acc.balanceVael : Math.round(liquidVlr * 1_000_000);
        const stakedVlr = acc.stakedBalanceVlr !== undefined ? acc.stakedBalanceVlr : ((acc.stakedBalanceVael || 0) / 1_000_000);
        const lockedEscrowVlr = acc.lockedEscrowVlr !== undefined ? acc.lockedEscrowVlr : ((acc.lockedEscrowVael || 0) / 1_000_000);

        console.log(`Account Handle:   ${C.gold}${C.bold}${acc.handle}${C.reset} ${C.dim}(${acc.displayName || 'Vaelor Citizen'})${C.reset}`);
        console.log(`L1 Address:       ${C.dim}${acc.address}${C.reset}`);
        console.log(`Mode:             ${source === 'rpc' ? C.emerald + 'Live RPC' : C.purple + 'Direct Lattice'}${C.reset}`);
        console.log(`${C.darkGray}${'─'.repeat(68)}${C.reset}`);
        console.log(`Liquid Balance:   ${C.gold}${C.bold}${Number(liquidVlr).toLocaleString('en-US', { minimumFractionDigits: 4 })} ◈ VLR${C.reset} ${C.dim}(${liquidVael.toLocaleString()} vael)${C.reset}`);
        console.log(`Staked Savings:   ${C.emerald}${C.bold}${Number(stakedVlr).toLocaleString('en-US', { minimumFractionDigits: 4 })} ◈ VLR${C.reset} ${C.dim}(8.5% APY PoUW Vault)${C.reset}`);
        console.log(`Locked in Escrow: ${C.cyan}${Number(lockedEscrowVlr).toFixed(4)} ◈ VLR${C.reset}`);

        if (cp.creditScore) {
          console.log(`\n${C.bold}💳 Revolving Credit Facility (0% APR):${C.reset}`);
          console.log(`  Credit Score:   ${C.emerald}${C.bold}${cp.creditScore} / 850${C.reset}`);
          console.log(`  Credit Limit:   ${C.gold}${cp.creditLimitVlr.toFixed(2)} ◈ VLR${C.reset}`);
          console.log(`  Available:      ${C.emerald}${cp.availableCreditVlr.toFixed(2)} ◈ VLR${C.reset}`);
          console.log(`  Drawn Balance:  ${C.purple}${cp.drawnCreditVlr.toFixed(2)} ◈ VLR${C.reset} (30-day grace period)`);
        }

        const blocks = (acc.blocks || acc.recentChain || []).slice(-4).reverse();
        if (blocks.length > 0) {
          console.log(`\n${C.bold}📜 Recent Micro-Blocks on Account Lattice:${C.reset}`);
          blocks.forEach((b) => {
            console.log(`  ${C.cyan}#${b.height}${C.reset} ${C.bold}${b.type.padEnd(16)}${C.reset} ${C.dim}${b.hash.slice(0, 16)}...${C.reset} ${C.emerald}✓ Verified${C.reset}`);
          });
        }
        break;
      }

      case 'send': {
        const from = cleanArgs[1];
        const to = cleanArgs[2];
        const amount = cleanArgs[3];
        const memo = cleanArgs.slice(4).join(' ') || 'Instant feeless transfer';

        if (!from || !to || !amount) {
          console.error(`${C.red}Error:${C.reset} Missing arguments. Usage: vaelor-cli send <from> <to> <amount> [memo]`);
          process.exit(1);
        }

        const { data } = await client.sendTransfer(from, to, amount, memo);
        if (isJson) {
          console.log(JSON.stringify(data, null, 2));
          return;
        }

        printHeader();
        console.log(`${C.emerald}${C.bold}⚡ Feeless Transfer Settled Instantly!${C.reset}`);
        console.log(`  From:           ${C.gold}${data.sendBlock.handle || data.sendBlock.accountHandle || from}${C.reset}`);
        console.log(`  To:             ${C.gold}${data.receiveBlock.handle || data.sendBlock.data.toHandle || to}${C.reset}`);
        console.log(`  Amount:         ${C.gold}${C.bold}${data.sendBlock.data.amountVlr} ◈ VLR${C.reset}`);
