        console.log(`  • Total Outflows:       ${C.white}-${summ.totalDisbursementsVlr || 0} ◈ VLR${C.reset}`);
        console.log(`  • Net Position Delta:   ${summ.netPositionChangeVlr >= 0 ? C.emerald : C.red}${summ.netPositionChangeVlr || 0} ◈ VLR${C.reset}`);
        console.log(`  • Micro-Blocks Audited: ${C.cyan}${summ.recordCount || 0} blocks${C.reset}`);
        console.log(`\n${C.dim}Tip: Run "vaelor-cli tax ${handle} ${year} --csv" to export CPA / TurboTax CSV.${C.reset}`);
