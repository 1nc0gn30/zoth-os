          const { data } = await client.resolveEscrow(escrowId, 'RELEASE', 0);
          if (isJson) {
            console.log(JSON.stringify(data, null, 2));
            return;
          }

          printHeader();
          console.log(`${C.emerald}${C.bold}✅ Protected Escrow Released to Merchant!${C.reset}`);
          console.log(`  Escrow ID:      ${C.gold}${data.escrowId || escrowId}${C.reset}`);
          console.log(`  Merchant Payout:${C.emerald}${C.bold} ${data.merchantAmountVlr || data.amountVlr} ◈ VLR (100% - $0.00 Fee)${C.reset}`);
          console.log(`  Buyer:          ${C.white}${data.buyer}${C.reset}`);
          console.log(`  Buyer Cashback: ${C.cyan}${C.bold}+${data.cashbackVlr} ◈ VLR Dynamic Rebate${C.reset}`);
          console.log(`  Status:         ${C.emerald}RELEASED ✓${C.reset}`);
