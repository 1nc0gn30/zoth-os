          if (!list || list.length === 0) {
            console.log(`  ${C.dim}No escrows found on lattice.${C.reset}`);
          } else {
            list.slice(0, 15).forEach((e) => {
              const statusColor = e.status === 'LOCKED' ? C.cyan : e.status === 'RELEASED' ? C.emerald : C.gold;
