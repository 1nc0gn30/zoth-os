            process.exit(1);
          }

          const { data } = await client.sendCommMessage(from, to, passphrase, message, attachedVlr, aiPrompt);
          if (isJson) {
            console.log(JSON.stringify(data, null, 2));
            return;
          }
          printHeader();
          console.log(`${C.emerald}${C.bold}🔒 AES-256-GCM Encrypted Comm Message Dispatched!${C.reset}`);
          console.log(`  Message ID:   ${C.gold}${data.messageId || 'msg_sent'}${C.reset}`);
          console.log(`  From:         ${C.cyan}${data.from || from}${C.reset} → Recipient: ${C.cyan}${data.to || to}${C.reset}`);
