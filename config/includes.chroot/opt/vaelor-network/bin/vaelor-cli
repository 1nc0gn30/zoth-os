        } else {
          console.error(`${C.red}Error:${C.reset} Unknown comm subcommand '${subAction}'. Use: peers, handshake, send, inbox`);
          process.exit(1);
        }
      }

      case 'help':
      default: {
        printHeader();
        console.log(`${C.bold}Usage:${C.reset} vaelor-cli <command> [options]\n`);
        console.log(`${C.bold}Commands:${C.reset}`);
        console.log(`  ${C.gold}status${C.reset}                     Network status, circulating supply, BFT quorum & TVL`);
        console.log(`  ${C.gold}balance${C.reset} [@handle]          Inspect liquid balance, staked savings & credit profile`);
        console.log(`  ${C.gold}send${C.reset} <from> <to> <amount>  Execute sub-20ms feeless transfer ($0.00 Gas)`);
        console.log(`  ${C.gold}tip${C.reset} <from> <creator> <amt> Feeless micro-patronage tip with dynamic cashback`);
        console.log(`  ${C.gold}fx${C.reset} <buyer> <merchant> <amt>  Multi-currency merchant FX auto-split checkout`);
        console.log(`  ${C.gold}escrow${C.reset} <create|release|refund|split|list> Zero-penalty protected commerce escrow`);
        console.log(`  ${C.gold}tax${C.reset} [@handle] [year] [--csv] Sovereign 1-click CPA tax & cashback audit report`);
        console.log(`  ${C.gold}comm${C.reset} <peers|handshake|send|inbox>  ZothOS passphrase-gated P2P encrypted messenger`);
        console.log(`  ${C.gold}mine${C.reset} [@handle] [type]      Mine PoUW computational audit reward block`);
        console.log(`  ${C.gold}check${C.reset} <@handle>            Phishing & homoglyph lookalike risk detector`);
        console.log(`\n${C.bold}Options:${C.reset}`);
        console.log(`  ${C.cyan}--rpc <url>${C.reset}                Custom RPC endpoint (default: http://127.0.0.1:8140)`);
        console.log(`  ${C.cyan}--offline${C.reset}                  Bypass HTTP daemon and use direct local lattice`);
        console.log(`  ${C.cyan}--json${C.reset}                     Output raw machine-readable JSON format`);
        console.log(`\n${C.dim}Engineered by Neal Frazier Tech (@1nc0gn30) • NullAI Platform${C.reset}`);
        break;
      }
    }
  } catch (err) {
    if (isJson) {
      console.log(JSON.stringify({ ok: false, error: err.message }));
    } else {
      console.error(`${C.red}${C.bold}Error:${C.reset} ${err.message}`);
    }
    process.exit(1);
  }
}

main();
