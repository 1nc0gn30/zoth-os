          console.log(`Trust Score:      ${C.red}10 / 100 (Unverified Impersonation Candidate)${C.reset}`);
        } else {
          console.log(`Safety Status:    ${C.cyan}UNVERIFIED COMMUNITY HANDLE${C.reset}`);
