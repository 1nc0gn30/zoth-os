          console.log(`  From Node:    ${C.cyan}${data.from || from}${C.reset}`);
          console.log(`  To Node:      ${C.cyan}${data.to || to}${C.reset}`);
          console.log(`  5/5 BFT Block:${C.dim}${data.blockHash || data.handshakeBlock?.hash}${C.reset}`);
          console.log(`  Channel State:${C.emerald}AUTHORIZED ✓${C.reset}`);
          break;

        } else if (subAction === 'send') {
          const from = cleanArgs[2];
          const to = cleanArgs[3];
          const passphrase = cleanArgs[4];
          const message = cleanArgs[5];
