          console.log(`  Buyer Refund:   ${C.emerald}${C.bold}100% (${data.buyerRefundVlr || data.amountVlr} ◈ VLR returned to ${data.buyer})${C.reset}`);
          console.log(`  Merchant Fee:   ${C.emerald}$0.00 Chargeback Penalty ($15-$25 saved vs Visa)${C.reset}`);
          console.log(`  Status:         ${C.gold}REFUNDED ✓${C.reset}`);
