          console.log(`  Ciphertext:   ${C.dim}${(data.ciphertextHex || '').slice(0, 48)}...${C.reset}`);
          console.log(`  Auth Tag:     ${C.dim}${data.authTagHex || 'N/A'}${C.reset}`);
