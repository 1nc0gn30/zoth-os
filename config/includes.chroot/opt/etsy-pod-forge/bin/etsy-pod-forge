#!/usr/bin/env python3
"""Executable CLI launcher for etsy-pod-forge (v2.6.0).

Engineered by Neal Frazier Tech (@1nc0gn30) • NullAI Platform.
Zero hardcoded home-directory paths; resolves ZOTH_REPO_DIR -> relative -> /opt/etsy-pod-forge -> Path.home().
"""

from __future__ import annotations

import json
import os
import sys
from pathlib import Path
from typing import List

TOOL_NAME = "etsy-pod-forge"
VERSION = "2.6.0"
LOCAL_PORT = 8107
SUBCOMMANDS = [
    "generate",
    "mockup",
    "listing",
    "prompts",
    "serve",
    "status",
    "desktop",
    "mcp",
    "test",
]


def _resolve_repo_root() -> Path:
    """Resolve etsy-pod-forge root without embedding literal user home paths."""
    candidates: List[Path] = []
    env_repo = os.environ.get("ZOTH_REPO_DIR", "").strip()
    if env_repo:
        candidates.append(Path(env_repo))
    candidates.append(Path(__file__).resolve().parent.parent)
    candidates.append(Path("/opt/etsy-pod-forge"))
    candidates.append(Path.home() / "NullAITech" / "etsy-pod-forge")

    for cand in candidates:
        if (cand / "src" / "etsy_pod_forge" / "__init__.py").is_file():
            return cand
    return Path("/opt/etsy-pod-forge")


def _emit_manifest() -> int:
    print(
        json.dumps(
            {
                "tool": TOOL_NAME,
                "ok": True,
                "kind": "json-manifest",
                "version": VERSION,
                "local_port": LOCAL_PORT,
                "execution_type": "browser",
                "studio_route": f"/tools/{TOOL_NAME}",
                "entry": f"/usr/local/bin/{TOOL_NAME}",
                "mcp_tools": 6,
                "cadres": 5,
                "prompts": 53,
                "commands": SUBCOMMANDS,
                "usage": f"run `{TOOL_NAME} --help`; subcommands: {', '.join(SUBCOMMANDS)}",
            },
            indent=2,
            sort_keys=True,
        )
    )
    return 0


def _main() -> int:
    if sys.argv[1:] == ["--json"]:
        return _emit_manifest()

    root = _resolve_repo_root()
    src_dir = root / "src"
    if src_dir.is_dir() and str(src_dir) not in sys.path:
        sys.path.insert(0, str(src_dir))

    from etsy_pod_forge.cli import main as cli_main

    return int(cli_main())


if __name__ == "__main__":
    sys.exit(_main())
