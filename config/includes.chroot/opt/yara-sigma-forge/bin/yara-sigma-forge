    "elf-shellcode-stager": {
        "ruleName": "ZOTH_ELF64_Memfd_Reflective_Loader",
        "label": "ELF64 Memfd Reflective Stager",
        "severity": "CRITICAL",
        "mitre": ["T1620 (Reflective Code Loading)", "T1027 (Obfuscated Files)"],
        "patterns": [
            {"id": "$elf_magic", "type": "ascii", "value": r"\x7fELF"},
            {"id": "$memfd", "type": "ascii", "value": "memfd_create"},
            {"id": "$execveat", "type": "ascii", "value": "fexecve"},
            {"id": "$proc_self", "type": "ascii", "value": "/proc/self/fd/"},
        ],
        "minMatches": 2,
    },
    "ransomware-shadow-copy": {
        "ruleName": "ZOTH_Ransomware_Vssadmin_Delete_Shadows",
        "label": "Windows Shadow Copy Deletion",
        "severity": "CRITICAL",
        "mitre": ["T1490 (Inhibit System Recovery)", "T1059.001 (PowerShell)"],
        "patterns": [
            {"id": "$vssadmin", "type": "ascii", "value": "vssadmin delete shadows /all /quiet"},
            {"id": "$wmic_shadow", "type": "ascii", "value": "shadowcopy delete"},
            {"id": "$bcdedit_rec", "type": "ascii", "value": "bcdedit /set {default} recoveryenabled No"},
            {"id": "$wbadmin_del", "type": "ascii", "value": "wbadmin delete catalog -quiet"},
        ],
        "minMatches": 1,
    },
}


def calculate_entropy(data: str) -> float:
    if not data:
        return 0.0
    freq = {}
    for ch in data:
        freq[ch] = freq.get(ch, 0) + 1
    entropy = 0.0
    length = len(data)
    for count in freq.values():
        p = count / length
        entropy -= p * math.log2(p)
    return entropy


def emit_yara(preset_key: str) -> str:
    preset = PRESETS.get(preset_key, PRESETS["php-cgi-rce"])
    strings = []
    for p in preset["patterns"]:
        if p["type"] == "ascii":
            strings.append(f'    {p["id"]} = "{p["value"]}" ascii wide')
        else:
            strings.append(f'    {p["id"]} = /{p["value"]}/ ascii')
    strings_block = "\n".join(strings)
    return f"""rule {preset["ruleName"]} : SovereignThreat
{{
  meta:
    description = "{preset["label"]}"
    author = "1nc0gn30 (@1nc0gn30) • NullAI Platform"
    severity = "{preset["severity"]}"
    mitre_attack = "{', '.join(preset["mitre"])}"

  strings:
{strings_block}

  condition:
    {preset["minMatches"]} of them
}}"""


def emit_sigma(preset_key: str) -> str:
    preset = PRESETS.get(preset_key, PRESETS["php-cgi-rce"])
    patterns = "\n".join([f"        - '{p['value']}'" for p in preset["patterns"]])
    return f"""title: {preset["label"]}
status: production
description: Sovereign Sigma detection rule
author: 1nc0gn30 (@1nc0gn30) • NullAI Platform
logsource:
  category: process_creation / webserver
  product: linux / windows
detection:
  selection:
    Payload|contains:
{patterns}
  condition: selection
level: {preset["severity"].lower()}"""


def scan_payload(payload: str) -> dict:
    entropy = calculate_entropy(payload)
    evals = []
    for key, preset in PRESETS.items():
        matched = []
        for p in preset["patterns"]:
            if p["type"] == "ascii" and p["value"] in payload:
                matched.append(p["id"])
            elif p["type"] == "regex" and re.search(p["value"], payload):
                matched.append(p["id"])
        evals.append(
            {
                "preset": key,
                "rule": preset["ruleName"],
                "matched": len(matched) >= preset["minMatches"],
                "matches": matched,
            }
        )
    return {
        "entropy": round(entropy, 2),
        "bytes": len(payload.encode("utf-8")),
        "verdict": "SUSPICIOUS" if entropy > 5.5 or any(e["matched"] for e in evals) else "CLEAN",
        "evaluations": evals,
    }


def main():
    parser = argparse.ArgumentParser(
        prog=TOOL_ID,
        description=f"{TOOL_NAME} (v{TOOL_VERSION}) — {TOOL_DESC}",
    )
    parser.add_argument("--version", action="version", version=f"{TOOL_ID} v{TOOL_VERSION}")
    parser.add_argument("--status", action="store_true", help="Check local ZothOS installation & daemon status")
    parser.add_argument("--json", action="store_true", help="Output deterministic JSON telemetry")
    parser.add_argument("--ui", action="store_true", help="Print local ZothOS workbench URL")
    parser.add_argument("--compile", choices=["yara", "sigma"], help="Compile rule to stdout")
    parser.add_argument("--preset", default="php-cgi-rce", choices=list(PRESETS.keys()), help="Threat preset")
    parser.add_argument("--scan", help="Scan text string or file path for threats")
    parser.add_argument("--entropy", help="Calculate Shannon entropy for text string or file path")
    parser.add_argument("--serve", type=int, metavar="PORT", help="Serve web studio on port")
    parser.add_argument("payload", nargs="*", help="Optional payload or subcommand")
    args = parser.parse_args()

    if args.serve:
        subprocess.run([sys.executable, os.path.join(REPO_DIR, "server.py"), "--port", str(args.serve)])
        return

    if args.compile:
        if args.compile == "yara":
            print(emit_yara(args.preset))
        else:
            print(emit_sigma(args.preset))
        return

    if args.entropy:
        content = args.entropy
        if os.path.isfile(content):
            with open(content, "r", errors="ignore") as f:
                content = f.read()
        e = calculate_entropy(content)
        if args.json:
            print(json.dumps({"entropy": round(e, 2), "bytes": len(content)}))
        else:
            print(f"Shannon Entropy: {e:.2f} (max 8.00)")
        return

    if args.scan:
        content = args.scan
        if os.path.isfile(content):
            with open(content, "r", errors="ignore") as f:
                content = f.read()
        res = scan_payload(content)
        if args.json:
            print(json.dumps(res, indent=2))
        else:
            print(f"Verdict : {res['verdict']}")
            print(f"Entropy : {res['entropy']} ({res['bytes']} bytes)")
            for ev in res["evaluations"]:
                status = "DETECTED" if ev["matched"] else "CLEAN"
                print(f"  [{status}] {ev['rule']}: {len(ev['matches'])} patterns matched")
        return

    daemon_running = False
    try:
        with urllib.request.urlopen(f"{LOCAL_PORT_URL}/health", timeout=1.0) as resp:
            if resp.status == 200:
                daemon_running = True
    except Exception:
        daemon_running = False

    info = {
        "id": TOOL_ID,
        "repo": TOOL_REPO,
        "name": TOOL_NAME,
        "version": TOOL_VERSION,
        "category": TOOL_CATEGORY,
        "installed": os.path.exists(REPO_DIR),
        "repo_path": REPO_DIR,
        "studio_workbench_url": STUDIO_URL,
        "local_endpoint": LOCAL_PORT_URL,
        "daemon_running": daemon_running,
        "threat_presets": list(PRESETS.keys()),
        "license": "100% Free & Open Access (Zero Paywalls)",
        "support": {
            "stripe_buy_coffee": "https://buy.stripe.com/3cIfZg27PdKo2D64Ocfw40X",
            "solana_wallet": "GG2eQbVh8ut1BK6j1A2tz7pSySdLpD38BgyEhGcxdXoK",
        },
        "status": "ONLINE" if daemon_running else "READY",
    }

    if args.json:
        print(json.dumps(info, indent=2))
        return

    print(f"✦ {TOOL_NAME} (v{TOOL_VERSION}) — [{TOOL_CATEGORY}]")
    print(f"  Repository : {REPO_DIR}")
    print(f"  Workbench  : {STUDIO_URL}")
    print(f"  Local Port : {LOCAL_PORT_URL} (Daemon: {'ONLINE' if daemon_running else 'STANDBY'})")
    print(f"  Access     : 100% Free & Open Access (☕ https://buy.stripe.com/3cIfZg27PdKo2D64Ocfw40X | ◎ GG2eQbVh8ut1BK6j1A2tz7pSySdLpD38BgyEhGcxdXoK)")


if __name__ == "__main__":
    main()
