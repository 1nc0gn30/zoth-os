{
  "name": "maya-video-editor",
  "version": "2.0.0",
  "description": "Wrap screen recordings in device frames, synthesize 60fps procedural motion edits, and export ready-to-share videos on Linux",
  "main": "main.js",
  "homepage": "./",
  "license": "MIT",
  "author": "Neal Frazier Tech (@1nc0gn30) <https://nullai.tech>",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node tests/test_electron_security.mjs",
    "app:dev": "NODE_ENV=development electron .",
    "dist": "npm run build && electron-builder --linux AppImage"
  },
  "build": {
    "appId": "com.maya.videoeditor",
    "productName": "Maya",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "main.js",
      "electron-main.js",
      "preload.js",
      "maya_motion_engine.py",
      "public/**/*"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Video;AudioVideo;AudioVideoEditing;",
      "icon": "public/app/icon_512.png"
    }
  },
  "dependencies": {
    "lucide-react": "^1.34.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.6.1",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
