#!/usr/bin/env bash
set -euo pipefail

# Canonical ZothOS wrapper for agy-hermes-proxy (v2.0.0)
# Probes /opt/agy-hermes-proxy and ~/NullAITech/agy-hermes-proxy without hardcoded user paths.

PY_BIN="/opt/zothos-ai-env/bin/python3"
if [[ ! -x "$PY_BIN" ]]; then
  PY_BIN="$(command -v python3)"
fi

SRC_DIR=""
for candidate in \
  "${AGY_HERMES_PROXY_HOME:-}/src" \
  "/opt/agy-hermes-proxy/src" \
  "${HOME}/NullAITech/agy-hermes-proxy/src"; do
  if [[ -n "$candidate" && -d "$candidate/agy_hermes_proxy" ]]; then
    SRC_DIR="$candidate"
    break
  fi
done

if [[ -z "$SRC_DIR" ]]; then
  echo "agy-hermes-proxy: package directory not found in /opt/agy-hermes-proxy/src or ~/NullAITech/agy-hermes-proxy/src" >&2
  exit 1
fi

export PYTHONPATH="${SRC_DIR}${PYTHONPATH:+:${PYTHONPATH}}"
exec "$PY_BIN" -m agy_hermes_proxy.cli "$@"
