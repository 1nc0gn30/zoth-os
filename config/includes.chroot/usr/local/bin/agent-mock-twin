#!/usr/bin/env bash
set -euo pipefail

# Portable ZothOS / host shim for agent-mock-twin (v2.6.0)
SCRIPT_PATH="$(readlink -f "$0")"
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
CANDIDATE_FROM_SCRIPT="$(dirname "$SCRIPT_DIR")"

REPO_DIR=""
for candidate in \
  "${ZOTH_REPO_DIR:-}" \
  "$CANDIDATE_FROM_SCRIPT" \
  "${HOME}/NullAITech/agent-mock-twin" \
  "/opt/agent-mock-twin"; do
  if [ -n "$candidate" ] && [ -d "$candidate/src/agent_mock_twin" ]; then
    REPO_DIR="$candidate"
    break
  fi
done

if [ -z "$REPO_DIR" ]; then
  echo "[!] agent-mock-twin source directory not found (checked /opt/agent-mock-twin and \$HOME/NullAITech/agent-mock-twin)" >&2
  exit 1
fi

export PYTHONPATH="$REPO_DIR/src:${PYTHONPATH:-}"
exec python3 -m agent_mock_twin.cli "$@"
