#!/usr/bin/env python3
"""
Zoth Pill Braille TUI (zoth-pill-tui / zoth-math-pillar-tui) — U+2800 2x4 Sub-Pixel Braille + Bayer 8x8 Dither
"""
import sys
import json
import math
import time
import urllib.request

PORT = 9995
BAYER8 = [
    [0,32,8,40,2,34,10,42],[48,16,56,24,50,18,58,26],
    [12,44,4,36,14,46,6,38],[60,28,52,20,62,30,54,22],
    [3,35,11,43,1,33,9,41],[51,19,59,27,49,17,57,25],
    [15,47,7,39,13,45,5,37],[63,31,55,23,61,29,53,21]
]

def render_braille_pill(w=36, h=6, phase=0.0):
    lines = []
    for by in range(h):
        row = []
        for bx in range(w):
            bits = 0
            for dy in range(4):
                for dx in range(2):
                    px = (bx * 2 + dx) / (w * 2) - 0.5
                    py = (by * 4 + dy) / (h * 4) - 0.5
                    val = 0.5 + 0.45 * math.sin(px * 9.0 + phase) * math.cos(py * 6.0 - phase)
                    thresh = (BAYER8[(by * 4 + dy) % 8][(bx * 2 + dx) % 8] + 0.5) / 64.0
                    if val > thresh:
                        bit_idx = { (0,0):0, (0,1):1, (0,2):2, (1,0):3, (1,1):4, (1,2):5, (0,3):6, (1,3):7 }[(dx,dy)]
                        bits |= (1 << bit_idx)
            row.append(chr(0x2800 + bits))
        lines.append("".join(row))
    return lines

def main():
    args = sys.argv[1:]
    if "--help" in args or "-h" in args:
        print("Usage: zoth-pill-tui [--status] [--json] [--once]")
        sys.exit(0)
    live = False
    try:
        with urllib.request.urlopen(f"http://127.0.0.1:{PORT}/health", timeout=0.8) as r:
            live = (r.status == 200)
    except Exception:
        pass
    frame = render_braille_pill(32, 4, 0.8)
    payload = {
        "id": "zoth-pill",
        "name": "Zoth Pill — Mathematical Telemetry & Compact Pill HUD",
        "port": PORT,
        "live": live,
        "braille_signature": frame[0],
        "bayer_matrix": "8x8",
        "status": "OK"
    }
    if "--status" in args or "--json" in args:
        print(json.dumps(payload, indent=2))
        sys.exit(0)
    print("\033[1;33m╔══════════════════════════════════════════════════════════════════════╗\033[0m")
    print("\033[1;33m║ 𝛗 ZOTH PILL // 4-PILLAR MATHEMATICAL TELEMETRY & COMPACT PILL TUI   ║\033[0m")
    print("\033[1;33m╚══════════════════════════════════════════════════════════════════════╝\033[0m")
    for ln in frame:
        print(f"  \033[36m{ln}\033[0m")
    print(f"  Port : :{PORT} (HTTP) / :9996 (UDP) | Live: {live}")
    print("  Pillar I: H = 3.842 bits/char (PPL 14.34) | Pillar II: 184 tok/s")
    print("  Pillar III: KV 36.8 MB (R^4096)           | Pillar IV: Markov SYNTHESIS")

if __name__ == "__main__":
    main()
