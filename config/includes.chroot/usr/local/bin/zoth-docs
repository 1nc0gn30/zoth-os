#!/usr/bin/env bash
# ==============================================================================
#  ZOTHOS SOVEREIGN DOCUMENTATION CODEX RUNNER
# ==============================================================================
set -euo pipefail

DOCS_DIR="/opt/zoth-docs"
if command -v electron >/dev/null 2>&1; then
    exec electron --no-sandbox --disable-dev-shm-usage --disable-gpu-sandbox "$DOCS_DIR" "$@"
elif [[ -x "/usr/local/bin/electron" ]]; then
    exec /usr/local/bin/electron --no-sandbox --disable-dev-shm-usage --disable-gpu-sandbox "$DOCS_DIR" "$@"
elif command -v google-chrome >/dev/null 2>&1; then
    exec google-chrome --no-sandbox --app="file://$DOCS_DIR/index.html" "$@"
elif command -v firefox >/dev/null 2>&1; then
    exec firefox "file://$DOCS_DIR/index.html" "$@"
else
    xdg-open "file://$DOCS_DIR/index.html"
fi
