#!/usr/bin/env bash
# ==============================================================================
#  ZOTHOS FIRST-BOOT TOOL PROVISIONER & HUD (ARSENAL + NEXUS 153+ TOOLS)
# ==============================================================================
set -u

if [ -f /etc/zothos/paths.sh ]; then
  # shellcheck disable=SC1091
  . /etc/zothos/paths.sh
fi
: "${ZOTH_USER:=zoth}"
: "${AZOTH_USER:=azoth}"
: "${ZOTH_HOME:=/home/${ZOTH_USER}}"
: "${AZOTH_HOME:=/home/${AZOTH_USER}}"
: "${ZOTH_ACTIVE_HOME:=${HOME:-${ZOTH_HOME}}}"
: "${ZOTH_SRC_ROOT:=${ZOTH_ACTIVE_HOME}/NullAITech}"

FLAG="${ZOTH_HOME}/.config/zothos/firstboot.done"
LOG="/var/log/zoth-nexus-firstboot.log"
mkdir -p "${ZOTH_HOME}/.config/zothos"
mkdir -p /var/log

if [[ -f "$FLAG" ]]; then
    exit 0
fi

log() {
    echo "[$(date "+%Y-%m-%d %H:%M:%S")] [FIRSTBOOT] $*" >> "$LOG" 2>/dev/null || true
}

log "Starting ZothOS First-Boot Provisioner..."

# Notify user on desktop immediately that Zoth Arsenal + Nexus are active
if command -v notify-send >/dev/null 2>&1; then
    notify-send -i /usr/share/pixmaps/zoth-arsenal.png \
        "ZOTH TOOL NEXUS PRO // 153+ TOOLS" \
        "All Kali, Parrot, Local AI Runtimes, Web3 & Infra tools pre-installed and ready."
fi

# Asynchronous background finalization
(
    sleep 2
    log "Initializing background daemons and service hooks..."

    # 1. Enforce AI environment ownership and symlinks
    log "Enforcing permissions on AI environment and core symlinks..."
    chown -R zoth:zoth /opt/zothos-ai-env 2>/dev/null || true
    chmod 1777 /tmp 2>/dev/null || true
    ln -sf /usr/bin/batcat /usr/local/bin/bat 2>/dev/null || true
    ln -sf /usr/bin/fdfind /usr/local/bin/fd 2>/dev/null || true
    chmod +x /usr/local/bin/zoth* 2>/dev/null || true

    # Expose AI env binaries to /usr/local/bin
    if [ -d /opt/zothos-ai-env/bin ]; then
        for b in /opt/zothos-ai-env/bin/*; do
            bname=$(basename "$b")
            if [ "$bname" != "python" ] && [ "$bname" != "python3" ] && [ "$bname" != "pip" ] && [ "$bname" != "pip3" ]; then
                if [ ! -e "/usr/local/bin/$bname" ] && [ -x "$b" ]; then
                    ln -sf "$b" "/usr/local/bin/$bname" 2>/dev/null || true
                fi
            fi
        done
    fi

    # 2. Start Ollama daemon if present
    if command -v ollama >/dev/null 2>&1; then
        log "Starting Ollama runtime daemon..."
        systemctl enable --now ollama 2>/dev/null || pgrep -x ollama >/dev/null || (ollama serve >/dev/null 2>&1 &)
    fi

    # 3. Initialize IPFS repository if not present
    if command -v ipfs >/dev/null 2>&1; then
        if [[ ! -d "${ZOTH_HOME}/.ipfs" ]]; then
            log "Initializing IPFS node..."
            su - zoth -c "ipfs init" >> "$LOG" 2>&1 || true
        fi
    fi

    # 4. Verify environment variables and paths (do NOT run update-desktop-database here as it triggers mid-session Plasma desktop icon reloads)
    log "Updating ldconfig..."
    ldconfig 2>/dev/null || true

    # 5. Final verification via zoth-pkg
    if command -v zoth-pkg >/dev/null 2>&1; then
        log "Running zoth-pkg verification..."
        zoth-pkg verify >> "$LOG" 2>&1 || true
    fi

    # Mark firstboot as complete
    touch "$FLAG"
    chown zoth:zoth "$FLAG" 2>/dev/null || true
    log "First-boot provisioning completed successfully."

    # Final completion notification
    if command -v notify-send >/dev/null 2>&1; then
        notify-send -i /usr/share/pixmaps/zoth-mark.png \
            "ZOTH ARSENAL & NEXUS READY" \
            "153+ Offensive, Defense, AI, and Sovereign tools are fully operational."
    fi
) >> "$LOG" 2>&1 &

exit 0
