#!/usr/bin/env bash
# HexStrike AI MCP Server Entrypoint
DIR="/usr/share/hexstrike-ai"
if [[ ! -d "$DIR" ]]; then
    if [[ -n "${ZOTHOS_SRC:-}" && -d "${ZOTHOS_SRC}/config/includes.chroot/usr/share/hexstrike-ai" ]]; then
        DIR="${ZOTHOS_SRC}/config/includes.chroot/usr/share/hexstrike-ai"
    elif [[ -d "/opt/hexstrike-ai" ]]; then
        DIR="/opt/hexstrike-ai"
    fi
fi
cd "$DIR" && exec python3 hexstrike_mcp.py "$@"
