#!/usr/bin/env python3
"""ZothOS CLI binary wrapper for shopify-connector.

Engineered by 1nc0gn30 • NullAI Platform.
100% Free & Open Access — Zero External Dependencies.
"""

import os
import subprocess
import sys

TOOL_ID = "shopify-connector"
REPO_DIR = os.path.expanduser("~/NullAITech/shopify-connector")
PKG_DIR = os.path.expanduser("~/NullAITech/shopify-connector/src")
PY_CLI = os.path.expanduser("~/NullAITech/shopify-connector/src/shopify_connector/cli.py")


def main():
    args = sys.argv[1:]
    if '--electron' in args or (args and args[0] in ('desktop', 'electron')):
        import shutil as _sh
        rem = [a for a in args if a not in ('--electron', 'desktop', 'electron')]
        elec = _sh.which('electron') or '/usr/local/bin/electron'
        sys.exit(subprocess.run([elec, os.path.join(REPO_DIR, 'electron', 'main.cjs')] + rem, cwd=REPO_DIR).returncode)
    if '--tui' in args or (args and args[0] == 'tui'):
        rem = [a for a in args if a not in ('--tui', 'tui')]
        sys.exit(subprocess.run([f'/usr/local/bin/{TOOL_ID}-tui'] + rem).returncode)
    env = os.environ.copy()
    if os.path.exists(PKG_DIR):
        env["PYTHONPATH"] = PKG_DIR + (os.pathsep + env.get("PYTHONPATH", "") if env.get("PYTHONPATH") else "")
        res = subprocess.run([sys.executable, "-m", "shopify_connector.cli"] + args, cwd=REPO_DIR, env=env)
        sys.exit(res.returncode)
    elif os.path.exists(PY_CLI):
        res = subprocess.run([sys.executable, PY_CLI] + args, cwd=REPO_DIR, env=env)
        sys.exit(res.returncode)
    else:
        print(f"Error: {TOOL_ID} repository not found at {REPO_DIR}", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
