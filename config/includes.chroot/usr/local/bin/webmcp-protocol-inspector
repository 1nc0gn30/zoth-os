#!/usr/bin/env python3
import sys, os, json, subprocess, argparse, urllib.request, urllib.error

TOOL_ID = 'webmcp-protocol-inspector'
TOOL_REPO = 'webmcp-protocol-inspector'
TOOL_NAME = 'WebMCP Protocol Suite'
TOOL_DESC = 'In-browser Model Context Protocol (MCP) JSON-RPC 2.0 inspector, tool schema dispatcher, token meter, and schema security firewall.'
TOOL_VERSION = '1.0.0'
TOOL_CATEGORY = 'AI & Knowledge'
TOOL_PORT = 8142
REPO_DIR = os.path.expanduser('~/NullAITech/webmcp-protocol-inspector')
PY_CLI = None
PKG_DIR = None
STUDIO_URL = f"http://127.0.0.1:3000/tools/{TOOL_ID}"
LOCAL_PORT_URL = f"http://127.0.0.1:{TOOL_PORT}"

def check_daemon():
    try:
        req = urllib.request.Request(f"http://127.0.0.1:{TOOL_PORT}/health")
        with urllib.request.urlopen(req, timeout=1.5) as resp:
            if resp.status == 200:
                return json.loads(resp.read().decode('utf-8'))
    except Exception:
        pass
    return None

def main():
    args = sys.argv[1:]
    if '--electron' in args or (args and args[0] in ('desktop', 'electron')):
        import shutil as _sh
        rem = [a for a in args if a not in ('--electron', 'desktop', 'electron')]
        elec = _sh.which('electron') or '/usr/local/bin/electron'
        sys.exit(subprocess.run([elec, os.path.join(REPO_DIR, 'electron', 'main.cjs')] + rem, cwd=REPO_DIR).returncode)
    if '--tui' in args or (args and args[0] == 'tui'):
        rem = [a for a in args if a not in ('--tui', 'tui')]
        sys.exit(subprocess.run([f'/usr/local/bin/{TOOL_ID}-tui'] + rem).returncode)

    parser = argparse.ArgumentParser(
        prog=TOOL_ID,
        description=f"{TOOL_NAME} (v{TOOL_VERSION}) — {TOOL_DESC}"
    )
    parser.add_argument('--version', '-v', action='version', version=f"{TOOL_ID} v{TOOL_VERSION}")
    parser.add_argument('--status', action='store_true', help='Check local ZothOS daemon status')
    parser.add_argument('--json', action='store_true', help='Output deterministic JSON telemetry')
    parser.add_argument('--ui', action='store_true', help='Print local ZothOS workbench URL')
    parser.add_argument('--inspect', '-i', type=str, metavar='FILE', help='Inspect and audit a JSON schema file')
    parser.add_argument('payload', nargs='*', help='Optional input payload or subcommand')
    parsed, unknown = parser.parse_known_args(args)

    daemon_status = check_daemon()

    if parsed.inspect:
        target = parsed.inspect
        if not os.path.exists(target):
            print(f"Error: file not found '{target}'", file=sys.stderr)
            sys.exit(1)
        with open(target, 'r', encoding='utf-8') as f:
            data = json.load(f)
        post_data = json.dumps({"schema": data}).encode('utf-8')
        try:
            req = urllib.request.Request(
                f"http://127.0.0.1:{TOOL_PORT}/api/inspect",
                data=post_data,
                headers={"Content-Type": "application/json"}
            )
            with urllib.request.urlopen(req, timeout=3) as resp:
                res = json.loads(resp.read().decode('utf-8'))
                if parsed.json:
                    print(json.dumps(res, indent=2))
                else:
                    audit = res.get("audit", {})
                    print(f"✦ Schema Inspection Report for: {data.get('name', 'unnamed')}")
                    print(f"  Grade        : {audit.get('grade')} ({audit.get('score')}/100)")
                    print(f"  Token Est.   : ~{audit.get('tokenEstimate')} tokens")
                    print(f"  Is Safe      : {audit.get('is_safe')}")
                    if audit.get("warnings"):
                        print("  Warnings:")
                        for w in audit.get("warnings"):
                            print(f"    - {w}")
                return
        except Exception as e:
            print(f"Error inspecting schema via daemon: {e}", file=sys.stderr)
            sys.exit(1)

    info = {
        "id": TOOL_ID,
        "repo": TOOL_REPO,
        "name": TOOL_NAME,
        "version": TOOL_VERSION,
        "category": TOOL_CATEGORY,
        "installed": os.path.exists(REPO_DIR),
        "repo_path": REPO_DIR,
        "native_cli": PY_CLI,
        "studio_workbench_url": STUDIO_URL,
        "local_endpoint": LOCAL_PORT_URL,
        "daemon_online": daemon_status is not None,
        "daemon_info": daemon_status,
        "license": "100% Free & Open Access (Zero Paywalls)",
        "support": {
            "stripe_buy_coffee": "https://buy.stripe.com/3cIfZg27PdKo2D64Ocfw40X",
            "solana_wallet": "GG2eQbVh8ut1BK6j1A2tz7pSySdLpD38BgyEhGcxdXoK"
        },
        "status": "READY"
    }

    if parsed.json:
        print(json.dumps(info, indent=2))
        return

    if parsed.ui:
        print(STUDIO_URL)
        return

    if parsed.status:
        state = "ONLINE" if daemon_status else "OFFLINE"
        print(f"✦ {TOOL_NAME} Daemon Status: {state} (:8142)")
        if daemon_status:
            print(f"  Uptime   : {daemon_status.get('uptime')}s")
            print(f"  Features : {', '.join(daemon_status.get('features', []))}")
        return

    print(f"✦ {TOOL_NAME} (v{TOOL_VERSION}) — [{TOOL_CATEGORY}]")
    print(f"  Repository : {REPO_DIR}")
    print(f"  Workbench  : {STUDIO_URL}")
    print(f"  Local Port : {LOCAL_PORT_URL}")
    print(f"  Daemon     : {'ONLINE' if daemon_status else 'OFFLINE'}")
    print(f"  Access     : 100% Free & Open Access (☕ https://buy.stripe.com/3cIfZg27PdKo2D64Ocfw40X | ◎ GG2eQbVh8ut1BK6j1A2tz7pSySdLpD38BgyEhGcxdXoK)")

if __name__ == '__main__':
    main()
