# ═══════════════════════════════════════════════════════════════════════════════
# Visual Helpers (Meters & Formatters)
# ═══════════════════════════════════════════════════════════════════════════════

def render_meter(pct: float, width: int = 14) -> str:
    """Generate high-density unicode meter bar [████░░░░░░]"""
    pct = max(0.0, min(100.0, pct))
    filled = int(round((pct / 100.0) * width))
    empty = max(0, width - filled)
    return "█" * filled + "░" * empty


# ═══════════════════════════════════════════════════════════════════════════════
# Headless / Status Mode CLI Renderer
# ═══════════════════════════════════════════════════════════════════════════════

def render_headless_status() -> None:
    """Prints a clean snapshot of ZOTHOS Cockpit directly to stdout."""
    metrics = SystemMetrics()
    time.sleep(0.05)
    cpu_pct, loads, cores, cpu_model = metrics.get_cpu()
    ram_used, ram_total, ram_pct, swap_used, swap_total = metrics.get_ram()
    disk_used, disk_total, disk_free, disk_pct = metrics.get_disk("/")
    uptime = metrics.get_uptime()
    net = metrics.get_net_info()
    tor_status, is_cloaked = metrics.get_tor_route()
    active_mode = metrics.get_active_mode().upper()
    sys_sum = metrics.get_system_summary()

    print(f"\n{ANSI_GOLD}{ANSI_BOLD}")
    print("  ╔════════════════════════════════════════════════════════════════════════════════════╗")
    print(f"  ║        * ZOTHOS LINUX COCKPIT - SOVEREIGN OPERATIONS DECK v{VERSION} *         ║")
    print("  ╚════════════════════════════════════════════════════════════════════════════════════╝")
    print(f"{ANSI_RESET}")

    print(f"  {ANSI_BOLD}ACTIVE PROFILE:{ANSI_RESET} [{ANSI_GREEN if active_mode == 'GHOST' else ANSI_GOLD}{active_mode}{ANSI_RESET}]   │  {ANSI_BOLD}UPTIME:{ANSI_RESET} {uptime}   │  {ANSI_BOLD}KERNEL:{ANSI_RESET} {sys_sum['kernel']}")
    print(f"  {ANSI_BOLD}NODE IP:{ANSI_RESET}         {net['ip']} ({net['iface']})   │  {ANSI_BOLD}GATEWAY:{ANSI_RESET} {net['gw']}")
    print(f"  {ANSI_BOLD}TOR CLOAKING:{ANSI_RESET}    {ANSI_GREEN if is_cloaked else ANSI_RED}{tor_status}{ANSI_RESET}\n")

    print(f"  {ANSI_CYAN}{ANSI_BOLD}─── [ 1. LIVE HARDWARE & TELEMETRY ] ───────────────────────────────────────────────{ANSI_RESET}")
    print(f"  CPU ({cores} Cores) : [{render_meter(cpu_pct)}] {cpu_pct:5.1f}%  (Load: {loads[0]:.2f}, {loads[1]:.2f}, {loads[2]:.2f}) - {cpu_model}")
    print(f"  RAM Memory  : [{render_meter(ram_pct)}] {ram_pct:5.1f}%  ({ram_used:.1f} GB / {ram_total:.1f} GB)")
    print(f"  Disk Root / : [{render_meter(disk_pct)}] {disk_pct:5.1f}%  ({disk_used:.1f} GB / {disk_total:.1f} GB, {disk_free:.1f} GB Free)")
    if swap_total > 0:
        swap_pct = (swap_used / swap_total) * 100.0
        print(f"  Swap Space  : [{render_meter(swap_pct)}] {swap_pct:5.1f}%  ({swap_used:.1f} GB / {swap_total:.1f} GB)")

    print(f"\n  {ANSI_PURPLE}{ANSI_BOLD}─── [ 2. FRONTIER & LOCAL AI STACK ] ───────────────────────────────────────────────{ANSI_RESET}")
    for eng in AI_ENGINES:
        if eng.get("port", 0) > 0:
            is_up = check_port(eng["port"])
            status = f"{ANSI_GREEN}● ONLINE :{eng['port']}{ANSI_RESET}" if is_up else f"{ANSI_RED}○ OFFLINE{ANSI_RESET}"
        elif eng.get("type") in ["bin", "gui"]:
            avail = tool_available(eng["bin"], eng.get("alt_bin"))
            status = f"{ANSI_GREEN}✓ INSTALLED{ANSI_RESET}" if avail else f"{ANSI_GRAY}○ NOT IN PATH{ANSI_RESET}"
        else:
            ready = tool_available(eng.get("bin", "")) or python_pkg_available(eng.get("pkg", ""))
            status = f"{ANSI_GREEN}✓ READY{ANSI_RESET}" if ready else f"{ANSI_GRAY}○ VENV READY{ANSI_RESET}"
        print(f"  [{eng['key'].upper()}] {eng['name']:<18} {status:<28} {ANSI_GRAY}{eng['desc']}{ANSI_RESET}")

    print(f"\n  {ANSI_RED}{ANSI_BOLD}─── [ 3. OFFENSIVE & DEFENSIVE SECURITY ARSENAL ] ──────────────────────────────────{ANSI_RESET}")
    for sec in SECURITY_TOOLS:
        avail = tool_available(sec["bin"], sec.get("alt_bin"))
        status = f"{ANSI_GREEN}✓ INSTALLED{ANSI_RESET}" if avail else f"{ANSI_GRAY}○ APT AVAILABLE{ANSI_RESET}"
        gui_badge = f"{ANSI_CYAN}[GUI]{ANSI_RESET} " if sec.get("gui") else f"{ANSI_DIM}[CLI]{ANSI_RESET} "
        print(f"  [{sec['key'].upper()}] {sec['name']:<18} {gui_badge}{status:<24} {ANSI_GRAY}{sec['desc']}{ANSI_RESET}")

    print(f"\n  {ANSI_GOLD}{ANSI_BOLD}─── [ 4. ZOTH STUDIO & SYSTEM DAEMONS ] ────────────────────────────────────────────{ANSI_RESET}")
    for s in ZOTH_STUDIO_SERVICES:
        up = check_port(s["port"]) or (s.get("alt_port") and check_port(s["alt_port"]))
        port_label = f":{s['port']}"
        status = f"{ANSI_GREEN}● ONLINE {port_label:<6}{ANSI_RESET}" if up else f"{ANSI_GRAY}○ OFFLINE{port_label:<6}{ANSI_RESET}"
        print(f"  [{s['key'].upper()}] {s['name']:<24} {status:<24} {ANSI_GRAY}{s['desc']}{ANSI_RESET}")

    print("")


def dump_json_status() -> None:
    """Outputs all telemetry and services as structured JSON for scripts and daemons."""
    metrics = SystemMetrics()
    cpu_pct, loads, cores, cpu_model = metrics.get_cpu()
    ram_used, ram_total, ram_pct, swap_used, swap_total = metrics.get_ram()
    disk_used, disk_total, disk_free, disk_pct = metrics.get_disk("/")
    uptime = metrics.get_uptime()
    net = metrics.get_net_info()
    tor_status, is_cloaked = metrics.get_tor_route()
    active_mode = metrics.get_active_mode()
    sys_sum = metrics.get_system_summary()

    ai_status = []
    for eng in AI_ENGINES:
        up = check_port(eng["port"]) if eng.get("port", 0) > 0 else False
        installed = tool_available(eng["bin"], eng.get("alt_bin"))
        ai_status.append({
            "key": eng["key"],
            "name": eng["name"],
            "port": eng.get("port", 0),
            "up": up,
            "installed": installed,
        })

    sec_status = []
    for sec in SECURITY_TOOLS:
        sec_status.append({
            "key": sec["key"],
            "name": sec["name"],
            "installed": tool_available(sec["bin"], sec.get("alt_bin")),
            "gui": sec.get("gui", False),
        })

    daemon_status = []
    for s in ZOTH_STUDIO_SERVICES:
        daemon_status.append({
            "key": s["key"],
            "name": s["name"],
            "port": s["port"],
            "up": check_port(s["port"]) or (s.get("alt_port") and check_port(s["alt_port"])),
        })

    data = {
        "version": VERSION,
        "timestamp": int(time.time()),
        "profile": active_mode,
        "tor": {"status": tor_status, "cloaked": is_cloaked},
        "network": net,
        "system": sys_sum,
        "telemetry": {
            "uptime": uptime,
            "cpu": {"pct": cpu_pct, "loads": loads, "cores": cores, "model": cpu_model},
            "ram": {"used_gb": ram_used, "total_gb": ram_total, "pct": ram_pct, "swap_used_gb": swap_used, "swap_total_gb": swap_total},
            "disk": {"used_gb": disk_used, "total_gb": disk_total, "free_gb": disk_free, "pct": disk_pct},
        },
        "ai_engines": ai_status,
        "security_tools": sec_status,
        "daemons": daemon_status,
    }
    print(json.dumps(data, indent=2))


# ═══════════════════════════════════════════════════════════════════════════════
# Interactive Fullscreen Curses Application
# ═══════════════════════════════════════════════════════════════════════════════

class CockpitTUI:
    TABS = [
        {"id": "telemetry", "title": "[1] TELEMETRY & SYSTEM"},
        {"id": "ai", "title": "[2] AI FRONTIER STACK"},
        {"id": "security", "title": "[3] SECURITY ARSENAL"},
        {"id": "studio", "title": "[4] STUDIO & DAEMONS"},
        {"id": "profiles", "title": "[5] REALITY PROFILES"},
    ]

    def __init__(self, stdscr: curses.window, initial_tab: int = 0) -> None:
        self.stdscr = stdscr
        self.metrics = SystemMetrics()
        self.status_msg = "Sovereign Cockpit active. Press [Tab/1-5] for views, [↑/↓] to navigate, [Enter] to run, [Q] to quit."
        self.status_time = time.time()
        self.current_tab = max(0, min(len(self.TABS) - 1, initial_tab))
        self.selected_indices = [0] * len(self.TABS)
        self.scroll_offsets = [0] * len(self.TABS)
        self.running = True
        self.show_help = False

    def init_colors(self) -> None:
        curses.start_color()
        curses.use_default_colors()

        if curses.can_change_color():
            # Fine-tune RGB for phosphor emerald, cyber gold, neon cyan
            curses.init_color(curses.COLOR_GREEN, 0, 1000, 615)     # #00ff9d
            curses.init_color(curses.COLOR_YELLOW, 984, 749, 141)   # #fbbf24
            curses.init_color(curses.COLOR_CYAN, 219, 741, 972)     # #38bdf8
            curses.init_color(curses.COLOR_MAGENTA, 752, 517, 988)  # #c084fc
            curses.init_color(curses.COLOR_RED, 956, 247, 368)      # #f43f5e

        curses.init_pair(1, curses.COLOR_GREEN, -1)                  # 1: Green on default
        curses.init_pair(2, curses.COLOR_YELLOW, -1)                 # 2: Gold on default
        curses.init_pair(3, curses.COLOR_CYAN, -1)                   # 3: Cyan on default
        curses.init_pair(4, curses.COLOR_RED, -1)                    # 4: Red on default
        curses.init_pair(5, curses.COLOR_MAGENTA, -1)                # 5: Purple on default
        curses.init_pair(6, curses.COLOR_WHITE, -1)                  # 6: White on default
        curses.init_pair(7, curses.COLOR_BLACK, curses.COLOR_YELLOW) # 7: Highlight Gold bar
        curses.init_pair(8, curses.COLOR_BLACK, curses.COLOR_GREEN)  # 8: Highlight Green bar
        curses.init_pair(9, curses.COLOR_BLACK, curses.COLOR_CYAN)   # 9: Highlight Cyan bar
        curses.init_pair(10, curses.COLOR_BLACK, curses.COLOR_RED)   # 10: Alert Red bar

    def notify(self, msg: str) -> None:
        self.status_msg = msg
        self.status_time = time.time()

    def safe_addstr(self, y: int, x: int, text: str, attr: int = 0) -> None:
        h, w = self.stdscr.getmaxyx()
        if 0 <= y < h and 0 <= x < w:
            max_len = max(0, w - x - 1)
            try:
                self.stdscr.addstr(y, x, text[:max_len], attr)
            except curses.error:
                pass

    def run_external_cli(self, cmd_list: List[str], title: str, pause_after: bool = True) -> None:
        """Suspends curses, restores terminal cursor, runs CLI interactive command, and restores curses."""
        try:
            curses.curs_set(1)
        except curses.error:
            pass
        curses.def_prog_mode()
        curses.endwin()

        resolved = resolve_tool(cmd_list[0]) or cmd_list[0]
        full_cmd = [resolved] + cmd_list[1:]

        print(f"\n\033[1;38;2;251;191;36m[*] ZOTHOS Cockpit: Launching {title}...\033[0m\n")
        try:
            res = subprocess.run(full_cmd)
            code = res.returncode
        except Exception as e:
            print(f"\033[1;31m[!] Error executing {title}: {e}\033[0m")
            code = 1

        if pause_after:
            print(f"\n\033[1;32m[✓] Process exited (code {code}). Press Enter to return to Cockpit...\033[0m")
            try:
                input()
            except Exception:
                pass

        curses.reset_prog_mode()
        try:
            curses.curs_set(0)
        except curses.error:
            pass
        self.stdscr.clear()
        self.notify(f"Returned from {title} (exit code: {code})")

    def run_external_gui(self, cmd_list: List[str], title: str) -> None:
        """Spawns GUI / background application without suspending curses."""
        resolved = resolve_tool(cmd_list[0]) or cmd_list[0]
        full_cmd = [resolved] + cmd_list[1:]
        try:
            subprocess.Popen(
                full_cmd,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                start_new_session=True,
            )
            self.notify(f"[✓] Launched {title} in background")
        except Exception as e:
            self.notify(f"[!] Failed to launch {title}: {e}")

    def set_mode(self, mode_id: str) -> None:
        """Switches active environment/stealth profile."""
        self.notify(f"Engaging {mode_id.upper()} profile...")
        if tool_available("zoth-mode"):
            try:
                res = subprocess.run(["zoth-mode", mode_id], capture_output=True, text=True, timeout=8.0)
                if res.returncode == 0:
                    self.notify(f"[✓] Profile switched to {mode_id.upper()}")
                else:
                    self.notify(f"[!] zoth-mode error: {res.stderr.strip() or res.stdout.strip()}")
            except Exception as e:
                self.notify(f"[!] Mode switch error: {e}")
        else:
            cfg_dir = os.path.expanduser("~/.config/zothos")
            os.makedirs(cfg_dir, exist_ok=True)
            for fname in ["profile.state", "current_mode", "reality.state"]:
                with open(os.path.join(cfg_dir, fname), "w") as f:
                    f.write(mode_id)
            self.notify(f"[✓] Profile state set to {mode_id.upper()}")

    # ── Tab Item Retrieval Helpers ─────────────────────────────────────────────

    def get_current_items(self) -> List[Dict[str, Any]]:
        tab_id = self.TABS[self.current_tab]["id"]
        if tab_id == "telemetry":
            return CORE_SYSTEM_TOOLS
        elif tab_id == "ai":
            return AI_ENGINES
        elif tab_id == "security":
            return SECURITY_TOOLS
        elif tab_id == "studio":
            return ZOTH_STUDIO_SERVICES
        elif tab_id == "profiles":
            return REALITY_PROFILES
        return []

    def execute_item(self, item: Dict[str, Any]) -> None:
        tab_id = self.TABS[self.current_tab]["id"]

        if tab_id == "telemetry":
            if item.get("gui"):
                self.run_external_gui(item["launch_gui"], item["name"])
            else:
                self.run_external_cli(item["launch_cli"], item["name"])

        elif tab_id == "ai":
            # AI tool execution
            if item["key"] == "o":  # Ollama
                if not check_port(11434):
                    self.run_external_gui(["ollama", "serve"], "Ollama Daemon")
                    self.notify("[*] Starting Ollama daemon (:11434)...")
                else:
                    self.run_external_cli(["ollama", "list"], "Ollama Models")
            elif item["key"] == "c":  # ComfyUI
                if check_port(8188):
                    self.run_external_gui(["xdg-open", "http://127.0.0.1:8188"], "ComfyUI Browser")
                elif os.path.isdir("/opt/ComfyUI"):
                    self.run_external_gui(["python3", "/opt/ComfyUI/main.py", "--listen", "127.0.0.1", "--port", "8188"], "ComfyUI Daemon")
                else:
                    self.notify("[!] ComfyUI not running on :8188 and /opt/ComfyUI not found")
            elif item["key"] == "v":  # vLLM
                self.run_external_cli(["vllm", "serve", "--help"], "vLLM Inference Server")
            elif item.get("gui") or item.get("launch_gui"):
                self.run_external_gui(item["launch_gui"], item["name"])
            elif item.get("launch_cli"):
                self.run_external_cli(item["launch_cli"], item["name"])

        elif tab_id == "security":
            if item.get("gui"):
                self.run_external_gui(item["launch_gui"], item["name"])
            else:
                self.run_external_cli(item["launch_cli"], item["name"])

        elif tab_id == "studio":
            if item["key"] == "u":  # Studio UI
                if check_port(3000):
                    self.run_external_gui(["xdg-open", "http://127.0.0.1:3000"], "Zoth Studio Web")
                elif check_port(8088):
                    self.run_external_gui(["xdg-open", "http://127.0.0.1:8088/studio/index.html"], "Classic Studio Web")
                elif os.path.isfile("/usr/local/bin/zoth-studio"):
                    self.run_external_gui(["/usr/local/bin/zoth-studio"], "Zoth Studio")
                else:
                    self.notify("[*] Zoth Studio UI offline. Press [A] to start daemons.")
            elif item["key"] == "o":  # Ollama
                if check_port(11434):
                    self.run_external_cli(["ollama", "list"], "Ollama Models")
                else:
                    self.run_external_gui(["ollama", "serve"], "Ollama Daemon")
            elif item["key"] == "t":  # Tor
                if check_port(9050):
                    self.notify("[✓] Tor SOCKS5 proxy already running on 127.0.0.1:9050")
                else:
                    self.run_external_cli(["sudo", "systemctl", "restart", "tor"], "Restart Tor")
            else:
                # Toggle / status of studio service
                if check_port(item["port"]):
                    self.notify(f"[✓] {item['name']} is active on port {item['port']}")
                else:
                    self.notify(f"[*] {item['name']} is offline. Press [A] to start all studio services.")

        elif tab_id == "profiles":
            self.set_mode(item["id"])

    def handle_input(self, ch: int) -> None:
        if ch in [ord("q"), ord("Q")]:
            self.running = False
            return
        elif ch in [ord("?"), ord("h"), ord("H")]:
            self.show_help = not self.show_help
            return
        elif ch == curses.KEY_RESIZE:
            self.stdscr.clear()
            return

        # Close help modal on any other key
        if self.show_help:
            self.show_help = False
            return

        # Tab Switching
        if ch in [9]:  # Tab key
            self.current_tab = (self.current_tab + 1) % len(self.TABS)
            return
        elif ch in [curses.KEY_BTAB]:  # Shift+Tab
            self.current_tab = (self.current_tab - 1) % len(self.TABS)
            return
        elif ch in [ord("1"), ord("2"), ord("3"), ord("4"), ord("5")]:
            self.current_tab = int(chr(ch)) - 1
            return
        elif ch in [curses.KEY_LEFT]:
            self.current_tab = (self.current_tab - 1) % len(self.TABS)
            return
        elif ch in [curses.KEY_RIGHT]:
            self.current_tab = (self.current_tab + 1) % len(self.TABS)
            return

        # Up/Down Navigation within current tab
        items = self.get_current_items()
        idx = self.selected_indices[self.current_tab]

        if ch in [curses.KEY_UP]:
            if items:
                self.selected_indices[self.current_tab] = (idx - 1) % len(items)
            return
        elif ch in [curses.KEY_DOWN]:
            if items:
                self.selected_indices[self.current_tab] = (idx + 1) % len(items)
            return
        elif ch in [10, 13, curses.KEY_ENTER]:  # Enter executes highlighted item
            if items and 0 <= idx < len(items):
                self.execute_item(items[idx])
            return

        # Refresh
        if ch in [ord("r"), ord("R"), curses.KEY_F5]:
            self.notify("[✓] Live metrics & service probes refreshed")
            return

        # Studio tab special action: [A] Bring up all studio daemons
        if self.TABS[self.current_tab]["id"] == "studio":
            c = chr(ch).lower() if 0 <= ch < 256 else ""
            if c == "a":
                if tool_available("zoth"):
                    self.run_external_cli(["zoth", "up"], "Start Studio Services", pause_after=True)
                else:
                    self.notify("[!] 'zoth' CLI not found")
                return
            elif c == "k":
                if tool_available("zoth"):
                    self.run_external_cli(["zoth", "down"], "Stop Studio Services", pause_after=True)
                else:
                    self.notify("[!] 'zoth' CLI not found")
                return
            elif c == "w":
                self.run_external_gui(["xdg-open", "http://127.0.0.1:3000"], "Studio Web")
                return

        # Direct hotkeys within current tab
        c = chr(ch).lower() if 0 <= ch < 256 else ""
        if c:
            for item in items:
                if item["key"].lower() == c:
                    self.execute_item(item)
                    return

    # ── Drawing & Rendering Engine ─────────────────────────────────────────────

    def draw(self) -> None:
        self.stdscr.erase()
        h, w = self.stdscr.getmaxyx()

        if h < 16 or w < 60:
            self.safe_addstr(0, 0, f"ZOTHOS Cockpit - Terminal too small ({w}x{h}). Minimum 60x16.", curses.A_BOLD)
            self.stdscr.refresh()
            return

        # Telemetry samples
        cpu_pct, loads, cores, cpu_model = self.metrics.get_cpu()
        ram_used, ram_total, ram_pct, swap_used, swap_total = self.metrics.get_ram()
        disk_used, disk_total, disk_free, disk_pct = self.metrics.get_disk("/")
        uptime = self.metrics.get_uptime()
        tor_status, is_cloaked = self.metrics.get_tor_route()
        active_mode = self.metrics.get_active_mode().upper()
        sys_sum = self.metrics.get_system_summary()

        c_green = curses.color_pair(1) | curses.A_BOLD
        c_gold = curses.color_pair(2) | curses.A_BOLD
        c_cyan = curses.color_pair(3) | curses.A_BOLD
        c_red = curses.color_pair(4) | curses.A_BOLD
        c_purple = curses.color_pair(5) | curses.A_BOLD
        c_white = curses.color_pair(6) | curses.A_BOLD
        c_dim = curses.color_pair(6) | curses.A_DIM

        # ── 1. Top Header Banner ────────────────────────────────────────────────
        title = f" ◈ ZOTHOS COCKPIT ◈  v{VERSION}  [{sys_sum['user']}@{sys_sum['host']}] "
        self.safe_addstr(0, max(0, (w - len(title)) // 2), title, curses.color_pair(7) | curses.A_BOLD)

        # Quick stats line under header
        profile_col = c_green if active_mode == "GHOST" else c_gold
        tor_col = c_green if is_cloaked else c_red
        clock_str = time.strftime("%H:%M:%S")

        stat_line = f" Mode: [{active_mode}] │ CPU: {cpu_pct:4.1f}% │ RAM: {ram_pct:4.1f}% │ Tor: {'● CLOAKED' if is_cloaked else '○ CLEARNET'} │ Up: {uptime} │ {clock_str} "
        self.safe_addstr(1, max(0, (w - len(stat_line)) // 2), stat_line, c_dim)

        # ── 2. Tab Navigation Selector Bar ─────────────────────────────────────
        tab_y = 2
        cur_x = 2
        for i, tab in enumerate(self.TABS):
            is_active = (i == self.current_tab)
            t_text = f" {tab['title']} "
            if is_active:
                self.safe_addstr(tab_y, cur_x, t_text, curses.color_pair(7) | curses.A_BOLD)
            else:
                self.safe_addstr(tab_y, cur_x, t_text, c_dim)
            cur_x += len(t_text) + 1

        sep_line = "═" * (w - 4)
        self.safe_addstr(3, 2, sep_line, c_gold)

        # ── 3. Tab Body ────────────────────────────────────────────────────────
        body_start_y = 4
        body_end_y = h - 3
        avail_lines = body_end_y - body_start_y

        tab_id = self.TABS[self.current_tab]["id"]

        if tab_id == "telemetry":
            self.draw_tab_telemetry(body_start_y, avail_lines, w, cpu_pct, loads, cores, cpu_model, ram_used, ram_total, ram_pct, swap_used, swap_total, disk_used, disk_total, disk_free, disk_pct, uptime, tor_status, is_cloaked, active_mode, sys_sum)
        else:
            items = self.get_current_items()
            selected_idx = self.selected_indices[self.current_tab]
            self.draw_item_list(body_start_y, avail_lines, w, items, selected_idx, tab_id)

        # ── 4. Notification Status Bar ─────────────────────────────────────────
        status_y = h - 2
        status_style = curses.color_pair(10) if "!" in self.status_msg else (curses.color_pair(8) if "✓" in self.status_msg else curses.color_pair(9))
        bar_text = f" STATUS: {self.status_msg} "
        self.safe_addstr(status_y, 2, bar_text.ljust(w - 4), status_style | curses.A_BOLD)

        # ── 5. Bottom Key Legend Footer ────────────────────────────────────────
        footer_y = h - 1
        legend = " [Tab/1-5: Views] [↑/↓: Select] [Enter: Run] [Key: Quick-Run] [R: Refresh] [?: Help] [Q: Exit] "
        self.safe_addstr(footer_y, max(0, (w - len(legend)) // 2), legend, curses.color_pair(7) | curses.A_BOLD)

        # ── 6. Help Modal Overlay (if toggled) ─────────────────────────────────
        if self.show_help:
            self.draw_help_modal(h, w)

        self.stdscr.refresh()

    def draw_tab_telemetry(self, start_y: int, max_h: int, w: int, cpu_pct: float, loads: List[float], cores: int, cpu_model: str, ram_used: float, ram_total: float, ram_pct: float, swap_used: float, swap_total: float, disk_used: float, disk_total: float, disk_free: float, disk_pct: float, uptime: str, tor_status: str, is_cloaked: bool, active_mode: str, sys_sum: Dict[str, str]) -> None:
        y = start_y
        c_green = curses.color_pair(1) | curses.A_BOLD
        c_gold = curses.color_pair(2) | curses.A_BOLD
        c_cyan = curses.color_pair(3) | curses.A_BOLD
        c_red = curses.color_pair(4) | curses.A_BOLD
        c_dim = curses.color_pair(6) | curses.A_DIM
        c_bold = curses.A_BOLD

        # Telemetry Box Header
        self.safe_addstr(y, 2, "┌── [ HARDWARE SENSORS & SYSTEM HEALTH TELEMETRY ] " + ("─" * max(0, w - 53)) + "┐", c_cyan)
        y += 1

        # CPU Row
        cpu_bar = render_meter(cpu_pct, 14)
        cpu_text = f"CPU Load  [{cpu_bar}] {cpu_pct:5.1f}%  (Load: {loads[0]:.2f}, {loads[1]:.2f}, {loads[2]:.2f}) │ {cores} Cores"
        self.safe_addstr(y, 4, cpu_text, c_green if cpu_pct < 75 else c_red)
        y += 1

        # RAM Row
        ram_bar = render_meter(ram_pct, 14)
        ram_text = f"RAM Memory[{ram_bar}] {ram_pct:5.1f}%  ({ram_used:.1f} GB / {ram_total:.1f} GB Used)"
        self.safe_addstr(y, 4, ram_text, c_green if ram_pct < 80 else c_gold)
        y += 1

        # Disk Row
        disk_bar = render_meter(disk_pct, 14)
        disk_text = f"Disk Root [{disk_bar}] {disk_pct:5.1f}%  ({disk_used:.1f} GB / {disk_total:.1f} GB, {disk_free:.1f} GB Free)"
        self.safe_addstr(y, 4, disk_text, c_cyan)
        y += 1

        # Tor & Network Row
        net = self.metrics.get_net_info()
        tor_attr = c_green if is_cloaked else c_red
        net_text = f"Net Link  : {net['ip']} ({net['iface']}) -> GW: {net['gw']} │ TOR: {tor_status}"
        self.safe_addstr(y, 4, net_text, tor_attr)
        y += 1

        # Uptime & Host Details
        self.safe_addstr(y, 4, f"Node Specs: {cpu_model} │ Kernel: {sys_sum['kernel']} ({sys_sum['arch']}) │ Up: {uptime}", c_dim)
        y += 1
        self.safe_addstr(y, 2, "└" + ("─" * (w - 6)) + "┘", c_cyan)
        y += 2

        # Core System Utilities Section
        self.safe_addstr(y, 2, "┌── [ CORE OPERATIONAL INSTRUMENTS & SELF-HEALING ] " + ("─" * max(0, w - 54)) + "┐", c_gold)
        y += 1

        items = CORE_SYSTEM_TOOLS
        selected_idx = self.selected_indices[0]

        for i, item in enumerate(items):
            if y >= start_y + max_h:
                break
            is_sel = (i == selected_idx)
            is_avail = tool_available(item["bin"], item.get("alt_bin"))
            status_text = "✓ READY" if is_avail else "○ NOT FOUND"
            status_attr = c_green if is_avail else c_dim

            pointer = "▶ " if is_sel else "  "
            row_attr = (curses.color_pair(7) | curses.A_BOLD) if is_sel else 0

            hotkey = f"[{item['key'].upper()}]"
            name = item['name']
            desc = item['desc']

            line_str = f"{pointer}{hotkey} {name:<18} {status_text:<12} {desc}"
            if is_sel:
                self.safe_addstr(y, 4, line_str.ljust(w - 8), row_attr)
            else:
                self.safe_addstr(y, 4, f"{pointer}{hotkey}", c_gold)
                self.safe_addstr(y, 9, f"{name:<18}", c_bold)
                self.safe_addstr(y, 28, f"{status_text:<12}", status_attr)
                if w >= 80:
                    self.safe_addstr(y, 42, f"↳ {desc}", c_dim)
            y += 1

        self.safe_addstr(y, 2, "└" + ("─" * (w - 6)) + "┘", c_gold)

    def draw_item_list(self, start_y: int, max_h: int, w: int, items: List[Dict[str, Any]], selected_idx: int, tab_id: str) -> None:
        y = start_y
        c_green = curses.color_pair(1) | curses.A_BOLD
        c_gold = curses.color_pair(2) | curses.A_BOLD
        c_cyan = curses.color_pair(3) | curses.A_BOLD
        c_red = curses.color_pair(4) | curses.A_BOLD
        c_purple = curses.color_pair(5) | curses.A_BOLD
        c_dim = curses.color_pair(6) | curses.A_DIM
        c_bold = curses.A_BOLD

        tab_titles = {
            "ai": ("FRONTIER & LOCAL NEURAL AI ARSENAL", c_purple),
            "security": ("OFFENSIVE & DEFENSIVE CYBER ARSENAL", c_red),
            "studio": ("ZOTH STUDIO SERVICES & QUANTUM DAEMONS", c_gold),
            "profiles": ("ENVIRONMENT & STEALTH REALITY SWITCHER", c_cyan),
        }
        title_text, box_col = tab_titles.get(tab_id, ("OPERATIONS", c_gold))

        self.safe_addstr(y, 2, f"┌── [ {title_text} ] " + ("─" * max(0, w - len(title_text) - 10)) + "┐", box_col)
        y += 1

        active_mode = self.metrics.get_active_mode().lower()

        # Handle vertical scrolling if items exceed max_h
        items_area_h = max_h - 2
        offset = self.scroll_offsets[self.current_tab]

        if selected_idx < offset:
            offset = selected_idx
        elif selected_idx >= offset + items_area_h:
            offset = selected_idx - items_area_h + 1
        self.scroll_offsets[self.current_tab] = offset

        visible_items = items[offset: offset + items_area_h]

        for i, item in enumerate(visible_items):
            actual_idx = offset + i
            is_sel = (actual_idx == selected_idx)
            pointer = "▶ " if is_sel else "  "
            row_attr = (curses.color_pair(7) | curses.A_BOLD) if is_sel else 0

            hotkey = f"[{item['key'].upper()}]"
            name = item["name"]
            desc = item.get("desc", "")

            # Determine live status text
            if tab_id == "profiles":
                is_active = (active_mode == item["id"].lower())
                status_text = "● ACTIVE" if is_active else "○ IDLE"
                status_attr = (curses.color_pair(8) | curses.A_BOLD) if is_active else c_dim
            elif tab_id == "studio":
                is_up = check_port(item["port"]) or (item.get("alt_port") and check_port(item["alt_port"]))
                status_text = f"● ONLINE :{item['port']}" if is_up else f"○ OFFLINE :{item['port']}"
                status_attr = c_green if is_up else c_dim
            elif tab_id == "ai":
                if item.get("port", 0) > 0:
                    is_up = check_port(item["port"])
                    status_text = f"● ONLINE :{item['port']}" if is_up else f"○ OFFLINE"
                    status_attr = c_green if is_up else c_dim
                elif item.get("gui") or item.get("type") in ["bin", "gui"]:
                    avail = tool_available(item["bin"], item.get("alt_bin"))
                    status_text = "✓ INSTALLED" if avail else "○ NOT IN PATH"
                    status_attr = c_green if avail else c_dim
                else:
                    ready = tool_available(item.get("bin", "")) or python_pkg_available(item.get("pkg", ""))
                    status_text = "✓ READY" if ready else "○ AVAILABLE"
                    status_attr = c_green if ready else c_dim
            elif tab_id == "security":
                avail = tool_available(item["bin"], item.get("alt_bin"))
                status_text = "✓ INSTALLED" if avail else "○ APT AVAILABLE"
                status_attr = c_green if avail else c_dim
            else:
                status_text = "✓ READY"
                status_attr = c_green

            line_str = f"{pointer}{hotkey} {name:<22} {status_text:<18} {desc}"
            if is_sel:
                self.safe_addstr(y, 4, line_str.ljust(w - 8), row_attr)
            else:
                self.safe_addstr(y, 4, f"{pointer}{hotkey}", box_col)
                self.safe_addstr(y, 9, f"{name:<22}", c_bold)
                self.safe_addstr(y, 32, f"{status_text:<18}", status_attr)
                if w >= 80:
                    self.safe_addstr(y, 52, f"↳ {desc}", c_dim)
            y += 1

        self.safe_addstr(y, 2, "└" + ("─" * (w - 6)) + "┘", box_col)

        # Context action tip at bottom of list
        y += 1
        if tab_id == "studio" and y < start_y + max_h:
            tip = " [Tip: Press 'A' to start all studio daemons, 'K' to stop, 'W' to open web UI, 'Enter' to probe] "
            self.safe_addstr(y, max(2, (w - len(tip)) // 2), tip, c_dim)
        elif tab_id == "profiles" and y < start_y + max_h:
            tip = " [Tip: Press 1-4 or Enter to engage reality profile instantly] "
            self.safe_addstr(y, max(2, (w - len(tip)) // 2), tip, c_dim)

    def draw_help_modal(self, h: int, w: int) -> None:
        """Renders interactive help modal over the center of the screen."""
        box_w = min(74, w - 6)
        box_h = min(20, h - 4)
        top = (h - box_h) // 2
        left = (w - box_w) // 2

        c_gold = curses.color_pair(2) | curses.A_BOLD
        c_green = curses.color_pair(1) | curses.A_BOLD
        c_cyan = curses.color_pair(3) | curses.A_BOLD
        c_dim = curses.color_pair(6) | curses.A_DIM

        # Draw box frame
        self.safe_addstr(top, left, "╔" + ("═" * (box_w - 2)) + "╗", c_gold)
        for cur_y in range(top + 1, top + box_h - 1):
            self.safe_addstr(cur_y, left, "║" + (" " * (box_w - 2)) + "║", c_gold)
        self.safe_addstr(top + box_h - 1, left, "╚" + ("═" * (box_w - 2)) + "╝", c_gold)

        title = " ◈ ZOTHOS COCKPIT KEYBOARD NAVIGATION & ACTIONS ◈ "
        self.safe_addstr(top, left + max(0, (box_w - len(title)) // 2), title, curses.color_pair(7) | curses.A_BOLD)

        lines = [
            ("", 0),
            ("  [Tab] / [Shift+Tab]   : Switch between Cockpit Tabs / Views", c_cyan),
            ("  [1] - [5]             : Jump straight to Tab (Telemetry, AI, Sec, Daemons, Modes)", c_cyan),
            ("  [←] / [→]             : Cycle tabs Left / Right", c_cyan),
            ("  [↑] / [↓]             : Navigate selection cursor smoothly through tools", c_green),
            ("  [Enter]               : Launch / Execute the highlighted tool or action", c_green),
            ("  [Bracketed Key]       : Direct hotkey (e.g. 'O' for Ollama, 'C' for Caido)", c_gold),
            ("  [R] / [F5]            : Force refresh hardware telemetry and port probes", c_cyan),
            ("  [?] / [H]             : Toggle this help guide overlay", c_gold),
            ("  [Q] / [Esc]           : Exit Cockpit cleanly back to terminal", c_gold),
            ("", 0),
            ("  Studio Tab Shortcuts:", c_gold),
            ("    'A' -> Bring up all background studio daemons (zoth up)", c_dim),
            ("    'K' -> Stop background studio daemons (zoth down)", c_dim),
            ("    'W' -> Open live Studio Web UI in browser (127.0.0.1:3000)", c_dim),
            ("", 0),
            ("  Press any key to close this guide...", curses.color_pair(8) | curses.A_BOLD),
        ]

        for i, (l_text, attr) in enumerate(lines):
            cur_line_y = top + 1 + i
            if cur_line_y < top + box_h - 1:
                self.safe_addstr(cur_line_y, left + 2, l_text[:box_w - 4], attr)

    def run(self) -> None:
        curses.curs_set(0)
        self.stdscr.nodelay(True)
        self.stdscr.timeout(1000)  # Refresh loop every 1s
        self.init_colors()

        while self.running:
            self.draw()
            try:
                ch = self.stdscr.getch()
                if ch != -1:
                    self.handle_input(ch)
            except KeyboardInterrupt:
                break
            except Exception as e:
                self.notify(f"UI Error: {e}")
                time.sleep(0.5)


def curses_main(stdscr: curses.window, initial_tab: int = 0) -> None:
    app = CockpitTUI(stdscr, initial_tab=initial_tab)
    app.run()


# ═══════════════════════════════════════════════════════════════════════════════
# Main Entrypoint & CLI Parsing
# ═══════════════════════════════════════════════════════════════════════════════

def main() -> int:
    parser = argparse.ArgumentParser(
        description="ZOTHOS Cockpit - Sovereign Interactive Operations Dashboard v2.0"
    )
    parser.add_argument(
        "--status",
        "--headless",
        action="store_true",
        help="Print real-time system metrics, AI engines, and daemon statuses directly to stdout",
    )
    parser.add_argument(
        "--json",
        action="store_true",
        help="Dump complete system metrics and services as machine-readable JSON",
    )
    parser.add_argument(
        "--tab",
        type=int,
        default=0,
        choices=[1, 2, 3, 4, 5],
        help="Start directly in specific tab (1: Telemetry, 2: AI Stack, 3: Security, 4: Studio, 5: Profiles)",
    )
    parser.add_argument(
        "--version",
        "-v",
        action="version",
        version=f"zoth-cockpit {VERSION}",
    )
    args = parser.parse_args()

    if args.json:
        dump_json_status()
        return 0

    if args.status or not sys.stdin.isatty():
        render_headless_status()
        return 0

    tab_index = (args.tab - 1) if args.tab > 0 else 0

    try:
        curses.wrapper(curses_main, initial_tab=tab_index)
    except KeyboardInterrupt:
        pass
    except Exception as e:
        print(f"Error initializing curses interface: {e}", file=sys.stderr)
        render_headless_status()
        return 1

    return 0


if __name__ == "__main__":
    sys.exit(main())
