#!/usr/bin/env python3
"""CWV Speed Engine v2.6.0 — Genuine Unicode U+2800 Braille Core Web Vitals TUI.

Imports cwv_speed_engine directly to audit real HTML files, render a Unicode U+2800
Braille speedometer gauge & vital bar meters, inspect diagnostics, and probe :8128/health.
Engineered by Neal Frazier Tech (@1nc0gn30) • NullAI Platform
"""

from __future__ import annotations

import argparse
import json
import math
import os
import sys
import time
import urllib.request
from pathlib import Path
from typing import Any, Dict, Optional

VERSION = "2.6.0"
BRAILLE_BASE = 0x2800


def _resolve_root() -> Path:
    candidates = []
    if os.environ.get("CWV_SPEED_HOME"):
        candidates.append(Path(os.environ["CWV_SPEED_HOME"]).expanduser())
    candidates.append(Path("/opt/cwv-speed-engine"))
    candidates.append(Path(__file__).resolve().parent.parent)
    candidates.append(Path.home() / "NullAITech" / "cwv-speed-engine")
    for cand in candidates:
        if (cand / "src" / "cwv_speed_engine").is_dir():
            return cand.resolve()
    return Path("/opt/cwv-speed-engine")


def _portable_path(p: Path) -> str:
    s = str(p)
    home = str(Path.home())
    if home and s.startswith(home):
        return "~" + s[len(home):]
    return s


ROOT_DIR = _resolve_root()
SRC_DIR = ROOT_DIR / "src"
if SRC_DIR.is_dir() and str(SRC_DIR) not in sys.path:
    sys.path.insert(0, str(SRC_DIR))

from cwv_speed_engine.ui_server import audit_html_content  # noqa: E402


def render_braille_gauge(score: int, width_cols: int = 22, height_rows: int = 5) -> list[str]:
    """Render a real Unicode U+2800 2x4 sub-pixel Braille semicircular CWV speedometer gauge."""
    px_w = width_cols * 2
    px_h = height_rows * 4
    grid = [[False] * px_w for _ in range(px_h)]

    cx = (px_w - 1) / 2.0
    cy = px_h - 2.0
    r_outer = min(cx - 1.0, cy - 0.5)
    r_inner = max(2.0, r_outer - 3.0)

    # Semicircle arc from 180 deg (left) to 0 deg (right)
    clamped = max(0, min(100, int(score)))
    fill_deg = 180.0 - (clamped / 100.0) * 180.0

    for y in range(px_h):
        for x in range(px_w):
            dx = x - cx
            dy = cy - y
            if dy < 0:
                continue
            dist = math.hypot(dx, dy)
            if r_inner <= dist <= r_outer:
                deg = math.degrees(math.atan2(dy, dx))
                # Draw full track outline faintly + filled score arc
                if deg >= fill_deg or abs(dist - r_outer) < 0.7:
                    grid[y][x] = True

    # Draw needle pointing to score angle
    needle_rad = math.radians(fill_deg)
    for step in range(int(r_inner)):
        nx = int(round(cx + math.cos(needle_rad) * step))
        ny = int(round(cy - math.sin(needle_rad) * step))
        if 0 <= nx < px_w and 0 <= ny < px_h:
            grid[ny][nx] = True

    dot_bits = (
        (0, 0, 0x01), (0, 1, 0x02), (0, 2, 0x04), (0, 3, 0x40),
        (1, 0, 0x08), (1, 1, 0x10), (1, 2, 0x20), (1, 3, 0x80),
    )
    lines = []
    for row in range(height_rows):
        chars = []
        for col in range(width_cols):
            mask = 0
            for dx, dy, bit in dot_bits:
                if grid[row * 4 + dy][col * 2 + dx]:
                    mask |= bit
            chars.append(chr(BRAILLE_BASE | mask))
        lines.append("".join(chars))
    return lines


def braille_meter(ratio: float, width: int = 16) -> str:
    """Render a compact Unicode U+2800 Braille horizontal fill bar."""
    filled = max(0, min(width, int(round(ratio * width))))
    return ("⣿" * filled) + ("⣀" * (width - filled))


def probe_local_server(port: int = 8128) -> Dict[str, Any]:
    """Probe http://127.0.0.1:8128/health with a fast 0.35s timeout."""
    url = f"http://127.0.0.1:{port}/health"
    try:
        with urllib.request.urlopen(url, timeout=0.35) as resp:
            data = json.loads(resp.read().decode("utf-8"))
            return {"active": True, "status": data.get("status", "healthy"), "version": data.get("version", VERSION)}
    except Exception:
        return {"active": False, "status": "IDLE", "version": VERSION}


def load_target_html(file_arg: Optional[str]) -> tuple[str, str]:
    if file_arg:
        p = Path(file_arg).expanduser()
        if p.is_file():
            return p.read_text(encoding="utf-8", errors="replace"), _portable_path(p.resolve())
    default_html = ROOT_DIR / "public" / "index.html"
    if default_html.is_file():
        return default_html.read_text(encoding="utf-8", errors="replace"), "public/index.html"
    sample = "<!DOCTYPE html><html><head><title>Sample</title><script src='/app.js'></script></head><body><img src='/hero.png'></body></html>"
    return sample, "builtin-sample.html"


def render_frame(report: Dict[str, Any], target_label: str, server_state: Dict[str, Any], elapsed_ms: float) -> str:
    score = report["score"]
    rating = report["rating"]
    device = report["device"].upper()
    m = report["metrics"]
    gauge_lines = render_braille_gauge(score)

    srv_badge = (
        f"\033[32m● :8128 ACTIVE (v{server_state['version']})\033[0m"
        if server_state["active"]
        else "\033[33m○ :8128 IDLE (on-demand)\033[0m"
    )
    score_col = "\033[32m" if score >= 90 else ("\033[33m" if score >= 50 else "\033[31m")

    out = [
        "\033[1;33m╭────────────────────────────────────────────────────────────────────────────╮\033[0m",
        f"\033[1;33m│\033[0m ⚡ \033[1;37mCWV Speed Engine v{VERSION} Braille TUI\033[0m   │  {srv_badge:<36} \033[1;33m│\033[0m",
        "\033[1;33m├────────────────────────────────────────────────────────────────────────────┤\033[0m",
        f"\033[1;33m│\033[0m Target: \033[36m{target_label[:38]:<38}\033[0m Device: \033[1m{device:<8}\033[0m ({elapsed_ms:.2f}ms) \033[1;33m│\033[0m",
    ]

    vital_rows = [
        f"Score : {score_col}{score:3d}/100 ({rating})\033[0m",
        f"LCP   : {m['lcp']['value']:>5}s  {braille_meter(min(1.0, m['lcp']['value']/4.0), 12)} [{m['lcp']['rating']}]",
        f"CLS   : {m['cls']['value']:>5}   {braille_meter(min(1.0, m['cls']['value']/0.25), 12)} [{m['cls']['rating']}]",
        f"INP   : {m['inp']['value']:>4}ms  {braille_meter(min(1.0, m['inp']['value']/500.0), 12)} [{m['inp']['rating']}]",
        f"FCP   : {m['fcp']['value']:>5}s  TTFB: {m['ttfb']['value']}ms",
    ]
    for g_line, v_line in zip(gauge_lines, vital_rows):
        out.append(f"\033[1;33m│\033[0m  {score_col}{g_line}\033[0m   {v_line}")

    out.append("\033[1;33m├────────────────────────────────────────────────────────────────────────────┤\033[0m")
    diags = report.get("diagnostics", [])[:4]
    for d in diags:
        sev = d.get("severity", "INFO")
        title = d.get("title", "")[:58]
        out.append(f"\033[1;33m│\033[0m  [{sev:<8}] {title:<61} \033[1;33m│\033[0m")
    out.append("\033[1;33m╰────────────────────────────────────────────────────────────────────────────╯\033[0m")
    out.append("  Engineered by Neal Frazier Tech (@1nc0gn30) • NullAI Platform")
    return "\n".join(out)


def main() -> None:
    ap = argparse.ArgumentParser(description=f"CWV Speed Engine v{VERSION} Braille TUI")
    ap.add_argument("--file", default=None, help="HTML file path to audit")
    ap.add_argument("--device", default="mobile", choices=["mobile", "desktop"], help="Device simulation profile")
    ap.add_argument("--once", action="store_true", help="Render one frame and exit")
    ap.add_argument("--json", action="store_true", help="Output deterministic JSON CWV telemetry and exit")
    ap.add_argument("--status", action="store_true", help="Output status JSON and exit")
    ap.add_argument("--version", action="version", version=f"cwv-speed-engine-tui v{VERSION}")
    args, _unknown = ap.parse_known_args()

    t0 = time.perf_counter()
    html_text, target_label = load_target_html(args.file)
    report = audit_html_content(html_text, device=args.device, url_context=target_label)
    elapsed_ms = round((time.perf_counter() - t0) * 1000.0, 2)
    server_state = probe_local_server(8128)
    gauge = render_braille_gauge(report["score"])

    if args.json or args.status:
        payload = {
            "tool": "cwv-speed-engine-tui",
            "version": VERSION,
            "target": target_label,
            "device": report["device"],
            "score": report["score"],
            "rating": report["rating"],
            "metrics": report["metrics"],
            "summary": report["summary"],
            "diagnostics_count": len(report.get("diagnostics", [])),
            "server_8128": server_state,
            "audit_elapsed_ms": elapsed_ms,
            "braille_gauge": gauge,
            "attribution": "Engineered by Neal Frazier Tech (@1nc0gn30) • NullAI Platform",
        }
        print(json.dumps(payload, indent=2))
        return

    if args.once or not sys.stdin.isatty():
        print(render_frame(report, target_label, server_state, elapsed_ms))
        return

    # Interactive mode (r=refresh, d=toggle device, q=quit)
    device = args.device
    try:
        while True:
            t_start = time.perf_counter()
            html_text, target_label = load_target_html(args.file)
            rep = audit_html_content(html_text, device=device, url_context=target_label)
            el = round((time.perf_counter() - t_start) * 1000.0, 2)
            srv = probe_local_server(8128)
            print("\033[2J\033[H" + render_frame(rep, target_label, srv, el))
            print("  Keys: [d] toggle mobile/desktop · [r] refresh · [q] quit > ", end="", flush=True)
            ch = sys.stdin.readline().strip().lower()
            if ch in ("q", "quit", "exit"):
                break
            if ch == "d":
                device = "desktop" if device == "mobile" else "mobile"
    except (KeyboardInterrupt, EOFError):
        pass


if __name__ == "__main__":
    main()
