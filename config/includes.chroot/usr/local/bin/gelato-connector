#!/usr/bin/env python3
"""Gelato Connector Executable Launcher.

Engineered by 1nc0gn30 (@1nc0gn30) • NullAI Platform.
100% Python Standard Library — Zero External Runtime Dependencies.
"""

# zothos-repo-shim: run the canonical repo copy so repo-relative paths resolve
import os as _os, sys as _sys
_here = _os.path.realpath(__file__)
_repo = _os.environ.get("ZOTH_REPO_DIR") or '/home/zoth/NullAITech' + "/" + 'gelato-connector'
_real = _os.path.join(_repo, "bin", 'gelato-connector')
if _os.path.exists(_real) and _os.path.realpath(_real) != _here:
    _os.execv(_sys.executable, [_sys.executable, _real] + _sys.argv[1:])
del _os, _sys, _here, _repo, _real


import os
import sys

# Add src to sys.path
root_dir = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
src_dir = os.path.join(root_dir, "src")
if src_dir not in sys.path:
    sys.path.insert(0, src_dir)

from gelato_connector.cli import main

if __name__ == "__main__":
    main()
