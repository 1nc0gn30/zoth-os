#!/usr/bin/env bash
# ==============================================================================
#  Tor Browser Sovereign Launcher - ZothOS Privacy Core
# ==============================================================================
set -euo pipefail

# 1. System-wide pre-installed Tor Browser bundle in /opt/tor-browser
if [[ -x "/opt/tor-browser/Browser/start-tor-browser" ]]; then
    cd /opt/tor-browser/Browser
    exec ./start-tor-browser "$@"
fi

# 2. User-specific Tor Browser bundle
if [[ -x "$HOME/.local/share/torbrowser/tbb/x86_64/tor-browser/Browser/start-tor-browser" ]]; then
    cd "$HOME/.local/share/torbrowser/tbb/x86_64/tor-browser/Browser"
    exec ./start-tor-browser "$@"
fi

# 3. torbrowser-launcher utility
if command -v torbrowser-launcher >/dev/null 2>&1; then
    exec torbrowser-launcher "$@"
fi

# 4. Standard Debian /usr/bin/tor-browser (avoid self-reference)
if [[ -x "/usr/bin/tor-browser" && "$(readlink -f /usr/bin/tor-browser 2>/dev/null || true)" != "$(readlink -f "$0" 2>/dev/null || true)" ]]; then
    exec /usr/bin/tor-browser "$@"
fi

echo -e "\e[1;33m[*] Tor Browser bundle not found in /opt or ~/.local/share.\e[0m"
echo -e "\e[1;36m[*] Launching installation via torbrowser-launcher...\e[0m"
sudo apt-get update && sudo apt-get install -y torbrowser-launcher && exec torbrowser-launcher "$@"
