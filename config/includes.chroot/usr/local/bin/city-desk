#!/usr/bin/env python3
import sys, os, json, subprocess, argparse, urllib.request, urllib.error

TOOL_ID = 'city-desk'
TOOL_REPO = 'city-desk'
TOOL_NAME = 'City Desk'
TOOL_DESC = '1,000 localized service landing pages across 20 trades and 50 mid-size cities with live customizer and standalone HTML export.'
TOOL_VERSION = '2.5.0'
TOOL_CATEGORY = 'Growth & SEO'
TOOL_PORT = 8087
REPO_DIR = os.path.expanduser('~/NullAITech/city-desk')
SERVER_SCRIPT = os.path.join(REPO_DIR, 'server.py')
BUILD_SCRIPT = os.path.join(REPO_DIR, 'build.js')
STUDIO_URL = f"http://127.0.0.1:3000/tools/{TOOL_ID}"
LOCAL_PORT_URL = f"http://127.0.0.1:{TOOL_PORT}"

def check_daemon_status():
    try:
        req = urllib.request.Request(f"{LOCAL_PORT_URL}/health", headers={"User-Agent": "ZothOS-CLI"})
        with urllib.request.urlopen(req, timeout=1.5) as resp:
            if resp.status == 200:
                data = json.loads(resp.read().decode('utf-8'))
                return True, data
    except Exception:
        pass
    return False, None

def query_endpoint(endpoint):
    try:
        req = urllib.request.Request(f"{LOCAL_PORT_URL}{endpoint}", headers={"User-Agent": "ZothOS-CLI"})
        with urllib.request.urlopen(req, timeout=2.0) as resp:
            return json.loads(resp.read().decode('utf-8'))
    except Exception as e:
        return {"status": "error", "message": str(e)}

def main():
    parser = argparse.ArgumentParser(
        prog='city-desk',
        description=f"{TOOL_NAME} (v{TOOL_VERSION}) — {TOOL_DESC}"
    )
    parser.add_argument('--version', action='version', version=f"{TOOL_ID} v{TOOL_VERSION}")
    parser.add_argument('--status', action='store_true', help='Check local ZothOS installation & daemon status')
    parser.add_argument('--json', action='store_true', help='Output deterministic JSON telemetry')
    parser.add_argument('--ui', action='store_true', help='Print local ZothOS workbench URL')
    parser.add_argument('--trades', action='store_true', help='List all 20 supported trade services')
    parser.add_argument('--cities', action='store_true', help='List all 50 target municipal cities')
    parser.add_argument('--build', action='store_true', help='Rebuild all 1,000 localized landing pages')
    parser.add_argument('--serve', action='store_true', help='Start background daemon server on port 8087')

    args = parser.parse_args()

    is_running, daemon_data = check_daemon_status()

    if args.serve:
        if is_running:
            print(f"City Desk daemon already active on {LOCAL_PORT_URL}")
            return
        subprocess.run([sys.executable, SERVER_SCRIPT, "--port", str(TOOL_PORT)])
        return

    if args.build:
        print("✦ Rebuilding 1,000 City Desk localized landing pages...")
        res = subprocess.run(["node", BUILD_SCRIPT], cwd=REPO_DIR)
        sys.exit(res.returncode)

    if args.trades:
        data = query_endpoint("/api/trades")
        if args.json:
            print(json.dumps(data, indent=2))
        else:
            trades = data.get("trades", [])
            print(f"✦ City Desk Supported Trades ({len(trades)} total):")
            for t in trades:
                print(f"  - {t['name'].ljust(15)}: ${t['price']} — {t['line']}")
        return

    if args.cities:
        data = query_endpoint("/api/cities")
        if args.json:
            print(json.dumps(data, indent=2))
        else:
            cities = data.get("cities", [])
            print(f"✦ City Desk Target Cities ({len(cities)} total):")
            for c in cities:
                print(f"  - {c['name']}, {c['state']} ({c['slug']})")
        return

    info = {
        "id": TOOL_ID,
        "repo": TOOL_REPO,
        "name": TOOL_NAME,
        "version": TOOL_VERSION,
        "category": TOOL_CATEGORY,
        "installed": os.path.exists(REPO_DIR),
        "repo_path": REPO_DIR,
        "daemon_running": is_running,
        "total_pages": 1000,
        "studio_workbench_url": STUDIO_URL,
        "local_endpoint": LOCAL_PORT_URL,
        "daemon_telemetry": daemon_data,
        "license": "100% Free & Open Access (Zero Paywalls)"
    }

    if args.json:
        print(json.dumps(info, indent=2))
    elif args.ui:
        print(LOCAL_PORT_URL)
    else:
        print(f"=====================================================")
        print(f"  {TOOL_NAME} (v{TOOL_VERSION})")
        print(f"  {TOOL_DESC}")
        print(f"=====================================================")
        print(f"  Installed:       {'Yes' if info['installed'] else 'No'}")
        print(f"  Daemon Port:     {LOCAL_PORT_URL} ({'Running' if is_running else 'Offline'})")
        print(f"  Pages Indexed:   1,000 (20 Trades × 50 Cities)")
        print(f"  Studio Route:    {STUDIO_URL}")
        print(f"  License:         100% Free & Open Access (Zero Paywalls)")
        print(f"  Coffee Tip:      https://buy.stripe.com/3cIfZg27PdKo2D64Ocfw40X")
        print(f"  Solana Tip:      GG2eQbVh8ut1BK6j1A2tz7pSySdLpD38BgyEhGcxdXoK")
        print(f"-----------------------------------------------------")
        print(f"Usage:")
        print(f"  city-desk --status")
        print(f"  city-desk --trades")
        print(f"  city-desk --cities")
        print(f"  city-desk --build")
        print(f"  city-desk --json")
        print(f"=====================================================")

if __name__ == '__main__':
    main()
