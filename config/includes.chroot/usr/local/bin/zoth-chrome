#!/usr/bin/env bash
# ==============================================================================
#  ZOTH CHROME WEB ENGINE LAUNCHER
#  Resilient enterprise launcher with sandbox detection & fallbacks
# ==============================================================================

FLAGS=(
    "--no-sandbox"
    "--test-type"
    "--disable-dev-shm-usage"
    "--password-store=basic"
    "--no-first-run"
    "--no-default-browser-check"
)

# Software rendering on VMs / systems without a GPU render node, otherwise
# Chrome/Chromium can show blank/black pages ("doesn't load") on virtual GL.
if [[ -r /usr/lib/zothos/gfx-compat.sh ]]; then
    . /usr/lib/zothos/gfx-compat.sh
    mapfile -t _GFX < <(zoth_chromium_gfx_flags)
    FLAGS+=("${_GFX[@]}")
fi

CHROME_BINS=(
    "/usr/bin/google-chrome-stable"
    "/usr/bin/google-chrome"
    "/opt/google/chrome/google-chrome"
    "/opt/google/chrome/chrome"
    "/usr/bin/chromium"
    "/usr/bin/chromium-browser"
)

SELF_REAL="$(readlink -f "$0" 2>/dev/null || echo "$0")"
for b in "${CHROME_BINS[@]}"; do
    if [[ -x "$b" ]]; then
        B_REAL="$(readlink -f "$b" 2>/dev/null || echo "$b")"
        if [[ "$B_REAL" != "$SELF_REAL" ]]; then
            exec "$b" "${FLAGS[@]}" "$@"
        fi
    fi
done

# Fallback to Firefox if Chrome is unavailable
if command -v firefox &>/dev/null; then
    exec firefox "$@"
elif command -v firefox-esr &>/dev/null; then
    exec firefox-esr "$@"
else
    notify-send -u critical "Zoth Chrome" "No suitable browser engine found." 2>/dev/null || true
    exit 1
fi
