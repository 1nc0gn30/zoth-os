#!/usr/bin/env bash
# One Electron runtime (/opt/electron, installed by the 0500-zothos-desktop-apps
# build hook) for Maya and the Zoth desktop apps.
# Adds software-rendering flags on VMs / systems without a GPU render node so
# Electron windows don't come up black (see /usr/lib/zothos/gfx-compat.sh).
set -e

# Ensure socket directory exists
if [[ ! -d /tmp/.X11-unix ]]; then
    mkdir -p /tmp/.X11-unix 2>/dev/null || true
    chmod 1777 /tmp/.X11-unix 2>/dev/null || true
fi

ELECTRON_BIN="/opt/electron/electron"
if [[ ! -x "$ELECTRON_BIN" ]]; then
    if [[ -n "${ZOTHOS_SRC:-}" && -x "${ZOTHOS_SRC}/config/includes.chroot/opt/electron/electron" ]]; then
        ELECTRON_BIN="${ZOTHOS_SRC}/config/includes.chroot/opt/electron/electron"
    elif [[ -x "/usr/bin/electron" ]]; then
        ELECTRON_BIN="/usr/bin/electron"
    elif [[ -x "/usr/local/lib/node_modules/electron/dist/electron" ]]; then
        ELECTRON_BIN="/usr/local/lib/node_modules/electron/dist/electron"
    else
        echo "Electron is not installed under /opt/electron." >&2
        notify-send -u critical "ZothOS" "Electron runtime missing (/opt/electron). Reinstall it with: sudo zoth-electron-install" 2>/dev/null || true
        exit 1
    fi
fi
export LD_LIBRARY_PATH="/opt/electron${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

FLAGS=(
    --no-sandbox
    --disable-dev-shm-usage
    --disable-gpu-sandbox
)

# Ozone / Display Server Handling
if [[ -n "${WAYLAND_DISPLAY:-}" ]] && [[ -z "${DISPLAY:-}" ]]; then
    FLAGS+=(
        --ozone-platform=wayland
        --enable-features=UseOzonePlatform,WaylandWindowDecorations
    )
elif [[ -n "${DISPLAY:-}" ]]; then
    FLAGS+=(
        --ozone-platform=x11
    )
else
    FLAGS+=(
        --ozone-platform-hint=auto
        --enable-features=UseOzonePlatform,WaylandWindowDecorations
    )
fi

# GFX Compatibility: VMs or Nouveau or requested software mode
if [[ -r /usr/lib/zothos/gfx-compat.sh ]]; then
    # shellcheck source=/usr/lib/zothos/gfx-compat.sh
    . /usr/lib/zothos/gfx-compat.sh
    while IFS= read -r flag; do
        [[ -n "$flag" ]] && FLAGS+=("$flag")
    done <<< "$(zoth_chromium_gfx_flags)"
fi


if grep -qs "nouveau" /proc/modules 2>/dev/null || [[ "${ZOTH_SOFTWARE_RENDER:-0}" == "1" ]] || [[ "${LIBGL_ALWAYS_SOFTWARE:-0}" == "1" ]]; then
    FLAGS+=(
        --disable-gpu
        --disable-software-rasterizer=false
    )
fi

exec "$ELECTRON_BIN" "${FLAGS[@]}" "$@"
