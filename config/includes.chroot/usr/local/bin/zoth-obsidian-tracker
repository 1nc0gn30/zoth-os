#!/usr/bin/env python3
import sys
import os
import argparse
import urllib.request
import json
import webbrowser

PORT = 8151
SERVER_PATH = os.path.expanduser("~/NullAITech/zoth-obsidian-tracker/server.py")

def main():
    parser = argparse.ArgumentParser(description="Zoth Obsidian Arsenal Tracker & Ecosystem Pillars CLI")
    parser.add_argument("--status", action="store_true", help="Check tracker daemon health, pillars, APKs, and tool counts")
    parser.add_argument("--pillars", action="store_true", help="Display the 5 Sovereign Ecosystem Pillars & 7-APK Master Roadmap")
    parser.add_argument("--json", action="store_true", help="Output JSON status payload")
    parser.add_argument("--serve", action="store_true", help="Run standalone server daemon")
    parser.add_argument("--port", type=int, default=PORT, help="Port to run on")
    parser.add_argument("--open", action="store_true", help="Open web app in default browser")
    parser.add_argument("--obsidian", action="store_true", help="Open Obsidian desktop application")
    args = parser.parse_args()

    if args.serve:
        os.system(f"python3 {SERVER_PATH} --port {args.port}")
        return

    if args.open:
        webbrowser.open(f"http://127.0.0.1:{args.port}")
        return

    if args.obsidian:
        os.system("xdg-open 'obsidian://open?vault=Obsidian%20Vault&file=Studio%2FVerification%2FArsenal%20Verification%20%26%20Test%20Tracker'")
        return

    if args.pillars:
        try:
            url = f"http://127.0.0.1:{args.port}/api/pillars"
            req = urllib.request.Request(url, headers={"User-Agent": "ZothObsidianCLI/1.2"})
            with urllib.request.urlopen(req, timeout=2.0) as resp:
                pdata = json.loads(resp.read().decode("utf-8"))
                if args.json:
                    print(json.dumps(pdata, indent=2))
                else:
                    print("🚀 ZOTH SOVEREIGN ECOSYSTEM PILLARS:")
                    for p in pdata.get("pillars", []):
                        print(f"  • {p['title']} [{p['version']}] — {', '.join(p.get('domains', []))}")
                    print("\n📱 1NC0GN30 7-APK MASTER ROADMAP (F-DROID & GOOGLE PLAY):")
                    for a in pdata.get("apk_roadmap", []):
                        print(f"  • {a['app']:<18} ({a['package_id']}) -> {a['status']} [{a['tracks']}]")
                return
        except Exception as e:
            print(f"Error querying /api/pillars: {e}")
            return

    try:
        url = f"http://127.0.0.1:{args.port}/health"
        req = urllib.request.Request(url, headers={"User-Agent": "ZothObsidianCLI/1.2"})
        with urllib.request.urlopen(req, timeout=2.0) as resp:
            data = json.loads(resp.read().decode("utf-8"))
            if args.json:
                print(json.dumps(data, indent=2))
            else:
                print(f"🟢 Zoth Obsidian Tracker: ONLINE (Port :{args.port})")
                print(f"   Verified Tools: {data.get('verified_tools')}/76 (72 Core + 4 Flagships · 100% Free & Open-Access)")
                print(f"   Canon & Wiki Notes: {data.get('canon_wiki_notes')} | JSON Canvases: {data.get('total_canvases')} | Bases: {data.get('total_bases')}")
                print(f"   Ecosystem Pillars: {data.get('ecosystem_pillars', 5)} | Android/WearOS APKs: {data.get('mobile_apks', 7)}")
                print(f"   Vault Path: {data.get('vault')}")
                print(f"   Web Dashboard: http://127.0.0.1:{args.port}")
    except Exception as e:
        if args.json:
            print(json.dumps({"status": "offline", "error": str(e), "port": args.port}))
        else:
            print(f"🟡 Zoth Obsidian Tracker daemon offline on port :{args.port}.")
            print(f"   Run '{parser.prog} --serve' or 'python3 {SERVER_PATH} --port {args.port}' to start.")

if __name__ == "__main__":
    main()
