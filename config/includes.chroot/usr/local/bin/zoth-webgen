#!/usr/bin/env bash
# ==============================================================================
#  Zoth WebGen Foundry — One-Shot Idea to Live Netlify Deploy & Template Engine
# ==============================================================================
set -eo pipefail

GOLD='\033[38;2;212;175;55m'
CYAN='\033[38;2;56;189;248m'
GREEN='\033[38;2;52;211;153m'
RED='\033[38;2;248;113;113m'
DIM='\033[38;2;148;163;184m'
BOLD='\033[1m'
NC='\033[0m'

CANDIDATES=(
  "${ZOTH_SRC_ROOT}/zoth-webgen"
  "${HOME}/NullAITech/zoth-webgen"
  "/opt/zoth-webgen"
  "${HOME}/zoth-webgen"
)
REPO_DIR=""
for c in "${CANDIDATES[@]}"; do
  if [[ -d "$c" && -f "$c/webgen_engine.py" ]]; then
    REPO_DIR="$c"
    break
  fi
done

if [[ -z "$REPO_DIR" || ! -d "$REPO_DIR" ]]; then
  echo -e "${GOLD}[*] Cloning Zoth WebGen from sovereign repo...${NC}"
  mkdir -p "${HOME}/NullAITech"
  git clone https://github.com/NullAITech/zoth-webgen.git "${HOME}/NullAITech/zoth-webgen"
  REPO_DIR="${HOME}/NullAITech/zoth-webgen"
fi

cd "$REPO_DIR"

ensure_server() {
  local port="${1:-8092}"
  if ! curl -s --max-time 1.5 "http://127.0.0.1:${port}/api/health" | grep -q "zoth-webgen" 2>/dev/null; then
    nohup python3 "$REPO_DIR/server.py" --port "$port" >/tmp/zoth-webgen-server.log 2>&1 &
    sleep 0.8
  fi
}

open_studio_ui() {
  local port="${1:-8092}"
  ensure_server "$port"
  local url="http://127.0.0.1:${port}"
  echo -e "${GREEN}[✓] WebGen Visual Studio active at: ${CYAN}${BOLD}${url}${NC}"
  if [[ -n "${DISPLAY:-}" ]]; then
    if command -v google-chrome >/dev/null 2>&1; then
      nohup google-chrome --app="$url" >/dev/null 2>&1 &
    elif command -v xdg-open >/dev/null 2>&1; then
      nohup xdg-open "$url" >/dev/null 2>&1 &
    fi
  fi
}

# Direct CLI execution when flags or subcommands are passed
if [[ $# -gt 0 ]]; then
  case "$1" in
    web|desktop|gui)
      open_studio_ui "${2:-8092}"
      exit 0
      ;;
    server|daemon)
      exec python3 "$REPO_DIR/server.py" --port "${2:-8092}"
      ;;
    *)
      exec python3 "$REPO_DIR/webgen_engine.py" "$@"
      ;;
  esac
fi

# Interactive Console Menu when launched without arguments
ensure_server 8092

while true; do
  clear
  echo -e "${GOLD}${BOLD}╔══════════════════════════════════════════════════════════════════════════╗${NC}"
  echo -e "${GOLD}${BOLD}║     ⚡ ZOTH WEBGEN FOUNDRY • ONE-SHOT IDEA TO LIVE NETLIFY DEPLOY ⚡     ║${NC}"
  echo -e "${GOLD}${BOLD}╚══════════════════════════════════════════════════════════════════════════╝${NC}"
  echo -e "  ${DIM}Studio Server:${NC} ${GREEN}ONLINE${NC} (${CYAN}http://127.0.0.1:8092${NC})"
  echo -e "  ${DIM}Templates:${NC}     ${GOLD}58 Sovereign Production Apps${NC} + ${CYAN}182 100-Websites Presets${NC}"
  echo -e "  ${DIM}Visual FX:${NC}     ${GREEN}@teknium Uncommon Web Shaders (Braille / Dither / ASCII / Constellation)${NC}\n"

  echo -e "  ${GOLD}${BOLD}SELECT OPERATION:${NC}"
  echo -e "    ${CYAN}[1]${NC} ${BOLD}⚡ One-Shot Idea → Synthesize & Deploy LIVE to Netlify${NC}"
  echo -e "    ${CYAN}[2]${NC} ${BOLD}🔥 One-Shot Idea → Synthesize Locally (No Deploy)${NC}"
  echo -e "    ${CYAN}[3]${NC} ${BOLD}🌐 Launch WebGen Visual Studio UI in Browser (:8092)${NC}"
  echo -e "    ${CYAN}[4]${NC} ${BOLD}📋 List All 58 Production App Templates (100-Websites Season)${NC}"
  echo -e "    ${CYAN}[5]${NC} ${BOLD}🏛️ Compile 6-Page Stack Project (HTML / Astro / React / MUI)${NC}"
  echo -e "    ${CYAN}[6]${NC} ${BOLD}🚀 Deploy Existing Project Directory to Netlify${NC}"
  echo -e "    ${RED}[0]${NC} ${BOLD}Exit${NC}\n"

  read -rp "  Select [0-6]: " choice || exit 0
  case "$choice" in
    1|2)
      echo ""
      read -rp "  💡 Describe your website or web app idea: " idea
      [[ -z "$idea" ]] && idea="Sovereign AI Developer Utility & Interactive Studio"
      read -rp "  🏷️  Brand / App Name [auto-generate]: " bname
      read -rp "  🎨 Mode [remix = 100-Websites Interactive App | foundry = 6-Page Site] (default: remix): " mode
      mode="${mode:-remix}"
      read -rp "  ✨ Uncommon Web Shader [braille | dither | ascii | constellation] (default: braille): " shader
      shader="${shader:-braille}"
      echo ""
      if [[ "$choice" == "1" ]]; then
        echo -e "  ${CYAN}[*] Synthesizing & Deploying live to Netlify Edge CDN...${NC}"
        python3 "$REPO_DIR/webgen_engine.py" --one-shot "$idea" --name "${bname:-Sovereign Site}" --mode "$mode" --shader "$shader" --deploy
      else
        echo -e "  ${CYAN}[*] Synthesizing project locally...${NC}"
        python3 "$REPO_DIR/webgen_engine.py" --one-shot "$idea" --name "${bname:-Sovereign Site}" --mode "$mode" --shader "$shader"
      fi
      echo ""
      read -rp "  Press [ENTER] to continue..." _
      ;;
    3)
      open_studio_ui 8092
      sleep 1
      ;;
    4)
      echo ""
      python3 -c '
from foundry.oneshot import list_production_templates
for i, t in enumerate(list_production_templates(), 1):
    print(f"  {i:02d}. {t[\"id\"]:<28} | {t[\"category\"]:<24} | {t[\"title\"]}")
' | less -R
      ;;
    5)
      echo ""
      read -rp "  Preset ID [100-websites-in-30-days]: " preset
      preset="${preset:-100-websites-in-30-days}"
      read -rp "  Stack [html | astro | react | react-mui] (default: html): " stack
      stack="${stack:-html}"
      read -rp "  Site Name [Sovereign Studio]: " sname
      sname="${sname:-Sovereign Studio}"
      out_dir="${ZOTH_SRC_ROOT}/generated-sites/$(echo "$sname" | tr '[:upper:] ' '[:lower:]-')"
      python3 "$REPO_DIR/webgen_engine.py" --preset "$preset" --stack "$stack" --name "$sname" --project "$out_dir"
      echo ""
      read -rp "  Press [ENTER] to continue..." _
      ;;
    6)
      echo ""
      read -rp "  Enter project directory path to deploy: " dpath
      if [[ -d "$dpath" ]]; then
        python3 -c "import json; from foundry.oneshot import deploy_to_netlify; print(json.dumps(deploy_to_netlify('$dpath'), indent=2))"
      else
        echo -e "  ${RED}[!] Directory not found: $dpath${NC}"
      fi
      echo ""
      read -rp "  Press [ENTER] to continue..." _
      ;;
    0)
      exit 0
      ;;
  esac
done
