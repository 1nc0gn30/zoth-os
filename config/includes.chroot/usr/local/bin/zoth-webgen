#!/usr/bin/env python3
"""
Zoth WebGen — alias launcher for Zoth Bolt (the real bolt.diy fork) on :5173.
Never starts the legacy braille server.py stand-in.
"""
import sys, os, subprocess, shutil

def main():
    bolt_bin = shutil.which('zoth-bolt') or '/usr/local/bin/zoth-bolt'
    if os.path.exists(bolt_bin) and os.path.realpath(bolt_bin) != os.path.realpath(__file__):
        sys.exit(subprocess.run([bolt_bin] + sys.argv[1:]).returncode)
    print('zoth-bolt launcher not found — install the real bolt.diy fork launcher first.', file=sys.stderr)
    sys.exit(1)

if __name__ == '__main__':
    main()
