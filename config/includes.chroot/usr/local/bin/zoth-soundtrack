#!/usr/bin/env bash
# Zoth Hermetic Audio Studio — Electron player (/opt/zoth-music-app),
# falls back to a headless mpv playlist when no GUI/Electron is available.
APP_DIR="/opt/zoth-music-app"
AUDIO_DIR="/usr/share/zothos/audio"

if [[ -x /opt/electron/electron && -d "$APP_DIR" && -n "${DISPLAY:-${WAYLAND_DISPLAY:-}}" ]]; then
    # /usr/local/bin/electron adds sandbox + GPU-compatibility flags
    exec /usr/local/bin/electron "$APP_DIR" "$@"
elif [[ -d "$AUDIO_DIR" ]] && command -v mpv >/dev/null 2>&1; then
    notify-send "Zoth Hermetic Audio Studio" "Electron UI unavailable — playing the focus playlist with mpv." 2>/dev/null || true
    nohup mpv --no-video --loop-playlist=inf --shuffle "$AUDIO_DIR" >/dev/null 2>&1 &
else
    echo "[-] Zoth Hermetic Audio Studio: no Electron runtime and no mpv/audio library found." >&2
    exit 1
fi
