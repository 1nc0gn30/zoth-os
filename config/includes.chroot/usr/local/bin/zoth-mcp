#!/usr/bin/env bash
# ==============================================================================
#  [+] ZOTHOS MASTER MODEL CONTEXT PROTOCOL (MCP) UNIFIED BRIDGE & HUB
#  Seamlessly binds hot MCP servers to Claude Code, Hermes, Codex & OpenCode
# ==============================================================================

set -euo pipefail

GREEN="\e[38;2;0;255;157m"
GOLD="\e[38;2;255;215;0m"
CYAN="\e[38;2;0;229;255m"
RED="\e[38;2;255;51;85m"
YELLOW="\e[38;2;255;184;0m"
PURPLE="\e[38;2;168;85;247m"
GRAY="\e[38;2;120;140;160m"
BOLD="\e[1m"
RESET="\e[0m"

MCP_CONFIG="/etc/zothos/mcp-servers.json"
USER_MCP_CONFIG="${HOME:-${ZOTH_HOME}}/.config/zothos/mcp-servers.json"
MCP_RUN_DIR="${HOME:-${ZOTH_HOME}}/.zothos/mcp/run"
MCP_LOG_DIR="${HOME:-${ZOTH_HOME}}/.zothos/mcp/logs"

# Resolve active config path
get_config_path() {
    if [[ -f "$USER_MCP_CONFIG" ]]; then
        echo "$USER_MCP_CONFIG"
    elif [[ -f "$MCP_CONFIG" ]]; then
        echo "$MCP_CONFIG"
    elif [[ -n "${ZOTHOS_SRC:-}" && -f "${ZOTHOS_SRC}/config/includes.chroot/etc/zothos/mcp-servers.json" ]]; then
        echo "${ZOTHOS_SRC}/config/includes.chroot/etc/zothos/mcp-servers.json"
    else
        echo "$MCP_CONFIG"
    fi
}

banner() {
    echo -e "${GREEN}${BOLD}  ███████╗ ██████╗ ████████╗██╗  ██╗     ███╗   ███╗ ██████╗██████╗ ${RESET}"
    echo -e "${GREEN}${BOLD}  ╚══███╔╝██╔═══██╗╚══██╔══╝██║  ██║     ████╗ ████║██╔════╝██╔══██╗${RESET}"
    echo -e "${GREEN}${BOLD}    ███╔╝ ██║   ██║   ██║   ███████║     ██╔████╔██║██║     ██████╔╝${RESET}"
    echo -e "${GREEN}${BOLD}   ███╔╝  ██║   ██║   ██║   ██╔══██║     ██║╚██╔╝██║██║     ██╔═══╝ ${RESET}"
    echo -e "${GREEN}${BOLD}  ███████╗╚██████╔╝   ██║   ██║  ██║     ██║ ╚═╝ ██║╚██████╗██║     ${RESET}"
    echo -e "${GREEN}${BOLD}  ╚══════╝ ╚═════╝    ╚═╝   ╚═╝  ╚═╝     ╚═╝     ╚═╝ ╚═════╝╚═╝     ${RESET}"
    echo -e "         ${BOLD}${GOLD}[+] MASTER MODEL CONTEXT PROTOCOL (MCP) HUB v3.1 [+]${RESET}"
    echo ""
}

show_help() {
    banner
    echo -e "${BOLD}Usage:${RESET} zoth-mcp [command] [options]"
    echo ""
    echo -e "${BOLD}Core Commands:${RESET}"
    echo -e "  ${GREEN}list${RESET}                 Formatted table of available MCP servers, security rings & modes"
    echo -e "  ${GREEN}health${RESET}               Comprehensive health & latency diagnostics of all MCP endpoints"
    echo -e "  ${GREEN}start-all${RESET}            Spawn all required offline MCP background daemons"
    echo -e "  ${GREEN}stop-all${RESET}             Stop all running MCP daemon processes"
    echo -e "  ${GREEN}sync${RESET}                 Sync the registry to Grok, AGY, Claude Code, Hermes, Codex, OpenCode, Cursor, and Aider"
    echo -e "  ${GREEN}enable <name>${RESET}        Turn a catalog server on and sync it"
    echo -e "  ${GREEN}disable <name>${RESET}       Turn a catalog server off and sync it"
    echo -e "  ${GREEN}test [server]${RESET}        Validate configuration, execution & sandbox for specified server"
    echo -e "  ${GREEN}status${RESET}               Display quick operational status of all registered MCP endpoints"
    echo -e "  ${GREEN}json${RESET}                 Output raw JSON master configuration"
    echo -e "  ${GREEN}interactive${RESET}          Launch interactive terminal management cockpit"
    echo -e "  ${GREEN}help, -h, --help${RESET}     Show this help documentation"
    echo ""
    echo -e "${BOLD}Active Registry Path:${RESET} $(get_config_path)"
}

cmd_list() {
    local cfg
    cfg=$(get_config_path)
    banner
    echo -e "${BOLD}Master MCP Server & Security Ring Registry (${CYAN}${cfg}${RESET}):${RESET}\n"
    if [[ ! -f "$cfg" ]]; then
        echo -e "${RED}[!] Configuration file not found: ${cfg}${RESET}"
        return 1
    fi

    if command -v jq >/dev/null 2>&1; then
        printf "  ${BOLD}%-22s %-18s %-12s %-22s %s${RESET}\n" "SERVER" "SECURITY RING" "MODE" "SANDBOX" "DESCRIPTION"
        printf "  ${GRAY}%-22s %-18s %-12s %-22s %s${RESET}\n" "----------------------" "------------------" "------------" "----------------------" "---------------------------------------"
        
        local servers
        servers=$(jq -r '.mcpServers | keys[]' "$cfg")
        for s in $servers; do
            local ring
            ring=$(jq -r ".mcpServers[\"$s\"].securityRing // \"RING_2\"" "$cfg")
            local offline
            offline=$(jq -r ".mcpServers[\"$s\"].offline // false" "$cfg")
            local sandbox
            sandbox=$(jq -r ".mcpServers[\"$s\"].sandbox // \"/tmp\"" "$cfg")
            local desc
            desc=$(jq -r ".mcpServers[\"$s\"].description // \"N/A\"" "$cfg")

            local ring_color="$CYAN"
            if [[ "$ring" == *"RING_0"* ]]; then
                ring_color="$GOLD"
            elif [[ "$ring" == *"RING_1"* ]]; then
                ring_color="$PURPLE"
            elif [[ "$ring" == *"RING_2"* ]]; then
                ring_color="$GREEN"
            fi

            local enabled
            enabled=$(jq -r ".mcpServers[\"$s\"].enabled // true" "$cfg")
            local mode_str="${GREEN}[ON]${RESET}"
            if [[ "$enabled" != "true" ]]; then
                mode_str="${GRAY}[off]${RESET}"
            elif [[ "$offline" != "true" ]]; then
                mode_str="${YELLOW}[ON+NET]${RESET}"
            fi

            # Shorten sandbox path if too long
            if [[ ${#sandbox} -gt 21 ]]; then
                sandbox="${sandbox:0:18}..."
            fi

            # Shorten desc if too long
            if [[ ${#desc} -gt 55 ]]; then
                desc="${desc:0:52}..."
            fi

            printf "  ${BOLD}%-22s${RESET} ${ring_color}%-18s${RESET} %-21b %-22s ${GRAY}%s${RESET}\n" "$s" "$ring" "$mode_str" "$sandbox" "$desc"
        done
        echo ""
    else
        cat "$cfg"
    fi
}

cmd_health() {
    local cfg
    cfg=$(get_config_path)
    banner
    echo -e "${BOLD}${CYAN}[*] Running Comprehensive MCP Server Health & Security Ring Audit...${RESET}\n"
    
    if [[ ! -f "$cfg" ]] || ! command -v jq >/dev/null 2>&1; then
        echo -e "${RED}[!] Configuration missing or jq not available.${RESET}"
        return 1
    fi

    local total=0
    local healthy=0
    local degraded=0

    local servers
    servers=$(jq -r '.mcpServers | keys[]' "$cfg")
    for s in $servers; do
        total=$((total + 1))
        local cmd
        cmd=$(jq -r ".mcpServers[\"$s\"].command" "$cfg")
        local ring
        ring=$(jq -r ".mcpServers[\"$s\"].securityRing // \"RING_2\"" "$cfg")
        local offline
        offline=$(jq -r ".mcpServers[\"$s\"].offline // false" "$cfg")
        local fallback
        fallback=$(jq -r ".mcpServers[\"$s\"].fallbackHandler // \"none\"" "$cfg")
        local sandbox
        sandbox=$(jq -r ".mcpServers[\"$s\"].sandbox // \"${HOME:-${ZOTH_HOME}}\"" "$cfg")

        echo -e "${BOLD}▶ [${s}]${RESET} (${ring})"
        
        # 1. Binary check
        local cmd_ok=0
        if command -v "$cmd" >/dev/null 2>&1; then
            cmd_ok=1
            echo -e "    ${GREEN}[✓] Executable binary:${RESET} $(command -v "$cmd")"
        else
            echo -e "    ${YELLOW}[!] Primary binary '${cmd}' not in current PATH${RESET}"
        fi

        # 2. Offline / Fallback check
        if [[ "$offline" == "true" ]]; then
            echo -e "    ${GREEN}[✓] Offline Capable:${RESET} True (Fallback: ${fallback})"
        else
            echo -e "    ${YELLOW}[i] Network Required:${RESET} Online API connection needed"
        fi

        # 3. Sandbox check
        if [[ -e "${sandbox%%,*}" ]]; then
            echo -e "    ${GREEN}[✓] Local Sandbox:${RESET} ${sandbox%%,*} (Accessible)"
        else
            echo -e "    ${GRAY}[○] Local Sandbox:${RESET} ${sandbox%%,*} (Created on demand)"
        fi

        # Overall server status
        if [[ $cmd_ok -eq 1 ]]; then
            healthy=$((healthy + 1))
            echo -e "    ${GREEN}${BOLD}Status: READY / HEALTHY${RESET}\n"
        else
            degraded=$((degraded + 1))
            echo -e "    ${YELLOW}${BOLD}Status: STANDBY (Fallback Active)${RESET}\n"
        fi
    done

    echo -e "${GREEN}${BOLD}======================================================================${RESET}"
    echo -e "  Health Check Summary: ${BOLD}${healthy}/${total} Servers Ready${RESET} | ${YELLOW}${degraded} Standby${RESET}"
    echo -e "${GREEN}${BOLD}======================================================================${RESET}\n"
}

cmd_start_all() {
    local cfg
    cfg=$(get_config_path)
    banner
    echo -e "${BOLD}${CYAN}[+] Spawning ZOTHOS Offline MCP Daemons & Background Bridges...${RESET}\n"
    
    mkdir -p "$MCP_RUN_DIR" "$MCP_LOG_DIR"

    # 1. Start HexStrike AI Server Daemon if not active
    echo -ne "  [*] Spawning HexStrike AI Daemon... "
    if [[ -x "/usr/local/bin/hexstrike" ]]; then
        /usr/local/bin/hexstrike start-backend >/dev/null 2>&1 || true
        echo -e "${GREEN}[DONE]${RESET}"
    else
        echo -e "${YELLOW}[SKIPPED]${RESET}"
    fi

    # 2. Ensure Local Database Directories Exist
    echo -ne "  [*] Initializing Local Storage & Databases (/var/lib/zothos)... "
    mkdir -p "${HOME}/.hexstrike" "${HOME}/.hermes" "${HOME}/.zothos/data" 2>/dev/null || true
    echo -e "${GREEN}[DONE]${RESET}"

    # 3. Sync Agent Configs
    cmd_sync

    echo ""
    echo -e "${GREEN}${BOLD}[✓] All Offline MCP Daemons & Service Endpoints Activated!${RESET}\n"
}

cmd_stop_all() {
    banner
    echo -e "${BOLD}${RED}[-] Stopping all ZOTHOS MCP Daemons...${RESET}\n"
    
    if [[ -x "/usr/local/bin/hexstrike" ]]; then
        /usr/local/bin/hexstrike stop >/dev/null 2>&1 || true
    fi

    pkill -f "hexstrike_server" 2>/dev/null || true
    pkill -f "hexstrike_mcp" 2>/dev/null || true
    
    echo -e "${GREEN}[✓] All MCP background services terminated cleanly.${RESET}\n"
}

cmd_status() {
    local cfg
    cfg=$(get_config_path)
    banner
    echo -e "${BOLD}Operational Status of MCP Servers (${CYAN}${cfg}${RESET}):${RESET}\n"
    if [[ ! -f "$cfg" ]] || ! command -v jq >/dev/null 2>&1; then
        cmd_list
        return
    fi

    local servers
    servers=$(jq -r '.mcpServers | keys[]' "$cfg")
    for s in $servers; do
        local cmd
        cmd=$(jq -r ".mcpServers[\"$s\"].command" "$cfg")
        local desc
        desc=$(jq -r ".mcpServers[\"$s\"].description // \"N/A\"" "$cfg")
        local stat="${GREEN}[READY]${RESET}"
        if ! command -v "$cmd" >/dev/null 2>&1; then
            stat="${YELLOW}[STANDBY]${RESET}"
        fi
        printf "  %-24s %-20b %s\n" "$s" "$stat" "${GRAY}$desc${RESET}"
    done
    echo ""
}

write_config() {
    local src="$1"
    local dest="$2"
    local dest_dir
    dest_dir=$(dirname "$dest")
    mkdir -p "$dest_dir" 2>/dev/null || sudo -n mkdir -p "$dest_dir"
    if [[ -w "$dest" ]] || [[ ! -e "$dest" && -w "$dest_dir" ]]; then
        cp "$src" "$dest"
    elif sudo -n true 2>/dev/null; then
        sudo -n cp "$src" "$dest"
    else
        echo -e "  ${RED}[!]${RESET} Cannot write ${dest}"
        return 1
    fi
}

cmd_sync() {
    local cfg
    cfg=$(get_config_path)
    echo -e "${BOLD}${CYAN}[*] Synchronizing MCP servers across local AI agents...${RESET}"

    if [[ ! -f "$cfg" ]]; then
        echo -e "${RED}[!] Error: Configuration file not found at ${cfg}${RESET}"
        return 1
    fi
    if ! command -v jq >/dev/null 2>&1; then
        echo -e "${RED}[!] jq is required to sync the registry.${RESET}"
        return 1
    fi
    if ! jq empty "$cfg" >/dev/null 2>&1; then
        echo -e "${RED}[!] Registry JSON is not valid: ${cfg}${RESET}"
        return 1
    fi

    local USER_HOME="${HOME:-${ZOTH_HOME}}"
    mkdir -p "${USER_HOME}/.zothos/mcp" "${USER_HOME}/.grok" "${USER_HOME}/.gemini/config" \
        "${USER_HOME}/.config/claude-code" "${USER_HOME}/.hermes" "${USER_HOME}/.config/codex" \
        "${USER_HOME}/.config/opencode" "${USER_HOME}/.cursor" "${USER_HOME}/.aider"

    python3 - "$cfg" "$USER_HOME" << 'PY'
import json, os, sys
cfg_path, home = sys.argv[1], sys.argv[2]
with open(cfg_path) as f:
    registry = json.load(f)
servers = registry.get("mcpServers") or {}

def client_entry(spec):
    entry = {
        "command": spec.get("command", ""),
        "args": spec.get("args") or [],
        "enabled": bool(spec.get("enabled", True)),
    }
    env = spec.get("env") or {}
    if env:
        entry["env"] = env
    return entry

def merge_env(old, new):
    merged = dict(new.get("env") or {})
    for key, value in (old.get("env") or {}).items():
        if value not in ("", None) and merged.get(key) in ("", None):
            merged[key] = value
    if merged:
        new["env"] = merged
    return new

def merge_json(path):
    current = {"mcpServers": {}}
    if os.path.isfile(path):
        try:
            with open(path) as f:
                loaded = json.load(f)
            if isinstance(loaded, dict) and isinstance(loaded.get("mcpServers"), dict):
                current = loaded
        except Exception:
            current = {"mcpServers": {}}
    dest = current.setdefault("mcpServers", {})
    for name, spec in servers.items():
        if not spec.get("enabled", True):
            dest.pop(name, None)
            continue
        entry = client_entry(spec)
        if name in dest and isinstance(dest[name], dict):
            entry = merge_env(dest[name], entry)
        dest[name] = entry
    tmp = path + ".zoth-mcp.tmp"
    with open(tmp, "w") as f:
        json.dump(current, f, indent=2)
        f.write("\n")
    os.replace(tmp, path)
    on = sum(1 for spec in servers.values() if spec.get("enabled", True))
    print(f"json {path} {len(servers)} catalog {on} on")

targets = [
    os.path.join(home, ".gemini", "config", "mcp_config.json"),
    os.path.join(home, ".config", "claude-code", "mcp.json"),
    os.path.join(home, ".hermes", "mcp_servers.json"),
    os.path.join(home, ".config", "codex", "mcp.json"),
    os.path.join(home, ".config", "opencode", "mcp.json"),
    os.path.join(home, ".cursor", "mcp.json"),
    os.path.join(home, ".aider", "mcp.json"),
]
for path in targets:
    os.makedirs(os.path.dirname(path), exist_ok=True)
    merge_json(path)

def toml_str(value):
    return '"' + str(value).replace("\\", "\\\\").replace('"', '\\"') + '"'

lines = ["# zoth-mcp:begin", "# Written by zoth-mcp sync. Change a server with: zoth-mcp enable <name>"]
for name in servers:
    spec = servers[name]
    if not spec.get("enabled", True):
        continue
    timeout = int(spec.get("timeout") or 60)
    lines.append(f"[mcp_servers.{name}]")
    lines.append(f"command = {toml_str(spec.get('command', ''))}")
    args = ", ".join(toml_str(item) for item in (spec.get("args") or []))
    lines.append(f"args = [{args}]")
    env = spec.get("env") or {}
    if env:
        pairs = ", ".join(f"{key} = {toml_str(value)}" for key, value in env.items())
        lines.append(f"env = {{ {pairs} }}")
    flag = "true" if spec.get("enabled", True) else "false"
    lines.append(f"enabled = {flag}")
    lines.append(f"startup_timeout_sec = {min(timeout, 120)}")
    lines.append(f"tool_timeout_sec = {timeout}")
    desc = " ".join(str(spec.get("description") or "").split())
    if desc:
        lines.append("# " + desc.replace("\n", " "))
    lines.append("")
lines.append("# zoth-mcp:end")
block = "\n".join(lines) + "\n"
grok_path = os.path.join(home, ".grok", "config.toml")
existing = ""
if os.path.isfile(grok_path):
    with open(grok_path) as f:
        existing = f.read()
begin, end = "# zoth-mcp:begin", "# zoth-mcp:end"
if begin in existing and end in existing:
    pre, rest = existing.split(begin, 1)
    _, post = rest.split(end, 1)
    post = post.lstrip("\n")
    updated = pre.rstrip() + "\n\n" + block + post
else:
    updated = existing.rstrip() + "\n\n" + block
tmp = grok_path + ".zoth-mcp.tmp"
with open(tmp, "w") as f:
    f.write(updated if updated.endswith("\n") else updated + "\n")
os.replace(tmp, grok_path)
on = sum(1 for spec in servers.values() if spec.get("enabled", True))
print(f"toml {grok_path} {len(servers)} catalog {on} on")
PY

    echo -e "  ${GREEN}[✓]${RESET} Grok, AGY, Claude Code, Hermes, Codex, OpenCode, Cursor, and Aider updated"
    echo -e "  ${GRAY}Servers with enabled=false stay in the catalog and are not started.${RESET}"
    echo ""
    echo -e "${BOLD}${GREEN}[✓] MCP catalog synced.${RESET}"
}

cmd_set_enabled() {
    local name="${1:-}"
    local flag="${2:-}"
    local cfg
    cfg=$(get_config_path)
    if [[ -z "$name" || ( "$flag" != "true" && "$flag" != "false" ) ]]; then
        echo -e "${RED}[!] Usage: zoth-mcp enable <name> | zoth-mcp disable <name>${RESET}"
        return 1
    fi
    if ! jq -e --arg n "$name" '.mcpServers[$n]' "$cfg" >/dev/null 2>&1; then
        echo -e "${RED}[!] '${name}' is not in ${cfg}${RESET}"
        echo -e "    Available: $(jq -r '.mcpServers | keys | join(", ")' "$cfg")"
        return 1
    fi
    local tmp
    tmp=$(mktemp)
    jq --arg n "$name" --argjson flag "$flag" '.mcpServers[$n].enabled = $flag' "$cfg" > "$tmp"
    write_config "$tmp" "$cfg"
    rm -f "$tmp"
    local word="enabled"
    [[ "$flag" == "false" ]] && word="disabled"
    echo -e "${GREEN}[✓]${RESET} ${name} ${word}"
    cmd_sync
}

cmd_test() {
    local server="${1:-filesystem}"
    local cfg
    cfg=$(get_config_path)
    banner
    echo -e "${BOLD}${CYAN}[*] Testing execution for MCP Server: ${server}...${RESET}"
    
    if [[ ! -f "$cfg" ]] || ! command -v jq >/dev/null 2>&1; then
        echo -e "  ${YELLOW}[!] JQ not available or config missing. Raw validation skipped.${RESET}"
        return 0
    fi

    local exists
    exists=$(jq -r ".mcpServers[\"$server\"] // empty" "$cfg")
    if [[ -z "$exists" ]]; then
        echo -e "  ${RED}[✗] Server '${server}' NOT found in ${cfg}.${RESET}"
        echo -e "      Available servers: $(jq -r '.mcpServers | keys | join(", ")' "$cfg")"
        return 1
    fi

    local cmd
    cmd=$(jq -r ".mcpServers[\"$server\"].command" "$cfg")
    local args
    args=$(jq -r ".mcpServers[\"$server\"].args // [] | join(\" \")" "$cfg")
    local desc
    desc=$(jq -r ".mcpServers[\"$server\"].description // \"N/A\"" "$cfg")
    local ring
    ring=$(jq -r ".mcpServers[\"$server\"].securityRing // \"N/A\"" "$cfg")
    local offline
    offline=$(jq -r ".mcpServers[\"$server\"].offline // false" "$cfg")

    echo -e "  ${GREEN}[✓]${RESET} Server '${server}' registered."
    echo -e "      Security Ring: ${ring}"
    echo -e "      Offline Mode:  ${offline}"
    echo -e "      Description:   ${desc}"
    echo -e "      Invocation:    ${cmd} ${args}"

    if command -v "$cmd" >/dev/null 2>&1; then
        echo -e "  ${GREEN}[✓]${RESET} Binary executable '${cmd}' resolved in PATH: $(command -v "$cmd")"
    else
        echo -e "  ${YELLOW}[!]${RESET} Binary executable '${cmd}' not currently in PATH. Fallback handler will be used."
    fi
}

interactive_menu() {
    while true; do
        clear
        cmd_status
        echo -e "${GREEN}${BOLD}══════════════════════════════════════════════════════════════════════${RESET}"
        echo -e "  ${BOLD}${GREEN}[1]${RESET} [LIST]      ${BOLD}Detailed Server Registry Listing & Rings${RESET}"
        echo -e "  ${BOLD}${CYAN}[2]${RESET} [HEALTH]    ${BOLD}Run Health & Latency Diagnostics${RESET}"
        echo -e "  ${BOLD}${GOLD}[3]${RESET} [START-ALL] ${BOLD}Spawn Offline MCP Daemons${RESET}"
        echo -e "  ${BOLD}${PURPLE}[4]${RESET} [SYNC]      ${BOLD}Sync MCP to Grok, AGY, Claude Code, Hermes, Codex, OpenCode${RESET}"
        echo -e "  ${BOLD}${YELLOW}[5]${RESET} [TEST]      ${BOLD}Test Specific Server Endpoint${RESET}"
        echo -e "  ${BOLD}${RED}[6]${RESET} [STOP-ALL]  ${BOLD}Stop Running Daemons${RESET}"
        echo -e "  ${BOLD}${GRAY}[7]${RESET} [JSON]      ${BOLD}View Raw MCP Configuration JSON${RESET}"
        echo -e "  ${BOLD}${GRAY}[0]${RESET} [EXIT]      ${BOLD}Exit Hub${RESET}"
        echo -e "${GREEN}${BOLD}══════════════════════════════════════════════════════════════════════${RESET}"
        read -r -p "Select MCP operation [0-7]: " choice
        case "$choice" in
            1) cmd_list; read -r -p "Press Enter to continue..." _ ;;
            2) cmd_health; read -r -p "Press Enter to continue..." _ ;;
            3) cmd_start_all; read -r -p "Press Enter to continue..." _ ;;
            4) banner; cmd_sync; read -r -p "Press Enter to continue..." _ ;;
            5) 
                read -r -p "Enter MCP server name to test [default: filesystem]: " sname
                cmd_test "${sname:-filesystem}"
                read -r -p "Press Enter to continue..." _
                ;;
            6) cmd_stop_all; read -r -p "Press Enter to continue..." _ ;;
            7)
                echo ""
                cat "$(get_config_path)"
                echo ""
                read -r -p "Press Enter to continue..." _
                ;;
            0|q|Q) break ;;
            *) echo -e "${RED}Invalid option${RESET}"; sleep 1 ;;
        esac
    done
}

action="${1:-interactive}"

case "$action" in
    list)
        cmd_list
        ;;
    health)
        cmd_health
        ;;
    start-all)
        cmd_start_all
        ;;
    stop-all)
        cmd_stop_all
        ;;
    status)
        cmd_status
        ;;
    sync)
        banner
        cmd_sync
        ;;
    enable)
        cmd_set_enabled "${2:-}" true
        ;;
    disable)
        cmd_set_enabled "${2:-}" false
        ;;
    test)
        cmd_test "${2:-filesystem}"
        ;;
    json)
        cat "$(get_config_path)"
        ;;
    gui|app)
        if [[ -n "${DISPLAY:-}" ]] && command -v electron >/dev/null 2>&1 && [[ -d "/opt/zoth-mcp-app" ]]; then
            exec electron /opt/zoth-mcp-app
        elif [[ -n "${ZOTHOS_SRC:-}" && -d "${ZOTHOS_SRC}/config/includes.chroot/opt/zoth-mcp-app" ]]; then
            local elec_bin="electron"
            [[ -x "${ZOTHOS_SRC}/config/includes.chroot/opt/electron/electron" ]] && elec_bin="${ZOTHOS_SRC}/config/includes.chroot/opt/electron/electron"
            exec "$elec_bin" "${ZOTHOS_SRC}/config/includes.chroot/opt/zoth-mcp-app"
        else
            interactive_menu
        fi
        ;;
    interactive)
        interactive_menu
        ;;
    help|-h|--help)
        show_help
        ;;
    "")
        if [[ -t 0 ]]; then
            interactive_menu
        else
            cmd_list
        fi
        ;;
    *)
        echo -e "${RED}Unknown command: ${action}${RESET}\n"
        show_help
        exit 1
        ;;
esac
