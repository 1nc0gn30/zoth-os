#!/usr/bin/env bash
# ==============================================================================
#  ZOTH GHOSTMODE GUI LAUNCHER
# ==============================================================================
set -euo pipefail

if [[ -n "${DISPLAY:-}" ]] && command -v electron >/dev/null 2>&1 && [[ -f "/opt/zoth-ghost-app/main.js" ]]; then
    exec electron --no-sandbox /opt/zoth-ghost-app "$@"
else
    exec konsole -qwindowtitle 'Ghostmode Operations' -e /usr/local/bin/zoth-ghost
fi
