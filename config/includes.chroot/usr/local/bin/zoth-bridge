#!/usr/bin/env python3
"""
ZOTHOS local system bridge (127.0.0.1:8199)
===========================================
Loopback API for telemetry, launching installed apps, the agent permission
layer and agent prompt routing.

Security model (audit 2026-10, finding P0-1):
  * There is NO arbitrary command execution endpoint. /api/exec was removed.
  * /api/launch starts only programs named by an installed .desktop file or a
    zoth-* tool, as an argv list (never a shell).
  * Every /api call except /api/metrics needs the per-session token from
    ~/.config/zothos/bridge-token (mode 0600), sent as X-Zoth-Token.
  * Host must be loopback and any Origin must be a local page, which blocks
    drive-by requests from websites and DNS rebinding. CORS is never '*'.
"""

import glob
import hmac
import json
import os
import secrets
import shlex
import shutil
import subprocess
import time
import urllib.parse
from http.server import SimpleHTTPRequestHandler
import socketserver

PORT = 8199
USER_STATE = os.path.expanduser("~/.config/zothos/agent-layer.state")
TOKEN_FILE = os.path.expanduser("~/.config/zothos/bridge-token")
LOCAL_HOSTS = {"127.0.0.1", "localhost", "::1"}
APP_DIRS = ["/usr/share/applications", os.path.expanduser("~/.local/share/applications")]


def load_token() -> str:
    try:
        tok = open(TOKEN_FILE, encoding="utf-8").read().strip()
        if tok:
            return tok
    except OSError:
        pass
    os.makedirs(os.path.dirname(TOKEN_FILE), mode=0o700, exist_ok=True)
    tok = secrets.token_urlsafe(32)
    fd = os.open(TOKEN_FILE, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.write(tok + "\n")
    return tok


def launchable_programs() -> set:
    """Program names allowed for /api/launch: Exec= of installed .desktop files + zoth-* tools."""
    names = set()
    for d in APP_DIRS:
        for desk in glob.glob(os.path.join(d, "*.desktop")):
            try:
                for line in open(desk, encoding="utf-8", errors="ignore"):
                    if line.startswith("Exec="):
                        argv = shlex.split(line[5:].strip())
                        if argv:
                            names.add(os.path.basename(argv[0]))
                        break
            except (OSError, ValueError):
                continue
    for b in glob.glob("/usr/local/bin/zoth-*"):
        names.add(os.path.basename(b))
    names.discard("zoth-bridge")
    return names


def parse_launch(cmd: str, allowed: set):
    """Return a safe argv for cmd or None. No shell metacharacters, allowlisted program."""
    if not cmd or len(cmd) > 512 or any(c in cmd for c in ";|&`$<>\n\r"):
        return None
    try:
        argv = shlex.split(cmd)
    except ValueError:
        return None
    argv = [a for a in argv if not a.startswith("%")]  # strip .desktop field codes
    if not argv or os.path.basename(argv[0]) not in allowed or "/" in argv[0] and not os.path.isabs(argv[0]):
        return None
    if not shutil.which(argv[0]):
        return None
    return argv


def is_local_origin(origin) -> bool:
    if not origin:
        return True
    u = urllib.parse.urlparse(origin)
    return u.scheme in ("http", "https") and (u.hostname or "") in LOCAL_HOSTS


class ZothBridgeHandler(SimpleHTTPRequestHandler):
    token = ""

    def end_headers(self):
        origin = self.headers.get("Origin", "") if hasattr(self, "headers") and self.headers else ""
        self.send_header("Access-Control-Allow-Origin", origin if origin and is_local_origin(origin) else "http://127.0.0.1")
        self.send_header("Vary", "Origin")
        self.send_header("Access-Control-Allow-Methods", "GET, OPTIONS")
        self.send_header("Access-Control-Allow-Headers", "Content-Type, X-Zoth-Token")
        super().end_headers()

    def list_directory(self, path):
        self.send_error(404)
        return None

    def _trusted_request(self) -> bool:
        host = (self.headers.get("Host") or "").rsplit(":", 1)[0].strip("[]").lower()
        return host in LOCAL_HOSTS and is_local_origin(self.headers.get("Origin"))

    def _authorized(self) -> bool:
        supplied = self.headers.get("X-Zoth-Token", "")
        return bool(self.token) and hmac.compare_digest(supplied.encode(), self.token.encode())

    def do_OPTIONS(self):
        self.send_response(204 if self._trusted_request() else 403)
        self.end_headers()

    def do_GET(self):
        if not self._trusted_request():
            self.send_json({"error": "forbidden origin or host"}, 403)
            return
        parsed = urllib.parse.urlparse(self.path)
        path = parsed.path
        params = urllib.parse.parse_qs(parsed.query)

        if path == "/api/metrics":
            self.send_json(self.get_system_metrics())
            return

        if path.startswith("/api/"):
            if not self._authorized():
                self.send_json({"error": "token required", "hint": f"send X-Zoth-Token from {TOKEN_FILE}"}, 401)
                return

        if path == "/api/exec":
            self.send_json({"error": "removed: arbitrary command execution is not available"}, 410)
            return

        if path == "/api/launch":
            raw = params.get("cmd", params.get("app", [""]))[0]
            argv = parse_launch(raw, launchable_programs())
            if not argv:
                self.send_json({"error": "not an installed app", "app": raw[:120]}, 400)
                return
            subprocess.Popen(argv, env=dict(os.environ, DISPLAY=os.environ.get("DISPLAY", ":0")),
                             stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                             start_new_session=True)
            self.send_json({"status": "launched", "argv": argv})
            return

        if path == "/api/layer":
            try:
                layer = int(params.get("val", ["4"])[0])
                if not 0 <= layer <= 9:
                    raise ValueError("layer must be 0-9")
                os.makedirs(os.path.dirname(USER_STATE), exist_ok=True)
                with open(USER_STATE, "w") as f:
                    f.write(str(layer))
                self.send_json({"status": "layer_updated", "layer": layer})
            except Exception as e:
                self.send_json({"error": str(e)}, 400)
            return

        if path == "/api/agent":
            prompt = params.get("prompt", [""])[0][:4000]
            if not prompt or not shutil.which("zoth-agent-os"):
                self.send_json({"error": "empty prompt or zoth-agent-os missing"}, 400)
                return
            subprocess.Popen(["zoth-agent-os", prompt],
                             env=dict(os.environ, DISPLAY=os.environ.get("DISPLAY", ":0")),
                             stdin=subprocess.DEVNULL, start_new_session=True)
            self.send_json({"status": "dispatched"})
            return

        if path.startswith("/api/"):
            self.send_json({"error": "unknown endpoint"}, 404)
            return

        super().do_GET()

    def do_POST(self):
        self.send_json({"error": "method not allowed"}, 405)

    def send_json(self, data, status=200):
        payload = json.dumps(data).encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(payload)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(payload)

    def get_system_metrics(self):
        # CPU
        cpu_pct = 0.0
        try:
            with open("/proc/stat", "r") as f:
                fields = [float(x) for x in f.readline().split()[1:8]]
                idle = fields[3] + fields[4]
                total = sum(fields)
                cpu_pct = round(100.0 * (1.0 - (idle / total)), 1) if total > 0 else 0.0
        except Exception:
            pass

        # RAM
        ram_used_gb = 0.0
        ram_total_gb = 0.0
        ram_pct = 0.0
        try:
            mem = {}
            with open("/proc/meminfo", "r") as f:
                for line in f:
                    p = line.split(":")
                    if len(p) == 2:
                        mem[p[0].strip()] = int(p[1].split()[0])
            total_kb = mem.get("MemTotal", 1024)
            avail_kb = mem.get("MemAvailable", mem.get("MemFree", 0))
            used_kb = total_kb - avail_kb
            ram_used_gb = round(used_kb / (1024 * 1024), 2)
            ram_total_gb = round(total_kb / (1024 * 1024), 2)
            ram_pct = round((used_kb / total_kb) * 100, 1)
        except Exception:
            pass

        # Active Layer
        layer = 4
        if os.path.exists(USER_STATE):
            try:
                with open(USER_STATE, "r") as f:
                    layer = int(f.read().strip())
            except Exception:
                pass

        return {
            "cpu_pct": cpu_pct,
            "ram_used_gb": ram_used_gb,
            "ram_total_gb": ram_total_gb,
            "ram_pct": ram_pct,
            "active_layer": layer,
            "timestamp": time.time()
        }

def run_server():
    target_dir = "/opt/zoth-studio/dist" if os.path.isdir("/opt/zoth-studio/dist") else "/usr/share/zothos"
    if os.path.exists(target_dir):
        os.chdir(target_dir)
    ZothBridgeHandler.token = load_token()
    socketserver.TCPServer.allow_reuse_address = True
    server = socketserver.ThreadingTCPServer(("127.0.0.1", PORT), ZothBridgeHandler)
    print(f"[*] ZOTHOS bridge on http://127.0.0.1:{PORT} (token: {TOKEN_FILE})")
    server.serve_forever()


if __name__ == "__main__":
    run_server()
