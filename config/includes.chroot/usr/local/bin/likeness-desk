#!/usr/bin/env python3
import sys, os, json, subprocess, argparse, urllib.request, urllib.error

TOOL_ID = 'likeness-desk'
TOOL_REPO = 'likeness-desk'
TOOL_NAME = 'Likeness Desk (AI Video Double)'
TOOL_DESC = 'Local video double on GPU; Chatterbox Turbo voice cloning and Wav2Lip photorealistic mouth animation on Quadro P1000 with zero cloud leakage.'
TOOL_VERSION = '2.5.0'
TOOL_CATEGORY = 'Voice & Real-Time'
TOOL_PORT = 9395
REPO_DIR = os.path.expanduser('~/NullAITech/likeness-desk')
STUDIO_URL = f"http://127.0.0.1:3000/tools/{TOOL_ID}"
LOCAL_PORT_URL = f"http://127.0.0.1:{TOOL_PORT}"

def query_status():
    try:
        req = urllib.request.Request(f"{LOCAL_PORT_URL}/api/status", headers={'User-Agent': 'ZothOS-CLI'})
        with urllib.request.urlopen(req, timeout=2.5) as r:
            return json.loads(r.read().decode('utf-8'))
    except Exception as e:
        return {"online": False, "error": str(e)}

def speak_text(text):
    try:
        data = json.dumps({"text": text}).encode('utf-8')
        req = urllib.request.Request(
            f"{LOCAL_PORT_URL}/api/speak",
            data=data,
            headers={'Content-Type': 'application/json', 'User-Agent': 'ZothOS-CLI'},
            method='POST'
        )
        with urllib.request.urlopen(req, timeout=15) as r:
            res = json.loads(r.read().decode('utf-8'))
            return res
    except Exception as e:
        return {"error": str(e)}

def main():
    args = sys.argv[1:]

    parser = argparse.ArgumentParser(
        prog=TOOL_ID,
        description=f"{TOOL_NAME} (v{TOOL_VERSION}) — {TOOL_DESC}"
    )
    parser.add_argument('--version', action='version', version=f"{TOOL_ID} v{TOOL_VERSION}")
    parser.add_argument('--status', action='store_true', help='Check local ZothOS installation & daemon status')
    parser.add_argument('--json', action='store_true', help='Output deterministic JSON telemetry')
    parser.add_argument('--ui', action='store_true', help='Print local ZothOS workbench URL')

    subparsers = parser.add_subparsers(dest='subcommand', help='Subcommands')
    subparsers.add_parser('status', help='Print live GPU, voice model, and face pipeline status')
    
    speak_p = subparsers.add_parser('speak', help='Synthesize speech via cloned neural voice')
    speak_p.add_argument('text', type=str, help='Text phrase to synthesize')

    serve_p = subparsers.add_parser('serve', help='Run likeness-desk server daemon')
    serve_p.add_argument('--port', type=int, default=TOOL_PORT, help='Port to bind')

    parsed, unknown = parser.parse_known_args(args)

    if parsed.subcommand == 'serve':
        env = os.environ.copy()
        env['LIKENESS_PORT'] = str(parsed.port or TOOL_PORT)
        cmd = ['node', 'server.js']
        print(f"✦ Starting {TOOL_NAME} on http://127.0.0.1:{env['LIKENESS_PORT']} ...")
        proc = subprocess.run(cmd, cwd=REPO_DIR, env=env)
        sys.exit(proc.returncode)

    if parsed.subcommand == 'speak':
        res = speak_text(parsed.text)
        print(json.dumps(res, indent=2))
        sys.exit(0)

    live_status = query_status()

    info = {
        "id": TOOL_ID,
        "repo": TOOL_REPO,
        "name": TOOL_NAME,
        "version": TOOL_VERSION,
        "category": TOOL_CATEGORY,
        "installed": os.path.exists(REPO_DIR),
        "repo_path": REPO_DIR,
        "studio_workbench_url": STUDIO_URL,
        "local_endpoint": LOCAL_PORT_URL,
        "daemon_active": live_status.get("error") is None,
        "hardware": {
            "gpu": live_status.get("faceGpuName", "Quadro P1000"),
            "voice_trained": live_status.get("voiceTrained", False),
            "voice_seconds": live_status.get("voiceSeconds", 0),
            "face_active": live_status.get("face", False)
        },
        "license": "100% Free & Open Access (Zero Paywalls)",
        "support": {
            "stripe_buy_coffee": "https://buy.stripe.com/3cIfZg27PdKo2D64Ocfw40X",
            "solana_wallet": "GG2eQbVh8ut1BK6j1A2tz7pSySdLpD38BgyEhGcxdXoK"
        },
        "status": "READY"
    }

    if parsed.json:
        print(json.dumps(info, indent=2))
        return

    if parsed.subcommand == 'status':
        print(f"✦ {TOOL_NAME} Live Pipeline Status:")
        print(json.dumps(live_status, indent=2))
        return

    print(f"✦ {TOOL_NAME} (v{TOOL_VERSION}) — [{TOOL_CATEGORY}]")
    print(f"  Repository : {REPO_DIR}")
    print(f"  Workbench  : {STUDIO_URL}")
    print(f"  Local Port : {LOCAL_PORT_URL}")
    print(f"  GPU Worker : {live_status.get('faceGpuName', 'Quadro P1000')} (Active: {live_status.get('faceGpu', False)})")
    print(f"  Voice Model: Chatterbox Turbo (Trained: {live_status.get('voiceTrained', False)}, {live_status.get('voiceSeconds', 0)}s)")
    print(f"  Access     : 100% Free & Open Access (☕ https://buy.stripe.com/3cIfZg27PdKo2D64Ocfw40X | ◎ GG2eQbVh8ut1BK6j1A2tz7pSySdLpD38BgyEhGcxdXoK)")

if __name__ == '__main__':
    main()
