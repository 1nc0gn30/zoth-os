#!/usr/bin/env python3
import sys, os, json, subprocess, argparse, urllib.request, urllib.error, urllib.parse

TOOL_ID = 'shodan-surface-sentinel'
TOOL_REPO = 'shodan-surface-sentinel'
TOOL_NAME = 'Shodan Attack Surface Sentinel'
TOOL_DESC = 'Zero-egress defensive asset auditor and InternetDB engine. Inspects open ports, CPE software stacks, and confirmed CVE exposures for your infrastructure.'
TOOL_VERSION = '3.5.0'
TOOL_CATEGORY = 'Security & Enclave'
TOOL_PORT = 8130
REPO_DIR = os.path.expanduser('~/NullAITech/shodan-surface-sentinel')
SERVER_PY = os.path.expanduser('~/NullAITech/shodan-surface-sentinel/server.py')
STUDIO_URL = f"http://127.0.0.1:3000/tools/{TOOL_ID}"
LOCAL_PORT_URL = f"http://127.0.0.1:{TOOL_PORT}"

def query_health():
    try:
        req = urllib.request.Request(f"{LOCAL_PORT_URL}/health", headers={'User-Agent': 'ZothOS-CLI'})
        with urllib.request.urlopen(req, timeout=3.0) as r:
            return json.loads(r.read().decode('utf-8'))
    except Exception as e:
        return {"error": str(e)}

def scan_target(target: str):
    try:
        # Try local daemon first
        url = f"{LOCAL_PORT_URL}/api/scan?target={urllib.parse.quote(target)}"
        req = urllib.request.Request(url, headers={'User-Agent': 'ZothOS-CLI'})
        with urllib.request.urlopen(req, timeout=5.0) as r:
            return json.loads(r.read().decode('utf-8'))
    except Exception:
        # Direct InternetDB query fallback
        try:
            import socket
            ip = socket.gethostbyname(target.strip())
            idb_url = f"https://internetdb.shodan.io/{ip}"
            req = urllib.request.Request(idb_url, headers={'User-Agent': 'ZothOS-CLI'})
            with urllib.request.urlopen(req, timeout=5.0) as r:
                data = json.loads(r.read().decode('utf-8'))
                return {
                    "target": target,
                    "ip": ip,
                    "ports": data.get("ports", []),
                    "cpes": data.get("cpes", []),
                    "hostnames": data.get("hostnames", []),
                    "vulns": data.get("vulns", []),
                    "threat_level": "HIGH" if data.get("vulns") else "LOW",
                    "source": "shodan_direct"
                }
        except Exception as e:
            return {"error": str(e), "target": target}

def main():
    args = sys.argv[1:]
    if '--electron' in args or (args and args[0] in ('desktop', 'electron')):
        import shutil as _sh
        rem = [a for a in args if a not in ('--electron', 'desktop', 'electron')]
        elec = _sh.which('electron') or '/usr/local/bin/electron'
        sys.exit(subprocess.run([elec, os.path.join(REPO_DIR, 'electron', 'main.cjs')] + rem, cwd=REPO_DIR).returncode)
    if '--tui' in args or (args and args[0] == 'tui'):
        rem = [a for a in args if a not in ('--tui', 'tui')]
        sys.exit(subprocess.run([f'/usr/local/bin/{TOOL_ID}-tui'] + rem).returncode)

    parser = argparse.ArgumentParser(
        prog=TOOL_ID,
        description=f"{TOOL_NAME} (v{TOOL_VERSION}) — {TOOL_DESC}"
    )
    parser.add_argument('--version', action='version', version=f"{TOOL_ID} v{TOOL_VERSION}")
    parser.add_argument('--status', action='store_true', help='Check local ZothOS installation & daemon status')
    parser.add_argument('--json', action='store_true', help='Output deterministic JSON telemetry')
    parser.add_argument('--ui', action='store_true', help='Print local ZothOS workbench URL')

    subparsers = parser.add_subparsers(dest='subcommand', help='Subcommands')
    scan_p = subparsers.add_parser('scan', help='Audit attack surface for an IP or domain')
    scan_p.add_argument('target', help='Target IP or domain to audit')

    serve_p = subparsers.add_parser('serve', help='Run Shodan Surface Sentinel daemon')
    serve_p.add_argument('--port', type=int, default=TOOL_PORT, help='Port to bind')

    parsed, unknown = parser.parse_known_args(args)

    if parsed.subcommand == 'serve':
        cmd = [sys.executable, SERVER_PY, '--port', str(parsed.port or TOOL_PORT)]
        print(f"✦ Starting {TOOL_NAME} on http://127.0.0.1:{parsed.port or TOOL_PORT} ...")
        proc = subprocess.run(cmd, cwd=REPO_DIR)
        sys.exit(proc.returncode)

    if parsed.subcommand == 'scan':
        target = parsed.target
        res = scan_target(target)
        if "error" in res:
            print(f"Audit Error: {res['error']}")
            sys.exit(1)
        if parsed.json or '--json' in unknown:
            print(json.dumps(res, indent=2))
        else:
            print(f"✦ Shodan Attack Surface Reconnaissance for [{res.get('target')}]:")
            print(f"  Resolved IP   : {res.get('ip')}")
            print(f"  Threat Level  : {res.get('threat_level')}")
            print(f"  Open Ports    : {', '.join(str(p) for p in res.get('ports', [])) or 'None'}")
            print(f"  Known CVEs    : {', '.join(res.get('vulns', [])) or 'None (Clean)'}")
            print(f"  Software CPEs : {len(res.get('cpes', []))} detected")
            if res.get('hostnames'):
                print(f"  Hostnames     : {', '.join(res.get('hostnames', []))}")
        sys.exit(0)

    health = query_health()
    is_online = health.get("error") is None

    info = {
        "id": TOOL_ID,
        "repo": TOOL_REPO,
        "name": TOOL_NAME,
        "version": TOOL_VERSION,
        "category": TOOL_CATEGORY,
        "installed": os.path.exists(REPO_DIR),
        "repo_path": REPO_DIR,
        "studio_workbench_url": STUDIO_URL,
        "local_endpoint": LOCAL_PORT_URL,
        "daemon_active": is_online,
        "daemon_telemetry": health if is_online else None,
        "license": "100% Free & Open Access (Zero Paywalls)",
        "support": {
            "stripe_buy_coffee": "https://buy.stripe.com/3cIfZg27PdKo2D64Ocfw40X",
            "solana_wallet": "GG2eQbVh8ut1BK6j1A2tz7pSySdLpD38BgyEhGcxdXoK"
        },
        "status": "READY"
    }

    if parsed.json:
        print(json.dumps(info, indent=2))
        return

    print(f"✦ {TOOL_NAME} (v{TOOL_VERSION}) — [{TOOL_CATEGORY}]")
    print(f"  Repository : {REPO_DIR}")
    print(f"  Workbench  : {STUDIO_URL}")
    print(f"  Local Port : {LOCAL_PORT_URL}")
    print(f"  Daemon     : {'ONLINE (Live)' if is_online else 'OFFLINE'}")
    if is_online:
        print(f"  Engine     : {health.get('engine')} (Uptime: {health.get('uptime_seconds')}s)")
    print(f"  Access     : 100% Free & Open Access (☕ https://buy.stripe.com/3cIfZg27PdKo2D64Ocfw40X | ◎ GG2eQbVh8ut1BK6j1A2tz7pSySdLpD38BgyEhGcxdXoK)")

if __name__ == '__main__':
    main()
