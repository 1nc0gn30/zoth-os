#!/usr/bin/env bash
# ==============================================================================
# Agent Prompt Firewall CLI Wrapper
# Engineered by Neal Frazier Tech (@1nc0gn30) • NullAI Platform
# ==============================================================================
set -e

PRIMARY_BIN="${ZOTH_SRC_ROOT}/agent-prompt-firewall/bin/agent-firewall"
REPO_DIR="${ZOTH_SRC_ROOT}/agent-prompt-firewall"

if [[ -x "$PRIMARY_BIN" ]]; then
    exec "$PRIMARY_BIN" "$@"
elif [[ -d "$REPO_DIR/src/agent_prompt_firewall" ]]; then
    export PYTHONPATH="$REPO_DIR/src:${PYTHONPATH:-}"
    exec python3 -m agent_prompt_firewall.cli "$@"
else
    echo "Error: agent-firewall not found in $PRIMARY_BIN or $REPO_DIR" >&2
    exit 1
fi
