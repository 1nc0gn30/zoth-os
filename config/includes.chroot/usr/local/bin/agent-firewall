#!/usr/bin/env bash
set -e
REPO_DIR="/home/zoth/NullAITech/agent-prompt-firewall"
[[ ! -d "$REPO_DIR" ]] && REPO_DIR="/opt/agent-prompt-firewall"
PRIMARY_BIN="$REPO_DIR/bin/agent-firewall"
if [[ -x "$PRIMARY_BIN" ]]; then
    exec "$PRIMARY_BIN" "$@"
elif [[ -d "$REPO_DIR/src" ]]; then
    export PYTHONPATH="$REPO_DIR/src:${PYTHONPATH:-}"
    pkg=$(ls "$REPO_DIR/src" | grep -v egg | head -n1)
    exec python3 -m "${pkg}.cli" "$@"
else
    echo "Error: agent-prompt-firewall not found in $REPO_DIR" >&2
    exit 1
fi
