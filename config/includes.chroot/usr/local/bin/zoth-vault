def zoth_vault_sub_menu():
    while True:
        banner()
        running = is_daemon_running()
        pid = get_daemon_pid() if running else None
        token = load_session_token()
        unlocked = is_session_valid(token) if running else False

        status_str = f"{GREEN}ONLINE{RESET} [PID: {pid}]" if running else f"{RED}OFFLINE{RESET}"
        lock_str = f"{GREEN}UNLOCKED (Session Active){RESET}" if unlocked else f"{YELLOW}LOCKED{RESET}"

        print(f"{BOLD}══════════════════════════════════════════════════════════════════════════{RESET}")
        print(f"  {BOLD}ZOTH SOVEREIGN VAULT (RUST + ARGON2ID + CHACHA20-POLY1305 + BLAKE3){RESET}")
        print(f"  {GRAY}Daemon:{RESET}    {status_str} (127.0.0.1:{DAEMON_PORT})")
        print(f"  {GRAY}State:{RESET}     {lock_str}")
        print(f"{BOLD}══════════════════════════════════════════════════════════════════════════{RESET}\n")

        print(f"  {BOLD}{GOLD}[1]{RESET}  {BOLD}Vault Status & Security Posture{RESET}   {GRAY}(Inspect storage, modes, health){RESET}")
        if unlocked:
            print(f"  {BOLD}{RED}[2]{RESET}  {BOLD}Lock Vault Immediately{RESET}            {GRAY}(Zeroize memory & purge session){RESET}")
        else:
            print(f"  {BOLD}{GREEN}[2]{RESET}  {BOLD}Unlock Vault{RESET}                      {GRAY}(Authenticate master passphrase){RESET}")
        print(f"  {BOLD}{CYAN}[3]{RESET}  {BOLD}List Secrets (Masked){RESET}             {GRAY}(Formatted ASCII table){RESET}")
        print(f"  {BOLD}{GOLD}[4]{RESET}  {BOLD}Reveal / Get Secret{RESET}               {GRAY}(Output plain secret value){RESET}")
        print(f"  {BOLD}{GREEN}[5]{RESET}  {BOLD}Add / Update Secret{RESET}               {GRAY}(Store key with tags & env){RESET}")
        print(f"  {BOLD}{RED}[6]{RESET}  {BOLD}Delete Secret{RESET}                     {GRAY}(Remove key from vault){RESET}")
        print(f"  {BOLD}{CYAN}[7]{RESET}  {BOLD}Export Secrets{RESET}                    {GRAY}(.env format or encrypted JSON){RESET}")
        print(f"  {BOLD}{GOLD}[8]{RESET}  {BOLD}Import Secrets (.env){RESET}             {GRAY}(Batch import key-value pairs){RESET}")
        print(f"  {BOLD}{GREEN}[9]{RESET}  {BOLD}Run Process with Injected Secrets{RESET} {GRAY}(Zero disk leaks, in-memory){RESET}")
        print(f"  {BOLD}{CYAN}[10]{RESET} {BOLD}Daemon Process Control{RESET}            {GRAY}(Start / Stop / Restart){RESET}")
        print(f"  {BOLD}{GRAY}[11]{RESET} {BOLD}Zoth Studio Web Vault UI{RESET}          {GRAY}(Open Browser :8088/vault){RESET}")
        print(f"  {BOLD}{GRAY}[0]{RESET}  {BOLD}Return to Master Menu{RESET}\n")

        try:
            choice = input(f"{GOLD}Select Option [1-11, 0]: {RESET}").strip()
            if choice == "1":
                cmd_status()
                input(f"\n{GRAY}Press Enter to continue...{RESET}")
            elif choice == "2":
                if unlocked:
                    cmd_lock()
                else:
                    cmd_unlock()
                input(f"\n{GRAY}Press Enter to continue...{RESET}")
            elif choice == "3":
                cmd_list()
                input(f"\n{GRAY}Press Enter to continue...{RESET}")
            elif choice == "4":
                key_name = input(f"{GOLD}[?] Enter secret name, label, or ID: {RESET}").strip()
                if key_name:
                    print(f"\n{BOLD}Secret value:{RESET}")
                    cmd_get(key_name)
                input(f"\n{GRAY}Press Enter to continue...{RESET}")
            elif choice == "5":
                name = input(f"{GOLD}[?] Secret Label / Name: {RESET}").strip()
                if name:
                    val = getpass.getpass(f"{GOLD}[?] Secret Value: {RESET}").strip()
                    prov = input(f"{GOLD}[?] Provider (e.g. openai, anthropic, stripe) [auto]: {RESET}").strip() or None
                    tags = input(f"{GOLD}[?] Tags (comma separated) [cli]: {RESET}").strip() or None
                    cmd_set(name, val, provider=prov, tags=tags)
                input(f"\n{GRAY}Press Enter to continue...{RESET}")
            elif choice == "6":
                name = input(f"{GOLD}[?] Secret Name or ID to delete: {RESET}").strip()
                if name:
                    cmd_delete(name)
                input(f"\n{GRAY}Press Enter to continue...{RESET}")
            elif choice == "7":
                fmt = input(f"{GOLD}[?] Export format (env/json) [env]: {RESET}").strip() or "env"
                cmd_export(fmt)
                input(f"\n{GRAY}Press Enter to continue...{RESET}")
            elif choice == "8":
                fpath = input(f"{GOLD}[?] Path to .env file to import: {RESET}").strip()
                if fpath:
                    cmd_import(fpath)
                input(f"\n{GRAY}Press Enter to continue...{RESET}")
            elif choice == "9":
                run_cmd = input(f"{GOLD}[?] Command to execute (e.g. bash -c 'echo $OPENAI_API_KEY'): {RESET}").strip()
                if run_cmd:
                    print(f"{GRAY}[*] Executing in subshell with injected vault secrets...{RESET}\n")
                    subprocess.run(["python3", sys.argv[0], "run", "--", "bash", "-c", run_cmd])
                input(f"\n{GRAY}Press Enter to continue...{RESET}")
            elif choice == "10":
                d_action = input(f"{GOLD}[?] Daemon action (start/stop/restart/status): {RESET}").strip().lower()
                cmd_daemon(d_action)
                input(f"\n{GRAY}Press Enter to continue...{RESET}")
            elif choice == "11":
                ensure_daemon()
                target_port = 3000
                for p in (3000, 8088, 8080):
                    try:
                        with urllib.request.urlopen(f"http://127.0.0.1:{p}/", timeout=0.3):
                            target_port = p
                            break
                    except Exception:
                        pass
                subprocess.Popen(["xdg-open", f"http://127.0.0.1:{target_port}/vault"])
                print(f"{GREEN}[✓] Opening Zoth Studio Web Vault (:{target_port}/vault)...{RESET}")
                time.sleep(1)
            elif choice in ["0", "q", "exit", "back"]:
                break
        except (KeyboardInterrupt, EOFError):
            break

def main_menu():
    while True:
        banner()
        bw_status = f"{GREEN}Installed{RESET}" if shutil.which("bw") else f"{RED}Missing{RESET}"
        keepass_status = f"{GREEN}Installed{RESET}" if shutil.which("keepassxc") else f"{RED}Missing{RESET}"
        pass_status = f"{GREEN}Installed{RESET}" if shutil.which("pass") else f"{RED}Missing{RESET}"
        zoth_status = f"{GREEN}Rust Argon2id Verified{RESET}" if get_daemon_bin() else f"{RED}Missing{RESET}"
        running = is_daemon_running()
        d_badge = f"{GREEN}127.0.0.1:{DAEMON_PORT} ONLINE{RESET}" if running else f"{RED}127.0.0.1:{DAEMON_PORT} OFFLINE{RESET}"

        print(f"{BOLD}══════════════════════════════════════════════════════════════════════════{RESET}")
        print(f"  {BOLD}AVAILABLE ENCRYPTED SECRETS ENGINES{RESET}   [{d_badge}]")
        print(f"  {GRAY}1. Zoth Sovereign Vault:{RESET}   {zoth_status}")
        print(f"  {GRAY}2. Bitwarden CLI (bw):{RESET}     {bw_status}")
        print(f"  {GRAY}3. KeePassXC GUI/CLI:{RESET}      {keepass_status}")
        print(f"  {GRAY}4. UNIX Pass (GPG):{RESET}        {pass_status}")
        print(f"{BOLD}══════════════════════════════════════════════════════════════════════════{RESET}\n")

        print(f"  {BOLD}{GOLD}[1]{RESET}  {BOLD}Zoth Sovereign Vault{RESET}    {GRAY}(Argon2id + Rust ChaCha20-Poly1305){RESET}")
        print(f"  {BOLD}{CYAN}[2]{RESET}  {BOLD}Bitwarden CLI (bw){RESET}      {GRAY}(Interactive official Bitwarden shell){RESET}")
        print(f"  {BOLD}{GREEN}[3]{RESET}  {BOLD}KeePassXC{RESET}               {GRAY}(Offline encrypted .kdbx password manager){RESET}")
        print(f"  {BOLD}{GOLD}[4]{RESET}  {BOLD}UNIX Pass (GPG){RESET}         {GRAY}(Standard UNIX password tree){RESET}")
        print(f"  {BOLD}{GRAY}[0]{RESET}  {BOLD}Exit{RESET}\n")

        try:
            choice = input(f"{GOLD}Select Secrets Manager [1-4, 0]: {RESET}").strip()
            if choice == "1":
                zoth_vault_sub_menu()
            elif choice == "2":
                run_bw()
            elif choice == "3":
                run_keepassxc()
            elif choice == "4":
                run_pass()
            elif choice in ["0", "q", "exit"]:
                break
        except (KeyboardInterrupt, EOFError):
            print("\n")
            break

# ─────────────────────────────────────────────────────────────────────────────
# CLI DISPATCHER
# ─────────────────────────────────────────────────────────────────────────────

def build_parser():
    parser = argparse.ArgumentParser(
        prog="zoth-vault",
        description="Zoth Sovereign Vault CLI & Process Secret Injector v3.5",
        add_help=True
    )
    subparsers = parser.add_subparsers(dest="subcommand", help="Vault subcommands")

    # status
    p_status = subparsers.add_parser("status", help="Check daemon status and vault file on-disk status")
    p_status.add_argument("--json", action="store_true", help="Output status as JSON")

    # init
    p_init = subparsers.add_parser("init", help="Initialize new vault with master passphrase")
    p_init.add_argument("passphrase", nargs="?", default=None, help="Master passphrase (min 12 chars)")

    # daemon
    p_daemon = subparsers.add_parser("daemon", help="Manage background zoth-vault-daemon process")
    p_daemon.add_argument("action", nargs="?", default="status", choices=["start", "stop", "restart", "status"])

    # unlock
    p_unlock = subparsers.add_parser("unlock", help="Unlock vault and cache session token (mode 0600)")
    p_unlock.add_argument("passphrase", nargs="?", default=None, help="Master passphrase")

    # lock
    subparsers.add_parser("lock", help="Explicitly lock vault and clear session token")

    # list
    p_list = subparsers.add_parser("list", help="Display formatted ASCII table of all secrets")
    p_list.add_argument("--json", action="store_true", help="Output secrets as JSON")
    p_list.add_argument("--tag", "-t", default=None, help="Filter by tag")
    p_list.add_argument("--provider", "-p", default=None, help="Filter by provider")

    # get
    p_get = subparsers.add_parser("get", help="Reveal and output raw secret value")
    p_get.add_argument("key", help="Key name, label, or UUID ID")
    p_get.add_argument("--json", action="store_true", help="Output full JSON key object")

    # set
    p_set = subparsers.add_parser("set", help="Store or update a secret in the vault")
    p_set.add_argument("key", help="Key name / label")
    p_set.add_argument("value", nargs="?", default=None, help="Secret value (reads stdin if '-' or omitted)")
    p_set.add_argument("--provider", "-p", default=None, help="Provider name")
    p_set.add_argument("--tags", "-t", default=None, help="Comma-separated tags")
    p_set.add_argument("--env", "-e", default=None, help="Environment variable binding")

    # delete
    p_del = subparsers.add_parser("delete", help="Delete a secret from the vault")
    p_del.add_argument("key", help="Key name, label, or UUID ID")
    p_del.add_argument("-y", "--yes", action="store_true", help="Skip confirmation prompt")

    # export
    p_exp = subparsers.add_parser("export", help="Export decrypted keys (.env) or encrypted JSON")
    p_exp.add_argument("format", nargs="?", default="env", choices=["env", "json"])
    p_exp.add_argument("--passphrase", "-p", default=None, help="Passphrase for encrypted JSON export")
    p_exp.add_argument("--decrypted", action="store_true", help="Export decrypted JSON")
    p_exp.add_argument("--out", "-o", default=None, help="Output file path (mode 0600)")

    # import
    p_imp = subparsers.add_parser("import", help="Import key-value pairs into the vault")
    p_imp.add_argument("file", help="Path to .env file (or '-' for stdin)")

    # run (Process Injector)
    p_run = subparsers.add_parser("run", help="Inject vault secrets into command execution environment")
    p_run.add_argument("command", nargs=argparse.REMAINDER, help="Command to execute with secrets")

    # menu
    subparsers.add_parser("menu", help="Launch interactive Cyber Terminal Menu")

    # External vault passthroughs
    p_bw = subparsers.add_parser("bw", help="Run Bitwarden CLI")
    p_bw.add_argument("bw_args", nargs=argparse.REMAINDER)

    subparsers.add_parser("keepass", help="Launch KeePassXC")
    subparsers.add_parser("keepassxc", help="Launch KeePassXC")

    p_pass = subparsers.add_parser("pass", help="Run UNIX Pass (GPG)")
    p_pass.add_argument("pass_args", nargs=argparse.REMAINDER)

    # Legacy alias
    p_zoth = subparsers.add_parser("zoth", help="Manage Zoth Vault Daemon")
    p_zoth.add_argument("zoth_args", nargs=argparse.REMAINDER)

    return parser

def main():
    raw_args = sys.argv[1:]

    # Interactive menu if no arguments or explicit --menu / menu
    if not raw_args or raw_args == ["--menu"] or raw_args == ["menu"]:
        main_menu()
        return 0

    # Special handling for 'run' command to preserve flags for child process
    if raw_args and raw_args[0] == "run":
        cmd_args = raw_args[1:]
        if cmd_args and cmd_args[0] == "--":
            cmd_args = cmd_args[1:]
        return cmd_run(cmd_args)

    parser = build_parser()
    try:
        args = parser.parse_args(raw_args)
    except SystemExit as e:
        return e.code

    sub = args.subcommand
    if sub == "status":
        return cmd_status(as_json=args.json)
    elif sub == "init":
        return cmd_init(passphrase=args.passphrase)
    elif sub == "daemon":
        return cmd_daemon(action=args.action)
    elif sub == "unlock":
        return cmd_unlock(passphrase=args.passphrase)
    elif sub == "lock":
        return cmd_lock()
    elif sub == "list":
        return cmd_list(as_json=args.json, filter_tag=args.tag, filter_provider=args.provider)
    elif sub == "get":
        return cmd_get(args.key, as_json=args.json)
    elif sub == "set":
        return cmd_set(args.key, value=args.value, provider=args.provider, tags=args.tags, env=args.env)
    elif sub == "delete":
        return cmd_delete(args.key, force=args.yes)
    elif sub == "export":
        return cmd_export(fmt=args.format, passphrase=args.passphrase, decrypted=args.decrypted, out_file=args.out)
    elif sub == "import":
        return cmd_import(args.file)
    elif sub == "menu":
        main_menu()
        return 0
    elif sub == "bw":
        run_bw(args.bw_args if args.bw_args else None)
        return 0
    elif sub in ["keepass", "keepassxc"]:
        run_keepassxc()
        return 0
    elif sub == "pass":
        run_pass(args.pass_args if args.pass_args else None)
        return 0
    elif sub == "zoth":
        if args.zoth_args and args.zoth_args[0] == "status":
            return cmd_status()
        elif args.zoth_args and args.zoth_args[0] in ["start", "stop", "restart"]:
            return cmd_daemon(args.zoth_args[0])
        else:
            return 0 if ensure_daemon() else 1
    else:
        parser.print_help()
        return 0

if __name__ == "__main__":
    try:
        sys.exit(main())
    except (KeyboardInterrupt, BrokenPipeError):
        sys.exit(0)
