def run_pass(args=None):
    p_bin = shutil.which("pass") or "/usr/bin/pass"
    if not p_bin:
        print(f"{RED}[!] UNIX Pass is not installed.{RESET}")
        input(f"\n{GRAY}Press Enter to return...{RESET}")
        return
    if args:
        subprocess.run([p_bin] + args)
        return

    while True:
        pass_banner()
        store_dir = os.path.expanduser("~/.password-store")
        store_exists = os.path.isdir(store_dir)
        count = 0
        if store_exists:
            for root, _, files in os.walk(store_dir):
                count += sum(1 for f in files if f.endswith(".gpg"))

        status_str = f"{GREEN}Initialized ({count} entries){RESET}" if store_exists else f"{YELLOW}Not Initialized{RESET}"

        print(f"{BOLD}══════════════════════════════════════════════════════════════════════════{RESET}")
        print(f"  {BOLD}PASSWORD STORE:{RESET}     {status_str}")
        print(f"  {GRAY}Storage Path:{RESET}       {store_dir}")
        print(f"  {GRAY}Encryption Engine:{RESET}  GNU Privacy Guard (GPG Asymmetric / Public Key)")
        print(f"{BOLD}══════════════════════════════════════════════════════════════════════════{RESET}")

        print(f"""
  {BOLD}{GOLD}┌── HOW TO USE UNIX PASS (PASSWORD STORE) ──────────────────────────────┐{RESET}
  {BOLD}{GOLD}│{RESET}  {BOLD}1. INITIALIZE STORE:{RESET} Bind ~/.password-store to your GPG key ID:        {BOLD}{GOLD}│{RESET}
  {BOLD}{GOLD}│{RESET}     $ {CYAN}pass init <gpg-id-or-email>{RESET}                                     {BOLD}{GOLD}│{RESET}
  {BOLD}{GOLD}│{RESET}  {BOLD}2. COMMON COMMANDS:{RESET}                                                     {BOLD}{GOLD}│{RESET}
  {BOLD}{GOLD}│{RESET}     $ {CYAN}pass{RESET}                    (view entire password tree)              {BOLD}{GOLD}│{RESET}
  {BOLD}{GOLD}│{RESET}     $ {CYAN}pass show <path/account>{RESET} (decrypt and view secret)               {BOLD}{GOLD}│{RESET}
  {BOLD}{GOLD}│{RESET}     $ {CYAN}pass insert <path>{RESET}       (add new secret)                         {BOLD}{GOLD}│{RESET}
  {BOLD}{GOLD}│{RESET}     $ {CYAN}pass generate <path> 24{RESET}  (generate and store new password)        {BOLD}{GOLD}│{RESET}
  {BOLD}{GOLD}│{RESET}     $ {CYAN}pass git init / push{RESET}     (track vault changes in git)             {BOLD}{GOLD}│{RESET}
  {BOLD}{GOLD}└───┴───────────────────────────────────────────────────────────────────┘{RESET}
""")

        print(f"  {BOLD}{GREEN}[1]{RESET}  {BOLD}View Password Tree / Hierarchy{RESET}      {GRAY}(pass ls){RESET}")
        print(f"  {BOLD}{GOLD}[2]{RESET}  {BOLD}Show & Decrypt Secret{RESET}               {GRAY}(pass show <path>){RESET}")
        print(f"  {BOLD}{CYAN}[3]{RESET}  {BOLD}Insert New Secret{RESET}                   {GRAY}(pass insert <path>){RESET}")
        print(f"  {BOLD}{YELLOW}[4]{RESET}  {BOLD}Generate Secure Password{RESET}            {GRAY}(pass generate <path> 24){RESET}")
        print(f"  {BOLD}{GREEN}[5]{RESET}  {BOLD}Initialize Store with GPG Key{RESET}       {GRAY}(pass init <gpg-id>){RESET}")
        print(f"  {BOLD}{GRAY}[6]{RESET}  {BOLD}View GPG Keys on System{RESET}             {GRAY}(gpg --list-secret-keys){RESET}")
        print(f"  {BOLD}{GOLD}[7]{RESET}  {BOLD}Launch Pass Interactive Shell{RESET}       {GRAY}(Subshell with pass ready){RESET}")
        print(f"  {BOLD}{GRAY}[0]{RESET}  {BOLD}Return to Master Menu{RESET}\n")

        try:
            choice = input(f"{GOLD}Select Action [1-7, 0]: {RESET}").strip()
            if choice == "1":
                print(f"\n{GRAY}[*] Listing password store...{RESET}")
                subprocess.run([p_bin])
                input(f"\n{GRAY}Press Enter to continue...{RESET}")
            elif choice == "2":
                target = input(f"{GOLD}[?] Enter password path (e.g. email/neo): {RESET}").strip()
                if target:
                    subprocess.run([p_bin, "show", target])
                input(f"\n{GRAY}Press Enter to continue...{RESET}")
            elif choice == "3":
                target = input(f"{GOLD}[?] Enter password path: {RESET}").strip()
                if target:
                    subprocess.run([p_bin, "insert", target])
                input(f"\n{GRAY}Press Enter to continue...{RESET}")
            elif choice == "4":
                target = input(f"{GOLD}[?] Enter password path: {RESET}").strip()
                length = input(f"{GOLD}[?] Length [24]: {RESET}").strip() or "24"
                if target:
                    subprocess.run([p_bin, "generate", target, length])
                input(f"\n{GRAY}Press Enter to continue...{RESET}")
            elif choice == "5":
                gpg_id = input(f"{GOLD}[?] Enter GPG key ID or email: {RESET}").strip()
                if gpg_id:
                    subprocess.run([p_bin, "init", gpg_id])
                input(f"\n{GRAY}Press Enter to continue...{RESET}")
            elif choice == "6":
                print(f"\n{GRAY}[*] GPG Secret Keys:{RESET}")
                subprocess.run(["gpg", "--list-secret-keys", "--keyid-format", "LONG"])
                input(f"\n{GRAY}Press Enter to continue...{RESET}")
            elif choice == "7":
                print(f"\n{GREEN}[*] Spawning shell with pass environment...{RESET}")
                print(f"    {GRAY}Type 'exit' to return to menu.{RESET}\n")
                subprocess.run(["bash", "-l"])
            elif choice in ["0", "q", "exit", "back"]:
                break
        except (KeyboardInterrupt, EOFError):
            break

