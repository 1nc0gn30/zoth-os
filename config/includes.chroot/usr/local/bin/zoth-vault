            elif choice == "7":
                target = input(f"{GOLD}[?] Enter item name or ID: {RESET}").strip()
                if target:
                    subprocess.run([bw_bin, "get", "totp", target])
                input(f"\n{GRAY}Press Enter to continue...{RESET}")
            elif choice == "8":
                target = input(f"{GOLD}[?] Enter item name or ID: {RESET}").strip()
                if target:
                    subprocess.run([bw_bin, "get", "item", target])
                input(f"\n{GRAY}Press Enter to continue...{RESET}")
            elif choice == "9":
                print(f"\n{GRAY}[*] Syncing vault...{RESET}")
                subprocess.run([bw_bin, "sync"])
                input(f"\n{GRAY}Press Enter to continue...{RESET}")
            elif choice == "10":
                print(f"\n{GRAY}[*] Generating secure password...{RESET}")
                subprocess.run([bw_bin, "generate", "-u", "-p", "-s", "--length", "24"])
                input(f"\n{GRAY}Press Enter to continue...{RESET}")
            elif choice == "11":
                s_url = input(f"{GOLD}[?] Enter server URL (leave empty for default cloud): {RESET}").strip()
                if s_url:
                    subprocess.run([bw_bin, "config", "server", s_url])
                else:
                    subprocess.run([bw_bin, "config", "server", "https://vault.bitwarden.com"])
                input(f"\n{GRAY}Press Enter to continue...{RESET}")
            elif choice == "12":
                print(f"\n{GRAY}[*] Locking vault...{RESET}")
                subprocess.run([bw_bin, "lock"])
                if "BW_SESSION" in os.environ:
                    del os.environ["BW_SESSION"]
                input(f"\n{GRAY}Press Enter to continue...{RESET}")
            elif choice == "13":
                print(f"\n{GRAY}[*] Logging out of Bitwarden...{RESET}")
                subprocess.run([bw_bin, "logout"])
                if "BW_SESSION" in os.environ:
                    del os.environ["BW_SESSION"]
                input(f"\n{GRAY}Press Enter to continue...{RESET}")
