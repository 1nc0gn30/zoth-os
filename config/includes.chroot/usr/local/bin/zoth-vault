def get_bw_info(bw_bin):
    try:
        res = subprocess.run([bw_bin, "status"], capture_output=True, text=True, timeout=2.0)
        if res.returncode == 0 and res.stdout.strip():
            return json.loads(res.stdout.strip())
    except Exception:
        pass
    return {}

def run_bw(args=None):
    bw_bin = shutil.which("bw") or "/usr/local/bin/bw"
    if not bw_bin or not os.path.exists(bw_bin):
        print(f"{RED}[!] Bitwarden CLI (bw) is not installed.{RESET}")
        input(f"\n{GRAY}Press Enter to return...{RESET}")
        return
    if args:
        subprocess.run([bw_bin] + args)
        return

    while True:
        bw_banner()
        info = get_bw_info(bw_bin)
        status_val = info.get("status", "unauthenticated").upper()
        server_url = info.get("serverUrl") or "https://vault.bitwarden.com (Default Cloud)"
        last_sync = info.get("lastSync") or "Never"
        user_email = info.get("userEmail") or "None"
        session_active = "BW_SESSION" in os.environ and bool(os.environ["BW_SESSION"])

        status_color = GREEN if status_val == "UNLOCKED" else (YELLOW if status_val == "LOCKED" else RED)
        session_badge = f"{GREEN}ACTIVE IN RAM{RESET}" if session_active else f"{GRAY}NOT EXPORTED{RESET}"

        print(f"{BOLD}══════════════════════════════════════════════════════════════════════════{RESET}")
        print(f"  {BOLD}BITWARDEN STATUS:{RESET}   {status_color}{status_val}{RESET}   |   {BOLD}SESSION:{RESET} {session_badge}")
        print(f"  {GRAY}User Email:{RESET}       {CYAN}{user_email}{RESET}")
        print(f"  {GRAY}Vault Server:{RESET}     {server_url}")
        print(f"  {GRAY}Last Synced:{RESET}      {last_sync}")
        print(f"{BOLD}══════════════════════════════════════════════════════════════════════════{RESET}")

        print(f"""
  {BOLD}{GOLD}┌── HOW TO USE BITWARDEN CLI (bw) ──────────────────────────────────────┐{RESET}
  {BOLD}{GOLD}│{RESET}  {BOLD}1. AUTHENTICATE:{RESET} Log in with your account or self-hosted server:       {BOLD}{GOLD}│{RESET}
  {BOLD}{GOLD}│{RESET}     $ {CYAN}bw login <email>{RESET}                                               {BOLD}{GOLD}│{RESET}
  {BOLD}{GOLD}│{RESET}     $ {CYAN}bw config server <https://your-vaultwarden.com>{RESET}                  {BOLD}{GOLD}│{RESET}
  {BOLD}{GOLD}│{RESET}  {BOLD}2. UNLOCK VAULT:{RESET} Decrypt secrets into session memory:                  {BOLD}{GOLD}│{RESET}
  {BOLD}{GOLD}│{RESET}     $ {CYAN}export BW_SESSION=$(bw unlock --raw){RESET}                           {BOLD}{GOLD}│{RESET}
