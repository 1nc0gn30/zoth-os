def run_keepassxc(args=None):
    k_bin = shutil.which("keepassxc") or "/usr/bin/keepassxc"
    kcli_bin = shutil.which("keepassxc-cli") or "/usr/bin/keepassxc-cli"
    if not k_bin and not kcli_bin:
        print(f"{RED}[!] KeePassXC is not installed.{RESET}")
        input(f"\n{GRAY}Press Enter to return...{RESET}")
        return
    if args and kcli_bin:
        subprocess.run([kcli_bin] + args)
        return

    while True:
        keepass_banner()
        gui_status = f"{GREEN}Installed{RESET}" if k_bin and os.path.exists(k_bin) else f"{RED}Missing{RESET}"
        cli_status = f"{GREEN}Installed{RESET}" if kcli_bin and os.path.exists(kcli_bin) else f"{RED}Missing{RESET}"

        print(f"{BOLD}══════════════════════════════════════════════════════════════════════════{RESET}")
        print(f"  {BOLD}KEEPASSXC STATUS:{RESET}   GUI: {gui_status}   |   CLI: {cli_status}")
        print(f"  {GRAY}Storage Engine:{RESET}     Offline Local .kdbx Container (AES-256 / ChaCha20)")
        print(f"  {GRAY}Cloud Telemetry:{RESET}    Zero (100% Sovereign Offline)")
        print(f"{BOLD}══════════════════════════════════════════════════════════════════════════{RESET}")

        print(f"""
  {BOLD}{GOLD}┌── HOW TO USE KEEPASSXC (.KDBX) ───────────────────────────────────────┐{RESET}
  {BOLD}{GOLD}│{RESET}  {BOLD}1. LOCAL OFFLINE STORAGE:{RESET} Passwords are encrypted inside a portable   {BOLD}{GOLD}│{RESET}
  {BOLD}{GOLD}│{RESET}     local database file (.kdbx) protected by Argon2id + master key.    {BOLD}{GOLD}│{RESET}
  {BOLD}{GOLD}│{RESET}  {BOLD}2. COMMON COMMANDS (keepassxc-cli):{RESET}                                     {BOLD}{GOLD}│{RESET}
  {BOLD}{GOLD}│{RESET}     $ {CYAN}keepassxc-cli db-create <database.kdbx>{RESET}                        {BOLD}{GOLD}│{RESET}
  {BOLD}{GOLD}│{RESET}     $ {CYAN}keepassxc-cli ls <database.kdbx>{RESET}                               {BOLD}{GOLD}│{RESET}
  {BOLD}{GOLD}│{RESET}     $ {CYAN}keepassxc-cli show -s <database.kdbx> <entry_name>{RESET}             {BOLD}{GOLD}│{RESET}
  {BOLD}{GOLD}│{RESET}     $ {CYAN}keepassxc-cli add -u <user> -p <database.kdbx> <entry_name>{RESET}    {BOLD}{GOLD}│{RESET}
  {BOLD}{GOLD}│{RESET}     $ {CYAN}keepassxc-cli clip <database.kdbx> <entry_name>{RESET} (copy to clip) {BOLD}{GOLD}│{RESET}
  {BOLD}{GOLD}│{RESET}  {BOLD}3. GRAPHICAL INTERFACE:{RESET} Launch full desktop GUI with auto-type.        {BOLD}{GOLD}│{RESET}
  {BOLD}{GOLD}└───┴───────────────────────────────────────────────────────────────────┘{RESET}
""")

        print(f"  {BOLD}{GREEN}[1]{RESET}  {BOLD}Launch KeePassXC Graphical Application (GUI){RESET}")
        print(f"  {BOLD}{CYAN}[2]{RESET}  {BOLD}Create New Offline Database (.kdbx){RESET}      {GRAY}(keepassxc-cli db-create){RESET}")
        print(f"  {BOLD}{YELLOW}[3]{RESET}  {BOLD}List Entries in Database{RESET}                 {GRAY}(keepassxc-cli ls){RESET}")
        print(f"  {BOLD}{GOLD}[4]{RESET}  {BOLD}Show & Reveal Entry Password{RESET}             {GRAY}(keepassxc-cli show -s){RESET}")
        print(f"  {BOLD}{GREEN}[5]{RESET}  {BOLD}Add New Credential Entry{RESET}                 {GRAY}(keepassxc-cli add){RESET}")
        print(f"  {BOLD}{CYAN}[6]{RESET}  {BOLD}Generate High-Entropy Password{RESET}           {GRAY}(keepassxc-cli generate){RESET}")
        print(f"  {BOLD}{GOLD}[7]{RESET}  {BOLD}Launch KeePassXC CLI Shell{RESET}               {GRAY}(Interactive terminal shell){RESET}")
        print(f"  {BOLD}{GRAY}[0]{RESET}  {BOLD}Return to Master Menu{RESET}\n")

        try:
            choice = input(f"{GOLD}Select Action [1-7, 0]: {RESET}").strip()
            if choice == "1":
                if k_bin and os.path.exists(k_bin):
                    print(f"\n{GREEN}[*] Launching KeePassXC GUI window...{RESET}")
                    subprocess.Popen([k_bin])
                    time.sleep(1)
                else:
                    print(f"\n{RED}[!] KeePassXC GUI binary not found.{RESET}")
                    input(f"\n{GRAY}Press Enter to continue...{RESET}")
            elif choice == "2":
                db_path = input(f"{GOLD}[?] Enter new database path (e.g. ~/vault.kdbx): {RESET}").strip()
                if db_path:
                    db_path = os.path.expanduser(db_path)
                    subprocess.run([kcli_bin, "db-create", db_path])
                input(f"\n{GRAY}Press Enter to continue...{RESET}")
            elif choice == "3":
                db_path = input(f"{GOLD}[?] Enter database path: {RESET}").strip()
                if db_path:
                    subprocess.run([kcli_bin, "ls", os.path.expanduser(db_path)])
                input(f"\n{GRAY}Press Enter to continue...{RESET}")
            elif choice == "4":
                db_path = input(f"{GOLD}[?] Enter database path: {RESET}").strip()
                entry = input(f"{GOLD}[?] Enter entry name: {RESET}").strip()
                if db_path and entry:
                    subprocess.run([kcli_bin, "show", "-s", os.path.expanduser(db_path), entry])
                input(f"\n{GRAY}Press Enter to continue...{RESET}")
            elif choice == "5":
                db_path = input(f"{GOLD}[?] Enter database path: {RESET}").strip()
                entry = input(f"{GOLD}[?] Enter entry name: {RESET}").strip()
                user = input(f"{GOLD}[?] Enter username: {RESET}").strip()
                if db_path and entry:
                    args_add = [kcli_bin, "add", "-p"]
                    if user: args_add.extend(["-u", user])
                    args_add.extend([os.path.expanduser(db_path), entry])
                    subprocess.run(args_add)
                input(f"\n{GRAY}Press Enter to continue...{RESET}")
            elif choice == "6":
                print(f"\n{GRAY}[*] Generating password...{RESET}")
                subprocess.run([kcli_bin, "generate", "-l", "24", "-U", "-l", "-d", "-s"])
                input(f"\n{GRAY}Press Enter to continue...{RESET}")
            elif choice == "7":
                print(f"\n{GREEN}[*] Spawning shell with keepassxc-cli available...{RESET}")
                print(f"    {GRAY}Type 'exit' to return to menu.{RESET}\n")
                subprocess.run(["bash", "-l"])
            elif choice in ["0", "q", "exit", "back"]:
                break
        except (KeyboardInterrupt, EOFError):
            break

