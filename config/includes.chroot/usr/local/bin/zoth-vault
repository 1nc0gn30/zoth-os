#!/usr/bin/env python3
"""
[+] ZOTHOS SOVEREIGN SECRETS & MULTI-VAULT MANAGER v3.5
Zero-leak cryptographic secrets engine & process secret injector:
- Zoth Sovereign Vault (Rust Argon2id + XChaCha20-Poly1305 + BLAKE3 + zeroize)
- Bitwarden Official CLI (bw)
- KeePassXC (Encrypted offline database)
- UNIX Pass (GPG-encrypted secret tree)
"""

import os
import sys
import shutil
import subprocess
import time
import json
import stat
import signal
import datetime
import getpass
import argparse
import urllib.request
import urllib.error

# Color Constants
GOLD = "\033[38;2;255;215;0m"
GREEN = "\033[38;2;0;255;157m"
CYAN = "\033[38;2;0;229;255m"
RED = "\033[38;2;255;51;85m"
YELLOW = "\033[38;2;255;204;0m"
GRAY = "\033[38;2;120;140;160m"
BOLD = "\033[1m"
RESET = "\033[0m"

DAEMON_PORT = int(os.environ.get("ZOTH_VAULT_PORT", 8787))
API_BASE = f"http://127.0.0.1:{DAEMON_PORT}"

# ─────────────────────────────────────────────────────────────────────────────
# PATHS & SESSION MANAGEMENT (0600 ENFORCED)
# ─────────────────────────────────────────────────────────────────────────────

def get_session_dir():
    runtime_dir = os.environ.get("XDG_RUNTIME_DIR")
    if runtime_dir and os.path.isdir(runtime_dir):
        d = os.path.join(runtime_dir, "zoth-vault")
    else:
        d = os.path.expanduser("~/.cache/zoth-vault")
    os.makedirs(d, mode=0o700, exist_ok=True)
    return d

def get_session_file():
    return os.path.join(get_session_dir(), "session")

def get_pid_file():
    return os.path.join(get_session_dir(), "daemon.pid")

def get_log_file():
    return os.path.expanduser("~/.cache/zoth-vault-daemon.log")

def save_session_token(token, expires_at=None):
    s_file = get_session_file()
    fd = os.open(s_file, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        data = {
            "token": token,
            "expires_at": expires_at,
            "saved_at": time.time()
        }
        json.dump(data, f)
    os.chmod(s_file, 0o600)

def load_session_token():
    s_file = get_session_file()
    if not os.path.isfile(s_file):
        return None
    try:
        with open(s_file, "r") as f:
            content = f.read().strip()
            if content.startswith("{"):
                data = json.loads(content)
                return data.get("token")
            return content
    except Exception:
        return None

def clear_session():
    s_file = get_session_file()
    if os.path.isfile(s_file):
        try:
            with open(s_file, "wb") as f:
                f.write(b"\x00" * 128)
            os.remove(s_file)
        except Exception:
            pass

def is_session_valid(token):
    if not token:
        return False
    status, res = api_request("GET", "/v1/session", token=token)
    return status == 200 and res.get("ok") is True

# ─────────────────────────────────────────────────────────────────────────────
# DAEMON DISCOVERY & PROCESS CONTROL
# ─────────────────────────────────────────────────────────────────────────────

def get_daemon_bin():
    candidates = [
        shutil.which("zoth-vault-daemon"),
        "/usr/local/bin/zoth-vault-daemon",
        "/opt/zoth-studio/backend/vault-daemon/target/release/zoth-vault-daemon",
    ]
    zothos_src = os.environ.get("ZOTHOS_SRC")
    if zothos_src:
        candidates.extend([
            os.path.join(zothos_src, "config/includes.chroot/usr/local/bin/zoth-vault-daemon"),
            os.path.join(zothos_src, "build/live_workspace/chroot/usr/local/bin/zoth-vault-daemon"),
            os.path.join(zothos_src, "build/live_workspace/chroot/opt/zoth-studio/backend/vault-daemon/target/release/zoth-vault-daemon"),
        ])
    for c in candidates:
        if c and os.path.isfile(c) and os.access(c, os.X_OK):
            return c
    return None

def is_daemon_running():
    try:
        req = urllib.request.Request(f"{API_BASE}/health", headers={"User-Agent": "ZothVaultCLI/3.5"})
        with urllib.request.urlopen(req, timeout=1.0) as resp:
            return resp.status == 200
    except Exception:
        return False

def get_daemon_pid():
    pid_file = get_pid_file()
    if os.path.isfile(pid_file):
        try:
            with open(pid_file, "r") as f:
                pid = int(f.read().strip())
                os.kill(pid, 0)
                return pid
        except (ValueError, OSError):
            pass
    try:
        res = subprocess.run(["pgrep", "-f", "zoth-vault-daemon"], capture_output=True, text=True)
        lines = res.stdout.strip().split()
        if lines:
            return int(lines[0])
    except Exception:
        pass
    return None

def save_daemon_pid(pid):
    pid_file = get_pid_file()
    try:
        with open(pid_file, "w") as f:
            f.write(str(pid))
        os.chmod(pid_file, 0o600)
    except Exception:
        pass

def clear_daemon_pid():
    pid_file = get_pid_file()
    if os.path.isfile(pid_file):
        try:
            os.remove(pid_file)
        except Exception:
            pass

def ensure_daemon(silent=False):
    if is_daemon_running():
        return True
    return daemon_start(silent=silent)

def daemon_start(silent=False):
    if is_daemon_running():
        if not silent:
            pid = get_daemon_pid()
            pid_str = f" (PID: {pid})" if pid else ""
            print(f"{GREEN}[✓] Zoth Vault daemon is already active on port {DAEMON_PORT}{pid_str}{RESET}")
        return True

    daemon_bin = get_daemon_bin()
    if not daemon_bin:
        print(f"{RED}[!] zoth-vault-daemon binary not found.{RESET}", file=sys.stderr)
        return False

    if not silent:
        print(f"{GRAY}[*] Starting sovereign Argon2id Zoth Vault daemon...{RESET}")

    log_path = get_log_file()
    os.makedirs(os.path.dirname(log_path), exist_ok=True)
    logfile = open(log_path, "a")
    proc = subprocess.Popen(
        [daemon_bin, "--port", str(DAEMON_PORT)],
        stdout=logfile,
        stderr=logfile,
        start_new_session=True
    )
    save_daemon_pid(proc.pid)

    for _ in range(25):
        time.sleep(0.2)
        if is_daemon_running():
            if not silent:
                print(f"{GREEN}[✓] Zoth Vault daemon active on port {DAEMON_PORT} (PID: {proc.pid}){RESET}")
            return True

    print(f"{RED}[!] Timed out waiting for Zoth Vault daemon.{RESET}", file=sys.stderr)
    return False

def daemon_stop(silent=False):
    if not is_daemon_running():
        if not silent:
            print(f"{YELLOW}[*] Zoth Vault daemon is not running.{RESET}")
        clear_daemon_pid()
        clear_session()
        return True

    pid = get_daemon_pid()
    if pid:
        try:
            os.kill(pid, signal.SIGTERM)
            for _ in range(15):
                time.sleep(0.2)
                try:
                    os.kill(pid, 0)
                except OSError:
                    break
        except Exception:
            pass

    if is_daemon_running():
        subprocess.run(["pkill", "-f", "zoth-vault-daemon"], capture_output=True)
        time.sleep(0.5)

    clear_daemon_pid()
    clear_session()

    stopped = not is_daemon_running()
    if stopped:
        if not silent:
            print(f"{GREEN}[✓] Zoth Vault daemon stopped. Session cleared.{RESET}")
        return True
    else:
        if not silent:
            print(f"{RED}[!] Failed to stop Zoth Vault daemon.{RESET}", file=sys.stderr)
        return False

def daemon_restart():
    print(f"{GRAY}[*] Restarting Zoth Vault daemon...{RESET}")
    daemon_stop(silent=True)
    time.sleep(0.5)
    return daemon_start()

# ─────────────────────────────────────────────────────────────────────────────
# REST CLIENT API HELPER
# ─────────────────────────────────────────────────────────────────────────────

def api_request(method, endpoint, data=None, token=None, timeout=5.0):
    url = f"{API_BASE}{endpoint}"
    headers = {"User-Agent": "ZothVaultCLI/3.5"}
    body = None
    if data is not None:
        headers["Content-Type"] = "application/json"
        body = json.dumps(data).encode("utf-8")
    if token:
        headers["Authorization"] = f"Bearer {token}"
    req = urllib.request.Request(url, data=body, headers=headers, method=method)
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            status = resp.status
            res_body = resp.read().decode("utf-8")
            if res_body:
                try:
                    return status, json.loads(res_body)
                except Exception:
                    return status, {"raw": res_body}
            return status, {}
    except urllib.error.HTTPError as e:
        err_body = e.read().decode("utf-8")
        try:
            err_json = json.loads(err_body)
        except Exception:
            err_json = {"error": err_body or str(e)}
        return e.code, err_json
    except Exception as e:
        return 0, {"error": str(e)}

def guess_provider(name, secret):
    s = secret or ""
    n = (name or "").upper()
    if s.startswith("sk-ant-"):
        return "anthropic"
    if s.startswith("sk-or-"):
        return "openrouter"
    if s.startswith("gsk_"):
        return "groq"
    if s.startswith("sk_live_") or s.startswith("sk_test_"):
        return "stripe"
    if s.startswith("hf_"):
        return "huggingface"
    if s.startswith("tvly-"):
        return "tavily"
    if "OPENAI" in n:
        return "openai"
    if "ANTHROPIC" in n:
        return "anthropic"
    if "XAI" in n or "GROK" in n:
        return "xai"
    if "GITHUB" in n:
        return "github"
    if "COHERE" in n:
        return "cohere"
    if "MISTRAL" in n:
        return "mistral"
    if "DEEPSEEK" in n:
        return "deepseek"
    if "GEMINI" in n or "GOOGLE" in n:
        return "google"
    return "custom"

# ─────────────────────────────────────────────────────────────────────────────
# TOKEN & AUTH RESOLUTION
# ─────────────────────────────────────────────────────────────────────────────

def get_valid_token(prompt_if_needed=True):
    if not ensure_daemon(silent=True):
        print(f"{RED}[!] Cannot connect to Zoth Vault daemon.{RESET}", file=sys.stderr)
        return None

    token = load_session_token()
    if token and is_session_valid(token):
        return token

    status, status_data = api_request("GET", "/v1/status")
    if not status_data.get("exists", False):
        print(f"{YELLOW}[!] Sovereign vault has not been initialized. Please run 'zoth-vault init' first.{RESET}", file=sys.stderr)
        return None

    if not prompt_if_needed:
        return None

    passphrase = os.environ.get("ZOTH_VAULT_PASSPHRASE")
    if not passphrase:
        if not sys.stdin.isatty():
            print(f"{RED}[!] Vault is locked. Run 'zoth-vault unlock' or set ZOTH_VAULT_PASSPHRASE.{RESET}", file=sys.stderr)
            return None
        try:
            passphrase = getpass.getpass(f"{GOLD}[?] Enter vault master passphrase to unlock: {RESET}")
        except (KeyboardInterrupt, EOFError):
            print("\nAborted.", file=sys.stderr)
            return None

    if not passphrase:
        print(f"{RED}[!] Passphrase cannot be empty.{RESET}", file=sys.stderr)
        return None

    status_code, res = api_request("POST", "/v1/vault/unlock", data={"passphrase": passphrase.strip()})
    if status_code == 200 and res.get("ok"):
        token = res["session_token"]
        save_session_token(token, res.get("expires_at"))
        return token
    else:
        err = res.get("error", "Unlock failed")
        print(f"{RED}[!] Unlock error: {err}{RESET}", file=sys.stderr)
        return None

# ─────────────────────────────────────────────────────────────────────────────
# CLI SUBCOMMAND IMPLEMENTATIONS
# ─────────────────────────────────────────────────────────────────────────────

def cmd_status(as_json=False):
    running = is_daemon_running()
    pid = get_daemon_pid() if running else None

    daemon_status = {}
    security_status = {}
    if running:
        _, daemon_status = api_request("GET", "/v1/status")
        _, security_status = api_request("GET", "/v1/security")

    daemon_bin = get_daemon_bin()
    offline_data = {}
    if daemon_bin:
        try:
            res = subprocess.run([daemon_bin, "status"], capture_output=True, text=True)
            if res.returncode == 0:
                offline_data = json.loads(res.stdout)
        except Exception:
            pass

    session_file = get_session_file()
    token = load_session_token()
    session_active = is_session_valid(token) if running else False

    if as_json:
        combined = {
            "daemon": {
                "running": running,
                "port": DAEMON_PORT,
                "pid": pid,
                "status": daemon_status,
                "security": security_status,
            },
            "disk": offline_data,
            "session": {
                "file": session_file,
                "active": session_active,
            }
        }
        print(json.dumps(combined, indent=2))
        return 0

    print(f"\n{BOLD}{GOLD}══════════════════════════════════════════════════════════════════════════{RESET}")
    print(f"  {BOLD}ZOTH SOVEREIGN VAULT & SECRETS ENGINE STATUS{RESET}")
    print(f"{BOLD}{GOLD}══════════════════════════════════════════════════════════════════════════{RESET}\n")

    print(f"  {BOLD}DAEMON RUNTIME:{RESET}")
    if running:
        print(f"    Status:         {GREEN}ONLINE{RESET} (Listening on 127.0.0.1:{DAEMON_PORT})")
        print(f"    PID:            {CYAN}{pid or 'active'}{RESET}")
        backend = daemon_status.get("backend", "rust-argon2id-xchacha20poly1305")
        print(f"    Backend:        {GREEN}{backend}{RESET}")
        unlocked = daemon_status.get("unlocked", False)
        lock_str = f"{GREEN}UNLOCKED{RESET}" if unlocked else f"{YELLOW}LOCKED{RESET}"
        print(f"    Vault State:    {lock_str}")
        if unlocked:
            keys = daemon_status.get("key_count", 0)
            rem = daemon_status.get("remaining_secs", 0)
            exp = daemon_status.get("expires_at", "N/A")
            print(f"    Active Keys:    {CYAN}{keys}{RESET}")
            print(f"    Remaining TTL:  {CYAN}{rem}s{RESET} (Expires: {exp})")
        grade = security_status.get("grade")
        score = security_status.get("score")
        if grade:
            grade_color = GREEN if grade in ("A", "A+") else YELLOW
            print(f"    Security Grade: {grade_color}{grade} ({score}% checks passed){RESET}")
    else:
        print(f"    Status:         {RED}OFFLINE{RESET}")
        print(f"    Target:         127.0.0.1:{DAEMON_PORT} (Loopback Enforced, Zero-Leak)")
        print(f"    Start with:     {BOLD}zoth-vault daemon start{RESET}")

    print(f"\n  {BOLD}ON-DISK VAULT STORAGE:{RESET}")
    exists = offline_data.get("exists") if "exists" in offline_data else daemon_status.get("exists", False)
    v_path = offline_data.get("vault_path") or daemon_status.get("vault_path", "N/A")
    d_path = offline_data.get("data_dir", os.path.dirname(v_path) if v_path != "N/A" else "N/A")
    v_mode = offline_data.get("vault_mode") or daemon_status.get("vault_mode", "N/A")
    v_bytes = offline_data.get("vault_bytes") or daemon_status.get("vault_bytes", 0)
    audit_path = offline_data.get("audit_path", "N/A")

    exists_str = f"{GREEN}YES{RESET}" if exists else f"{YELLOW}NO (run 'zoth-vault init'){RESET}"
    print(f"    Vault Exists:   {exists_str}")
    print(f"    Vault Path:     {v_path}")
    mode_str = f"{GREEN}{v_mode}{RESET}" if v_mode == "600" else f"{RED}{v_mode} (Expected 0600!){RESET}"
    print(f"    Vault Mode:     {mode_str}")
    print(f"    Vault Size:     {v_bytes} bytes")
    print(f"    Data Directory: {d_path}")
    print(f"    Audit Log:      {audit_path}")

    print(f"\n  {BOLD}SESSION CACHE:{RESET}")
    print(f"    Session File:   {session_file}")
    if os.path.isfile(session_file):
        try:
            mode_octal = oct(stat.S_IMODE(os.stat(session_file).st_mode))[2:]
            mode_ok = mode_octal == "600"
            m_str = f"{GREEN}{mode_octal} (0600 ENFORCED){RESET}" if mode_ok else f"{RED}{mode_octal} (INSECURE!){RESET}"
            print(f"    File Mode:      {m_str}")
        except Exception:
            pass
        print(f"    Session State:  {GREEN}ACTIVE & VALID{RESET}" if session_active else f"{YELLOW}EXPIRED / INACTIVE{RESET}")
    else:
        print(f"    Session State:  {GRAY}None (No cached token){RESET}")

    print(f"\n{BOLD}{GOLD}══════════════════════════════════════════════════════════════════════════{RESET}\n")
    return 0

def cmd_init(passphrase=None):
    if not ensure_daemon():
        return 1

    code, status_data = api_request("GET", "/v1/status")
    if code == 200 and status_data.get("exists", False):
        print(f"{YELLOW}[!] Sovereign vault already exists at {status_data.get('vault_path')}.{RESET}")
        print(f"    To reinitialize, wipe or remove the existing vault file.")
        return 1

    if not passphrase:
        if not sys.stdin.isatty():
            print(f"{RED}[!] Passphrase required for non-interactive init. Pass as argument.{RESET}", file=sys.stderr)
            return 1
        try:
            print(f"{CYAN}{BOLD}Initialize Zoth Sovereign Vault{RESET}")
            print(f"{GRAY}Argon2id (m=64MiB, t=3, p=1) + XChaCha20-Poly1305 AEAD{RESET}\n")
            p1 = getpass.getpass(f"{GOLD}[?] Enter master passphrase (min 12 chars): {RESET}")
            if len(p1.strip()) < 12:
                print(f"{RED}[!] Passphrase must be at least 12 characters.{RESET}")
                return 1
            p2 = getpass.getpass(f"{GOLD}[?] Confirm master passphrase: {RESET}")
            if p1 != p2:
                print(f"{RED}[!] Passphrases do not match.{RESET}")
                return 1
            passphrase = p1.strip()
        except (KeyboardInterrupt, EOFError):
            print("\nAborted.")
            return 1

    if len(passphrase.strip()) < 12:
        print(f"{RED}[!] Passphrase must be at least 12 characters.{RESET}", file=sys.stderr)
        return 1

    code, res = api_request("POST", "/v1/vault/init", data={"passphrase": passphrase.strip()})
    if code == 200 and res.get("ok"):
        print(f"{GREEN}{BOLD}[✓] Sovereign vault initialized successfully!{RESET}")
        u_code, u_res = api_request("POST", "/v1/vault/unlock", data={"passphrase": passphrase.strip()})
        if u_code == 200 and u_res.get("ok"):
            token = u_res["session_token"]
            save_session_token(token, u_res.get("expires_at"))
            print(f"{GREEN}[✓] Vault unlocked and session cached at {get_session_file()} (mode 0600).{RESET}")
        return 0
    else:
        err = res.get("error", "Init failed")
        print(f"{RED}[!] Initialization failed: {err}{RESET}", file=sys.stderr)
        return 1

def cmd_daemon(action="status"):
    act = (action or "status").lower()
    if act == "start":
        return 0 if daemon_start() else 1
    elif act == "stop":
        return 0 if daemon_stop() else 1
    elif act == "restart":
        return 0 if daemon_restart() else 1
    elif act == "status":
        running = is_daemon_running()
        pid = get_daemon_pid() if running else None
        if running:
            print(f"{GREEN}[✓] Zoth Vault daemon is RUNNING on 127.0.0.1:{DAEMON_PORT} (PID: {pid or 'unknown'}){RESET}")
            return 0
        else:
            print(f"{RED}[✗] Zoth Vault daemon is STOPPED.{RESET}")
            return 1
    else:
        print(f"{RED}[!] Unknown daemon action '{action}'. Choose: start, stop, restart, status.{RESET}")
        return 1

def cmd_unlock(passphrase=None):
    if not ensure_daemon():
        return 1

    token = load_session_token()
    if token and is_session_valid(token):
        _, sess = api_request("GET", "/v1/session", token=token)
        rem = sess.get("remaining_secs", "unknown")
        print(f"{GREEN}[✓] Vault is already unlocked.{RESET} (Active session cached, {rem}s remaining)")
        return 0

    if not passphrase:
        passphrase = os.environ.get("ZOTH_VAULT_PASSPHRASE")
    if not passphrase:
        try:
            passphrase = getpass.getpass(f"{GOLD}[?] Enter master vault passphrase: {RESET}")
        except (KeyboardInterrupt, EOFError):
            print("\nAborted.")
            return 1

    if not passphrase:
        print(f"{RED}[!] Passphrase cannot be empty.{RESET}")
        return 1

    code, res = api_request("POST", "/v1/vault/unlock", data={"passphrase": passphrase.strip()})
    if code == 200 and res.get("ok"):
        token = res["session_token"]
        save_session_token(token, res.get("expires_at"))
        s_file = get_session_file()
        count = res.get("key_count", 0)
        exp = res.get("expires_at", "N/A")
        print(f"{GREEN}{BOLD}[✓] Vault unlocked successfully!{RESET}")
        print(f"    {GRAY}Session Token:{RESET} Cached in {s_file} (mode 0600)")
        print(f"    {GRAY}Active Keys:{RESET}   {count} secret(s) loaded into memory")
        print(f"    {GRAY}Expires At:{RESET}    {exp}")
        return 0
    else:
        err = res.get("error", "Authentication failed")
        lockout = res.get("lockout_secs")
        if lockout:
            print(f"{RED}[!] Rate limit lockout: {err} ({lockout}s){RESET}")
        else:
            print(f"{RED}[!] Unlock failed: {err}{RESET}")
        return 1

def cmd_lock():
    token = load_session_token()
    if token and is_daemon_running():
        api_request("POST", "/v1/vault/lock", token=token)
    clear_session()
    print(f"{GREEN}[✓] Sovereign vault locked.{RESET}")
    print(f"    {GRAY}Session token cleared and secret memory purged.{RESET}")
    return 0

def print_table(headers, rows):
    widths = [len(h) for h in headers]
    for row in rows:
        for i, val in enumerate(row):
            widths[i] = max(widths[i], len(str(val)))

    def border(char_left, char_mid, char_right, char_line):
        return char_left + char_mid.join([char_line * (w + 2) for w in widths]) + char_right

    def format_row(row, is_header=False):
        cells = []
        for i, val in enumerate(row):
            s = str(val)
            pad = widths[i] - len(s)
            if is_header:
                cell = f" {BOLD}{GOLD}{s}{RESET}{' ' * pad} "
            else:
                if i == 1:
                    cell = f" {GREEN}{s}{RESET}{' ' * pad} "
                elif i == 4:
                    cell = f" {YELLOW}{s}{RESET}{' ' * pad} "
                elif i == 3:
                    cell = f" {CYAN}{s}{RESET}{' ' * pad} "
                else:
                    cell = f" {s}{' ' * pad} "
            cells.append(cell)
        return "│" + "│".join(cells) + "│"

    top = border("┌", "┬", "┐", "─")
    mid = border("├", "┼", "┤", "─")
    bot = border("└", "┴", "┘", "─")

    print(f"{GRAY}{top}{RESET}")
    print(format_row(headers, is_header=True))
    print(f"{GRAY}{mid}{RESET}")
    for row in rows:
        print(format_row(row))
    print(f"{GRAY}{bot}{RESET}")

def cmd_list(as_json=False, filter_tag=None, filter_provider=None):
    token = get_valid_token()
    if not token:
        return 1

    code, keys = api_request("GET", "/v1/keys", token=token)
    if code != 200:
        print(f"{RED}[!] Failed to list secrets: {keys.get('error', 'unknown error')}{RESET}", file=sys.stderr)
        return 1

    if filter_tag:
        keys = [k for k in keys if filter_tag in k.get("tags", [])]
    if filter_provider:
        keys = [k for k in keys if k.get("provider", "").lower() == filter_provider.lower()]

    if as_json:
        print(json.dumps(keys, indent=2))
        return 0

    if not keys:
        print(f"\n{YELLOW}[*] No secrets found in sovereign vault.{RESET}")
        print(f"    Use {BOLD}zoth-vault set <NAME> <VALUE>{RESET} or {BOLD}zoth-vault import <file.env>{RESET} to add keys.\n")
        return 0

    headers = ["ID", "LABEL", "ENV VAR", "PROVIDER", "SECRET (MASKED)", "TAGS", "UPDATED"]
    rows = []
    for k in keys:
        kid = k.get("id", "")
        label = k.get("label", "")
        env = k.get("env") or f"{label.upper().replace('-', '_')}_API_KEY"
        provider = k.get("provider", "custom")
        preview = k.get("secret_preview", "••••••••")
        tags = ", ".join(k.get("tags", [])) or "-"
        last_used = k.get("last_used") or k.get("created", 0)
        if last_used:
            try:
                date_str = datetime.datetime.fromtimestamp(last_used / 1000.0).strftime("%Y-%m-%d %H:%M")
            except Exception:
                date_str = "-"
        else:
            date_str = "-"
        rows.append([kid, label, env, provider, preview, tags, date_str])

    print_table(headers, rows)
    print(f"\n{CYAN}Total:{RESET} {len(keys)} secret(s) in sovereign vault. (Secrets masked at rest and list)\n")
    return 0

def resolve_key_id(key_target, token):
    code, keys = api_request("GET", "/v1/keys", token=token)
    if code != 200 or not isinstance(keys, list):
        return None, None
    # 1. Exact matches
    for k in keys:
        if k.get("id") == key_target:
            return k["id"], k
        if k.get("label", "").lower() == key_target.lower():
            return k["id"], k
        if (k.get("env") or "").lower() == key_target.lower():
            return k["id"], k
    # 2. Prefix matches on ID
    for k in keys:
        if k.get("id", "").lower().startswith(key_target.lower()):
            return k["id"], k
    return None, None

def cmd_get(key_target, as_json=False):
    token = get_valid_token()
    if not token:
        return 1

    matched_id, _ = resolve_key_id(key_target, token)
    if not matched_id:
        print(f"{RED}[!] Secret '{key_target}' not found in vault.{RESET}", file=sys.stderr)
        return 1

    code, secret_obj = api_request("GET", f"/v1/keys/{matched_id}", token=token)
    if code != 200:
        print(f"{RED}[!] Failed to reveal secret: {secret_obj.get('error')}{RESET}", file=sys.stderr)
        return 1

    if as_json:
        print(json.dumps(secret_obj, indent=2))
    else:
        raw_secret = secret_obj.get("secret", "")
        if sys.stdout.isatty():
            sys.stdout.write(raw_secret + "\n")
        else:
            sys.stdout.write(raw_secret)
        sys.stdout.flush()
    return 0

def cmd_set(name, value=None, provider=None, tags=None, env=None):
    token = get_valid_token()
    if not token:
        return 1

    if value is None or value == "":
        if not sys.stdin.isatty():
            value = sys.stdin.read().strip()
        else:
            try:
                value = getpass.getpass(f"{GOLD}[?] Enter secret value for '{name}': {RESET}")
            except (KeyboardInterrupt, EOFError):
                print("\nAborted.")
                return 1
    elif value == "-":
        value = sys.stdin.read().strip()

    if not value:
        print(f"{RED}[!] Secret value cannot be empty.{RESET}", file=sys.stderr)
        return 1

    existing_id, existing_meta = resolve_key_id(name, token)
    if existing_meta:
        if not provider and existing_meta.get("provider"):
            provider = existing_meta["provider"]
        if tags is None and existing_meta.get("tags"):
            tags = existing_meta["tags"]
        if not env and existing_meta.get("env"):
            env = existing_meta["env"]

    if not provider:
        provider = guess_provider(name, value)

    tag_list = []
    if isinstance(tags, list):
        tag_list = tags
    elif isinstance(tags, str):
        tag_list = [t.strip() for t in tags.split(",") if t.strip()]
    if not tag_list:
        tag_list = ["cli"]

    if not env:
        env = name.upper().replace("-", "_")

    payload = {
        "provider": provider,
        "label": name,
        "secret": value,
        "tags": tag_list,
        "favorite": False,
        "env": env,
    }
    if existing_id:
        payload["id"] = existing_id

    code, res = api_request("POST", "/v1/keys", data=payload, token=token)
    if code in (200, 201):
        action = "Updated" if existing_id else "Stored"
        kid = res.get("id", existing_id or "")
        print(f"{GREEN}[✓] {action} secret '{name}' in sovereign vault.{RESET}")
        print(f"    {GRAY}ID:{RESET}       {kid}")
        print(f"    {GRAY}Provider:{RESET} {provider}")
        print(f"    {GRAY}Env Var:{RESET}  {env}")
        print(f"    {GRAY}Tags:{RESET}     {', '.join(tag_list)}")
        return 0
    else:
        err = res.get("error", "Failed to store secret")
        print(f"{RED}[!] Error storing secret: {err}{RESET}", file=sys.stderr)
        return 1

def cmd_delete(key_target, force=False):
    token = get_valid_token()
    if not token:
        return 1

    matched_id, target_key = resolve_key_id(key_target, token)
    if not matched_id:
        print(f"{RED}[!] Secret '{key_target}' not found in vault.{RESET}", file=sys.stderr)
        return 1

    klabel = target_key.get("label", matched_id)

    if not force and sys.stdin.isatty():
        try:
            confirm = input(f"{YELLOW}[?] Delete secret '{klabel}' ({matched_id})? [y/N]: {RESET}").strip().lower()
            if confirm not in ("y", "yes"):
                print("Cancelled.")
                return 0
        except (KeyboardInterrupt, EOFError):
            print("\nCancelled.")
            return 0

    code, res = api_request("DELETE", f"/v1/keys/{matched_id}", token=token)
    if code == 200:
        print(f"{GREEN}[✓] Secret '{klabel}' (ID: {matched_id}) deleted successfully.{RESET}")
        return 0
    else:
        print(f"{RED}[!] Failed to delete secret: {res.get('error')}{RESET}", file=sys.stderr)
        return 1

def cmd_export(fmt="env", passphrase=None, decrypted=False, out_file=None):
    token = get_valid_token()
    if not token:
        return 1

    fmt = (fmt or "env").lower()
    if fmt == "env":
        code, res = api_request("POST", "/v1/export/env", token=token)
        if code != 200:
            print(f"{RED}[!] Export failed: {res.get('error')}{RESET}", file=sys.stderr)
            return 1
        output = res.get("env", "")
    elif fmt == "json":
        if decrypted:
            code, keys = api_request("GET", "/v1/keys", token=token)
            if code != 200:
                print(f"{RED}[!] Export failed: {keys.get('error')}{RESET}", file=sys.stderr)
                return 1
            decrypted_list = []
            for k in keys:
                c2, reveal = api_request("GET", f"/v1/keys/{k['id']}", token=token)
                if c2 == 200:
                    decrypted_list.append(reveal)
                else:
                    decrypted_list.append(k)
            output = json.dumps({"keys": decrypted_list}, indent=2)
        else:
            if not passphrase:
                passphrase = os.environ.get("ZOTH_EXPORT_PASSPHRASE")
            if not passphrase and sys.stdin.isatty():
                try:
                    passphrase = getpass.getpass(f"{GOLD}[?] Enter export encryption passphrase (min 12 chars): {RESET}")
                except (KeyboardInterrupt, EOFError):
                    print("\nAborted.")
                    return 1
            if not passphrase or len(passphrase.strip()) < 12:
                print(f"{RED}[!] Export passphrase must be at least 12 characters.{RESET}", file=sys.stderr)
                return 1
            code, res = api_request("POST", "/v1/export/json", data={"export_passphrase": passphrase.strip()}, token=token)
            if code != 200:
                print(f"{RED}[!] Export failed: {res.get('error')}{RESET}", file=sys.stderr)
                return 1
            output = json.dumps(res, indent=2)
    else:
        print(f"{RED}[!] Unknown export format '{fmt}'. Choose 'env' or 'json'.{RESET}", file=sys.stderr)
        return 1

    if out_file:
        try:
            fd = os.open(out_file, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
            with os.fdopen(fd, "w") as f:
                f.write(output)
            print(f"{GREEN}[✓] Exported secrets ({fmt}) to {out_file} (mode 0600){RESET}")
        except Exception as e:
            print(f"{RED}[!] Failed to write export file: {e}{RESET}", file=sys.stderr)
            return 1
    else:
        sys.stdout.write(output + ("\n" if not output.endswith("\n") else ""))
        sys.stdout.flush()
    return 0

def cmd_import(file_path):
    token = get_valid_token()
    if not token:
        return 1

    if file_path == "-":
        content = sys.stdin.read()
    else:
        if not os.path.isfile(file_path):
            print(f"{RED}[!] Import file not found: {file_path}{RESET}", file=sys.stderr)
            return 1
        with open(file_path, "r", encoding="utf-8") as f:
            content = f.read()

    if not content.strip():
        print(f"{YELLOW}[!] Import file is empty.{RESET}")
        return 0

    code, res = api_request("POST", "/v1/import/env", data={"text": content}, token=token)
    if code == 200:
        added = res.get("added", 0)
        print(f"{GREEN}[✓] Successfully imported {added} secret(s) into sovereign vault.{RESET}")
        return 0
    else:
        print(f"{RED}[!] Import failed: {res.get('error')}{RESET}", file=sys.stderr)
        return 1

def cmd_run(cmd_args):
    if not cmd_args:
        print(f"{RED}[!] No command specified to run.{RESET}\nUsage: zoth-vault run -- <command> [args...]", file=sys.stderr)
        return 1

    token = get_valid_token()
    if not token:
        return 1

    code, keys = api_request("GET", "/v1/keys", token=token)
    if code != 200:
        print(f"{RED}[!] Failed to fetch secrets from vault: {keys.get('error')}{RESET}", file=sys.stderr)
        return 1

    child_env = os.environ.copy()
    injected_count = 0

    for k in keys:
        kid = k["id"]
        c, reveal = api_request("GET", f"/v1/keys/{kid}", token=token)
        if c == 200 and "secret" in reveal:
            secret = reveal["secret"]
            env_name = reveal.get("env") or f"{reveal.get('label', '').upper().replace('-', '_')}_API_KEY"
            child_env[env_name] = secret
            injected_count += 1

            raw_label_var = reveal.get("label", "").upper().replace("-", "_")
            if raw_label_var and raw_label_var != env_name:
                child_env[raw_label_var] = secret

            if reveal.get("endpoint"):
                base_env = env_name.removesuffix("_API_KEY").removesuffix("_TOKEN").removesuffix("_SECRET")
                child_env[f"{base_env}_BASE_URL"] = reveal["endpoint"]

    c_env, res_env = api_request("POST", "/v1/export/env", token=token)
    if c_env == 200 and "env" in res_env:
        for line in res_env["env"].splitlines():
            line = line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            ek, ev = line.split("=", 1)
            ek = ek.strip().removeprefix("export ")
            ev = ev.strip().strip("'\"")
            if ek and ev and ek not in child_env:
                child_env[ek] = ev

    child_env["ZOTH_VAULT_INJECTED"] = "1"

    # In-memory execution: zero secrets written to disk
    try:
        os.execvpe(cmd_args[0], cmd_args, child_env)
    except FileNotFoundError:
        print(f"{RED}[!] Command not found: {cmd_args[0]}{RESET}", file=sys.stderr)
        sys.exit(127)
    except Exception as e:
        print(f"{RED}[!] Execution failed: {e}{RESET}", file=sys.stderr)
        sys.exit(1)

