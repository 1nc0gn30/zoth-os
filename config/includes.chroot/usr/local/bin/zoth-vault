  {BOLD}{GOLD}└───┴───────────────────────────────────────────────────────────────────┘{RESET}
""")

        print(f"  {BOLD}{GOLD}[1]{RESET}  {BOLD}Vault Status & Diagnostics{RESET}      {GRAY}(Inspect bw status JSON){RESET}")
        print(f"  {BOLD}{GREEN}[2]{RESET}  {BOLD}Log In to Account{RESET}               {GRAY}(Interactive bw login){RESET}")
        print(f"  {BOLD}{CYAN}[3]{RESET}  {BOLD}Unlock Vault & Export Session{RESET}   {GRAY}(Decrypts vault into BW_SESSION){RESET}")
        print(f"  {BOLD}{YELLOW}[4]{RESET}  {BOLD}List Vault Items (Pretty){RESET}       {GRAY}(bw list items --pretty){RESET}")
        print(f"  {BOLD}{GOLD}[5]{RESET}  {BOLD}Get Password / Secret{RESET}           {GRAY}(bw get password <id/name>){RESET}")
        print(f"  {BOLD}{GOLD}[6]{RESET}  {BOLD}Get Username{RESET}                    {GRAY}(bw get username <id/name>){RESET}")
        print(f"  {BOLD}{CYAN}[7]{RESET}  {BOLD}Get 2FA TOTP Verification Code{RESET}  {GRAY}(bw get totp <id/name>){RESET}")
