#!/usr/bin/env bash
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
ROOT_DIR="$(dirname "$SCRIPT_DIR")"
if [[ ! -d "$ROOT_DIR/egregore" ]]; then
  for cand in "$HOME/NullAITech/zoth-egregore" "/opt/zoth-egregore"; do
    if [[ -d "$cand/egregore" ]]; then
      ROOT_DIR="$cand"
      break
    fi
  done
fi
export PYTHONPATH="$ROOT_DIR${PYTHONPATH:+:$PYTHONPATH}"
exec python3 -m egregore "$@"
