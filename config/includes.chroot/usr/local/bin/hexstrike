#!/usr/bin/env bash
# Unified Portable HexStrike Security Arsenal CLI Wrapper (v3.2.0)
# Resolves repo cleanly via $HOME or /opt/hexstrike-arsenal with zero hardcoded user paths.
set -euo pipefail

find_hexstrike_root() {
  local candidates=(
    "${HEXSTRIKE_ROOT:-}"
    "$HOME/NullAITech/NullAI-HexStrike-AI-Terminal"
    "$HOME/NullAITech/hexstrike-arsenal"
    "/opt/hexstrike-arsenal"
  )
  for dir in "${candidates[@]}"; do
    if [[ -n "$dir" && -f "$dir/cli.py" ]]; then
      printf '%s\n' "$dir"
      return 0
    fi
  done
  return 1
}

ROOT_DIR="$(find_hexstrike_root || true)"
if [[ -z "$ROOT_DIR" ]]; then
  echo "Error: hexstrike-arsenal cli.py not found in \$HOME/NullAITech/NullAI-HexStrike-AI-Terminal or /opt/hexstrike-arsenal" >&2
  exit 1
fi

case "${1:-}" in
  --tui|tui)
    shift
    if command -v hexstrike-arsenal-tui >/dev/null 2>&1; then
      exec hexstrike-arsenal-tui "$@"
    elif [[ -x "$ROOT_DIR/bin/hexstrike-arsenal-tui" ]]; then
      exec "$ROOT_DIR/bin/hexstrike-arsenal-tui" "$@"
    fi
    ;;
  desktop|--electron|electron)
    shift
    if [[ -f "$ROOT_DIR/electron/main.cjs" ]] && command -v electron >/dev/null 2>&1; then
      exec electron "$ROOT_DIR/electron/main.cjs" "$@"
    fi
    exec python3 "$ROOT_DIR/cli.py" serve --host 127.0.0.1 --port 8138 "$@"
    ;;
  web)
    shift
    exec python3 "$ROOT_DIR/cli.py" serve --host 127.0.0.1 --port 8138 "$@"
    ;;
  --status)
    shift
    exec python3 "$ROOT_DIR/cli.py" status "$@"
    ;;
  --info|--ui|--studio)
    shift
    exec python3 "$ROOT_DIR/cli.py" status "$@"
    ;;
esac

exec python3 "$ROOT_DIR/cli.py" "$@"
