HASH_PATH = CONFIG_DIR / "session-lock.hash"
SENTRY_DIR = Path(
    os.environ.get("ZOTH_SENTRY_DIR", Path.home() / "NullAITech" / "security-captures")
)
AUDIT_LOG_PATH = SENTRY_DIR / "lock-audit.jsonl"
SIGNAL_SOCKET_PATH = os.environ.get("SIGNAL_SOCKET_PATH", "/tmp/signal-cli.sock")
SENTRY_GRACE_SEC = float(os.environ.get("ZOTH_SENTRY_GRACE_SEC", "8.0"))
SENTRY_COOLDOWN_SEC = float(os.environ.get("ZOTH_SENTRY_COOLDOWN_SEC", "15.0"))
SENTRY_MOTION_MIN_AREA = int(os.environ.get("ZOTH_SENTRY_MOTION_MIN_AREA", "1500"))
SENTRY_MOTION_MIN_PCT = float(os.environ.get("ZOTH_SENTRY_MOTION_MIN_PCT", "0.65"))
SENTRY_LIVE_PORT = int(os.environ.get("ZOTH_SENTRY_PORT", "8499"))
WEBCAM_DEV = os.environ.get("ZOTH_WEBCAM_DEV", "/dev/video0")
RUNTIME_DIR = Path(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}"))
PID_PATH = RUNTIME_DIR / "zoth-lock.pid"
WALLPAPER = Path(
    os.environ.get(
        "ZOTH_LOCK_WALLPAPER",
        "/usr/share/backgrounds/zothos/zoth-gold-master.jpg",
    )
)
FONT_SANS = "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf"
FONT_SANS_BOLD = "/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf"
