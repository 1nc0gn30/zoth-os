HAIR = "#2A261C"

SCRYPT_N = 2**14
SCRYPT_R = 8
SCRYPT_P = 1
SCRYPT_DKLEN = 32
SALT_BYTES = 16
MIN_PASSWORD = 4
MAX_PASSWORD = 128
FAIL_LIMIT = 5
FAIL_BASE_SEC = 20

INHIBIT_WHAT = "sleep:idle:handle-lid-switch"


# ---------------------------------------------------------------------------
# Password record
# ---------------------------------------------------------------------------

def _now_iso() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def _now_local_str() -> str:
    return datetime.now().strftime("%Y-%m-%d %H:%M:%S %Z").strip()


_SENTRY_LOCK = threading.Lock()
_ACTIVE_CAM_LOCK = threading.Lock()
_ACTIVE_CAM_FRAME = None  # latest BGR numpy array from active CameraMotionSentry
_ACTIVE_HUD_JPEG: bytes | None = None  # latest HUD-annotated JPEG bytes for live stream
_LAST_STREAM_VIEWER_MONO: float = 0.0  # monotonic timestamp of last live-stream viewer request


def get_signal_recipient() -> str:
    """Resolve Signal recipient from env, ~/.config/zothos/sentry.json, or local signal-cli accounts.json."""
    env_val = os.environ.get("ZOTH_SIGNAL_RECIPIENT") or os.environ.get("SIGNAL_ACCOUNT")
    if env_val:
        return env_val.strip()
    try:
        cfg_file = CONFIG_DIR / "sentry.json"
        if cfg_file.is_file():
            data = json.loads(cfg_file.read_text(encoding="utf-8"))
            if data.get("signal_recipient"):
                return str(data["signal_recipient"]).strip()
    except Exception:
        pass
    try:
        acct_file = Path.home() / ".local" / "share" / "signal-cli" / "data" / "accounts.json"
        if acct_file.is_file():
            data = json.loads(acct_file.read_text(encoding="utf-8"))
            accts = data.get("accounts", [])
            if accts and accts[0].get("number"):
                return str(accts[0]["number"]).strip()
    except Exception:
        pass
    return ""


SIGNAL_RECIPIENT = get_signal_recipient()


def get_tailscale_ip() -> str:
    """Return the active Tailscale IPv4 address (100.x.y.z) from tailscale0, or fallback to 127.0.0.1."""
    try:
        out = subprocess.check_output(
            ["ip", "-4", "-o", "addr", "show", "dev", "tailscale0"],
            stderr=subprocess.DEVNULL,
            text=True,
            timeout=2.0,
        )
        for part in out.split():
            if "/" in part and part.startswith("100."):
                return part.split("/")[0]
    except Exception:
        pass
    return "127.0.0.1"


def get_live_view_url() -> str:
    return f"http://{get_tailscale_ip()}:{SENTRY_LIVE_PORT}"


def _is_tailscale_or_local_ip(ip_str: str) -> bool:
    """Allow ONLY Tailscale CGNAT (100.64.0.0/10) and local loopback (127.0.0.0/8)."""
    import ipaddress
    try:
        clean = ip_str.split("%")[0].strip()
        if clean.startswith("::ffff:"):
            clean = clean[7:]
        addr = ipaddress.ip_address(clean)
        ts_net = ipaddress.ip_network("100.64.0.0/10")
        lo_net = ipaddress.ip_network("127.0.0.0/8")
        return addr in ts_net or addr in lo_net or addr.is_loopback
    except Exception:
        return False


def sentry_log_event(event_type: str, **details) -> dict:
    """Append a structured JSONL audit entry to Home/NullAITech/security-captures/lock-audit.jsonl."""
    entry = {
        "ts_utc": _now_iso(),
        "ts_local": _now_local_str(),
        "event": event_type,
        **details,
    }
    try:
        SENTRY_DIR.mkdir(parents=True, exist_ok=True)
        os.chmod(SENTRY_DIR, 0o700)
        with _SENTRY_LOCK:
            with open(AUDIT_LOG_PATH, "a", encoding="utf-8") as f:
                f.write(json.dumps(entry) + "\n")
        os.chmod(AUDIT_LOG_PATH, 0o600)
    except Exception:
        pass
    return entry


def _annotate_sentry_frame(frame, label: str, bbox: tuple[int, int, int, int] | None = None, motion_pct: float | None = None):
    """Draw a subtle Zoth Gold tactical HUD timestamp bar and optional motion bounding box."""
    try:
        import cv2
        out = frame.copy()
        h, w = out.shape[:2]
        if bbox is not None:
            bx, by, bw, bh = bbox
            cv2.rectangle(out, (bx, by), (bx + bw, by + bh), (55, 175, 212), 2)
            tag_txt = f"MOTION {motion_pct:.1f}%" if motion_pct is not None else "MOTION"
            cv2.rectangle(out, (bx, max(0, by - 20)), (min(w, bx + 135), by), (18, 20, 28), -1)
            cv2.putText(
                out,
                tag_txt,
                (bx + 5, max(14, by - 5)),
                cv2.FONT_HERSHEY_SIMPLEX,
                0.45,
                (55, 175, 212),
                1,
                cv2.LINE_AA,
            )
        cv2.rectangle(out, (0, h - 28), (w, h), (11, 15, 23), -1)
        cv2.line(out, (0, h - 28), (w, h - 28), (55, 175, 212), 1)
        hud_text = f"ZOTH SENTRY // {_now_local_str()} // {label[:42]}"
        cv2.putText(
            out,
            hud_text,
            (10, h - 9),
            cv2.FONT_HERSHEY_SIMPLEX,
            0.44,
            (232, 228, 217),
            1,
            cv2.LINE_AA,
        )
        return out
    except Exception:
        return frame


def sentry_snap_webcam(tag: str = "intruder", label: str = "SENTRY CAPTURE") -> Path | None:
    """Silently capture a single auto-exposed JPEG frame from active stream, local live daemon, or /dev/video0."""
    try:
        SENTRY_DIR.mkdir(parents=True, exist_ok=True)
        os.chmod(SENTRY_DIR, 0o700)
        stamp = datetime.now().strftime("%Y%m%d-%H%M%S")
        safe_tag = "".join(c if c.isalnum() or c in "-_" else "_" for c in tag)
        out_path = SENTRY_DIR / f"sentry-{stamp}-{safe_tag}.jpg"

        # 1. In-process active camera frame
        with _ACTIVE_CAM_LOCK:
            live_frame = _ACTIVE_CAM_FRAME.copy() if _ACTIVE_CAM_FRAME is not None else None
        if live_frame is not None:
            import cv2
            annotated = _annotate_sentry_frame(live_frame, label=label)
            if cv2.imwrite(str(out_path), annotated, [int(cv2.IMWRITE_JPEG_QUALITY), 92]):
                os.chmod(out_path, 0o600)
                return out_path

        # 2. If background Tailscale Live Sentry daemon holds /dev/video0 on :8499, fetch frame.jpg
        try:
            import urllib.request
            with urllib.request.urlopen(f"http://127.0.0.1:{SENTRY_LIVE_PORT}/frame.jpg", timeout=1.5) as resp:
                jpg_bytes = resp.read()
                if jpg_bytes and len(jpg_bytes) > 2000:
                    out_path.write_bytes(jpg_bytes)
                    os.chmod(out_path, 0o600)
                    return out_path
        except Exception:
            pass

        # 3. Fallback to direct ffmpeg v4l2 capture
        ffmpeg = shutil.which("ffmpeg")
        if not ffmpeg or not Path(WEBCAM_DEV).exists():
            return None
        proc = subprocess.run(
            [
                ffmpeg,
                "-y",
                "-loglevel",
                "error",
                "-f",
                "v4l2",
                "-i",
                WEBCAM_DEV,
                "-vf",
                "select=gte(n\\,8)",
                "-frames:v",
                "1",
                "-update",
                "1",
                str(out_path),
            ],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=6.0,
            check=False,
        )
        if proc.returncode == 0 and out_path.is_file() and out_path.stat().st_size > 0:
            os.chmod(out_path, 0o600)
            return out_path
    except Exception:
        pass
    return None


def sentry_send_signal_alert(message: str, photo_path: Path | None = None) -> bool:
    """Send an instant Signal alert (with optional webcam photo) over /tmp/signal-cli.sock."""
    sock_path = Path(SIGNAL_SOCKET_PATH)
    if not sock_path.exists():
        return False
    params: dict = {
        "recipient": [SIGNAL_RECIPIENT],
        "message": message,
    }
    if photo_path and photo_path.is_file():
        params["attachment"] = [str(photo_path)]
    payload = {
        "jsonrpc": "2.0",
        "method": "send",
        "params": params,
        "id": f"zoth-lock-sentry-{int(time.time() * 1000)}",
    }
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
            s.settimeout(12.0)
            s.connect(str(sock_path))
            s.sendall((json.dumps(payload) + "\n").encode("utf-8"))
            resp = s.recv(4096)
            return b'"error"' not in resp
    except Exception:
        return False


def sentry_trigger_async(reason: str, label: str, state: dict | None = None) -> None:
    """Background worker: snap webcam photo, log to audit JSONL, and dispatch Signal alert."""
    def _worker() -> None:
        photo = sentry_snap_webcam(tag=reason, label=label)
        if state is not None and photo is not None:
            state["captures"] = state.get("captures", 0) + 1
        entry = sentry_log_event(
            "sentry_alert",
            reason=reason,
            label=label,
            photo=str(photo) if photo else None,
        )
        msg = (
            f"🚨 [ZOTH LOCK SENTRY ALERT]\n"
            f"• Event: {label}\n"
            f"• Time: {entry['ts_local']}\n"
            f"• Live View (Tailscale): {get_live_view_url()}\n"
            f"• Photo: {photo if photo else 'webcam busy/unavailable'}\n"
            f"• Audit Log: {AUDIT_LOG_PATH}"
        )
        sentry_send_signal_alert(msg, photo_path=photo)

    t = threading.Thread(target=_worker, daemon=True)
    t.start()


class CameraMotionSentry:
    """Continuous OpenCV room & doorway visual motion detector + live frame producer for /dev/video0."""

    def __init__(
        self,
        grace_sec: float = SENTRY_GRACE_SEC,
        cooldown_sec: float = SENTRY_COOLDOWN_SEC,
        min_area: int = SENTRY_MOTION_MIN_AREA,
        min_pct: float = SENTRY_MOTION_MIN_PCT,
        state: dict | None = None,
        stop_after_first: bool = False,
        on_detect_callback=None,
        armed: bool = True,
        require_lock: bool = True,
    ) -> None:
        self.grace_sec = grace_sec
        self.cooldown_sec = cooldown_sec
        self.min_area = min_area
        self.min_pct = min_pct
        self.state = state
        self.stop_after_first = stop_after_first
        self.on_detect_callback = on_detect_callback
        self.armed = armed
        self.require_lock = require_lock
        self.last_motion_pct = 0.0
        self.last_bbox: tuple[int, int, int, int] | None = None
        self._stop_evt = threading.Event()
        self._thread: threading.Thread | None = None
        self.triggered_count = 0
        self.last_photo: Path | None = None

    def start(self) -> None:
        if self._thread is not None and self._thread.is_alive():
            return
        self._stop_evt.clear()
        self._thread = threading.Thread(target=self._run_loop, daemon=True)
        self._thread.start()

    def stop(self) -> None:
        self._stop_evt.set()
        if self._thread is not None:
            self._thread.join(timeout=2.5)

    def _run_loop(self) -> None:
        global _ACTIVE_CAM_FRAME, _ACTIVE_HUD_JPEG, _LAST_STREAM_VIEWER_MONO
        try:
            import cv2
            import numpy as np
        except ImportError:
            return

        if not Path(WEBCAM_DEV).exists():
            return

        cap = None
        start_mono = time.monotonic()
        last_alert_mono = 0.0
        avg_bg = None
        motion_streak = 0
        was_locked = False
        locked_since_mono = 0.0

        try:
            while not self._stop_evt.is_set():
                now_m = time.monotonic()
                lock_engaged = (
                    (self.state is not None and not self.state.get("unlocked", False))
                    or lock_is_active()
                    or (not self.require_lock)
                )
                viewer_active = (now_m - _LAST_STREAM_VIEWER_MONO) < 6.0

                # Thermal & Power Optimization: if laptop is unlocked and nobody is viewing Tailscale stream,
                # release /dev/video0 and sleep at 0.0% CPU until Zoth Lock engages or live view is opened.
                if not lock_engaged and not viewer_active:
                    if cap is not None:
                        cap.release()
                        cap = None
                        avg_bg = None
                    was_locked = False
                    motion_streak = 0
                    self.last_motion_pct = 0.0
                    self.last_bbox = None
                    time.sleep(0.8)
                    continue

                if cap is None or not cap.isOpened():
                    cap = cv2.VideoCapture(WEBCAM_DEV, cv2.CAP_V4L2)
                    if not cap.isOpened():
                        cap = cv2.VideoCapture(0)
                    if not cap.isOpened():
                        time.sleep(1.0)
                        continue
                    for _ in range(8):
                        if self._stop_evt.is_set():
                            return
                        ok, frame = cap.read()
                        if ok and frame is not None:
                            hud = _annotate_sentry_frame(frame, label="CALIBRATING SENSOR...")
                            ok_j, buf = cv2.imencode(".jpg", hud, [int(cv2.IMWRITE_JPEG_QUALITY), 82])
                            with _ACTIVE_CAM_LOCK:
                                _ACTIVE_CAM_FRAME = frame
                                if ok_j:
                                    _ACTIVE_HUD_JPEG = buf.tobytes()
                        time.sleep(0.04)

                ok, frame = cap.read()
                if not ok or frame is None:
                    time.sleep(0.15)
                    continue

                gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)
                gray = cv2.GaussianBlur(gray, (21, 21), 0)

                now_m = time.monotonic()
                if now_m - start_mono < self.grace_sec:
                    if avg_bg is None:
                        avg_bg = gray.astype("float")
                    else:
                        cv2.accumulateWeighted(gray, avg_bg, 0.25)
                    hud = _annotate_sentry_frame(frame, label="GRACE WINDOW // CALIBRATING")
                    ok_j, buf = cv2.imencode(".jpg", hud, [int(cv2.IMWRITE_JPEG_QUALITY), 82])
                    with _ACTIVE_CAM_LOCK:
                        _ACTIVE_CAM_FRAME = frame
                        if ok_j:
                            _ACTIVE_HUD_JPEG = buf.tobytes()
                    time.sleep(0.09)
                    continue

                if avg_bg is None:
                    avg_bg = gray.astype("float")
                    time.sleep(0.09)
                    continue

                frame_delta = cv2.absdiff(gray, cv2.convertScaleAbs(avg_bg))
                thresh = cv2.threshold(frame_delta, 22, 255, cv2.THRESH_BINARY)[1]
                thresh = cv2.dilate(thresh, None, iterations=2)

                changed_px = int(np.count_nonzero(thresh))
                total_px = int(thresh.shape[0] * thresh.shape[1])
                motion_pct = (changed_px / max(1, total_px)) * 100.0

                contours_info = cv2.findContours(
                    thresh.copy(), cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE
                )
                contours = contours_info[0] if len(contours_info) == 2 else contours_info[1]

                largest_area = 0
                best_bbox = None
                rx1, ry1, rx2, ry2 = 99999, 99999, 0, 0
                significant_boxes = 0

                for c in contours:
                    area = cv2.contourArea(c)
                    if area > largest_area:
                        largest_area = int(area)
                    if area >= self.min_area:
                        x, y, w, h = cv2.boundingRect(c)
                        rx1 = min(rx1, x)
                        ry1 = min(ry1, y)
                        rx2 = max(rx2, x + w)
                        ry2 = max(ry2, y + h)
                        significant_boxes += 1

                if significant_boxes > 0:
                    best_bbox = (rx1, ry1, rx2 - rx1, ry2 - ry1)

                self.last_motion_pct = round(motion_pct, 2)
                self.last_bbox = best_bbox

                # Strictly enforce that detection only fires when Zoth Lock is active
                lock_engaged = (
                    (self.state is not None and not self.state.get("unlocked", False))
                    or lock_is_active()
                    or (not self.require_lock)
                )
                if lock_engaged and not was_locked:
                    was_locked = True
                    locked_since_mono = now_m
                elif not lock_engaged:
                    was_locked = False

                in_lock_grace = lock_engaged and (now_m - locked_since_mono < self.grace_sec)
                effective_armed = self.armed and lock_engaged and not in_lock_grace

                if not lock_engaged:
                    mode_tag = "STANDBY (LAPTOP UNLOCKED)"
                elif in_lock_grace:
                    rem = max(0.0, self.grace_sec - (now_m - locked_since_mono))
                    mode_tag = f"LOCKED // WALK-AWAY GRACE ({rem:.0f}s)"
                elif self.armed:
                    mode_tag = "ARMED (ZOTH LOCK ACTIVE)"
                else:
                    mode_tag = "LIVE VIEW (ALERTS PAUSED)"

                if viewer_active:
                    live_hud = _annotate_sentry_frame(
                        frame,
                        label=f"{mode_tag} // DELTA {motion_pct:.1f}%",
                        bbox=best_bbox if effective_armed else None,
                        motion_pct=motion_pct if (best_bbox and effective_armed) else None,
                    )
                    ok_j, buf = cv2.imencode(".jpg", live_hud, [int(cv2.IMWRITE_JPEG_QUALITY), 82])
                    with _ACTIVE_CAM_LOCK:
                        _ACTIVE_CAM_FRAME = frame
                        if ok_j:
                            _ACTIVE_HUD_JPEG = buf.tobytes()
                else:
                    with _ACTIVE_CAM_LOCK:
                        _ACTIVE_CAM_FRAME = frame

                if not effective_armed:
                    motion_streak = 0
                    cv2.accumulateWeighted(gray, avg_bg, 0.12)
                    time.sleep(0.65 if not lock_engaged else 0.18)
                    continue

                is_motion = (largest_area >= self.min_area) and (motion_pct >= self.min_pct)
                if is_motion:
                    motion_streak += 1
                else:
                    motion_streak = 0
                    cv2.accumulateWeighted(gray, avg_bg, 0.06)

                if effective_armed and motion_streak >= 2 and (now_m - last_alert_mono >= self.cooldown_sec):
                    best_frame = frame.copy()
                    best_pct = motion_pct
                    best_box = best_bbox
                    best_area = largest_area

                    for _ in range(4):
                        time.sleep(0.08)
                        ok2, f2 = cap.read()
                        if not ok2 or f2 is None:
                            continue
                        g2 = cv2.GaussianBlur(cv2.cvtColor(f2, cv2.COLOR_BGR2GRAY), (21, 21), 0)
                        d2 = cv2.absdiff(g2, cv2.convertScaleAbs(avg_bg))
                        t2 = cv2.dilate(cv2.threshold(d2, 22, 255, cv2.THRESH_BINARY)[1], None, iterations=2)
                        pct2 = (int(np.count_nonzero(t2)) / max(1, total_px)) * 100.0
                        c_info2 = cv2.findContours(t2, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
                        cs2 = c_info2[0] if len(c_info2) == 2 else c_info2[1]
                        bx1, by1, bx2, by2 = 99999, 99999, 0, 0
                        cnt2 = 0
                        max_a2 = 0
                        for c in cs2:
                            a2 = cv2.contourArea(c)
                            if a2 > max_a2:
                                max_a2 = int(a2)
                            if a2 >= self.min_area:
                                x, y, w, h = cv2.boundingRect(c)
                                bx1, by1 = min(bx1, x), min(by1, y)
                                bx2, by2 = max(bx2, x + w), max(by2, y + h)
                                cnt2 += 1
                        if pct2 >= best_pct and cnt2 > 0:
                            best_frame = f2.copy()
                            best_pct = pct2
                            best_box = (bx1, by1, bx2 - bx1, by2 - by1)
                            best_area = max_a2

                    last_alert_mono = time.monotonic()
                    motion_streak = 0
                    g_final = cv2.GaussianBlur(cv2.cvtColor(best_frame, cv2.COLOR_BGR2GRAY), (21, 21), 0)
                    avg_bg = g_final.astype("float")

                    self.triggered_count += 1
                    label_str = f"CAMERA MOTION IN ROOM/DOORWAY ({best_pct:.1f}% delta)"
                    annotated = _annotate_sentry_frame(
                        best_frame,
                        label=label_str,
                        bbox=best_box,
                        motion_pct=best_pct,
                    )
                    SENTRY_DIR.mkdir(parents=True, exist_ok=True)
                    os.chmod(SENTRY_DIR, 0o700)
                    stamp = datetime.now().strftime("%Y%m%d-%H%M%S")
                    out_path = SENTRY_DIR / f"sentry-{stamp}-camera-motion.jpg"
                    cv2.imwrite(str(out_path), annotated, [int(cv2.IMWRITE_JPEG_QUALITY), 92])
                    os.chmod(out_path, 0o600)
                    self.last_photo = out_path

                    if self.state is not None:
                        self.state["camera_motions"] = self.state.get("camera_motions", 0) + 1
                        self.state["captures"] = self.state.get("captures", 0) + 1
                        self.state["last_sentry_mono"] = last_alert_mono

                    entry = sentry_log_event(
                        "camera_motion",
                        motion_pct=round(best_pct, 2),
                        largest_area_px=best_area,
                        bbox=list(best_box) if best_box else None,
                        photo=str(out_path),
                    )
                    msg = (
                        f"🚨 [ZOTH SENTRY — ROOM / DOORWAY MOTION DETECTED]\n"
                        f"• Event: Person / Motion in Camera View ({best_pct:.1f}% delta)\n"
                        f"• Time: {entry['ts_local']}\n"
                        f"• Live View (Tailscale): {get_live_view_url()}\n"
                        f"• Photo: {out_path}\n"
                        f"• Audit Log: {AUDIT_LOG_PATH}"
                    )
                    threading.Thread(
                        target=sentry_send_signal_alert,
                        args=(msg, out_path),
                        daemon=True,
                    ).start()

                    if self.on_detect_callback is not None:
                        try:
                            self.on_detect_callback(entry, out_path)
                        except Exception:
                            pass

                    if self.stop_after_first:
                        return

                time.sleep(0.09 if viewer_active else 0.20)
        finally:
            with _ACTIVE_CAM_LOCK:
                _ACTIVE_CAM_FRAME = None
                _ACTIVE_HUD_JPEG = None
            if cap is not None:
                cap.release()


