async function pollStatus() {
  try {
    const r = await fetch('/api/status');
    const d = await r.json();
    const armed = d.armed;
    const locked = d.screen_locked;
    document.getElementById('st-armed').textContent = (locked && armed)
      ? 'ARMED (AUTO-SIGNAL ON)'
      : (!locked ? 'STANDBY (WAITING FOR ZOTH LOCK)' : 'VIEW-ONLY (PAUSED)');
    document.getElementById('st-delta').textContent = (d.motion_pct || 0).toFixed(2) + '%';
    document.getElementById('st-count').textContent = d.triggered_count || 0;
