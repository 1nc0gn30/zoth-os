def is_listening(port):
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
        s.settimeout(0.25)
        return s.connect_ex(("127.0.0.1", port)) == 0

def start_daemon(tool_id, repo_name, port):
    repo_dir = os.path.join(NULLAI_DIR, repo_name)
    if not os.path.isdir(repo_dir):
        return False, "missing_repo"

    env = os.environ.copy()
    env["PORT"] = str(port)
    env["PYTHONUNBUFFERED"] = "1"

    cmd = None
    if os.path.isfile(os.path.join(repo_dir, "server.js")):
        cmd = ["node", "server.js", "--port", str(port)]
    elif os.path.isfile(os.path.join(repo_dir, "server.py")):
        cmd = [sys.executable, "server.py", "--port", str(port)]
    elif os.path.isfile(os.path.join(repo_dir, "zoth_relay/server.py")):
        cmd = [sys.executable, "-m", "zoth_relay.server", "--port", str(port)]
    elif os.path.isdir(os.path.join(repo_dir, "src")):
        src_dir = os.path.join(repo_dir, "src")
        for d in sorted(os.listdir(src_dir)):
            if os.path.isfile(os.path.join(src_dir, d, "cli.py")):
                env["PYTHONPATH"] = src_dir + os.pathsep + env.get("PYTHONPATH", "")
                cmd = [sys.executable, "-m", f"{d}.cli", "serve", "--port", str(port)]
                break

    if not cmd:
        return False, "no_entrypoint"

    log_path = f"/tmp/zoth-daemon-{tool_id}.log"
    with open(log_path, "ab") as logf:
        subprocess.Popen(
            cmd,
            cwd=repo_dir,
            env=env,
            stdin=subprocess.DEVNULL,
            stdout=logf,
            stderr=logf,
            close_fds=True,
            start_new_session=True,
        )
    return True, "spawned"

def main():
    started = 0
    already_up = 0
    for tool_id, repo_name, port in DAEMONS:
        if is_listening(port):
            already_up += 1
            continue
        ok, _ = start_daemon(tool_id, repo_name, port)
        if ok:
            started += 1

    if started > 0:
        time.sleep(1.8)

    online = sum(1 for _, _, p in DAEMONS if is_listening(p))
    print(f"✦ Zoth Arsenal Daemons: {online}/{len(DAEMONS)} ONLINE (already_up={already_up}, newly_started={started})")

if __name__ == "__main__":
    main()
