#!/usr/bin/env python3
"""
ZothOS Core Daemon Orchestrator — Memory-Safe On-Demand Architecture
Starts only the 5 core lightweight daemons by default (individual tools start on-demand when opened in Electron or CLI).
"""
import os, sys, time, socket, subprocess

HOME = os.path.expanduser("~")
NULLAI_DIR = os.path.join(HOME, "NullAITech")

CORE_DAEMONS = [
    ("zoth-bolt", "bolt.diy", 5173),
    ("zoth-webgen", "zoth-webgen", 8092),
    ("zoth-civilization", "zoth-civilization", 9393),
    ("zoth-bounty", "zoth-bounty", 9494),
    ("zothos-lite", "zothos-lite", 8145),
]

def is_listening(port):
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
        s.settimeout(0.25)
        return s.connect_ex(("127.0.0.1", port)) == 0

def start_daemon(tool_id, repo_name, port):
    repo_dir = os.path.join(NULLAI_DIR, repo_name)
    if not os.path.isdir(repo_dir):
        repo_dir = os.path.join("/opt", repo_name)
    if not os.path.isdir(repo_dir):
        return False
    env = os.environ.copy()
    env["PORT"] = str(port)
    cmd = ["node", "server.js", "--port", str(port)] if os.path.isfile(os.path.join(repo_dir, "server.js")) else [sys.executable, "server.py", "--port", str(port)]
    with open(f"/tmp/zoth-daemon-{tool_id}.log", "ab") as logf:
        subprocess.Popen(cmd, cwd=repo_dir, env=env, stdin=subprocess.DEVNULL, stdout=logf, stderr=logf, close_fds=True, start_new_session=True)
    return True

def main():
    for tid, repo, port in CORE_DAEMONS:
        if not is_listening(port):
            start_daemon(tid, repo, port)
    time.sleep(0.5)
    online = sum(1 for _, _, p in CORE_DAEMONS if is_listening(p))
    print(f"✦ Zoth Core Daemons: {online}/{len(CORE_DAEMONS)} ONLINE (Memory-Safe On-Demand Mode)")

if __name__ == "__main__":
    main()
