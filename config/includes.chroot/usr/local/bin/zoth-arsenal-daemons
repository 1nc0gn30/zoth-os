#!/usr/bin/env python3
"""
ZothOS Sovereign Arsenal Local Port Supervisor
Ensures all 71 Arsenal tool local ports are listening on 127.0.0.1.
"""
import os, socket, subprocess, re

TOOLS_JS = os.path.expanduser('~/NullAITech/zoth-studio-v2/src/data/toolsData.js')

def is_up(port):
    s = socket.socket()
    s.settimeout(0.15)
    try:
        return s.connect_ex(('127.0.0.1', int(port))) == 0
    finally:
        s.close()

def main():
    if not os.path.exists(TOOLS_JS):
        return
    txt = open(TOOLS_JS).read()
    # Extract id, repo, localPort
    blocks = txt.split("id: '")[1:]
    started = 0
    up_count = 0
    for b in blocks:
        tid = b.split("'", 1)[0]
        rm = re.search(r"repo:\s*'([^']+)'", b)
        pm = re.search(r"localPort:\s*(\d+)", b)
        if not pm:
            continue
        port = int(pm.group(1))
        repo = (rm.group(1) if rm else tid).split('/')[-1]
        pub_dir = fos.path.expanduser("~/NullAITech/{repo}/public")
        if is_up(port):
            up_count += 1
            continue
        if os.path.isdir(pub_dir):
            subprocess.Popen(
                ['python3', '-m', 'http.server', str(port), '--bind', '127.0.0.1', '--directory', pub_dir],
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True
            )
            started += 1
            up_count += 1
    print(f"ZothOS Arsenal Supervisor: {up_count} tool ports active ({started} newly started).")

if __name__ == '__main__':
    main()
