#!/usr/bin/env python3
"""Anderson Security Sentinel (v2.6.0) — Live Loopback (:8103) Braille Telemetry TUI.

Queries real telemetry from 127.0.0.1:8103:
  /api/status, /api/wifi_xray, /api/usb_status, /api/bluetooth_status
"""

from __future__ import annotations

import argparse
import json
import os
import sys
import time
import urllib.request

VERSION = "2.6.0"
BRAILLE_BASE = 0x2800


def _fetch_json(port: int, path: str, timeout: float = 1.8) -> dict | None:
    headers = {"Origin": f"http://127.0.0.1:{port}"}
    token = os.environ.get("ANDERSON_API_TOKEN", "").strip()
    if token:
        headers["Authorization"] = f"Bearer {token}"
    req = urllib.request.Request(f"http://127.0.0.1:{port}{path}", headers=headers)
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            if resp.status == 200:
                return json.loads(resp.read().decode("utf-8"))
    except Exception:
        return None
    return None


def braille_sparkline(vals: list[float], width: int = 24) -> str:
    if not vals:
        vals = [0.0] * (width * 2)
    padded = list(vals[-(width * 2):])
    while len(padded) < width * 2:
        padded.insert(0, 0.0)
    out = []
    for i in range(0, len(padded) - 1, 2):
        v1 = max(0, min(3, int(padded[i] * 3.99)))
        v2 = max(0, min(3, int(padded[i + 1] * 3.99)))
        dots1 = (0x40, 0x04, 0x02, 0x01)[v1]
        dots2 = (0x80, 0x20, 0x10, 0x08)[v2]
        out.append(chr(BRAILLE_BASE | dots1 | dots2))
    return "".join(out)


def collect_snapshot(port: int) -> dict:
    status = _fetch_json(port, "/api/status")
    xray = _fetch_json(port, "/api/wifi_xray")
    usb = _fetch_json(port, "/api/usb_status")
    ble = _fetch_json(port, "/api/bluetooth_status")
    online = status is not None

    nodes = (xray or {}).get("nodes", []) if isinstance(xray, dict) else []
    disturbance = float((xray or {}).get("disturbance_index", 0.0) or 0.0)
    room = (xray or {}).get("room_bounds", {}) if isinstance(xray, dict) else {}
    bp = (xray or {}).get("building_perimeter", {}) if isinstance(xray, dict) else {}
    cameras = (xray or {}).get("cameras", []) if isinstance(xray, dict) else []

    signal_norm = [
        max(0.0, min(1.0, float(n.get("signal_pct", 0)) / 100.0))
        for n in nodes[:48]
    ]

    return {
        "tool": "anderson-security-sentinel",
        "version": VERSION,
        "port": port,
        "online": online,
        "timestamp": time.strftime("%Y-%m-%d %H:%M:%S"),
        "status": {
            "armed": bool((status or {}).get("armed", False)),
            "security_status": (status or {}).get("status", "OFFLINE"),
            "enrolled_count": int((status or {}).get("enrolled_count", 0)),
            "camera_active": bool((status or {}).get("camera_active", False)),
            "fps": float((status or {}).get("fps", 0.0)),
            "current_targets": int((status or {}).get("current_targets", 0)),
        },
        "rf_xray": {
            "active": bool((xray or {}).get("active", False)),
            "total_nodes": len(nodes),
            "disturbance_index": round(disturbance, 2),
            "room_bounds": room,
            "footprint_sqm": bp.get("footprint_sqm"),
            "cameras_detected": len(cameras),
            "tomography_grid_active": bool((xray or {}).get("tomography_grid")),
            "braille_spectrum": braille_sparkline(signal_norm),
        },
        "usb": {
            "active": bool((usb or {}).get("active", False)),
            "trusted_count": int((usb or {}).get("trusted_count", 0)),
            "breach_detected": bool((usb or {}).get("breach_detected", False)),
        },
        "bluetooth": {
            "active": bool((ble or {}).get("active", False)),
            "owner_present": bool((ble or {}).get("owner_present", False)),
            "total_devices": int((ble or {}).get("total_devices", 0)),
        },
    }


def render_frame(snap: dict) -> str:
    st = snap["status"]
    rf = snap["rf_xray"]
    usb = snap["usb"]
    ble = snap["bluetooth"]
    state_tag = f"{st['security_status']} (LIVE :{snap['port']})" if snap["online"] else f"OFFLINE (:{snap['port']} idle)"
    room_w = rf["room_bounds"].get("width_m", "--")
    room_l = rf["room_bounds"].get("length_m", "--")

    lines = [
        "\033[1;33m╭────────────────────────────────────────────────────────────────────────────╮\033[0m",
        f"\033[1;33m│\033[0m \033[1;37mANDERSON SECURITY SENTINEL v{VERSION}\033[0m  │  \033[36m{state_tag:<37}\033[0m \033[1;33m│\033[0m",
        "\033[1;33m├────────────────────────────────────────────────────────────────────────────┤\033[0m",
        f"\033[1;33m│\033[0m Biometrics : Armed={str(st['armed']):<5} | Enrolled={st['enrolled_count']:<2} | Cam={'LIVE' if st['camera_active'] else 'STBY':<4} | FPS={st['fps']:<4}      \033[1;33m│\033[0m",
        f"\033[1;33m│\033[0m Wi-Fi XRay : Nodes={rf['total_nodes']:<3} | Dist={rf['disturbance_index']:<5}% | Room={str(room_w)}x{str(room_l)}m | Cams={rf['cameras_detected']:<2}  \033[1;33m│\033[0m",
        f"\033[1;33m│\033[0m RF Spectrum: \033[32m{rf['braille_spectrum']}\033[0m  VRTI={'ON ' if rf['tomography_grid_active'] else 'OFF'}                    \033[1;33m│\033[0m",
        f"\033[1;33m│\033[0m Hardware   : USB Trusted={usb['trusted_count']:<2} ({'BREACH' if usb['breach_detected'] else 'SECURE'}) | BLE={ble['total_devices']:<2} (Owner={'YES' if ble['owner_present'] else 'NO '})       \033[1;33m│\033[0m",
        f"\033[1;33m│\033[0m Updated    : {snap['timestamp']:<22} │ Neal Frazier Tech • NullAI Platform \033[1;33m│\033[0m",
        "\033[1;33m╰────────────────────────────────────────────────────────────────────────────╯\033[0m",
    ]
    return "\n".join(lines)


def main() -> int:
    ap = argparse.ArgumentParser(description=f"Anderson Security Sentinel v{VERSION} Live TUI")
    ap.add_argument("--version", "-v", action="version", version=f"anderson-security-sentinel-tui v{VERSION}")
    ap.add_argument("--port", "-p", type=int, default=int(os.environ.get("ANDERSON_PORT", "8103")), help="Daemon port (default 8103)")
    ap.add_argument("--status", action="store_true", help="Print a single live status frame and exit")
    ap.add_argument("--json", action="store_true", help="Output live JSON telemetry snapshot and exit")
    ap.add_argument("--watch", action="store_true", help="Continuously refresh telemetry")
    ap.add_argument("--interval", type=float, default=1.5, help="Refresh interval seconds for --watch")
    args = ap.parse_args()

    if args.json:
        snap = collect_snapshot(args.port)
        print(json.dumps(snap, indent=2))
        return 0

    if not args.watch or args.status or not sys.stdout.isatty():
        snap = collect_snapshot(args.port)
        print(render_frame(snap))
        return 0

    try:
        while True:
            snap = collect_snapshot(args.port)
            sys.stdout.write("\033[2J\033[H" + render_frame(snap) + "\nPress Ctrl+C to exit.\n")
            sys.stdout.flush()
            time.sleep(max(0.5, args.interval))
    except KeyboardInterrupt:
        return 0


if __name__ == "__main__":
    raise SystemExit(main())
