#!/usr/bin/env bash
# Aider launcher. Prefer the Zoth venv binary so this wrapper cannot exec itself.
set -euo pipefail
VENV_AIDER=/opt/zothos-ai-env/bin/aider
if [[ ! -x "$VENV_AIDER" ]]; then
  echo -e "\e[1;36m[*] Installing Aider into /opt/zothos-ai-env...\e[0m"
  mkdir -p /opt/zothos-ai-env
  python3 -m venv /opt/zothos-ai-env --system-site-packages 2>/dev/null || true
  if [[ -x /opt/zothos-ai-env/bin/pip ]]; then
    /opt/zothos-ai-env/bin/pip install --upgrade aider-chat 2>/dev/null || true
  fi
fi
if [[ -x "$VENV_AIDER" ]]; then
  exec "$VENV_AIDER" "$@"
fi
echo -e "\e[1;31m[!] Unable to launch Aider.\e[0m" >&2
exit 1
