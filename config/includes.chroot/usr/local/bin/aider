#!/usr/bin/env python3
"""
==============================================================================
 ZOTHOS AIDER AI CODING AGENT • SOVEREIGN TERMINAL WORKSTATION v3.0
==============================================================================
"""

import os
import sys
import shutil
import subprocess
import json
import urllib.request

CYAN = "\033[38;2;0;229;255m"
GOLD = "\033[38;2;212;175;55m"
AMBER = "\033[38;2;245;158;11m"
GREEN = "\033[38;2;74;222;128m"
RED = "\033[38;2;248;113;113m"
PURPLE = "\033[38;2;168;85;247m"
DIM = "\033[38;2;140;150;170m"
NC = "\033[0m"
BOLD = "\033[1m"

BIN_CANDIDATES = [
    "/opt/zothos-ai-env/bin/aider",
    os.path.expanduser("~/.local/bin/aider"),
    os.path.expanduser("~/.local/share/uv/tools/aider-chat/bin/aider"),
    "/usr/local/bin/aider-cli",
    "/usr/bin/aider"
]

def find_real_binary():
    self_path = os.path.realpath(sys.argv[0])
    for p in BIN_CANDIDATES:
        path = os.path.expanduser(p)
        if os.path.isfile(path) and os.access(path, os.X_OK):
            if os.path.realpath(path) != self_path:
                return path

    found = shutil.which("aider")
    if found and os.path.realpath(found) != self_path:
        return found
    return None

def get_aider_version(real_bin):
    if not real_bin:
        return None
    try:
        res = subprocess.run([real_bin, "--version"], capture_output=True, text=True, timeout=5)
        out = (res.stdout or res.stderr).strip().split("\n")[0]
        return out if out else "Verified"
    except Exception as e:
        return f"Error: {e}"

def check_ollama_models():
    try:
        req = urllib.request.Request("http://127.0.0.1:11434/api/tags", headers={"User-Agent": "ZothOS/3.0"})
        with urllib.request.urlopen(req, timeout=1.5) as resp:
            data = json.loads(resp.read().decode("utf-8"))
            models = [m["name"] for m in data.get("models", [])]
            return True, models
    except Exception:
        return False, []

def check_vault_status():
    try:
        req = urllib.request.Request("http://127.0.0.1:8787/health", headers={"User-Agent": "ZothOS/3.0"})
        with urllib.request.urlopen(req, timeout=1.5) as resp:
            data = json.loads(resp.read().decode("utf-8"))
            return data.get("status", "ONLINE")
    except Exception:
        return "OFFLINE"

def print_header(real_bin, version_str):
    os.system("clear" if os.name == "posix" else "cls")
    print(f"{GOLD}{BOLD}")
    print(r"""    █████╗ ██╗██████╗ ███████╗██████╗ 
   ██╔══██╗██║██╔══██╗██╔════╝██╔══██╗
   ███████║██║██║  ██║█████╗  ██████╔╝
   ██╔══██║██║██║  ██║██╔══╝  ██╔══██╗
   ██║  ██║██║██████╔╝███████╗██║  ██║
   ╚═╝  ╚═╝╚═╝╚═════╝ ╚══════╝╚═╝  ╚═╝""")
    print(f"       {AMBER}• SOVEREIGN AI PAIR PROGRAMMING IN THE TERMINAL •{NC}\n")

    ollama_ok, models = check_ollama_models()
    vault_status = check_vault_status()

    ollama_desc = f"{GREEN}ACTIVE ({len(models)} models){NC}" if ollama_ok else f"{DIM}Standby (127.0.0.1:11434){NC}"
    vault_desc = f"{GREEN}ONLINE (:8787){NC}" if vault_status == "ONLINE" else f"{DIM}Standby (:8787){NC}"

    status_tag = f"{GREEN}VERIFIED & READY{NC}" if real_bin else f"{RED}MISSING RUNTIME{NC}"

    print(f"  {GOLD}┌─ AIDER TELEMETRY ────────────────────────────────────────────────────────┐{NC}")
    print(f"  {GOLD}│{NC}  {BOLD}Status:{NC}        {status_tag}")
    print(f"  {GOLD}│{NC}  {BOLD}Binary Path:{NC}   {CYAN}{real_bin or 'None'}{NC}")
    print(f"  {GOLD}│{NC}  {BOLD}Version:{NC}       {CYAN}{version_str or 'Not installed'}{NC}")
    print(f"  {GOLD}│{NC}  {BOLD}Local Ollama:{NC}  {ollama_desc}")
    print(f"  {GOLD}│{NC}  {BOLD}Zoth Vault:{NC}    {vault_desc}")
    print(f"  {GOLD}│{NC}  {BOLD}Working Dir:{NC}   {AMBER}{os.getcwd()}{NC}")
    print(f"  {GOLD}└──────────────────────────────────────────────────────────────────────────┘{NC}\n")

def pause_menu():
    print(f"\n{GOLD}{BOLD}Press [ENTER] to return to the Aider Menu...{NC}", end="")
    try:
        input()
    except (KeyboardInterrupt, EOFError):
        pass

def run_aider(real_bin, extra_args=None):
    if not real_bin:
        print(f"\n{RED}[!] Aider binary is not available. Please run repair/install from menu.{NC}")
        pause_menu()
        return

    cmd = [real_bin] + (extra_args or [])
    print(f"\n{GREEN}[+] Launching Aider AI Coding Agent...{NC}")
    print(f"    {DIM}Command: {' '.join(cmd)}{NC}\n")

    env = os.environ.copy()
    # Add virtualenv bin to PATH so any tools aider spawns (like git, python) are found
    venv_bin = os.path.dirname(real_bin)
    env["PATH"] = f"{venv_bin}:{env.get('PATH', '')}"

    try:
        res = subprocess.run(cmd, env=env)
        if res.returncode != 0:
            print(f"\n{AMBER}[*] Aider process exited with code {res.returncode}.{NC}")
    except KeyboardInterrupt:
        print(f"\n{DIM}[*] Interrupted by user.{NC}")
    except Exception as e:
        print(f"\n{RED}[!] Failed to launch Aider: {e}{NC}")
    pause_menu()

def launch_ollama_mode(real_bin):
    ollama_ok, models = check_ollama_models()
    print(f"\n{GOLD}{BOLD}═ LOCAL OLLAMA AIDER RUNNER ═{NC}\n")
    if not ollama_ok:
        print(f"{AMBER}[!] Ollama does not appear to be running on 127.0.0.1:11434.{NC}")
        ans = input("Would you like to start Ollama service now? [Y/n]: ").strip().lower()
        if ans in ["", "y", "yes"]:
            subprocess.run(["sudo", "systemctl", "start", "ollama"])
            import time
            time.sleep(1.5)
            ollama_ok, models = check_ollama_models()

    if models:
        print(f"{GREEN}Available local models:{NC}")
        for i, m in enumerate(models, 1):
            print(f"  [{i}] {CYAN}{m}{NC}")
        print(f"  [C] Custom model name\n")
        c = input("Select model index or enter custom name: ").strip()
        if c.isdigit() and 1 <= int(c) <= len(models):
            chosen = models[int(c)-1]
        elif c.lower() == "c":
            chosen = input("Enter Ollama model name (e.g. qwen2.5-coder:7b): ").strip()
        else:
            chosen = c if c else models[0]
    else:
        chosen = input("Enter Ollama model name (e.g. qwen2.5-coder:7b, deepseek-coder:6.7b): ").strip()
        if not chosen:
            chosen = "qwen2.5-coder:7b"

    run_aider(real_bin, ["--model", f"ollama/{chosen}", "--dark-mode"])

def configure_keys():
    print(f"\n{GOLD}{BOLD}═ CONFIGURE AIDER API KEYS & ENVIRONMENT ═{NC}\n")
    print("1. Set OpenAI API Key (OPENAI_API_KEY)")
    print("2. Set Anthropic API Key (ANTHROPIC_API_KEY)")
    print("3. Set OpenRouter API Key (OPENROUTER_API_KEY)")
    print("4. Set DeepSeek API Key (DEEPSEEK_API_KEY)")
    print("5. Load keys from Zoth Sovereign Vault (zoth-vault)")
    print("0. Back\n")

    choice = input("Enter selection [0-5]: ").strip()
    if choice == "1":
        k = input("Enter OpenAI API Key: ").strip()
        if k:
            os.environ["OPENAI_API_KEY"] = k
            print(f"{GREEN}✓ OPENAI_API_KEY set for current session.{NC}")
    elif choice == "2":
        k = input("Enter Anthropic API Key: ").strip()
        if k:
            os.environ["ANTHROPIC_API_KEY"] = k
            print(f"{GREEN}✓ ANTHROPIC_API_KEY set for current session.{NC}")
    elif choice == "3":
        k = input("Enter OpenRouter API Key: ").strip()
        if k:
            os.environ["OPENROUTER_API_KEY"] = k
            print(f"{GREEN}✓ OPENROUTER_API_KEY set for current session.{NC}")
    elif choice == "4":
        k = input("Enter DeepSeek API Key: ").strip()
        if k:
            os.environ["DEEPSEEK_API_KEY"] = k
            print(f"{GREEN}✓ DEEPSEEK_API_KEY set for current session.{NC}")
    elif choice == "5":
        if shutil.which("zoth-vault"):
            print(f"\n{CYAN}[+] Querying Zoth Sovereign Vault...{NC}")
            subprocess.run(["zoth-vault", "status"])
        else:
            print(f"{RED}zoth-vault tool not found in PATH.{NC}")
    pause_menu()

def update_or_repair(real_bin):
    print(f"\n{GOLD}{BOLD}═ UPDATE / REPAIR AIDER ENVIRONMENT ═{NC}\n")
    pip_candidates = [
        "/opt/zothos-ai-env/bin/pip",
        os.path.expanduser("~/.local/bin/pip"),
        shutil.which("pip3")
    ]
    pip_bin = None
    for p in pip_candidates:
        if p and os.path.isfile(p) and os.access(p, os.X_OK):
            pip_bin = p
            break

    uv_bin = shutil.which("uv")

    if uv_bin and os.path.exists("/opt/zothos-ai-env/bin/python"):
        cmd = [uv_bin, "pip", "install", "--python", "/opt/zothos-ai-env/bin/python", "--upgrade", "aider-chat"]
    elif pip_bin:
        cmd = [pip_bin, "install", "--upgrade", "aider-chat"]
    else:
        cmd = ["pip3", "install", "--user", "--break-system-packages", "--upgrade", "aider-chat"]

    print(f"{CYAN}[+] Running upgrade command: {' '.join(cmd)}{NC}\n")
    try:
        subprocess.run(cmd)
        print(f"\n{GREEN}✓ Environment updated successfully.{NC}")
    except Exception as e:
        print(f"\n{RED}[!] Failed to update: {e}{NC}")
    pause_menu()

def show_cheatsheet():
    print(f"\n{GOLD}{BOLD}══════════════════════════════════════════════════════════════════════════{NC}")
    print(f"              {AMBER}{BOLD}AIDER AI CODING AGENT • IN-TERMINAL CHEATSHEET{NC}")
    print(f"{GOLD}{BOLD}══════════════════════════════════════════════════════════════════════════{NC}\n")
    print(f"{BOLD}{GOLD}1. WHAT IS AIDER?{NC}")
    print("   Aider lets you pair program with LLMs directly in your terminal git repo.")
    print("   It edits multiple files at once, creates coherent git commits, and verifies diffs.\n")
    print(f"{BOLD}{GOLD}2. CORE IN-CHAT COMMANDS:{NC}")
    print(f"   {CYAN}/add <file1> <file2>{NC}     Add files to the chat context so Aider can edit them")
    print(f"   {CYAN}/drop <file>{NC}             Remove file from the chat context")
    print(f"   {CYAN}/diff{NC}                    Show diff of changes since last message")
    print(f"   {CYAN}/undo{NC}                    Revert last change made by Aider in git")
    print(f"   {CYAN}/run <cmd>{NC}               Run bash command without leaving Aider")
    print(f"   {CYAN}/test <cmd>{NC}              Run test command and give errors to Aider to fix")
    print(f"   {CYAN}/architect{NC}               Switch to Architect mode (pro model plans, fast edits)")
    print(f"   {CYAN}/model <name>{NC}            Switch active model dynamically")
    print(f"   {CYAN}/tokens{NC}                  Report context window token usage")
    print(f"   {CYAN}/exit{NC}                    Exit Aider cleanly\n")
    print(f"{BOLD}{GOLD}3. CLI LAUNCH FLAGS:{NC}")
    print(f"   {CYAN}aider --model ollama/qwen2.5-coder:7b{NC}  # Run 100% offline with local Ollama")
    print(f"   {CYAN}aider --model claude-3-5-sonnet-20241022{NC} # Run with Anthropic Claude Sonnet")
    print(f"   {CYAN}aider --architect{NC}                        # Architect/Editor dual agent mode\n")
    pause_menu()

def main():
    real_bin = find_real_binary()
    version_str = get_aider_version(real_bin)

    # Pass-through if CLI arguments were passed directly:
    if len(sys.argv) > 1:
        if sys.argv[1] in ["--help", "-h"]:
            if real_bin:
                subprocess.run([real_bin, "--help"])
                return
        elif sys.argv[1] in ["--version", "-v"]:
            print(version_str)
            return
        elif sys.argv[1] == "install":
            update_or_repair(real_bin)
            return
        else:
            run_aider(real_bin, sys.argv[1:])
            return

    # Interactive Menu
    while True:
        real_bin = find_real_binary()
        version_str = get_aider_version(real_bin)
        print_header(real_bin, version_str)

        print(f"  {BOLD}{GOLD}AVAILABLE OPERATIONS:{NC}")
        print(f"    {CYAN}[1]{NC}  {BOLD}⚡ Launch Aider AI Coding Agent (Interactive){NC}   {DIM}(Auto-detect keys & git repo){NC}")
        print(f"    {CYAN}[2]{NC}  {BOLD}🦙 Launch Aider with Local Ollama (100% Offline){NC}{DIM}(qwen2.5, deepseek, llama){NC}")
        print(f"    {CYAN}[3]{NC}  {BOLD}🏛️  Launch Aider Architect Mode{NC}                   {DIM}(Dual reasoning + code generation){NC}")
        print(f"    {CYAN}[4]{NC}  {BOLD}🔑 Configure Model & API Keys{NC}                    {DIM}(OpenAI, Claude, Vault){NC}")
        print(f"    {CYAN}[5]{NC}  {BOLD}🔄 Update / Repair Aider Environment{NC}             {DIM}(Self-heal packages){NC}")
        print(f"    {CYAN}[6]{NC}  {BOLD}📖 Aider In-Terminal Cheatsheet & Guide{NC}          {DIM}(Learn /commands & workflow){NC}")
        print(f"    {CYAN}[7]{NC}  {BOLD}💻 Aider Python Environment Shell{NC}                {DIM}(Interactive bash inside venv){NC}")
        print(f"    {RED}[0]{NC}  {BOLD}🚪 Exit{NC}\n")

        try:
            choice = input("  Enter selection [0-7]: ").strip()
            if choice == "1":
                run_aider(real_bin)
            elif choice == "2":
                launch_ollama_mode(real_bin)
            elif choice == "3":
                run_aider(real_bin, ["--architect"])
            elif choice == "4":
                configure_keys()
            elif choice == "5":
                update_or_repair(real_bin)
            elif choice == "6":
                show_cheatsheet()
            elif choice == "7":
                print(f"\n{GOLD}{BOLD}Entering Aider Python environment shell. Type 'exit' to return.{NC}\n")
                venv_bin = os.path.dirname(real_bin) if real_bin else "/opt/zothos-ai-env/bin"
                env = os.environ.copy()
                env["PATH"] = f"{venv_bin}:{env.get('PATH', '')}"
                subprocess.run(["bash"], env=env)
            elif choice in ["0", "q", "Q", "exit"]:
                print(f"\n{GOLD}Exiting Aider Workstation. Sovereign operational.{NC}")
                sys.exit(0)
            else:
                print(f"\n{RED}Invalid choice. Please select from 0-7.{NC}")
                import time
                time.sleep(1)
        except (KeyboardInterrupt, EOFError):
            print(f"\n\n{GOLD}Exiting Aider Workstation.{NC}")
            sys.exit(0)

if __name__ == "__main__":
    main()
