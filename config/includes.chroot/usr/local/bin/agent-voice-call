#!/usr/bin/env python3
"""Executable runner for Zoth Sovereign Live Voice Calling Station."""

# zothos-repo-shim: run the canonical repo copy so repo-relative paths resolve
import os as _os, sys as _sys
_here = _os.path.realpath(__file__)
_repo = _os.environ.get("ZOTH_REPO_DIR") or '/home/zoth/NullAITech' + "/" + 'agent-voice-call'
_real = _os.path.join(_repo, "bin", 'agent-voice-call')
if _os.path.exists(_real) and _os.path.realpath(_real) != _here:
    _os.execv(_sys.executable, [_sys.executable, _real] + _sys.argv[1:])
del _os, _sys, _here, _repo, _real


import os
import sys
from pathlib import Path

# Add src to sys.path
PROJECT_DIR = Path(__file__).resolve().parent.parent
SRC_DIR = PROJECT_DIR / "src"

if str(SRC_DIR) not in sys.path:
    sys.path.insert(0, str(SRC_DIR))

from agent_voice_call.cli import main

if __name__ == "__main__":
    sys.exit(main())
