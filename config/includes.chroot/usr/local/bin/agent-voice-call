#!/usr/bin/env python3
"""Executable CLI wrapper for Agent Voice Call Station (v2.6.0).

Probes /opt/agent-voice-call, repo-relative src, and ~/NullAITech/agent-voice-call
dynamically without hardcoded user home paths.
Engineered by Neal Frazier Tech (@1nc0gn30) • NullAI Platform.
"""

from __future__ import annotations

import os
import sys
from pathlib import Path


def _resolve_src_dir() -> Path:
    candidates = []
    env_repo = os.environ.get("ZOTH_REPO_DIR", "").strip()
    if env_repo:
        candidates.append(Path(env_repo) / "src")
    here = Path(__file__).resolve()
    candidates.append(here.parent.parent / "src")
    candidates.append(Path("/opt/agent-voice-call/src"))
    candidates.append(Path.home() / "NullAITech" / "agent-voice-call" / "src")

    for cand in candidates:
        if (cand / "agent_voice_call" / "cli.py").is_file():
            return cand
    return candidates[0]


SRC_DIR = _resolve_src_dir()
if str(SRC_DIR) not in sys.path:
    sys.path.insert(0, str(SRC_DIR))

from agent_voice_call.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
