#!/usr/bin/env bash
# ==============================================================================
# Etsy Connector CLI Wrapper
# Engineered by Neal Frazier Tech (@1nc0gn30) • NullAI Platform
# ==============================================================================
set -e

PRIMARY_BIN="${ZOTH_SRC_ROOT}/etsy-connector/bin/etsy-connector"
REPO_DIR="${ZOTH_SRC_ROOT}/etsy-connector"

if [[ -x "$PRIMARY_BIN" ]]; then
    exec "$PRIMARY_BIN" "$@"
elif [[ -d "$REPO_DIR/src/etsy_connector" ]]; then
    export PYTHONPATH="$REPO_DIR/src:${PYTHONPATH:-}"
    exec python3 -m etsy_connector.cli "$@"
else
    echo "Error: etsy-connector not found in $PRIMARY_BIN or $REPO_DIR" >&2
    exit 1
fi
