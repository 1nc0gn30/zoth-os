#!/usr/bin/env bash
if [ $# -eq 0 ] && [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ] && [ -x /opt/zoth-bot/bin/zoth-bot ]; then
    exec /opt/zoth-bot/bin/zoth-bot
elif [ "${1:-}" = "--gui" ] && [ -x /opt/zoth-bot/bin/zoth-bot ]; then
    shift
    exec /opt/zoth-bot/bin/zoth-bot "$@"
else
    exec python3 /usr/local/bin/zoth-bot-cli "$@"
fi
