#!/usr/bin/env python3
import sys, os, json, subprocess, argparse

TOOL_ID = 'agent-flight-recorder'
TOOL_REPO = 'agent-flight-recorder'
TOOL_NAME = 'Agent Flight Recorder'
TOOL_DESC = 'Black box flight recorder & time-scrubbing telemetry forensics hub for AI agents with synchronized terminal stream, egress graph, memory engrams, and zero-dependency Python backend.'
TOOL_VERSION = '2.5.0'
TOOL_CATEGORY = 'Forensics & Telemetry'
TOOL_PORT = 8104
REPO_DIR = os.path.expanduser('~/NullAITech/agent-flight-recorder')
PKG_DIR = os.path.expanduser('~/NullAITech/agent-flight-recorder/src')
STUDIO_URL = f"http://127.0.0.1:3000/tools/{TOOL_ID}"
LOCAL_PORT_URL = f"http://127.0.0.1:{TOOL_PORT}"

def main():
    args = sys.argv[1:]
    if '--electron' in args or (args and args[0] in ('desktop', 'electron')):
        import shutil as _sh
        rem = [a for a in args if a not in ('--electron', 'desktop', 'electron')]
        elec = _sh.which('electron') or '/usr/local/bin/electron'
        sys.exit(subprocess.run([elec, os.path.join(REPO_DIR, 'electron', 'main.cjs')] + rem, cwd=REPO_DIR).returncode)
    if '--tui' in args or (args and args[0] == 'tui'):
        rem = [a for a in args if a not in ('--tui', 'tui')]
        sys.exit(subprocess.run([f'/usr/local/bin/{TOOL_ID}-tui'] + rem).returncode)
    subcommands = {'record', 'serve', 'export', 'status'}

    if args and (args[0] in subcommands or (args[0] in ('-h', '--help') and len(args) > 1)):
        env = os.environ.copy()
        env['PYTHONPATH'] = PKG_DIR + os.pathsep + env.get('PYTHONPATH', '')
        res = subprocess.run([sys.executable, '-m', 'agent_flight_recorder.cli'] + args, cwd=REPO_DIR, env=env)
        sys.exit(res.returncode)

    parser = argparse.ArgumentParser(
        prog=TOOL_ID,
        description=f"{TOOL_NAME} (v{TOOL_VERSION}) — {TOOL_DESC}"
    )
    parser.add_argument('--version', action='version', version=f"{TOOL_ID} v{TOOL_VERSION}")
    parser.add_argument('--status', action='store_true', help='Check local ZothOS installation & daemon status')
    parser.add_argument('--json', action='store_true', help='Output deterministic JSON telemetry')
    parser.add_argument('--ui', action='store_true', help='Print local ZothOS workbench URL')
    parser.add_argument('payload', nargs='*', help='Optional subcommands (record, serve, export, status)')
    parsed, unknown = parser.parse_known_args(args)

    if parsed.payload and parsed.payload[0] in subcommands:
        env = os.environ.copy()
        env['PYTHONPATH'] = PKG_DIR + os.pathsep + env.get('PYTHONPATH', '')
        res = subprocess.run([sys.executable, '-m', 'agent_flight_recorder.cli'] + args, cwd=REPO_DIR, env=env)
        sys.exit(res.returncode)

    is_live = False
    try:
        import urllib.request
        with urllib.request.urlopen(f"http://127.0.0.1:{TOOL_PORT}/health", timeout=1.0) as resp:
            if resp.status == 200:
                is_live = True
    except Exception:
        pass

    info = {
        "id": TOOL_ID,
        "repo": TOOL_REPO,
        "name": TOOL_NAME,
        "version": TOOL_VERSION,
        "category": TOOL_CATEGORY,
        "installed": os.path.exists(REPO_DIR),
        "repo_path": REPO_DIR,
        "native_cli": os.path.join(PKG_DIR, "agent_flight_recorder", "cli.py"),
        "studio_workbench_url": STUDIO_URL,
        "local_endpoint": LOCAL_PORT_URL,
        "daemon_live": is_live,
        "license": "100% Free & Open Access (Zero Paywalls)",
        "support": {
            "stripe_buy_coffee": "https://buy.stripe.com/3cIfZg27PdKo2D64Ocfw40X",
            "solana_wallet": "GG2eQbVh8ut1BK6j1A2tz7pSySdLpD38BgyEhGcxdXoK"
        },
        "status": "ACTIVE" if is_live else "READY"
    }

    if parsed.json:
        print(json.dumps(info, indent=2))
        return

    print(f"✦ {TOOL_NAME} (v{TOOL_VERSION}) — [{TOOL_CATEGORY}]")
    print(f"  Repository : {REPO_DIR}")
    print(f"  Workbench  : {STUDIO_URL}")
    print(f"  Local Port : {LOCAL_PORT_URL} (Daemon: {'ACTIVE' if is_live else 'OFFLINE'})")
    print(f"  Access     : 100% Free & Open Access (☕ https://buy.stripe.com/3cIfZg27PdKo2D64Ocfw40X | ◎ GG2eQbVh8ut1BK6j1A2tz7pSySdLpD38BgyEhGcxdXoK)")
    print(f"\nSubcommands available via native CLI (agent-flight):")
    print("  agent-flight record -- <cmd>         Record an agent execution session")
    print("  agent-flight serve [--port 8104]     Launch Time-Scrubbing Flight Deck UI")
    print("  agent-flight export <session_id>     Export standalone single-file bundle")
    print("  agent-flight status                  Summarize flight telemetry storage")

if __name__ == '__main__':
    main()
