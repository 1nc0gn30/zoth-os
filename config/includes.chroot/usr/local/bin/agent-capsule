#!/usr/bin/env bash
# ==============================================================================
# Agent Capsule Jail CLI Wrapper
# Engineered by Neal Frazier Tech (@1nc0gn30) • NullAI Platform
# ==============================================================================
set -e

PRIMARY_BIN="${ZOTH_SRC_ROOT}/agent-capsule-jail/bin/agent-capsule"
REPO_DIR="${ZOTH_SRC_ROOT}/agent-capsule-jail"

if [[ -x "$PRIMARY_BIN" ]]; then
    exec "$PRIMARY_BIN" "$@"
elif [[ -d "$REPO_DIR/src/agent_capsule_jail" ]]; then
    export PYTHONPATH="$REPO_DIR/src:${PYTHONPATH:-}"
    exec python3 -m agent_capsule_jail.cli "$@"
else
    echo "Error: agent-capsule not found in $PRIMARY_BIN or $REPO_DIR" >&2
    exit 1
fi
