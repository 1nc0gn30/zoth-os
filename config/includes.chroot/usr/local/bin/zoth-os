#!/usr/bin/env bash
REPO_DIR="$HOME/NullAITech/zoth-os"
PYTHON_BIN="python3"

if [ "$1" = "--status" ] || [ "$1" = "status" ]; then
  curl -s http://127.0.0.1:8137/api/status 2>/dev/null || echo '{"status":"OFFLINE","port":8137}'
elif [ "$1" = "--version" ] || [ "$1" = "-v" ]; then
  echo "zoth-os v3.3.0 (ZothOS Sovereign Linux Distro)"
  exit 0
elif [ "$1" = "--json" ]; then
  curl -s http://127.0.0.1:8137/api/status 2>/dev/null || cat << 'JSON'
{
  "id": "zoth-os",
  "name": "Zoth OS v3.3.0",
  "status": "READY",
  "binary": "/usr/local/bin/zoth-os",
  "port": 8137,
  "license": "100% Free & Open Access (Zero Paywalls)"
}
JSON
elif [ "$1" = "web" ] || [ "$1" = "serve" ]; then
  exec "$PYTHON_BIN" "$REPO_DIR/server.py" --port 8137
else
  cat << 'HELP'
usage: zoth-os [-h] [--version] [--status] [--json] [serve|web]

Zoth OS v3.3.0 — Sovereign Linux Distro CLI Controller

commands:
  serve, web      Launch local web cockpit daemon on port 8137
  status, --status Query local daemon status and system telemetry
  --json          Output deterministic JSON telemetry
  --version       Display version information
HELP
fi
