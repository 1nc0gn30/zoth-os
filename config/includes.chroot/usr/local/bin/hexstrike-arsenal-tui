#!/usr/bin/env python3
"""HexStrike Security Arsenal — Live :8138 & Catalog Braille Status TUI (v3.2.0)."""

from __future__ import annotations

import argparse
import json
import os
import sys
import urllib.request
from pathlib import Path

VERSION = "3.2.0"


def resolve_root() -> Path | None:
    candidates = [
        os.environ.get("HEXSTRIKE_ROOT", ""),
        os.path.expanduser("~/NullAITech/NullAI-HexStrike-AI-Terminal"),
        os.path.expanduser("~/NullAITech/hexstrike-arsenal"),
        "/opt/hexstrike-arsenal",
    ]
    for c in candidates:
        if c and (Path(c) / "mcp_server.py").is_file():
            return Path(c)
    return None


def redact_home(p: str) -> str:
    home = str(Path.home())
    return "~" + p[len(home):] if p.startswith(home) else p


def braille_bar(ratio: float, width: int = 24) -> str:
    clamped = max(0.0, min(1.0, ratio))
    filled = int(round(clamped * width))
    return "⣿" * filled + "⣀" * (width - filled)


def collect_live_status(port: int = 8138) -> dict:
    root = resolve_root()
    catalog_count = 0
    categories: dict[str, int] = {}
    mcp_tools: list[str] = []

    if root is not None:
        sys.path.insert(0, str(root))
        try:
            from mcp_server import load_tools_catalog, mcp_tool_definitions

            catalog = load_tools_catalog()
            catalog_count = len(catalog)
            for item in catalog:
                cat = str(item.get("category", "Other"))
                categories[cat] = categories.get(cat, 0) + 1
            mcp_tools = [t["name"] for t in mcp_tool_definitions()]
        except Exception:
            pass

    daemon_online = False
    daemon_health = None
    try:
        with urllib.request.urlopen(f"http://127.0.0.1:{port}/health", timeout=1.0) as resp:
            if resp.status == 200:
                daemon_online = True
                daemon_health = json.loads(resp.read().decode("utf-8"))
    except Exception:
        pass

    return {
        "service": "hexstrike-arsenal",
        "version": VERSION,
        "root": redact_home(str(root)) if root else None,
        "local_endpoint": f"http://127.0.0.1:{port}",
        "daemon_state": "ONLINE" if daemon_online else "IDLE (on-demand)",
        "daemon_online": daemon_online,
        "daemon_health": daemon_health,
        "arsenal_count": catalog_count,
        "mcp_tool_count": len(mcp_tools),
        "mcp_tools": mcp_tools,
        "top_categories": sorted(categories.items(), key=lambda kv: kv[1], reverse=True)[:5],
    }


def render_tui(info: dict) -> str:
    lines = [
        "╔════════════════════════════════════════════════════════════════════╗",
        f"║  HEXSTRIKE SECURITY ARSENAL v{info['version']} // LIVE BRAILLE MONITOR      ║",
        "╠════════════════════════════════════════════════════════════════════╣",
        f"║  Daemon (:8138) : {info['daemon_state']:<49}║",
        f"║  Catalog Tools  : {str(info['arsenal_count']) + ' indexed':<49}║",
        f"║  MCP Tools      : {str(info['mcp_tool_count']) + ' JSON-RPC 2.0 stdio tools':<49}║",
        f"║  Root Path      : {(info['root'] or 'unconfigured'):<49}║",
        "╠════════════════════════════════════════════════════════════════════╣",
        "║  TOP CATALOG CATEGORIES (Unicode U+2800 Braille Density)          ║",
    ]
    total = max(1, info["arsenal_count"])
    for cat, count in info["top_categories"]:
        bar = braille_bar(count / total, width=22)
        row = f"  {cat:<14} {bar} {count:>3}/{total:<3}"
        lines.append(f"║{row:<68}║")
    lines.append("╚════════════════════════════════════════════════════════════════════╝")
    return "\n".join(lines)


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog="hexstrike-arsenal-tui",
        description=f"HexStrike Security Arsenal v{VERSION} live :8138 and catalog Braille monitor",
    )
    parser.add_argument("--status", action="store_true", help="Print live :8138 daemon and catalog Braille monitor")
    parser.add_argument("--json", action="store_true", help="Emit live status telemetry as JSON")
    parser.add_argument("--port", type=int, default=8138, help="Loopback port to probe (default: 8138)")
    parser.add_argument("--version", action="version", version=f"hexstrike-arsenal-tui v{VERSION}")
    args = parser.parse_args(argv)

    info = collect_live_status(port=args.port)
    if args.json:
        print(json.dumps(info, indent=2))
        return 0
    print(render_tui(info))
    return 0


if __name__ == "__main__":
    sys.exit(main())
