#!/usr/bin/env python3
"""
zoth-osint v2.0 — Sovereign Open-Source Intelligence Engine & Orchestrator CLI
Engineered by Neal Frazier Tech (@1nc0gn30) • NullAI Platform
"""

import argparse
import json
import os
import sys

REAL_PATH = os.path.realpath(__file__)
ROOT_DIR = os.path.dirname(os.path.dirname(REAL_PATH))
if ROOT_DIR not in sys.path:
    sys.path.insert(0, ROOT_DIR)

from engine.arsenal_runner import execute_arsenal_tool, get_arsenal_status  # noqa: E402
from engine.breach_intel import recon_breaches_and_pastes  # noqa: E402
from engine.case_store import correlate_cases, correlate_payloads, get_case, list_cases  # noqa: E402
from engine.mitre_attack import map_mitre_attack  # noqa: E402
from engine.takeover import check_subdomain_takeovers  # noqa: E402
from engine.voice_announcer import announce_scan_result  # noqa: E402
from engine.osint_core import (  # noqa: E402
    analyze_file_forensics,
    classify_target,
    recon_asn_bgp,
    recon_domain,
    recon_email,
    recon_favicon_mmh3,
    recon_http_stack,
    recon_ip,
    recon_new_age_identity,
    recon_phone,
    recon_rdap,
    recon_username,
    recon_wallet,
    recon_wayback,
    run_unified_scan,
    synthesize_dorks,
)


def _print_banner() -> None:
    print("╔══════════════════════════════════════════════════════════════════════╗")
    print("║  ZOTH-OSINT v4.0 // SOVEREIGN CORRELATION & 32-TOOL ORCHESTRATOR    ║")
    print("║  Engineered by Neal Frazier Tech (@1nc0gn30) • NullAI Platform      ║")
    print("╚══════════════════════════════════════════════════════════════════════╝")


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="zoth-osint",
        description="Zoth OSINT v2.0 — Sovereign Multi-Pivot Reconnaissance & Open-Source OSINT Orchestrator",
    )
    parser.add_argument("--json", action="store_true", help="Emit machine-readable JSON output")
    parser.add_argument("--voice", "--announce", dest="voice", action="store_true", help="Announce reconnaissance completion via Kokoro ONNX speech engine (:9394)")
    sub = parser.add_subparsers(dest="cmd")

    # scan (auto-classifies target + synthesizes graph + Obsidian canvas + STIX 2.1 bundle)
    p_scan = sub.add_parser("scan", help="Auto-classify target (domain/ip/username/email/wallet/phone) and run full OSINT scan")
    p_scan.add_argument("target", help="Target domain, IPv4, @username, email, wallet address, or phone number")
    p_scan.add_argument("--canvas", help="Write Obsidian JSON Canvas (.canvas) to file path")
    p_scan.add_argument("--stix", help="Write OASIS STIX 2.1 Cyber Threat Intelligence Bundle (.json) to file path")
    p_scan.add_argument("--voice", "--announce", dest="voice", action="store_true", help="Announce reconnaissance completion via Kokoro ONNX speech engine (:9394)")
    p_scan.add_argument("--json", action="store_true", help="Output raw JSON")

    # username
    p_user = sub.add_parser("username", help="Enumerate username across developer/social platforms & GitHub deep intel")
    p_user.add_argument("handle", help="Username / handle (e.g. 1nc0gn30)")
    p_user.add_argument("--json", action="store_true", help="Output raw JSON")

    # domain
    p_dom = sub.add_parser("domain", help="Passive DNS, SPF/DMARC, TLS, crt.sh subdomains, Wayback CDX & Shodan InternetDB pivot")
    p_dom.add_argument("domain", help="Domain name (e.g. nullai.tech)")
    p_dom.add_argument("--json", action="store_true", help="Output raw JSON")

    # ip
    p_ip = sub.add_parser("ip", help="Shodan InternetDB zero-key ports/CVEs/CPEs + GeoIP/ASN lookup")
    p_ip.add_argument("ip", help="IPv4 address (e.g. 1.1.1.1)")
    p_ip.add_argument("--json", action="store_true", help="Output raw JSON")

    # email
    p_em = sub.add_parser("email", help="Gravatar MD5/SHA256 probe, OpenPGP keyserver, GitHub commit & domain MX check")
    p_em.add_argument("email", help="Email address")
    p_em.add_argument("--json", action="store_true", help="Output raw JSON")

    # breach
    p_br = sub.add_parser("breach", help="Zero-key breach, leak archive & pastebin/gist reconnaissance")
    p_br.add_argument("target", help="Target email, username, or keyword")
    p_br.add_argument("--type", choices=["email", "username", "auto"], default="auto", help="Override query target type")
    p_br.add_argument("--json", action="store_true", help="Output raw JSON")

    # wallet
    p_wal = sub.add_parser("wallet", help="Zero-key Blockchain RPC OSINT for Solana, Ethereum/EVM, and Bitcoin addresses")
    p_wal.add_argument("address", help="Solana (Base58), Ethereum (0x...), or Bitcoin (bc1...) wallet address")
    p_wal.add_argument("--json", action="store_true", help="Output raw JSON")

    # phone
    p_ph = sub.add_parser("phone", help="ITU-T E.164 normalization, NANPA area code geolocation & messaging pivot URLs")
    p_ph.add_argument("number", help="Phone number (e.g. +1-757-555-0199)")
    p_ph.add_argument("--json", action="store_true", help="Output raw JSON")

    # wayback
    p_wb = sub.add_parser("wayback", help="Wayback Machine CDX historical endpoint & sensitive path discovery")
    p_wb.add_argument("domain", help="Domain name (e.g. nullai.tech)")
    p_wb.add_argument("--json", action="store_true", help="Output raw JSON")

    # favicon
    p_fav = sub.add_parser("favicon", help="Compute Shodan/Censys 32-bit signed MurmurHash3 (mmh3) & SHA256 for a domain's /favicon.ico")
    p_fav.add_argument("domain", help="Domain name (e.g. nullai.tech)")
    p_fav.add_argument("--json", action="store_true", help="Output raw JSON")

    # web3
    p_w3 = sub.add_parser("web3", help="Resolve Bluesky ATProto DIDs (did:plc), ENS (.eth) Web3 profiles & HuggingFace AI models")
    p_w3.add_argument("target", help="Handle, domain, or .eth name (e.g. vitalik.eth or bsky.app)")
    p_w3.add_argument("--json", action="store_true", help="Output raw JSON")

    # rdap
    p_rd = sub.add_parser("rdap", help="Query structured IETF RDAP registry (registrar, registration/expiration dates, DNSSEC)")
    p_rd.add_argument("target", help="Domain or IPv4 address")
    p_rd.add_argument("--json", action="store_true", help="Output raw JSON")

    # tech
    p_tc = sub.add_parser("tech", help="Passive HTTP security header grader (0-100) & CDN/Web Tech-Stack fingerprinter")
    p_tc.add_argument("domain", help="Domain name (e.g. nullai.tech)")
    p_tc.add_argument("--json", action="store_true", help="Output raw JSON")

    # takeover
    p_to = sub.add_parser("takeover", help="Active/passive DNS CNAME and Subdomain takeover audit across 23+ SaaS signatures")
    p_to.add_argument("target", help="Domain or subdomain(s) to audit (e.g. nullai.tech, or sub1.example.com,sub2.example.com)")
    p_to.add_argument("--json", action="store_true", help="Output raw JSON")

    # asn
    p_as = sub.add_parser("asn", help="Query RIPE Stat BGP API for Autonomous System holder & announced CIDR prefixes")
    p_as.add_argument("asn", help="ASN number (e.g. AS13335 or 13335)")
    p_as.add_argument("--json", action="store_true", help="Output raw JSON")

    # correlate
    p_cr = sub.add_parser("correlate", help="Merge multiple OSINT targets or saved cases into a Unified Supergraph & detect shared overlaps")
    p_cr.add_argument("targets", nargs="*", help="Two or more targets to scan and correlate (or omit to correlate recent saved cases)")
    p_cr.add_argument("--gexf", help="Write Gephi / Cytoscape .gexf XML graph to file path")
    p_cr.add_argument("--json", action="store_true", help="Output raw JSON")

    # mcp
    sub.add_parser("mcp", help="Run the Zoth OSINT Model Context Protocol (MCP) JSON-RPC 2.0 STDIO server")

    # dorks
    p_dk = sub.add_parser("dorks", help="Synthesize 18 targeted Google, GitHub, Shodan & CT search queries for a target")
    p_dk.add_argument("target", help="Target domain, handle, email, or IP")
    p_dk.add_argument("--json", action="store_true", help="Output raw JSON")

    # mitre
    p_mitre = sub.add_parser("mitre", help="Map target recon telemetry to MITRE ATT&CK Enterprise Matrix & tactical countermeasures")
    p_mitre.add_argument("target", help="Target domain, IPv4, username, email, or wallet")
    p_mitre.add_argument("--stix", help="Write enriched OASIS STIX 2.1 Threat Bundle to file path")
    p_mitre.add_argument("--json", action="store_true", help="Output raw JSON")

    # cases
    p_cs = sub.add_parser("cases", help="List saved SQLite OSINT investigation cases (~/.zoth-osint/cases.db)")
    p_cs.add_argument("--id", type=int, help="Fetch full JSON payload for a specific case ID")
    p_cs.add_argument("--json", action="store_true", help="Output raw JSON")

    # exif / forensics
    p_exif = sub.add_parser("exif", help="Binary file forensics: SHA256/MD5, Shannon entropy, MIME & embedded URLs/emails")
    p_exif.add_argument("file", help="Path to local file")
    p_exif.add_argument("--json", action="store_true", help="Output raw JSON")

    # arsenal
    p_ars = sub.add_parser("arsenal", help="List top 24 open-source OSINT tools & local installation status")
    p_ars.add_argument("--target", default="nullai.tech", help="Target for command template synthesis")
    p_ars.add_argument("--json", action="store_true", help="Output raw JSON")

    # run
    p_run = sub.add_parser("run", help="Execute an installed open-source OSINT binary (sherlock, holehe, subfinder, dig, whois, nmap, httpx, internetdb)")
    p_run.add_argument("tool_id", help="Tool ID (e.g. sherlock, holehe, subfinder, dig, whois, nmap, httpx, internetdb)")
    p_run.add_argument("target", help="Target string")
    p_run.add_argument("--json", action="store_true", help="Output raw JSON")

    # serve
    p_srv = sub.add_parser("serve", help="Start the Zoth OSINT Web Workstation daemon (default port 8148)")
    p_srv.add_argument("--host", default="127.0.0.1")
    p_srv.add_argument("--port", type=int, default=8148)

    args = parser.parse_args()
    want_json = getattr(args, "json", False)

    if not args.cmd:
        if want_json:
            print(json.dumps(get_arsenal_status("nullai.tech"), indent=2))
            return 0
        _print_banner()
        parser.print_help()
        return 0

    if args.cmd == "serve":
        from server import ZothOsintHandler, ThreadingHTTPServer

        srv = ThreadingHTTPServer((args.host, args.port), ZothOsintHandler)
        print(f"[zoth-osint v2.0] Web Workstation running at http://{args.host}:{args.port}")
        try:
            srv.serve_forever()
        except KeyboardInterrupt:
            pass
        return 0

    if args.cmd == "scan":
        res = run_unified_scan(args.target)
        if getattr(args, "voice", False) or os.environ.get("ZOTH_VOICE_ANNOUNCE") == "1":
            announce_scan_result(
                target=res.get("target", args.target),
                target_type=res.get("type", "unknown"),
                finding_count=len(res.get("findings", [])),
                risk_score=res.get("risk", {}).get("score") if isinstance(res.get("risk"), dict) else None
            )
        if args.canvas:
            with open(args.canvas, "w", encoding="utf-8") as f:
                json.dump(res["obsidian_canvas"], f, indent=2)
        if args.stix:
            with open(args.stix, "w", encoding="utf-8") as f:
                json.dump(res["stix_bundle"], f, indent=2)
        if want_json:
            print(json.dumps(res, indent=2))
        else:
            _print_banner()
            print(f"[*] Target: {res['target']}  (Classified as: {res['type'].upper()})  [Case #{res.get('case_id')}]")
            for finding in res.get("findings", []):
                print(f"  + {finding}")
            print(f"  + Entity Graph: {len(res['graph']['nodes'])} nodes, {len(res['graph']['edges'])} edges")
            print(f"  + STIX 2.1 Bundle: {len(res.get('stix_bundle', {}).get('objects', []))} SDO/SRO objects")
            if args.canvas:
                print(f"  + Saved Obsidian Canvas to: {args.canvas}")
            if args.stix:
                print(f"  + Saved STIX 2.1 Bundle to: {args.stix}")
        return 0

    if args.cmd == "username":
        res = recon_username(args.handle)
    elif args.cmd == "domain":
        res = recon_domain(args.domain)
    elif args.cmd == "ip":
        res = recon_ip(args.ip)
    elif args.cmd == "email":
        res = recon_email(args.email)
    elif args.cmd == "breach":
        q_type = args.type if args.type != "auto" else classify_target(args.target)
        res = recon_breaches_and_pastes(args.target, query_type=q_type)
        if want_json:
            print(json.dumps(res, indent=2))
        else:
            _print_banner()
            print(f"[*] Breach & Leak Reconnaissance: {res['target']} ({res.get('query_type', 'auto').upper()})")
            risk = res.get("risk", {})
            print(f"[*] Threat Rating: {risk.get('level', 'CLEAN')} ({risk.get('score', 0)}/100)  |  Breaches: {len(res.get('breaches', []))}  |  Pastes/Gists: {len(res.get('pastes', []))}")
            pwn = res.get("pwned_passwords_k_anonymity") or {}
            if pwn.get("checked"):
                status_str = f"EXPOSED ({pwn['occurrences']:,} occurrences)" if pwn.get("pwned") else "CLEAN (0 occurrences)"
                print(f"[*] HIBP SHA-1 k-Anonymity [{pwn.get('hash_prefix', '?????')}***]: {status_str}")
            print("\nFindings:")
            for f in res.get("findings", []):
                print(f"  + {f}")
            if res.get("breaches"):
                print("\nDiscovered Public Breaches (Top 10):")
                for b in res["breaches"][:10]:
                    d_str = f" ({b.get('date')})" if b.get('date') else ""
                    classes = ", ".join(b.get("data_classes", [])[:4])
                    print(f"  • {b.get('name')}{d_str} — {b.get('industry', 'Leak')} [{classes or 'Account Data'}]")
            if res.get("pastes"):
                print("\nDiscovered Pastes / Gists:")
                for p in res["pastes"][:10]:
                    print(f"  • [{p.get('source')}] {p.get('title')} -> {p.get('url')}")
            if res.get("commit_mentions"):
                print("\nDiscovered Public GitHub Commit Leaks:")
                for c in res["commit_mentions"][:5]:
                    print(f"  • [{c.get('repo')}] {c.get('message')} ({c.get('author')})")
        return 0
    elif args.cmd == "wallet":
        res = recon_wallet(args.address)
    elif args.cmd == "phone":
        res = recon_phone(args.number)
    elif args.cmd == "wayback":
        res = recon_wayback(args.domain)
    elif args.cmd == "favicon":
        res = recon_favicon_mmh3(args.domain)
    elif args.cmd == "web3":
        res = recon_new_age_identity(args.target)
    elif args.cmd == "rdap":
        res = recon_rdap(args.target, is_ip=(classify_target(args.target) == "ip"))
    elif args.cmd == "tech":
        res = recon_http_stack(args.domain)
    elif args.cmd == "takeover":
        target = args.target.strip()
        if "," in target:
            subs = [s.strip() for s in target.split(",") if s.strip()]
            res = check_subdomain_takeovers(subdomains=subs)
        elif target.count(".") <= 1 and not target.startswith("www."):
            res = check_subdomain_takeovers(subdomains=[], target_domain=target)
        else:
            res = check_subdomain_takeovers(subdomains=[target])

        if not want_json:
            _print_banner()
            print(f"[*] Subdomain Takeover & Dangling DNS Audit: {args.target}")
            print(f"    Audited: {res['total_checked']} targets across {res['signatures_count']} SaaS signatures")
            print(f"    Vulnerabilities: {res['vulnerable_count']} confirmed  |  Dangling CNAMEs: {res['dangling_count']}\n")
            if res.get("vulnerable"):
                print("🚨 CONFIRMED TAKEOVER VULNERABILITIES:")
                for v in res["vulnerable"]:
                    print(f"  [CRITICAL] {v['subdomain']} -> CNAME {v.get('cname')}")
                    print(f"             Service: {v['service']}  |  Matched Fingerprint: '{v.get('fingerprint_matched')}'")
                    print(f"             Action: {v.get('discussion')}\n")
            if res.get("dangling"):
                print("⚠️ DANGLING CNAME RECORDS (NXDOMAIN):")
                for d in res["dangling"]:
                    print(f"  [HIGH RISK] {d['subdomain']} -> CNAME {d.get('cname')} (NXDOMAIN)")
                    print(f"              Action: {d.get('discussion')}\n")
            if not res.get("vulnerable") and not res.get("dangling"):
                print("✅ 0 takeover vulnerabilities or dangling pointers detected. All audited CNAMEs are clean or active.\n")
                if res.get("all_cnames"):
                    print("Discovered CNAME Delegations:")
                    for c in res["all_cnames"]:
                        print(f"  - {c['subdomain']} -> {c.get('cname')} ({c.get('status')} / {c.get('service') or 'External'})")
            return 0
    elif args.cmd == "asn":
        res = recon_asn_bgp(args.asn)
    elif args.cmd == "correlate":
        if args.targets and len(args.targets) >= 2:
            payloads = [run_unified_scan(t) for t in args.targets[:4]]
            res = correlate_payloads(payloads)
        else:
            res = correlate_cases([])
        if args.gexf:
            with open(args.gexf, "w", encoding="utf-8") as f:
                f.write(res.get("gexf_xml", ""))
    elif args.cmd == "mcp":
        from mcp_server import run_mcp_stdio

        run_mcp_stdio()
        return 0
    elif args.cmd == "dorks":
        t_type = classify_target(args.target)
        res = {"target": args.target, "type": t_type, "dorks": synthesize_dorks(args.target, t_type)}
    elif args.cmd == "mitre":
        scan_res = run_unified_scan(args.target)
        mitre_data = scan_res.get("mitre_attack") or map_mitre_attack(scan_res.get("findings", []), scan_res)
        if args.stix:
            with open(args.stix, "w", encoding="utf-8") as f:
                json.dump(scan_res.get("stix_bundle", {}), f, indent=2)
        if want_json:
            print(json.dumps(mitre_data, indent=2))
        else:
            _print_banner()
            print(f"[*] Target: {mitre_data['target']}  (Classified as: {mitre_data.get('target_type', scan_res.get('type', '')).upper()})")
            print(f"    Hardening Score: {mitre_data.get('defensive_score', 0)}/100 | Risk Level: {mitre_data.get('risk_level', 'UNKNOWN')}")
            print(f"    Total ATT&CK Techniques: {mitre_data.get('total_techniques', 0)} | Tactics Active: {', '.join(f'{k} ({v})' for k, v in mitre_data.get('tactics_summary', {}).items())}\n")

            print("── [DETECTED ATT&CK TECHNIQUES] ──────────────────────────────────────────")
            for t in mitre_data.get("techniques_detected", []):
                print(f"  • [{t['id']}] {t['name']}")
                print(f"    Tactic: {t['tactic']} ({t.get('tactic_id', '')}) | Severity: {t.get('severity', 'MEDIUM')} | Confidence: {t.get('confidence', 'HIGH')}")
                for ev in t.get("evidence", []):
                    print(f"    ↳ Evidence: {ev}")
                print(f"    ↳ Reference: {t.get('url', '')}\n")

            print("── [TACTICAL DEFENSIVE COUNTERMEASURES] ──────────────────────────────────")
            for cm in mitre_data.get("countermeasures", []):
                techs = ", ".join(cm.get("associated_techniques", []))
                print(f"  [{cm.get('priority', 'P2')}] [{cm.get('category', 'Defense')}] (Mitigates: {techs})")
                print(f"    Action: {cm.get('recommendation')}\n")

            if args.stix:
                print(f"  + Saved enriched STIX 2.1 Threat Intelligence Bundle to: {args.stix}")
        return 0
    elif args.cmd == "cases":
        if args.id:
            res = get_case(args.id) or {"error": f"Case #{args.id} not found"}
        else:
            cases = list_cases(limit=25)
            if not want_json:
                _print_banner()
                print(f"Saved OSINT Cases in ~/.zoth-osint/cases.db ({len(cases)} recent):\n")
                for c in cases:
                    print(f"  [#{c['id']:03d}] {c['timestamp']}  |  {c['target_type'].upper():8}  |  {c['target']:36}  ({c['node_count']} nodes, {c['edge_count']} edges)")
                return 0
            res = {"cases": cases}
    elif args.cmd == "exif":
        res = analyze_file_forensics(args.file)
    elif args.cmd == "arsenal":
        res = get_arsenal_status(args.target)
        if not want_json:
            _print_banner()
            print(f"Open-Source OSINT Arsenal ({res['installed_or_builtin']}/{res['total_tools']} available locally):\n")
            for t in res["tools"]:
                mark = "[INSTALLED]" if t["installed"] else "[CATALOGED]"
                print(f"  {mark:12} {t['name']:28} ({t['category']})")
                print(f"               $ {t['ready_command']}")
            return 0
    elif args.cmd == "run":
        res = execute_arsenal_tool(args.tool_id, args.target)
    else:
        parser.print_help()
        return 1

    print(json.dumps(res, indent=2))
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except BrokenPipeError:
        devnull = os.open(os.devnull, os.O_WRONLY)
        os.dup2(devnull, sys.stdout.fileno())
        sys.exit(0)
