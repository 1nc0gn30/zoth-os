#!/usr/bin/env python3
"""Storefront Catalog CLI Entrypoint."""

# zothos-repo-shim: run the canonical repo copy so repo-relative paths resolve
import os as _os, sys as _sys
_here = _os.path.realpath(__file__)
_repo = _os.environ.get("ZOTH_REPO_DIR") or '/home/zoth/NullAITech' + "/" + 'storefront-catalog'
_real = _os.path.join(_repo, "bin", 'storefront-catalog')
if _os.path.exists(_real) and _os.path.realpath(_real) != _here:
    _os.execv(_sys.executable, [_sys.executable, _real] + _sys.argv[1:])
del _os, _sys, _here, _repo, _real

import os
import subprocess
import sys

ROOT = os.path.abspath(os.path.join(os.path.dirname(__file__), ".."))
sys.exit(subprocess.call([sys.executable, os.path.join(ROOT, "server.py"), *sys.argv[1:]]))
