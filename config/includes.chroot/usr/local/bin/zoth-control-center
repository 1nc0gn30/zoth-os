]

PILLARS = [
    ("00-Root-Flagships", "10 Core Flagship Desktop Apps", "${ZOTH_HOME}/Desktop"),
    ("01-AI-Agents-and-Dev", "Frontier Coding Agents, AI Stacks & Web Builders", "${ZOTH_HOME}/Desktop/01-AI-Agents-and-Dev"),
    ("02-Security-and-Privacy", "HexStrike AI, Kali/Parrot Suite, Ghostmode & Vaults", "${ZOTH_HOME}/Desktop/02-Security-and-Privacy"),
    ("03-ZothOS-Daemons", "22 Loopback Enclave Daemons & Telemetry Conductor", "${ZOTH_HOME}/Desktop/03-ZothOS-Daemons"),
    ("04-Media-and-Utilities", "Obsidian Canon, Yazi, Desktop Pet, Audio/Video & Tools", "${ZOTH_HOME}/Desktop/04-Media-and-Utilities"),
]


def check_port(port):
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
        s.settimeout(0.25)
        return s.connect_ex(("127.0.0.1", port)) == 0


def get_thermals():
    temps = []
    for p in glob.glob("/sys/class/thermal/thermal_zone*/temp"):
        try:
            with open(p, "r") as f:
                val = int(f.read().strip())
                if 1000 < val < 120000:
                    temps.append(round(val / 1000.0, 1))
        except Exception:
            pass
    max_t = max(temps) if temps else 42.0
    avg_t = round(sum(temps) / len(temps), 1) if temps else 37.0
    state = "COOL" if max_t < 65.0 else ("WARM" if max_t < 78.0 else "HOT")
    return {"max_c": max_t, "avg_c": avg_t, "state": state}


def list_desktop_apps(folder):
    apps = []
    if not os.path.isdir(folder):
        return apps
    for p in sorted(glob.glob(os.path.join(folder, "*.desktop"))):
        name = os.path.basename(p).replace(".desktop", "")
        exec_cmd = ""
        try:
            with open(p, "r", errors="ignore") as f:
                for line in f:
                    if line.startswith("Name="):
                        name = line.split("=", 1)[1].strip()
                    elif line.startswith("Exec="):
                        exec_cmd = line.split("=", 1)[1].strip()
        except Exception:
            pass
        apps.append({"file": os.path.basename(p), "name": name, "exec": exec_cmd})
    return apps


def collect_report():
    cpus = os.cpu_count() or 1
    kvm = os.path.exists("/dev/kvm")
    thermals = get_thermals()
    svcs = []
    for name, port, path, boot_cmd in SERVICES:
        up = check_port(port)
        svcs.append({"name": name, "port": port, "up": up, "boot_cmd": boot_cmd})
    pillars = {}
    for key, desc, folder in PILLARS:
        pillars[key] = {
            "description": desc,
            "folder": folder,
            "count": len(list_desktop_apps(folder)),
            "apps": list_desktop_apps(folder),
        }
    return {"cpus": cpus, "kvm": kvm, "thermals": thermals, "services": svcs, "desktop_pillars": pillars}


def print_dashboard(rep):
    t = rep["thermals"]
    t_color = "\033[1;32m" if t["state"] == "COOL" else ("\033[1;33m" if t["state"] == "WARM" else "\033[1;31m")
    print("\033[1;33m==========================================================================\033[0m")
    print("\033[1;33m  ⚡ ZOTHOS SOVEREIGN CONTROL CENTER v2.0 · UNIFIED DESKTOP & DAEMON HUB\033[0m")
    print("\033[1;33m==========================================================================\033[0m")
    kvm_str = "\033[1;32mAVAILABLE\033[0m" if rep["kvm"] else "\033[1;33mUNAVAILABLE\033[0m"
    print(f"  CPU Threads: {rep['cpus']}  |  KVM: {kvm_str}  |  Thermals: {t_color}{t['max_c']}°C ({t['state']})\033[0m")
    print("--------------------------------------------------------------------------")
    print("  \033[1;36m[CONSOLIDATED DESKTOP ARCHITECTURE — 10 FLAGSHIPS + 4 PILLARS]\033[0m")
    for idx, (key, meta) in enumerate(rep["desktop_pillars"].items()):
        print(f"    [{idx}] \033[1m{key:<24}\033[0m ({meta['count']:>2} apps) — {meta['description']}")
    print("--------------------------------------------------------------------------")
    print("  \033[1;36m[CORE SOVEREIGN DAEMONS & RUNTIMES]\033[0m")
    for s in rep["services"]:
        badge = "\033[1;32m[ONLINE ]\033[0m" if s["up"] else "\033[1;31m[OFFLINE]\033[0m"
        print(f"    {badge} {s['name']:<36} (127.0.0.1:{s['port']})")
    print("==========================================================================")
    print("  Commands: zoth-control-center [--status | --json | --boot-all | --pillars | --interactive]")


def run_interactive(rep):
    while True:
        print_dashboard(rep)
        print("\n  Select action:")
        print("    [1] Browse 01-AI-Agents-and-Dev     [2] Browse 02-Security-and-Privacy")
        print("    [3] Browse 03-ZothOS-Daemons        [4] Browse 04-Media-and-Utilities")
        print("    [b] Boot All 22 ZothOS Daemons      [a] Probe Coding Agents (Hermes/Grok/Ollama)")
        print("    [q] Quit")
        try:
            choice = input("\n  zoth-control-center > ").strip().lower()
        except (EOFError, KeyboardInterrupt):
            print()
            break
        if choice == "q":
            break
        elif choice == "b":
            subprocess.run(["${ZOTH_SRC_ROOT}/bin/zoth-agent-conductor", "up"])
            rep = collect_report()
        elif choice == "a":
            subprocess.run(["${ZOTH_SRC_ROOT}/bin/zoth-agent-conductor", "agents"])
            input("\n  Press Enter to continue...")
        elif choice in ("1", "2", "3", "4"):
            idx = int(choice)
            key, desc, folder = PILLARS[idx]
            apps = list_desktop_apps(folder)
            print(f"\n  \033[1;33m=== {key}: {desc} ===\033[0m")
            for i, app in enumerate(apps, 1):
                print(f"    [{i:>2}] {app['name']:<32} ({app['file']})")
            sub = input("\n  Enter app # to launch (or Enter to go back): ").strip()
            if sub.isdigit() and 1 <= int(sub) <= len(apps):
                cmd = apps[int(sub) - 1]["exec"].split("%")[0].strip()
                if cmd:
                    print(f"  [*] Launching: {cmd}")
                    subprocess.Popen(cmd, shell=True, executable="/bin/bash")


if __name__ == "__main__":
    args = sys.argv[1:]
    if "--boot-all" in args:
        subprocess.run(["${ZOTH_SRC_ROOT}/bin/zoth-agent-conductor", "up"])
        rep = collect_report()
        for s in rep["services"]:
            if not s["up"]:
                subprocess.Popen(s["boot_cmd"], shell=True, executable="/bin/bash")
        sys.exit(0)
    rep = collect_report()
    if "--json" in args:
        print(json.dumps(rep, indent=2))
    elif "--pillars" in args:
        for key, meta in rep["desktop_pillars"].items():
            print(f"\n=== {key} ({meta['count']} apps) ===")
            for a in meta["apps"]:
                print(f"  • {a['name']:<34} [{a['file']}]")
    elif "--interactive" in args or (sys.stdout.isatty() and not args):
        if "--status" in args or not sys.stdin.isatty():
            print_dashboard(rep)
        else:
            run_interactive(rep)
    else:
        print_dashboard(rep)
