#!/usr/bin/env python3
# ==============================================================================
#  zoth-cursorz — CLI Utility for Linux & Android Multi-Agent Virtual Cursors
#  Features:
#   - Concurrent virtual agent cursors & Braille lattice holographic trails
#   - Linux Wayland/X11 & Android ADB gesture and tap dispatch
#   - Automated workflow training & visual landmark pre-flight verification
# ==============================================================================

import sys
import os
import json
import urllib.request
import urllib.error

API_URL = "http://127.0.0.1:9990"

def usage():
    print("""Usage: zoth-cursorz <command> [arguments]

Multi-Cursor Commands:
  list                          List all active virtual agent cursors
  spawn <agent> [color] [x] [y] Spawn a virtual cursor for an agent
  move <agent> <x> <y> [text]   Move an agent's cursor to coordinates
  click <agent> [left|right]    Trigger a click action on an agent's cursor
  remove <agent>                Remove an agent's virtual cursor
  overlay                       Launch transparent click-through Electron overlay (Linux)
  dashboard                     Launch desktop multi-agent control panel window
  daemon                        Start the background daemon process (:9990)
  status                        Check daemon health and connection

Linux & Android Computer-Use Commands:
  tap <x> <y>                   Dispatch tap / click to target coordinates
  swipe <x1> <y1> <x2> <y2> [ms]Dispatch swipe / drag gesture across screen
  type <text>                   Inject text buffer to focused input field
  key <key_name>                Inject physical key press (Return, Tab, Escape, etc.)
  screenshot [output_path]      Capture live display frame (grim/spectacle/adb)

Workflow Training & Preset Commands:
  train start <preset_name>     Start recording mouse movements, clicks, and keystrokes
  train click [button]          Record a click at current position with landmark micro-crop
  train swipe <x1> <y1> <x2> <y2> Record a gesture swipe
  train type <text>             Record a typing sequence
  train key <key>               Record a keypress
  train stop                    Stop recording and save verified workflow preset
  run <preset_name> [platform]  Replay workflow with pre-flight layout analysis & auto-drift
  presets                       List all saved automation presets

Android Subsystem Commands:
  android build                 Compile, sign, and align Android APK (zoth-cursorz-arm64.apk)
  android install               Deploy APK to connected Android device / emulator via ADB
  android devices               List connected Android devices

Attribution: Neal Frazier Tech (@1nc0gn30) • NullAI Platform
""")
    sys.exit(1)

def req(endpoint, data=None, method="GET"):
    url = f"{API_URL}{endpoint}"
    try:
        body = json.dumps(data).encode("utf-8") if data else None
        headers = {"Content-Type": "application/json"} if data else {}
        r = urllib.request.Request(url, data=body, headers=headers, method=method)
        with urllib.request.urlopen(r, timeout=3) as resp:
            return json.loads(resp.read().decode("utf-8"))
    except urllib.error.URLError as e:
        print(f"Error connecting to zoth-cursorz-daemon on {API_URL}: {e}")
        print("Tip: Run 'zoth-cursorz daemon' to start the daemon.")
        sys.exit(1)

def main():
    if len(sys.argv) < 2:
        usage()

    cmd = sys.argv[1]

    if cmd == "list":
        res = req("/api/cursors")
        print(f"Active Virtual Cursors ({res.get('count', 0)}):")
        for c in res.get("cursors", []):
            print(f"  • {c.get('symbol', '✦')} {c.get('name', 'Agent')} ({c.get('agent_id')}): ({c.get('x')}, {c.get('y')}) [{c.get('state')}] {c.get('action_text')}")
    
    elif cmd == "status":
        res = req("/api/health")
        print(json.dumps(res, indent=2))

    elif cmd == "spawn":
        if len(sys.argv) < 3: usage()
        agent_id = sys.argv[2]
        color = sys.argv[3] if len(sys.argv) > 3 else None
        x = float(sys.argv[4]) if len(sys.argv) > 4 else 960
        y = float(sys.argv[5]) if len(sys.argv) > 5 else 540
        res = req("/api/cursors/spawn", {"agent_id": agent_id, "color": color, "x": x, "y": y}, method="POST")
        print(f"Spawned virtual cursor for {agent_id}: ({x}, {y})")

    elif cmd == "move":
        if len(sys.argv) < 5: usage()
        agent_id = sys.argv[2]
        x = float(sys.argv[3])
        y = float(sys.argv[4])
        text = sys.argv[5] if len(sys.argv) > 5 else ""
        res = req("/api/cursors/move", {"agent_id": agent_id, "x": x, "y": y, "action_text": text}, method="POST")
        print(f"Moved {agent_id} to ({x}, {y}) {text}")

    elif cmd == "click":
        if len(sys.argv) < 3: usage()
        agent_id = sys.argv[2]
        click_type = sys.argv[3] if len(sys.argv) > 3 else "left"
        res = req("/api/cursors/click", {"agent_id": agent_id, "click_type": click_type}, method="POST")
        print(f"Clicked {click_type} on {agent_id}")

    elif cmd == "remove":
        if len(sys.argv) < 3: usage()
        agent_id = sys.argv[2]
        res = req(f"/api/cursors/{agent_id}", method="DELETE")
        print(f"Removed cursor: {agent_id}")

    # Unified Direct Input Injection
    elif cmd == "tap":
        if len(sys.argv) < 4: usage()
        x, y = float(sys.argv[2]), float(sys.argv[3])
        res = req("/api/action", {"action": "click", "x": x, "y": y, "button": "left"}, method="POST")
        print(f"Dispatched tap at ({x}, {y})")

    elif cmd == "swipe":
        if len(sys.argv) < 6: usage()
        x1, y1 = float(sys.argv[2]), float(sys.argv[3])
        x2, y2 = float(sys.argv[4]), float(sys.argv[5])
        duration = int(sys.argv[6]) if len(sys.argv) > 6 else 250
        res = req("/api/action", {"action": "swipe", "x1": x1, "y1": y1, "x2": x2, "y2": y2, "duration": duration}, method="POST")
        print(f"Dispatched swipe from ({x1}, {y1}) -> ({x2}, {y2}) [{duration}ms]")

    elif cmd == "type":
        if len(sys.argv) < 3: usage()
        text = " ".join(sys.argv[2:])
        res = req("/api/action", {"action": "type", "text": text}, method="POST")
        print(f"Dispatched typing: {text}")

    elif cmd == "key":
        if len(sys.argv) < 3: usage()
        key = sys.argv[2]
        res = req("/api/action", {"action": "key", "key": key}, method="POST")
        print(f"Dispatched key press: {key}")

    elif cmd == "screenshot":
        out = sys.argv[2] if len(sys.argv) > 2 else "/tmp/zoth_screen.png"
        res = req("/api/screenshot")
        print(f"Screenshot captured: {res.get('path')}")

    # Training and Presets commands
    elif cmd == "train":
        if len(sys.argv) < 3: usage()
        sub = sys.argv[2]
        state_file = "/tmp/zoth_training_active.json"

        if sub == "start":
            pname = sys.argv[3] if len(sys.argv) > 3 else "preset_1"
            with open(state_file, "w") as f:
                json.dump({"preset_name": pname, "start_time": sys.version}, f)
            print(f"Training active for preset: '{pname}'")

        elif sub == "stop":
            if os.path.exists(state_file):
                os.remove(state_file)
            print("Training stopped and preset finalized.")

    elif cmd == "run":
        if len(sys.argv) < 3: usage()
        preset_name = sys.argv[2]
        plat = sys.argv[3] if len(sys.argv) > 3 else "auto"
        preset_dir = os.path.expanduser(f"~/NullAITech/zoth-cursorz/training/presets/{preset_name}")
        from training.preset_runner import PresetRunner
        runner = PresetRunner(preset_path=preset_dir, platform=plat)
        runner.run()

    elif cmd == "presets":
        presets_dir = os.path.expanduser("~/NullAITech/zoth-cursorz/training/presets")
        if os.path.exists(presets_dir):
            ps = [d for d in os.listdir(presets_dir) if os.path.isdir(os.path.join(presets_dir, d))]
            print(f"Saved Presets ({len(ps)}):")
            for p in sorted(ps):
                print(f"  • {p}")
        else:
            print("No presets found.")

    elif cmd == "daemon":
        import subprocess
        daemon_script = "/home/zoth/NullAITech/zoth-cursorz/daemon/server.py"
        subprocess.run([sys.executable, daemon_script])

    elif cmd == "overlay":
        import subprocess
        overlay_main = "/home/zoth/NullAITech/zoth-cursorz/overlay/main.js"
        subprocess.run(["electron", "--no-sandbox", "--disable-dev-shm-usage", overlay_main])

    elif cmd == "dashboard":
        import subprocess
        dash_main = "/home/zoth/NullAITech/zoth-cursorz/launch_dashboard.js"
        subprocess.run(["electron", "--no-sandbox", "--disable-dev-shm-usage", dash_main])

    # Android Management Subcommands
    elif cmd == "android":
        if len(sys.argv) < 3:
            print("Usage: zoth-cursorz android [build|install|devices]")
            sys.exit(1)
        sub = sys.argv[2]
        if sub == "build":
            import subprocess
            subprocess.run(["bash", "/home/zoth/NullAITech/zoth-cursorz/android/package_apk.sh"])
        elif sub == "install":
            import subprocess
            apk_path = "/home/zoth/NullAITech/zoth-cursorz/android/dist/zoth-cursorz-arm64.apk"
            subprocess.run(["adb", "install", "-r", apk_path])
        elif sub == "devices":
            import subprocess
            subprocess.run(["adb", "devices"])

    else:
        usage()

if __name__ == "__main__":
    main()
