  {{ id: 'high-entropy', label: 'Hex Entropy Sample', badge: 'CRYPTO', data: 'a7f92b4c810d93ea6f8812cb04e578c1df89ab1034ce77fa0912bcde3499ab08' }},
];

export default function {comp}() {{
  const [activePreset, setActivePreset] = useState('default');
  const [input, setInput] = useState(PRESETS[0].data);
  const [history, setHistory] = useState([54, 62, 58, 74, 69, 64]);

  const metrics = useMemo(() => {{
    const bytes = new TextEncoder().encode(input || '');
    const counts = new Array(256).fill(0);
    for (let i = 0; i < bytes.length; i += 1) counts[bytes[i]] += 1;
    let entropy = 0;
    for (let c = 0; c < 256; c += 1) {{
      if (counts[c] > 0) {{
        const p = counts[c] / bytes.length;
        entropy -= p * Math.log2(p);
      }}
    }}
    return {{
      tool: '{slug}',
      bytes: bytes.length,
      lines: (input || '').split('\\n').length,
      entropy: Number(entropy.toFixed(3)),
    }};
  }}, [input]);

  const updateInput = (nextVal) => {{
    setInput(nextVal);
    const len = new TextEncoder().encode(nextVal || '').length;
    setHistory((prev) => [...prev.slice(-11), len]);
  }};

  return (
    <SovereignWorkstationShell
      id="{slug}"
      category="{category.upper()}"
      title="{title}"
      version="3.0.0"{var_prop}
      subtitle="Zero-egress Zoth Studio workstation built on SovereignWorkstationShell v3 + @zoth/ui."
      metrics={{[
        {{ label: 'INPUT BYTES', value: String(metrics.bytes), unit: 'B' }},
        {{ label: 'ENTROPY', value: String(metrics.entropy), unit: 'b/B', status: metrics.entropy > 5.2 ? 'HIGH' : 'STRUCTURED' }},
        {{ label: 'EXECUTION', value: 'LOCAL', status: 'ZERO EGRESS', accent: SOV.emerald }},
        {{ label: 'UI KIT', value: '@zoth/ui v3' }},
      ]}}
      tutorialSteps={{[
        {{ icon: '⚡', title: 'Select Preset or Upload', desc: 'Load a preset or local file from the preset toolbar.' }},
        {{ icon: '📊', title: 'Inspect Live Telemetry', desc: 'Watch the radial entropy gauge and byte-size sparkline update live.' }},
        {{ icon: '📦', title: 'Export Artifact', desc: 'Copy or download the verified JSON output from the right pane.' }},
      ]}}
      leftPane={{
        <SovereignCard index="01" eyebrow="INPUT CONSOLE" title="Presets & Source Payload">
          <Stack spacing={{2}}>
            <SovereignPresetBar
              presets={{PRESETS}}
              activeId={{activePreset}}
              onSelect={{(p) => {{ setActivePreset(p.id); updateInput(p.data); }}}}
              onUploadText={{({{ text }}) => {{ setActivePreset('upload'); updateInput(text); }}}}
              onReset={{() => {{ setActivePreset('default'); updateInput(PRESETS[0].data); }}}}
            />
            <TextField
              multiline
              minRows={{6}}
              fullWidth
              value={{input}}
              onChange={{(e) => updateInput(e.target.value)}}
              sx={{{{ '& textarea': {{ fontFamily: '"JetBrains Mono", monospace', fontSize: '0.82rem' }} }}}}
            />
            <SovereignAlertBanner
              severity="success"
              title="LOCAL LOOPBACK VERIFIED"
              message="Zero external network calls executed during inspection."
            />
          </Stack>
        </SovereignCard>
      }}
      rightPane={{
        <Stack spacing={{2}}>
          <Grid container spacing={{2}}>
            <Grid xs={{12}} sm={{5}}>
              <SovereignGauge
                value={{metrics.entropy}}
                max={{8}}
                label="SHANNON ENTROPY"
                unit=" b/B"
                thresholds={{{{ warn: 4.8, danger: 6.8 }}}}
                status={{metrics.entropy > 5.8 ? 'HIGH RANDOMNESS' : 'STRUCTURED'}}
              />
            </Grid>
            <Grid xs={{12}} sm={{7}}>
              <SovereignSparkline
                title="PAYLOAD BYTE STREAM"
                data={{history}}
                unit=" B"
                threshold={{128}}
                thresholdLabel="FRAME TARGET (128 B)"
              />
            </Grid>
          </Grid>
          <SovereignKeyValueGrid
            items={{[
              {{ label: 'TOOL SLUG', value: '{slug}' }},
              {{ label: 'BYTE COUNT', value: `${{metrics.bytes}} bytes` }},
            ]}}
          />
          <SovereignCodeBlock
            title="{slug.upper()} READOUT"
            badge="CLIENT-SIDE"
            filename="{slug}-output.json"
            code={{JSON.stringify(metrics, null, 2)}}
          />
        </Stack>
      }}
    />
  );
}}
"""


def render_web_index(slug: str, title: str, category: str, description: str, port: int, archetype: str = "workstation", variant: str | None = None) -> str:
    if archetype == "auditor":
        return render_auditor_web(slug, title, category, description, port, variant)
    if archetype == "diff-converter":
        return render_diff_web(slug, title, category, description, port, variant)
    if archetype == "landing":
        return render_site_index(slug, title, category, description, port, variant)
    return render_workstation_web(slug, title, category, description, port, variant)


def write_static_bundle(args, generator_name: str) -> dict:
    slug = slugify(args.slug)
    title = args.title or title_from_slug(slug)
    archetype = getattr(args, "archetype", None) or ("landing" if generator_name == "site" else "workstation")
    variant = getattr(args, "variant", None)
    category = args.category or ("Sovereign Platform" if generator_name == "site" else "Sovereign Developer Tool")
    description = args.description or f"{title} — zero-egress, offline-capable web platform built on Zoth UI Kit v3."
    port = args.port or (8165 if generator_name == "site" else 8160)
    out_dir = Path(args.out_dir).expanduser().resolve() if args.out_dir else (DEFAULT_ROOT / slug)

    public_dir = out_dir / "public"
    prompts_dir = out_dir / "prompts"
    public_dir.mkdir(parents=True, exist_ok=True)
    prompts_dir.mkdir(parents=True, exist_ok=True)

    html = (
        render_site_index(slug, title, category, description, port, variant)
        if generator_name == "site"
        else render_web_index(slug, title, category, description, port, archetype, variant)
    )
    (public_dir / "index.html").write_text(html, encoding="utf-8")
    shutil.copy2(KIT_DIR / "zoth-ui.css", public_dir / "zoth-ui.css")
    shutil.copy2(KIT_DIR / "zoth-ui.js", public_dir / "zoth-ui.js")
    (public_dir / "robots.txt").write_text(render_robots(slug), encoding="utf-8")
    (public_dir / "sitemap.xml").write_text(render_sitemap(slug), encoding="utf-8")
    (out_dir / "netlify.toml").write_text(render_netlify_toml(), encoding="utf-8")
    (prompts_dir / "motion_graphics_showreel.md").write_text(
        render_showreel_prompt(slug, title, description), encoding="utf-8"
    )

    server_path = out_dir / "server.py"
    server_path.write_text(render_server_py(slug, port), encoding="utf-8")
    server_path.chmod(server_path.stat().st_mode | stat.S_IXUSR | stat.S_IXGRP | stat.S_IXOTH)
    (out_dir / "README.md").write_text(render_readme(slug, title, description, port, archetype), encoding="utf-8")

    return {
        "ok": True,
        "generator": generator_name,
        "archetype": archetype,
        "variant": variant,
        "slug": slug,
        "title": title,
        "outDir": str(out_dir),
        "port": port,
        "files": [
            str(public_dir / "index.html"),
            str(public_dir / "zoth-ui.css"),
            str(public_dir / "zoth-ui.js"),
            str(public_dir / "robots.txt"),
            str(public_dir / "sitemap.xml"),
            str(out_dir / "netlify.toml"),
            str(prompts_dir / "motion_graphics_showreel.md"),
            str(server_path),
            str(out_dir / "README.md"),
        ],
    }


def cmd_studio_tool(args) -> dict:
    slug = slugify(args.slug)
    title = args.title or title_from_slug(slug)
    category = args.category or "Developer Utility"
    archetype = getattr(args, "archetype", "workstation") or "workstation"
    variant = getattr(args, "variant", None)
    comp = pascal_from_slug(slug)
    out_path = Path(args.out).expanduser().resolve() if args.out else (STUDIO_TOOLS_DIR / f"{comp}.jsx")
    out_path.parent.mkdir(parents=True, exist_ok=True)
    out_path.write_text(render_studio_tool_jsx(slug, title, category, archetype, variant), encoding="utf-8")
    return {
        "ok": True,
        "generator": "studio-tool",
        "archetype": archetype,
        "variant": variant,
        "slug": slug,
        "component": comp,
        "outFile": str(out_path),
    }


def _find_first(base: Path, candidates: list[str]) -> Path | None:
    for rel in candidates:
        p = base / rel
        if p.is_file():
            return p
    return None


def cmd_audit(args) -> dict:
    target = Path(args.target).expanduser().resolve()
    index_path = _find_first(target, ["public/index.html", "index.html"])
    robots_path = _find_first(target, ["public/robots.txt", "robots.txt"])
    sitemap_path = _find_first(target, ["public/sitemap.xml", "sitemap.xml"])
    netlify_path = _find_first(target, ["netlify.toml"])
    redirects_path = _find_first(target, ["public/_redirects", "_redirects"])
    zoth_js_path = _find_first(target, ["public/zoth-ui.js", "public/zoth-ui/zoth-ui.js", "zoth-ui.js"])

    html_text = index_path.read_text(encoding="utf-8", errors="ignore") if index_path else ""
    robots_text = robots_path.read_text(encoding="utf-8", errors="ignore") if robots_path else ""
    sitemap_text = sitemap_path.read_text(encoding="utf-8", errors="ignore") if sitemap_path else ""
    netlify_text = netlify_path.read_text(encoding="utf-8", errors="ignore") if netlify_path else ""
    redirects_text = redirects_path.read_text(encoding="utf-8", errors="ignore") if redirects_path else ""
    zoth_js_text = zoth_js_path.read_text(encoding="utf-8", errors="ignore") if zoth_js_path else ""
    combined_client = html_text + "\n" + zoth_js_text

    style_balanced = len(re.findall(r"<style\b", html_text, re.I)) == len(re.findall(r"</style>", html_text, re.I))
    script_balanced = len(re.findall(r"<script\b", html_text, re.I)) == len(re.findall(r"</script>", html_text, re.I))

    checks = [
        {
            "id": "index_html",
            "pass": bool(index_path and style_balanced and script_balanced and "</body>" in html_text.lower()),
            "detail": str(index_path) if index_path else "Missing public/index.html or balanced markup",
        },
        {
            "id": "schema_graph",
            "pass": bool(
                "application/ld+json" in html_text
                and '"@graph"' in html_text
                and '"FAQPage"' in html_text
            ),
            "detail": "Schema.org JSON-LD @graph + FAQPage",
        },
        {
            "id": "robots_txt",
            "pass": bool(
                robots_path
                and all(tok in robots_text for tok in ("GPTBot", "ClaudeBot", "PerplexityBot", "Sitemap:"))
            ),
            "detail": str(robots_path) if robots_path else "Missing robots.txt with frontier AI crawler allow rules",
        },
        {
            "id": "sitemap_xml",
            "pass": bool(sitemap_path and "<loc>" in sitemap_text),
            "detail": str(sitemap_path) if sitemap_path else "Missing sitemap.xml with <loc>",
        },
        {
            "id": "netlify_toml",
            "pass": bool(
                netlify_path
                and "X-Frame-Options" in netlify_text
                and "X-Content-Type-Options" in netlify_text
                and ("[[redirects]]" in netlify_text or "/index.html 200" in redirects_text)
            ),
            "detail": str(netlify_path) if netlify_path else "Missing netlify.toml security headers & SPA redirect",
        },
        {
            "id": "open_access_support",
            "pass": bool(
                "3cIfZg27PdKo2D64Ocfw40X" in combined_client
                and "GG2eQbVh8ut1BK6j1A2tz7pSySdLpD38BgyEhGcxdXoK" in combined_client
                and not re.search(r"filter:\s*blur\(", html_text, re.I)
                and "depay" not in html_text.lower()
            ),
            "detail": "Stripe Buy Us a Coffee + Solana tip without paywall blur or DePay",
        },
        {
            "id": "viewport_meta",
            "pass": bool(re.search(r"width=device-width", html_text, re.I) and re.search(r"initial-scale=1", html_text, re.I)),
            "detail": "Responsive viewport meta tag",
        },
        {
            "id": "zoth_ui_adoption",
            "pass": bool(
                "zoth-ui.css" in html_text
                or "zoth-ui.js" in html_text
                or "@zoth/ui" in html_text
                or "components/sovereign" in html_text
            ),
            "detail": "References zoth-ui.css / zoth-ui.js or @zoth/ui primitives",
        },
    ]

    passed = sum(1 for c in checks if c["pass"])
    total = len(checks)
    return {
        "ok": passed == total,
        "target": str(target),
        "score": passed,
        "maxScore": total,
        "pct": round((passed / total) * 100),
        "checks": checks,
    }


def main():
    parser = argparse.ArgumentParser(
        prog="zoth-scaffold",
        description="Unified Zoth UI v3.0 component, archetype & guardrail audit CLI.",
    )
    parser.add_argument("--json", action="store_true", help="Output machine-readable JSON")
    sub = parser.add_subparsers(dest="command")

    p_list = sub.add_parser("list", help="List reusable @zoth/ui v3.0 primitives, archetypes, and canvas variants")
    p_list.add_argument("--json", action="store_true", help="Output JSON catalog")

    for name, default_port, default_arch, help_txt in [
        ("web", 8160, "workstation", "Scaffold a standalone web workstation / auditor / diff-converter / landing page"),
        ("site", 8165, "landing", "Scaffold a full product/marketing website (hero + feature grid + stat bars + CSV table + FAQ)"),
    ]:
        p = sub.add_parser(name, help=help_txt)
        p.add_argument("slug", help="Kebab-case slug (e.g. my-audit-tool)")
        p.add_argument("--title", help="Display title")
        p.add_argument("--category", help="Product/tool category")
        p.add_argument("--description", help="Short summary")
        p.add_argument("--archetype", choices=KIT_CATALOG["archetypes"], default=default_arch, help="UI archetype template")
        p.add_argument("--variant", choices=KIT_CATALOG["canvasVariants"], default=None, help="Override deterministic canvas engine")
        p.add_argument("--port", type=int, default=default_port, help=f"Local server port (default: {default_port})")
        p.add_argument("--out-dir", help="Target directory (default: ~/NullAITech/<slug>)")
        p.add_argument("--json", action="store_true", help="Output JSON result")

    p_studio = sub.add_parser("studio-tool", help="Scaffold a Zoth Studio v2 React tool component")
    p_studio.add_argument("slug", help="Kebab-case tool slug")
    p_studio.add_argument("--title", help="Display title")
    p_studio.add_argument("--category", help="Tool category")
    p_studio.add_argument("--archetype", choices=KIT_CATALOG["archetypes"], default="workstation", help="React archetype template")
    p_studio.add_argument("--variant", choices=KIT_CATALOG["canvasVariants"], default=None, help="Override deterministic canvas engine")
    p_studio.add_argument("--out", help="Output .jsx file path")
    p_studio.add_argument("--json", action="store_true", help="Output JSON result")

    p_audit = sub.add_parser("audit", help="Audit any project directory against the 8 Sovereign Guardrail checks")
    p_audit.add_argument("target", nargs="?", default=".", help="Project root directory to audit (default: current directory)")
    p_audit.add_argument("--json", action="store_true", help="Output JSON report")

    args = parser.parse_args()

    if args.command is None or args.command == "list":
        if args.json:
            print(json.dumps(KIT_CATALOG, indent=2))
        else:
            print("zoth-scaffold v3.0.0 — Zoth Unified UI & Archetype Generator")
            print("Generators: " + ", ".join(KIT_CATALOG["generators"]))
            print("Archetypes: " + ", ".join(KIT_CATALOG["archetypes"]))
            print("Canvas:     " + ", ".join(KIT_CATALOG["canvasVariants"]))
            print("React kit:  " + ", ".join(KIT_CATALOG["reactPrimitives"]))
            print("Vanilla kit: " + ", ".join(KIT_CATALOG["vanillaAssets"]))
        return 0

    if args.command in ("web", "site"):
        res = write_static_bundle(args, args.command)
        if args.json:
            print(json.dumps(res, indent=2))
        else:
            print(f"✔ Scaffolded {args.command} ({res['archetype']}) '{res['slug']}' at {res['outDir']}")
            for f in res["files"]:
                print(f"  - {f}")
        return 0

    if args.command == "studio-tool":
        res = cmd_studio_tool(args)
        if args.json:
            print(json.dumps(res, indent=2))
        else:
            print(f"✔ Scaffolded React component {res['component']} ({res['archetype']}) at {res['outFile']}")
        return 0

    if args.command == "audit":
        res = cmd_audit(args)
        if args.json:
            print(json.dumps(res, indent=2))
        else:
            print(f"Sovereign Audit: {res['target']} -> {res['score']}/{res['maxScore']} ({res['pct']}%)")
            for chk in res["checks"]:
                mark = "✔" if chk["pass"] else "✘"
                print(f"  {mark} {chk['id']}: {chk['detail']}")
        return 0 if res["ok"] else 1

    parser.print_help()
    return 1


if __name__ == "__main__":
    sys.exit(main())
