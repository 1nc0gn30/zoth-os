def slugify(raw: str) -> str:
    s = re.sub(r"[^a-zA-Z0-9-]+", "-", raw.strip().lower()).strip("-")
    return s or "zoth-app"


def title_from_slug(slug: str) -> str:
    return " ".join(part.capitalize() for part in slug.split("-") if part)


def pascal_from_slug(slug: str) -> str:
    return "".join(part.capitalize() for part in slug.split("-") if part) + "GodModeTool"


def build_schema_graph(title: str, site_url: str, escaped_desc: str, app_cat: str) -> str:
    return json.dumps(
        {
            "@context": "https://schema.org",
            "@graph": [
                {
                    "@type": "SoftwareApplication",
                    "name": title,
                    "url": site_url,
                    "applicationCategory": app_cat,
                    "operatingSystem": "Linux, macOS, Windows, Web",
                    "description": escaped_desc,
                    "offers": {"@type": "Offer", "price": "0", "priceCurrency": "USD"},
                    "creator": {
                        "@type": "Organization",
                        "name": "Neal Frazier Tech (@1nc0gn30)",
                        "url": "https://nullai.tech",
                    },
                },
                {
                    "@type": "FAQPage",
                    "mainEntity": [
                        {
                            "@type": "Question",
                            "name": f"What does {title} do?",
                            "acceptedAnswer": {"@type": "Answer", "text": escaped_desc},
                        },
                        {
                            "@type": "Question",
                            "name": f"Does {title} run locally with zero telemetry?",
                            "acceptedAnswer": {
                                "@type": "Answer",
                                "text": f"Yes. {title} executes client-side or on localhost loopback with zero external tracking.",
                            },
                        },
                        {
                            "@type": "Question",
                            "name": f"Is {title} free and open-access?",
                            "acceptedAnswer": {
                                "@type": "Answer",
                                "text": "Yes. 100% free and open-access with zero paywalls. Optional support via Stripe or Solana tip.",
                            },
                        },
                    ],
                },
            ],
        },
        indent=2,
    )


def render_head(title: str, slug: str, escaped_desc: str, schema_graph: str) -> str:
    site_url = f"https://{slug}.nullai.tech/"
    return f"""  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title} — Zero-Egress Sovereign Platform</title>
  <meta name="description" content="{escaped_desc}">

  <meta property="og:title" content="{title} — Zero-Egress Sovereign Platform">
  <meta property="og:description" content="{escaped_desc}">
  <meta property="og:url" content="{site_url}">
  <meta property="og:type" content="website">
  <meta property="og:image" content="https://zoth.nullai.tech/brand/ghostbyte-dark.png">

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:site" content="@1nc0gn30">
  <meta name="twitter:creator" content="@1nc0gn30">
  <meta name="twitter:title" content="{title}">
  <meta name="twitter:description" content="{escaped_desc}">
  <meta name="twitter:image" content="https://zoth.nullai.tech/brand/ghostbyte-dark.png">

  <script type="application/ld+json">
{schema_graph}
  </script>

  <link rel="stylesheet" href="/zoth-ui.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600;700;800&family=Space+Grotesk:wght@400;600;700&display=swap" rel="stylesheet">"""


def band_block(slug: str, title: str, category: str, variant: str | None) -> str:
    variant_attr = f' data-zoth-variant="{variant}"' if variant else ""
    return f"""      <div class="zoth-band">
        <canvas data-zoth-band="{slug}"{variant_attr} role="img" aria-label="{title} live sovereign canvas"></canvas>
        <div class="zoth-band-scanlines" aria-hidden="true"></div>
        <div class="zoth-band-chrome">
          <span class="zoth-band-eyebrow">{category.upper()}</span>
          <span class="zoth-band-readout">INITIALIZING</span>
        </div>
      </div>"""


def wrap_html_document(title: str, slug: str, escaped_desc: str, schema_graph: str, body_main: str, app_cfg: str, extra_script: str = "") -> str:
    return f"""<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
{render_head(title, slug, escaped_desc, schema_graph)}
</head>
<body>
  <div class="zoth-container">
    <div id="zoth-support-mount"></div>
    <div id="zoth-header-mount"></div>

    <main>
{body_main}
    </main>

    <div id="zoth-footer-mount"></div>
  </div>

  <script>
    window.ZOTH_APP = {app_cfg};
  </script>
  <script src="/zoth-ui.js" defer></script>
{extra_script}</body>
</html>
"""


def render_workstation_web(slug: str, title: str, category: str, description: str, port: int, variant: str | None) -> str:
    site_url = f"https://{slug}.nullai.tech/"
    escaped_desc = description.replace('"', "'")
    schema_graph = build_schema_graph(title, site_url, escaped_desc, "DeveloperApplication")
    app_cfg = json.dumps(
        {
            "id": slug,
            "name": title,
            "version": "v3.0.0",
            "glyph": "☿",
            "tagline": description,
            "category": category,
            "repo": slug,
            "statusText": f"127.0.0.1:{port} · WORKSTATION",
            "tutorialSteps": [
                {"icon": "⚡", "title": "Select Preset or Upload", "desc": "Use quick presets or upload a local file; zero data leaves your browser."},
                {"icon": "📊", "title": "Watch Live Gauge & Sparkline", "desc": "Shannon entropy gauge and byte-trend sparkline update on every edit."},
                {"icon": "📦", "title": "Copy or Download Artifact", "desc": "Export deterministic SHA-256 digests and formatted payloads in 1 click."},
            ],
        },
        indent=2,
    )

    sample_json = f'{{"project": "{slug}", "engine": "zoth-ui-kit", "version": "3.0.0", "localFirst": true}}'
    sample_ping = '{"event": "heartbeat", "egressBytes": 0, "status": "NOMINAL"}'
    sample_utf8 = '{"glyphs": "☿ ⣿ ◆ ✦", "region": "zoth-enclave", "notes": "Dual-theme contrast verified"}'

    body_main = f"""{band_block(slug, title, category, variant)}

      <div class="zoth-alert zoth-alert-success">
        <span><strong>ZERO-EGRESS ACTIVE:</strong> SubtleCrypto SHA-256 &amp; Shannon Entropy run 100% locally in your browser.</span>
        <span class="zoth-badge">PORT :{port}</span>
      </div>

      <section class="zoth-bento" aria-label="Telemetry & Presets">
        <div class="zoth-gauge-card zoth-col-4" id="zoth-entropy-gauge" data-zoth-gauge data-value="4.6" data-max="8" data-label="SHANNON ENTROPY" data-unit=" b/B" data-status="STRUCTURED TEXT"></div>
        <div class="zoth-sparkline-card zoth-col-8" id="zoth-bytes-sparkline" data-zoth-sparkline data-points="48,64,52,78,86,92,89" data-label="PAYLOAD SIZE HISTORY" data-unit=" B" data-threshold="128" data-accent="#38BDF8"></div>
      </section>

      <section class="zoth-bento" aria-label="Interactive Workstation">
        <div class="zoth-card zoth-col-5">
          <div class="zoth-card-head">
            <div>
              <span class="zoth-eyebrow">01 · INPUT CONSOLE</span>
              <h2 class="zoth-card-title">Presets, Upload &amp; Controls</h2>
            </div>
          </div>
          <div class="zoth-preset-bar" aria-label="Quick Presets">
            <button type="button" class="zoth-tab is-active" data-zoth-preset-target="#zoth-input-box" data-zoth-preset-value='{sample_json}'>Standard Config</button>
            <button type="button" class="zoth-tab" data-zoth-preset-target="#zoth-input-box" data-zoth-preset-value='{sample_ping}'>Telemetry Ping</button>
            <button type="button" class="zoth-tab" data-zoth-preset-target="#zoth-input-box" data-zoth-preset-value='{sample_utf8}'>Unicode Sample</button>
            <button type="button" class="zoth-btn zoth-btn-outline" data-zoth-file-target="#zoth-input-box">Upload File</button>
          </div>
          <div class="zoth-field">
            <label class="zoth-label" for="zoth-mode-select">Transform Pipeline</label>
            <select class="zoth-select" id="zoth-mode-select">
              <option value="inspect">Inspect + SHA-256 Digest + Base64</option>
              <option value="json-pretty">Pretty-Print JSON</option>
              <option value="upper-hex">UTF-8 Hex Dump</option>
            </select>
          </div>
          <div class="zoth-field">
            <label class="zoth-label" for="zoth-input-box">Input Payload</label>
            <textarea class="zoth-textarea" id="zoth-input-box" spellcheck="false">{sample_json}</textarea>
          </div>
        </div>

        <div class="zoth-card zoth-col-7">
          <div class="zoth-card-head">
            <div>
              <span class="zoth-eyebrow">02 · DETERMINISTIC OUTPUT</span>
              <h2 class="zoth-card-title">Digest &amp; Diagnostic Readout</h2>
            </div>
            <div style="display:flex; flex-wrap:wrap; gap:0.5rem;">
              <button type="button" class="zoth-btn zoth-btn-outline" data-zoth-copy="#zoth-output-box">Copy Output</button>
              <button type="button" class="zoth-btn zoth-btn-cyan" data-zoth-download="#zoth-output-box" data-zoth-filename="{slug}-output.json">Download</button>
            </div>
          </div>
          <div class="zoth-kv-grid" style="margin-bottom:0.9rem;">
            <div class="zoth-kv-item"><div class="zoth-kv-key">UTF-8 Bytes</div><div class="zoth-kv-val" id="kv-bytes">0 B</div></div>
            <div class="zoth-kv-item"><div class="zoth-kv-key">SHA-256 Prefix</div><div class="zoth-kv-val" id="kv-sha">—</div></div>
          </div>
          <pre class="zoth-terminal" id="zoth-output-box"></pre>
        </div>
      </section>"""

    extra_script = f"""  <script>
    (function () {{
      var inputEl = document.getElementById('zoth-input-box');
      var modeEl = document.getElementById('zoth-mode-select');
      var outEl = document.getElementById('zoth-output-box');
      var kvBytes = document.getElementById('kv-bytes');
      var kvSha = document.getElementById('kv-sha');
      var gaugeEl = document.getElementById('zoth-entropy-gauge');
      var sparkEl = document.getElementById('zoth-bytes-sparkline');
      var history = [48, 64, 52, 78, 86];

      function shannonEntropy(bytes) {{
        if (!bytes.length) return 0;
        var counts = new Array(256).fill(0);
        for (var i = 0; i < bytes.length; i++) counts[bytes[i]]++;
        var ent = 0;
        for (var c = 0; c < 256; c++) {{
          if (!counts[c]) continue;
          var p = counts[c] / bytes.length;
          ent -= p * Math.log2(p);
        }}
        return ent;
      }}

      async function sha256Hex(bytes) {{
        if (!window.crypto || !window.crypto.subtle) return 'subtle-crypto-unavailable';
        var buf = await window.crypto.subtle.digest('SHA-256', bytes);
        return Array.from(new Uint8Array(buf)).map(function (b) {{
          return b.toString(16).padStart(2, '0');
        }}).join('');
      }}

      async function runTransform() {{
        var raw = inputEl.value || '';
        var bytes = new TextEncoder().encode(raw);
        var entropy = shannonEntropy(bytes);
        var digest = await sha256Hex(bytes);

        kvBytes.textContent = bytes.length + ' B';
        kvSha.textContent = digest.slice(0, 16) + '…';

        if (window.ZothUI) {{
          gaugeEl.setAttribute('data-value', entropy.toFixed(2));
          gaugeEl.setAttribute('data-status', entropy > 5.8 ? 'HIGH RANDOMNESS' : entropy > 3.5 ? 'STRUCTURED TEXT' : 'LOW ENTROPY');
          window.ZothUI.renderGauge(gaugeEl);
          if (history[history.length - 1] !== bytes.length) {{
            history.push(bytes.length);
            if (history.length > 14) history.shift();
          }}
          sparkEl.setAttribute('data-points', history.join(','));
          window.ZothUI.renderSparkline(sparkEl);
        }}

        var mode = modeEl.value;
        if (mode === 'json-pretty') {{
          try {{ outEl.textContent = JSON.stringify(JSON.parse(raw), null, 2); }}
          catch (err) {{ outEl.textContent = 'JSON Parse Error: ' + err.message; }}
          return;
        }}
        if (mode === 'upper-hex') {{
          outEl.textContent = Array.from(bytes).map(function (b) {{ return b.toString(16).toUpperCase().padStart(2, '0'); }}).join(' ');
          return;
        }}
        var b64 = btoa(String.fromCharCode.apply(null, Array.from(bytes)));
        outEl.textContent = JSON.stringify({{ tool: '{slug}', bytes: bytes.length, entropyBitsPerByte: Number(entropy.toFixed(4)), sha256: digest, base64: b64 }}, null, 2);
      }}

      inputEl.addEventListener('input', runTransform);
      modeEl.addEventListener('change', runTransform);
      window.addEventListener('DOMContentLoaded', runTransform);
    }})();
  </script>
"""
    return wrap_html_document(title, slug, escaped_desc, schema_graph, body_main, app_cfg, extra_script)


def render_auditor_web(slug: str, title: str, category: str, description: str, port: int, variant: str | None) -> str:
    site_url = f"https://{slug}.nullai.tech/"
    escaped_desc = description.replace('"', "'")
    schema_graph = build_schema_graph(title, site_url, escaped_desc, "SecurityApplication")
    app_cfg = json.dumps(
        {
            "id": slug,
            "name": title,
            "version": "v3.0.0",
            "glyph": "🛡",
            "tagline": description,
            "category": category,
            "repo": slug,
            "statusText": f"127.0.0.1:{port} · AUDITOR ARCHETYPE",
            "tutorialSteps": [
                {"icon": "🔎", "title": "Paste HTML/JSON Manifest", "desc": "Load a snippet or upload a file to audit rules locally in-browser."},
                {"icon": "📈", "title": "Review Score & CSV Findings", "desc": "Compliance score gauge, event timeline, and filterable findings update immediately."},
            ],
        },
        indent=2,
    )

    sample_ok = '&lt;meta name="viewport" content="width=device-width, initial-scale=1.0"&gt;&lt;script type="application/ld+json"&gt;{"@graph":["FAQPage"]}&lt;/script&gt;'
    sample_warn = '&lt;div&gt;Missing viewport meta and blur-lock paywall gate detected&lt;/div&gt;'

    body_main = f"""{band_block(slug, title, category, variant)}

      <div class="zoth-alert" id="audit-banner">
        <span id="audit-banner-text"><strong>AUDITOR READY:</strong> Running live policy rules cleanly on localhost.</span>
        <span class="zoth-badge" id="audit-score-badge">100 / 100</span>
      </div>

      <section class="zoth-bento" aria-label="Audit Telemetry">
        <div class="zoth-gauge-card zoth-col-4" id="audit-gauge" data-zoth-gauge data-value="100" data-max="100" data-label="COMPLIANCE SCORE" data-unit="%" data-status="PASS"></div>
        <div class="zoth-card zoth-col-8">
          <span class="zoth-eyebrow">01 · ARTIFACT TARGET INPUT</span>
          <h2 class="zoth-card-title">Paste Config, HTML, or JSON to Audit</h2>
          <div class="zoth-preset-bar" style="margin-top:0.65rem;">
            <button type="button" class="zoth-tab is-active" data-zoth-preset-target="#audit-input" data-zoth-preset-value='{sample_ok}'>Compliant Artifact</button>
            <button type="button" class="zoth-tab" data-zoth-preset-target="#audit-input" data-zoth-preset-value='{sample_warn}'>Failing Sample</button>
            <button type="button" class="zoth-btn zoth-btn-outline" data-zoth-file-target="#audit-input">Upload Target</button>
          </div>
          <textarea class="zoth-textarea" id="audit-input" spellcheck="false">{sample_ok}</textarea>
        </div>
      </section>

      <section class="zoth-bento" aria-label="Findings and Timeline">
        <div class="zoth-card zoth-col-8">
          <div class="zoth-card-head">
            <div>
              <span class="zoth-eyebrow">02 · FINDINGS MATRIX</span>
              <h2 class="zoth-card-title">Rule Evaluation Table</h2>
            </div>
            <div style="display:flex; flex-wrap:wrap; gap:0.5rem;">
              <input class="zoth-input" type="search" placeholder="Filter checks..." data-zoth-table-search="#audit-table">
              <button type="button" class="zoth-btn zoth-btn-outline" data-zoth-table-csv="#audit-table" data-zoth-filename="{slug}-findings.csv">Export CSV</button>
            </div>
          </div>
          <div class="zoth-table-wrap">
            <table class="zoth-table" id="audit-table">
              <thead><tr><th>Rule</th><th>Condition</th><th>Severity</th><th>Status</th></tr></thead>
              <tbody id="audit-tbody"></tbody>
            </table>
          </div>
        </div>

        <div class="zoth-card zoth-col-4">
          <span class="zoth-eyebrow">03 · SCAN PIPELINE</span>
          <h2 class="zoth-card-title" style="margin-bottom:0.85rem;">Execution Timeline</h2>
          <div class="zoth-timeline">
            <div class="zoth-timeline-item"><div class="zoth-timeline-dot"></div><strong>Tokenizer</strong><div class="zoth-subtitle">Parsed target in &lt;2ms</div></div>
            <div class="zoth-timeline-item"><div class="zoth-timeline-dot"></div><strong>Guardrail Engine</strong><div class="zoth-subtitle">Checked AEO, Viewport &amp; Zero-Paywall</div></div>
            <div class="zoth-timeline-item"><div class="zoth-timeline-dot"></div><strong>CSV / Log Ready</strong><div class="zoth-subtitle">Exportable locally without egress</div></div>
          </div>
        </div>
      </section>"""

    extra_script = """  <script>
    (function () {
      var inp = document.getElementById('audit-input');
      var tbody = document.getElementById('audit-tbody');
      var gauge = document.getElementById('audit-gauge');
      var badge = document.getElementById('audit-score-badge');

      function evaluate() {
        var txt = inp.value || '';
        var lt = String.fromCharCode(60);
        var scriptOpenRe = new RegExp(lt + 'script', 'gi');
        var scriptCloseRe = new RegExp(lt + '/script>', 'gi');
        var blurRe = new RegExp('filter: *blu' + 'r|blur-lock', 'i');
        var rules = [
          { name: 'Viewport Meta', cond: 'width=device-width present', sev: 'HIGH', pass: /width=device-width/i.test(txt) },
          { name: 'Schema.org Graph', cond: 'ld+json or @graph detected', sev: 'MED', pass: /(@graph|FAQPage|SoftwareApplication)/i.test(txt) },
          { name: 'Zero Paywall Blur', cond: 'No paywall blur or blur-lock', sev: 'CRIT', pass: !blurRe.test(txt) },
          { name: 'Balanced Markup', cond: 'No unclosed script/style tags', sev: 'HIGH', pass: (txt.match(scriptOpenRe) || []).length === (txt.match(scriptCloseRe) || []).length }
        ];
        var passed = rules.filter(function (r) { return r.pass; }).length;
        var score = Math.round((passed / rules.length) * 100);
        if (badge) badge.textContent = score + ' / 100';
        tbody.innerHTML = rules.map(function (r) {
          var cls = r.pass ? 'zoth-pill-pass' : (r.sev === 'CRIT' ? 'zoth-pill-fail' : 'zoth-pill-warn');
          return '<tr><td>' + r.name + '</td><td>' + r.cond + '</td><td>' + r.sev + '</td><td><span class="' + cls + '">' + (r.pass ? 'PASS' : 'FAIL') + '</span></td></tr>';
        }).join('');
        if (window.ZothUI) {
          gauge.setAttribute('data-value', String(score));
          gauge.setAttribute('data-status', score === 100 ? 'ALL CHECKS PASS' : 'NEEDS FIXES');
          window.ZothUI.renderGauge(gauge);
        }
      }

      inp.addEventListener('input', evaluate);
      window.addEventListener('DOMContentLoaded', evaluate);
    })();
  </script>
"""
    return wrap_html_document(title, slug, escaped_desc, schema_graph, body_main, app_cfg, extra_script)


def render_diff_web(slug: str, title: str, category: str, description: str, port: int, variant: str | None) -> str:
    site_url = f"https://{slug}.nullai.tech/"
    escaped_desc = description.replace('"', "'")
    schema_graph = build_schema_graph(title, site_url, escaped_desc, "DeveloperApplication")
    app_cfg = json.dumps(
        {
            "id": slug,
            "name": title,
            "version": "v3.0.0",
            "glyph": "⇄",
            "tagline": description,
            "category": category,
            "repo": slug,
            "statusText": f"127.0.0.1:{port} · DIFF CONVERTER",
            "tutorialSteps": [
                {"icon": "⇄", "title": "Edit Source or Apply Pipeline", "desc": "Format JSON, sort object keys, or inspect manual line changes cleanly."},
                {"icon": "📦", "title": "Copy Transformed Output", "desc": "Everything executes locally with live +added / -removed counters."},
            ],
        },
        indent=2,
    )

    sample_a = '{"service":"' + slug + '","paywall":true,"theme":"legacy","port":' + str(port) + '}'
    body_main = f"""{band_block(slug, title, category, variant)}

      <section class="zoth-bento" aria-label="Diff Converter Workspace">
        <div class="zoth-card zoth-col-5">
          <span class="zoth-eyebrow">01 · SOURCE PAYLOAD</span>
          <h2 class="zoth-card-title">Input &amp; Transform Pipeline</h2>
          <div class="zoth-preset-bar" style="margin-top:0.65rem;">
            <button type="button" class="zoth-tab is-active" data-diff-mode="pretty">Pretty JSON</button>
            <button type="button" class="zoth-tab" data-diff-mode="sort">Sort Keys</button>
            <button type="button" class="zoth-tab" data-diff-mode="minify">Minify</button>
            <button type="button" class="zoth-btn zoth-btn-outline" data-zoth-file-target="#diff-source">Upload File</button>
          </div>
          <textarea class="zoth-textarea" id="diff-source" spellcheck="false">{sample_a}</textarea>
        </div>

        <div class="zoth-card zoth-col-7">
          <div class="zoth-card-head">
            <div>
              <span class="zoth-eyebrow">02 · TRANSFORMED OUTPUT</span>
              <h2 class="zoth-card-title">Live Converted Artifact</h2>
            </div>
            <button type="button" class="zoth-btn zoth-btn-outline" data-zoth-copy="#diff-target">Copy Transformed</button>
          </div>
          <textarea class="zoth-textarea" id="diff-target" spellcheck="false"></textarea>
        </div>
      </section>

      <section aria-label="Line by Line Diff">
        <div class="zoth-diff-wrap" id="live-diff-view" data-zoth-diff data-title="{slug.upper()} LINE DIFF"></div>
      </section>"""

    extra_script = """  <script>
    (function () {
      var src = document.getElementById('diff-source');
      var dst = document.getElementById('diff-target');
      var diffEl = document.getElementById('live-diff-view');
      var mode = 'pretty';

      function sortObj(val) {
        if (Array.isArray(val)) return val.map(sortObj);
        if (val && typeof val === 'object') {
          return Object.keys(val).sort().reduce(function (acc, k) {
            acc[k] = sortObj(val[k]);
            return acc;
          }, {});
        }
        return val;
      }

      function applyTransform(recomputeTarget) {
        if (recomputeTarget) {
          try {
            var parsed = JSON.parse(src.value || '{}');
            if (mode === 'minify') dst.value = JSON.stringify(parsed);
            else if (mode === 'sort') dst.value = JSON.stringify(sortObj(parsed), null, 2);
            else dst.value = JSON.stringify(parsed, null, 2);
          } catch (err) {
            dst.value = (src.value || '').trim().toUpperCase();
          }
        }
        diffEl.setAttribute('data-before', src.value || '');
        diffEl.setAttribute('data-after', dst.value || '');
        if (window.ZothUI) window.ZothUI.renderDiff(diffEl);
      }

      document.querySelectorAll('[data-diff-mode]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          mode = btn.getAttribute('data-diff-mode');
          document.querySelectorAll('[data-diff-mode]').forEach(function (b) { b.classList.toggle('is-active', b === btn); });
          applyTransform(true);
        });
      });

      src.addEventListener('input', function () { applyTransform(true); });
      dst.addEventListener('input', function () { applyTransform(false); });
      window.addEventListener('DOMContentLoaded', function () { applyTransform(true); });
    })();
  </script>
"""
    return wrap_html_document(title, slug, escaped_desc, schema_graph, body_main, app_cfg, extra_script)


