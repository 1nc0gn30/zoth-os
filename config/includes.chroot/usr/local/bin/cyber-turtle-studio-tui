#!/usr/bin/env python3
"""Cyber Turtle Studio v2.6.0 — Real Unicode U+2800 Braille Fractal & :8129 Dashboard TUI.

Imports cyber_turtle_studio directly to render real 2x4 sub-pixel Unicode Braille
vector fractals, compute live 2-Opt TSP air-travel telemetry, and probe 127.0.0.1:8129/health.
"""

from __future__ import annotations

import argparse
import json
import os
import sys
import time
import urllib.request
from pathlib import Path
from typing import Any, Dict, Optional

DEFAULT_PORT = 8129


def _resolve_runtime_root() -> Optional[Path]:
    candidates = []
    env_home = os.environ.get("CYBER_TURTLE_HOME", "").strip()
    if env_home:
        candidates.append(Path(env_home).expanduser())
    candidates.append(Path("/opt/cyber-turtle-studio"))
    try:
        candidates.append(Path(__file__).resolve().parent.parent)
    except Exception:
        pass
    candidates.append(Path.home() / "NullAITech" / "cyber-turtle-studio")
    for c in candidates:
        if (c / "src" / "cyber_turtle_studio").is_dir():
            return c.resolve()
    return None


def _display_path(p: Optional[Path]) -> str:
    if p is None:
        return "/opt/cyber-turtle-studio"
    text = str(p)
    home = str(Path.home())
    if home and text.startswith(home):
        return "~" + text[len(home):]
    return text


def _probe_health(port: int = DEFAULT_PORT) -> Dict[str, Any]:
    url = f"http://127.0.0.1:{port}/health"
    try:
        with urllib.request.urlopen(url, timeout=0.6) as resp:
            data = json.loads(resp.read().decode("utf-8"))
            return {"online": resp.status == 200, "status": data.get("status", "ok"), "version": data.get("version", "2.6.0")}
    except Exception:
        return {"online": False, "status": "idle", "version": "2.6.0"}


def main() -> int:
    ap = argparse.ArgumentParser(description="Cyber Turtle Studio v2.6.0 — Unicode U+2800 Braille TUI")
    ap.add_argument("--preset", default="koch_snowflake", help="Preset ID to render (default: koch_snowflake)")
    ap.add_argument("--width", type=int, default=54, help="Braille character columns (default: 54)")
    ap.add_argument("--height", type=int, default=16, help="Braille character rows (default: 16)")
    ap.add_argument("--once", action="store_true", help="Render a single deterministic frame and exit")
    ap.add_argument("--status", action="store_true", help="Check :8129 health and render dashboard")
    ap.add_argument("--json", action="store_true", help="Output live engine & Braille telemetry as JSON")
    args, _ = ap.parse_known_args()

    root = _resolve_runtime_root()
    if root is None:
        print(json.dumps({"error": "cyber_turtle_studio runtime not found"}) if args.json else "Error: cyber_turtle_studio runtime not found.", file=sys.stderr)
        return 1

    src_dir = str(root / "src")
    if src_dir not in sys.path:
        sys.path.insert(0, src_dir)

    from cyber_turtle_studio import __version__
    from cyber_turtle_studio.catalog import PRESETS, generate_pattern
    from cyber_turtle_studio.exporters import export_ascii
    from cyber_turtle_studio.toolpath_optimizer import ToolpathOptimizer

    t0 = time.perf_counter()
    preset_id = args.preset if args.preset in PRESETS else "koch_snowflake"
    ast = generate_pattern(preset_id)
    opt = ToolpathOptimizer()
    _, tsp_report = opt.optimize_toolpath(ast)
    braille_frame = export_ascii(
        ast,
        width=max(24, min(90, args.width)),
        height=max(8, min(32, args.height)),
        mode="braille",
        use_color=False,
        show_border=True,
        show_header=True,
    )
    elapsed_ms = round((time.perf_counter() - t0) * 1000.0, 2)
    health = _probe_health(DEFAULT_PORT)
    ast_stats = ast.stats()

    payload = {
        "tool": "cyber-turtle-studio",
        "version": __version__,
        "runtime_root": _display_path(root),
        "preset": preset_id,
        "preset_count": len(PRESETS),
        "segments": ast_stats["drawing_segments"],
        "draw_length_mm": round(float(ast_stats["total_drawing_length"]), 2),
        "tsp_polylines": tsp_report.total_polylines,
        "tsp_initial_air_mm": round(float(tsp_report.initial_air_travel_mm), 2),
        "tsp_optimized_air_mm": round(float(tsp_report.optimized_air_travel_mm), 2),
        "tsp_reduction_percent": round(float(tsp_report.reduction_percent), 2),
        "render_ms": elapsed_ms,
        "server_8129": health,
        "braille_lines": len(braille_frame.splitlines()),
        "braille_preview": braille_frame,
    }

    if args.json:
        print(json.dumps(payload, indent=2))
        return 0

    status_badge = "ONLINE :8129" if health["online"] else "IDLE (on-demand :8129)"
    print(f"=== Cyber Turtle Studio v{__version__} | Braille Vector TUI | {status_badge} ===")
    print(
        f"Preset: {preset_id} ({len(PRESETS)} catalog) | "
        f"Segments: {payload['segments']} | Draw: {payload['draw_length_mm']} mm | "
        f"2-Opt Air: {payload['tsp_initial_air_mm']} -> {payload['tsp_optimized_air_mm']} mm "
        f"(-{payload['tsp_reduction_percent']}%) | {elapsed_ms} ms"
    )
    print(braille_frame)
    print("Engineered by Neal Frazier Tech (@1nc0gn30) • NullAI Platform")
    return 0


if __name__ == "__main__":
    sys.exit(main())
