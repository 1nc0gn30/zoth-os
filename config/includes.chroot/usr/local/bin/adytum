#!/usr/bin/env python3
import sys, os, json, subprocess, argparse, shutil

TOOL_ID = 'adytum-alchemist-ai-workflow'
TOOL_REPO = 'adytum-alchemist-ai-workflow'
TOOL_NAME = 'Adytum Sanctuary 3D (22 Major Arcana)'
TOOL_DESC = 'Interactive 3D Esoteric Tarot Sanctuary, 22 Major Arcana 3D Diorama Explorer, and Hermetic Alchemist Workbench.'
TOOL_VERSION = '2.4.0'
TOOL_CATEGORY = 'Creative & Design'
TOOL_PORT = 8135
REPO_DIR = os.path.expanduser('~/NullAITech/adytum-alchemist-ai-workflow')
SERVER_PY = os.path.expanduser('~/NullAITech/adytum-alchemist-ai-workflow/server.py')
ELECTRON_MAIN = os.path.expanduser('~/NullAITech/adytum-alchemist-ai-workflow/electron/main.cjs')
STUDIO_URL = f"http://127.0.0.1:3000/tools/{TOOL_ID}"
LOCAL_PORT_URL = f"http://127.0.0.1:{TOOL_PORT}"

def main():
    args = sys.argv[1:]
    if '--electron' in args or (args and args[0] in ('desktop', 'electron')):
        rem = [a for a in args if a not in ('--electron', 'desktop', 'electron')]
        elec = shutil.which('electron') or '/usr/local/bin/electron'
        sys.exit(subprocess.run([elec, ELECTRON_MAIN] + rem, cwd=REPO_DIR).returncode)
    if '--tui' in args or (args and args[0] == 'tui'):
        rem = [a for a in args if a not in ('--tui', 'tui')]
        sys.exit(subprocess.run(['/usr/local/bin/adytum-alchemist-ai-workflow-tui'] + rem).returncode)
    if args and args[0] == 'serve':
        os.execv(sys.executable, [sys.executable, SERVER_PY, '--port', str(TOOL_PORT)])

    parser = argparse.ArgumentParser(prog=TOOL_ID, description=f"{TOOL_NAME} (v{TOOL_VERSION}) — {TOOL_DESC}")
    parser.add_argument('--version', action='version', version=f"{TOOL_ID} v{TOOL_VERSION}")
    parser.add_argument('--status', action='store_true', help='Check local ZothOS installation & daemon status')
    parser.add_argument('--json', action='store_true', help='Output deterministic JSON telemetry')
    parser.add_argument('--ui', action='store_true', help='Print local ZothOS workbench URL')
    parser.add_argument('payload', nargs='*', help='Optional input payload or subcommand')
    parsed, _ = parser.parse_known_args(args)

    info = {
        "id": TOOL_ID,
        "repo": TOOL_REPO,
        "name": TOOL_NAME,
        "version": TOOL_VERSION,
        "category": TOOL_CATEGORY,
        "installed": os.path.exists(REPO_DIR),
        "repo_path": REPO_DIR,
        "native_cli": SERVER_PY,
        "studio_workbench_url": STUDIO_URL,
        "local_endpoint": LOCAL_PORT_URL,
        "license": "100% Free & Open Access (Zero Paywalls)",
        "support": {
            "stripe_buy_coffee": "https://buy.stripe.com/3cIfZg27PdKo2D64Ocfw40X",
            "solana_wallet": "GG2eQbVh8ut1BK6j1A2tz7pSySdLpD38BgyEhGcxdXoK"
        },
        "status": "READY"
    }
    if parsed.json:
        print(json.dumps(info, indent=2))
        return
    if parsed.ui:
        print(LOCAL_PORT_URL)
        return
    print(f"✦ {TOOL_NAME} (v{TOOL_VERSION}) — [{TOOL_CATEGORY}]")
    print(f"  Repository : {REPO_DIR}")
    print(f"  Workbench  : {STUDIO_URL}")
    print(f"  Local Port : {LOCAL_PORT_URL}")
    print(f"  Access     : 100% Free & Open Access")

if __name__ == '__main__':
    main()
