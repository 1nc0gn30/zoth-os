    print(f"{GOLD}╔════════════════════════════════════════════════════════════════════════════╗{RESET}")
    print(f"{GOLD}║{WHITE}{BOLD}   🛡️  ZOTHOS SOVEREIGN WORKSTATION & AMNESIC AGENT OS                    {GOLD}║{RESET}")
    print(f"{GOLD}║{GRAY}   Debian 13 Live · Universal x86_64 · 100% Free & Open-Access              {GOLD}║{RESET}")
    print(f"{GOLD}╚════════════════════════════════════════════════════════════════════════════╝{RESET}\n")

def menu_amnesic():
    clear()
    header()
    print(f"{CYAN}{BOLD}1. AMNESIC RAM-ONLY HYGIENE & POWER-OFF BEHAVIOR{RESET}\n")
    print(f"{WHITE}• How ZothOS Boots:{RESET}")
    print(f"  ZothOS loads entirely into volatile system RAM ({EMERALD}toram noswap{RESET}).")
    print(f"  Once the desktop appears, the boot USB or drive is completely unmounted.")
    print(f"  You can safely unplug the boot media while the OS is running.\n")
    print(f"{WHITE}• What Happens When You Shut Off or Close the Machine:{RESET}")
    print(f"  {EMERALD}Zero Forensic Footprint:{RESET} Because everything runs in volatile RAM, turning off the")
    print(f"  machine instantaneously wipes all processes, temporary files, and RAM contents.")
    print(f"  Nothing is ever written to internal host hard drives unless explicitly mounted by you.\n")
    print(f"{WHITE}• Universal Hardware Compatibility:{RESET}")
    print(f"  No proprietary GPU locks or special hardware required. Runs smoothly on Intel UHD/Iris,")
    print(f"  AMD Radeon, NVIDIA GPUs, or pure CPU Mesa software rendering on any 64-bit PC or VM.\n")
    input(f"{GRAY}Press Enter to return to menu...{RESET}")

