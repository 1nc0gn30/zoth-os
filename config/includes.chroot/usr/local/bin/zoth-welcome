import shutil

GOLD = '\033[38;2;212;175;55m'
CYAN = '\033[38;2;56;189;248m'
EMERALD = '\033[38;2;16;185;129m'
WHITE = '\033[1;37m'
GRAY = '\033[38;2;148;163;184m'
RESET = '\033[0m'
BOLD = '\033[1m'

CONFIG_DIR = os.path.expanduser('~/.config/zoth')
AI_CONFIG_FILE = os.path.join(CONFIG_DIR, 'ai_providers.json')

def clear():
    os.system('clear' if os.name == 'posix' else 'cls')

