def menu_ai_providers():
    clear()
    header()
    print(f"{GOLD}{BOLD}3. MULTI-MODEL AI CONFIGURATION (40+ MODELS ACROSS 8 PROVIDERS){RESET}\n")
    print(f"{WHITE}ZothOS empowers your autonomous agents with multi-provider access:{RESET}\n")
    providers = [
        ("OpenRouter", "300+ models with 1 key (Claude 3.5, Hermes 3 405B, DeepSeek-V3, Llama 3.3)"),
        ("Nous Hermes Swarm", "Native Hermes-3 Agent Reasoner with tool-use & STDP memory"),
        ("Anthropic Claude", "Claude 3.5 Sonnet & Haiku for elite coding and agent architecture"),
        ("OpenAI", "GPT-4o, GPT-4o-mini & o1 reasoning enclaves"),
        ("Groq LPU", "Ultra-fast 800+ tokens/sec LPUs for lightning-fast agent loops"),
        ("Google Gemini", "Gemini 2.0 Flash & Pro with massive context windows"),
        ("DeepSeek", "DeepSeek-V3 & DeepSeek-R1 reasoner at high cost efficiency"),
        ("Local / LAN Ollama", "100% offline local inference on :11434 with zero network egress")
    ]
    for idx, (name, desc) in enumerate(providers, 1):
        print(f"  {CYAN}{idx}. {name:<18}{RESET} {GRAY}— {desc}{RESET}")
    print(f"\n{WHITE}Configuration File:{RESET} {CYAN}{AI_CONFIG_FILE}{RESET}")
    print(f"{WHITE}CLI Command:{RESET}        {BOLD}zoth-ai-config{RESET} (enter keys or test endpoints)\n")

    choice = input(f"{GOLD}Would you like to configure an AI provider now? (y/N): {RESET}").strip().lower()
    if choice == 'y':
        run_ai_config()

def run_ai_config():
    os.makedirs(CONFIG_DIR, exist_ok=True)
    cfg = {}
    if os.path.exists(AI_CONFIG_FILE):
        try:
            with open(AI_CONFIG_FILE, 'r') as f:
                cfg = json.load(f)
        except Exception:
            cfg = {}

    print(f"\n{CYAN}Select provider to configure:{RESET}")
    print("1. OpenRouter (Recommended)")
    print("2. Nous Hermes Swarm")
    print("3. Anthropic Claude")
    print("4. OpenAI")
    print("5. Groq")
    print("6. Google Gemini")
    print("7. DeepSeek")
    print("8. Local Ollama (Set endpoint)")
    p_choice = input(f"{GOLD}Choose [1-8]: {RESET}").strip()

    p_map = {
        '1': ('openrouter', 'OpenRouter API Key (sk-or-v1-...): '),
        '2': ('nous_hermes', 'Nous Hermes Swarm Key (nous_live_...): '),
        '3': ('anthropic', 'Anthropic API Key (sk-ant-...): '),
        '4': ('openai', 'OpenAI API Key (sk-proj-...): '),
        '5': ('groq', 'Groq API Key (gsk_...): '),
        '6': ('gemini', 'Google Gemini API Key (AIzaSy...): '),
        '7': ('deepseek', 'DeepSeek API Key (sk-...): '),
        '8': ('ollama', 'Ollama Base URL [http://127.0.0.1:11434]: ')
    }

    if p_choice in p_map:
        key_id, prompt = p_map[p_choice]
        val = input(prompt).strip()
        if val or key_id == 'ollama':
            if key_id == 'ollama' and not val:
                val = 'http://127.0.0.1:11434'
            cfg[key_id] = {'key': val, 'updated_at': os.times()[4]}
            with open(AI_CONFIG_FILE, 'w') as f:
                json.dump(cfg, f, indent=2)
            print(f"{EMERALD}✓ Saved {key_id} configuration to {AI_CONFIG_FILE}!{RESET}")
    input(f"{GRAY}Press Enter to continue...{RESET}")

