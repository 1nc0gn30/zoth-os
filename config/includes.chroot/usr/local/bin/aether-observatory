#!/usr/bin/env bash
# aether-observatory CLI + daemon + MCP entry — works from any install location.
# Resolves the project root from the script's location (with symlink support).
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
BIN_DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"

if [ ! -f "$BIN_DIR/aether-observatory.js" ]; then
  for cand in "${HOME}/NullAITech/aether-observatory/bin" "/opt/aether-observatory/bin" "/usr/local/share/aether-observatory/bin"; do
    if [ -f "$cand/aether-observatory.js" ]; then
      BIN_DIR="$cand"
      break
    fi
  done
fi

if [ "$1" = "serve" ]; then
  shift
  exec node "$BIN_DIR/../src/server.js" "$@"
elif [ "$1" = "mcp" ]; then
  shift
  exec node "$BIN_DIR/../src/mcp_server.js" "$@"
else
  exec node "$BIN_DIR/aether-observatory.js" "$@"
fi
