#!/usr/bin/env bash
REPO_DIR="$HOME/NullAITech/sovereign-agent-bridge"
PYTHON_BIN="$REPO_DIR/.venv/bin/python"
if [ ! -f "$PYTHON_BIN" ]; then
  PYTHON_BIN="python3"
fi

if [ "$1" = "--status" ] || [ "$1" = "status" ]; then
  exec "$PYTHON_BIN" -m sovereign_agent_bridge.cli channels --json
elif [ "$1" = "--version" ] || [ "$1" = "-v" ]; then
  echo "sovereign-agent-bridge v3.2.0 (Sovereign Agent Signal Bridge)"
  exit 0
elif [ "$1" = "--help" ] || [ "$1" = "-h" ]; then
  exec "$PYTHON_BIN" -m sovereign_agent_bridge.cli --help
elif [ "$1" = "web" ] || [ "$1" = "serve" ]; then
  exec "$PYTHON_BIN" "$REPO_DIR/server.py" --port 8102
else
  exec "$PYTHON_BIN" -m sovereign_agent_bridge.cli "$@"
fi
