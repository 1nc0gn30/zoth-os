#!/usr/bin/env bash
# ZothOS Desktop (Electron) & Braille TUI Interceptor
if [ "$1" = "desktop" ] || [ "$1" = "electron" ] || [ "$1" = "--electron" ]; then
  shift
  exec /usr/local/bin/electron "$HOME/NullAITech/sovereign-agent-bridge/electron/main.cjs" "$@"
elif [ "$1" = "tui" ] || [ "$1" = "--tui" ]; then
  shift
  exec /usr/local/bin/sovereign-agent-bridge-tui "$@"
fi
REPO_DIR="$HOME/NullAITech/sovereign-agent-bridge"
export PYTHONPATH="$REPO_DIR/src:${PYTHONPATH:-}"
PYTHON_BIN="$REPO_DIR/.venv/bin/python"
if [ ! -f "$PYTHON_BIN" ]; then
  PYTHON_BIN="python3"
fi

if [ "$1" = "--status" ] || [ "$1" = "status" ]; then
  exec "$PYTHON_BIN" -m sovereign_agent_bridge.cli agents --json
elif [ "$1" = "--version" ] || [ "$1" = "-v" ]; then
  echo "sovereign-agent-bridge v3.3.0 (Sovereign Agent Signal & Cross-Agent Introspection Bridge)"
  exit 0
elif [ "$1" = "--help" ] || [ "$1" = "-h" ]; then
  exec "$PYTHON_BIN" -m sovereign_agent_bridge.cli --help
elif [ "$1" = "web" ] || [ "$1" = "serve" ]; then
  exec "$PYTHON_BIN" "$REPO_DIR/server.py" --port 8102
else
  exec "$PYTHON_BIN" -m sovereign_agent_bridge.cli "$@"
fi
