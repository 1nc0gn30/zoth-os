from __future__ import annotations

import argparse
import json
import os
import sys
import time

sys.path.insert(0, os.path.abspath(os.path.join(os.path.dirname(__file__), "..", "sdk", "python")))

from fieldkit import Mission, BoundingBox, LandmarkPoint, RaycastEvaluator, NearFieldVoiceGate, SovereignBiometricVault


def print_banner():
    print("""
\033[1;33m  ███████╗██╗███████╗██╗     ██████╗ ██╗  ██╗██╗████████╗
  ██╔════╝██║██╔════╝██║     ██╔══██╗██║ ██╔╝██║╚══██╔══╝
  █████╗  ██║█████╗  ██║     ██║  ██║█████═╝ ██║   ██║   
  ██╔══╝  ██║██╔══╝  ██║     ██║  ██║██╔═██╗ ██║   ██║   
  ██║     ██║███████╗███████╗██████╔╝██║ ╚██╗██║   ██║   
  ╚═╝     ╚═╝╚══════╝╚══════╝╚═════╝ ╚═╝  ╚═╝╚═╝   ╚═╝   \033[0m
  \033[36mPhysical AI Operating Framework · Coined by 1nc0gn30 · NullAI\033[0m
""")


def cmd_run(args):
    """Run an interactive mission session in CLI terminal."""
    yaml_path = args.mission_file
    if not os.path.exists(yaml_path):
        print(f"\033[31m[-] Mission template not found: {yaml_path}\033[0m")
        sys.exit(1)

    print(f"\033[32m[+] Loading FieldKit mission from {yaml_path}...\033[0m")
    mission = Mission.from_yaml_file(yaml_path)

    print(f"\n\033[1;37mMission:\033[0m \033[1;33m{mission.title}\033[0m ({mission.category})")
    print(f"\033[1;37mTotal Steps:\033[0m {len(mission.ordered_step_ids)}")
    print(f"\033[1;37mHands-Busy Invariant:\033[0m \033[32mACTIVE\033[0m\n")

    while not mission.is_finished:
        curr = mission.current_step
        if not curr:
            break

        idx = mission.ordered_step_ids.index(curr.id) + 1
        print("─" * 60)
        print(f"\033[1;36m[STEP {idx}/{len(mission.ordered_step_ids)}]\033[0m \033[1;37m{curr.name}\033[0m")
        print(f"\033[33m🗣️ Audio Cue to Ear:\033[0m \"{curr.prompt_speech}\"")
        if curr.expected_action:
            print(f"\033[35mTarget Physical Action:\033[0m {curr.expected_action}")

        # Interactive simulation
        print("\nPress [ENTER] to simulate sensor verification (or type 'abort'): ", end="", flush=True)
        user_input = sys.stdin.readline().strip().lower()

        if user_input == "abort":
            mission.abort("User triggered abort.")
            print("\033[31m[!] Mission aborted by operator.\033[0m")
            return

        next_step = mission.advance(f"Operator simulated physical verification at {time.strftime('%X')}")
        print(f"\033[32m[✓] Verified! Progress: {mission.progress_percentage}%\033[0m")

    print("\n" + "=" * 60)
    print("\033[1;32m🎉 MISSION COMPLETE! All physical checkpoints verified.\033[0m")
    print("=" * 60 + "\n")


def cmd_test_raycast(args):
    """Test skeletal hand raycasting against a target bounding box."""
    print("\033[36m[*] Running 3D Skeletal Landmark Raycast Simulation...\033[0m")
    target = BoundingBox(ymin=0.2, xmin=0.3, ymax=0.6, xmax=0.7, label="circuit_breaker_lever")
    thumb = LandmarkPoint(x=0.45, y=0.35, z=0.01)
    index = LandmarkPoint(x=0.47, y=0.37, z=0.01)

    manipulating, conf = RaycastEvaluator.verify_manipulation(target, thumb, index)
    print(f"Target Bounding Box: [{target.ymin}, {target.xmin}, {target.ymax}, {target.xmax}] ({target.label})")
    print(f"Pinch Centroid: ({thumb.x + index.x / 2:.2f}, {thumb.y + index.y / 2:.2f})")
    print(f"Physical Pinch Detected: \033[32m{manipulating}\033[0m (Confidence: {conf * 100:.1f}%)")


def cmd_vault_audit(args):
    """Run security audit on the local Biometric People Vault."""
    print("\033[36m[*] Inspecting On-Device Sovereign Biometric People Vault...\033[0m")
    vault = SovereignBiometricVault()
    vault.store_identity("operator-01", {"callsign": "1nc0gn30", "clearance": "level_5", "voice_enrolled": True})
    manifest = vault.export_audit_manifest()
    print(json.dumps(manifest, indent=2))
    print("\033[32m[✓] Zero-egress hardware enclave compliance confirmed.\033[0m")


def main():
    print_banner()
    parser = argparse.ArgumentParser(description="FieldKit Physical AI CLI & Runtime Runner")
    subparsers = parser.add_subparsers(dest="command", help="Command to execute")

    # Run mission
    p_run = subparsers.add_parser("run", help="Run a procedural FieldKit mission")
    p_run.add_argument("mission_file", help="Path to mission YAML template")

    # Test raycast
    subparsers.add_parser("test-raycast", help="Test skeletal hand raycasting geometry")

    # Vault audit
    subparsers.add_parser("vault-audit", help="Audit local sovereign biometric vault")

    args = parser.parse_args()
    if args.command == "run":
        cmd_run(args)
    elif args.command == "test-raycast":
        cmd_test_raycast(args)
    elif args.command == "vault-audit":
        cmd_vault_audit(args)
    else:
        parser.print_help()


if __name__ == "__main__":
    main()
