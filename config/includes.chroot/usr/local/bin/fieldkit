#!/usr/bin/env python3
"""FieldKit Command-Line Interface (CLI) — v2.0.0.

Execute physical missions, test smart glasses 3D skeletal raycasting, audit edge
cryptography, and launch the FieldKit JSON-RPC 2.0 MCP server.

Engineered by Neal Frazier Tech (@1nc0gn30) • NullAI Platform
"""

from __future__ import annotations

import argparse
import json
import os
import sys
import time
from pathlib import Path
from typing import Any, Dict, List, Optional


def _resolve_root() -> Optional[Path]:
    candidates: List[Path] = []
    env_dir = os.environ.get("FIELDKIT_REPO_DIR", "").strip()
    if env_dir:
        candidates.append(Path(env_dir).resolve())
    candidates.append(Path("/opt/fieldkit"))
    candidates.append(Path(__file__).resolve().parent.parent)
    for candidate in candidates:
        if (candidate / "sdk" / "python" / "fieldkit").is_dir():
            return candidate
    return None


FIELDKIT_ROOT = _resolve_root()
if FIELDKIT_ROOT is not None:
    for _sub in (("sdk", "python"), ("mcp",)):
        _p = str(FIELDKIT_ROOT.joinpath(*_sub))
        if _p not in sys.path:
            sys.path.insert(0, _p)

from fieldkit import (  # noqa: E402
    HAS_CRYPTO,
    BoundingBox,
    LandmarkPoint,
    Mission,
    RaycastEvaluator,
    SovereignBiometricVault,
    StateTransitionError,
    __version__ as FIELDKIT_VERSION,
)

ATTRIBUTION = "Engineered by Neal Frazier Tech (@1nc0gn30) • NullAI Platform"


def _use_color(no_color: bool, json_mode: bool) -> bool:
    if json_mode or no_color or os.environ.get("NO_COLOR"):
        return False
    return sys.stdout.isatty()


def _c(code: str, text: str, enabled: bool) -> str:
    if not enabled:
        return text
    return f"\033[{code}m{text}\033[0m"


def print_banner(color_enabled: bool) -> None:
    if not color_enabled:
        return
    print(
        "\n"
        "\033[1;33m  ███████╗██╗███████╗██╗     ██████╗ ██╗  ██╗██╗████████╗\n"
        "  ██╔════╝██║██╔════╝██║     ██╔══██╗██║ ██╔╝██║╚══██╔══╝\n"
        "  █████╗  ██║█████╗  ██║     ██║  ██║█████═╝ ██║   ██║   \n"
        "  ██╔══╝  ██║██╔══╝  ██║     ██║  ██║██╔═██╗ ██║   ██║   \n"
        "  ██║     ██║███████╗███████╗██████╔╝██║ ╚██╗██║   ██║   \n"
        "  ╚═╝     ╚═╝╚══════╝╚══════╝╚═════╝ ╚═╝  ╚═╝╚═╝   ╚═╝   \033[0m\n"
        f"  \033[36mPhysical AI Operating Framework v{FIELDKIT_VERSION} · {ATTRIBUTION}\033[0m\n"
    )


def _status_payload() -> Dict[str, Any]:
    install_mode = (
        "/opt/fieldkit"
        if FIELDKIT_ROOT is not None and str(FIELDKIT_ROOT) == "/opt/fieldkit"
        else ("portable-repo" if FIELDKIT_ROOT is not None else "installed-package")
    )
    templates: List[str] = []
    if FIELDKIT_ROOT is not None:
        tpl_map = {
            "industrial_pump": "templates/industrial-repair/mission.yaml",
            "tccc_tourniquet": "templates/emergency-medical/mission.yaml",
            "datacenter_sweep": "templates/security-inspection/mission.yaml",
        }
        templates = sorted(
            name for name, rel in tpl_map.items() if (FIELDKIT_ROOT / rel).is_file()
        )
    return {
        "name": "fieldkit",
        "version": FIELDKIT_VERSION,
        "status": "ready",
        "install_mode": install_mode,
        "has_cryptography": HAS_CRYPTO,
        "mcp_command": "fieldkit-mcp --stdio",
        "subcommands": ["run", "test-raycast", "vault-audit", "mcp"],
        "templates_available": templates,
        "attribution": ATTRIBUTION,
    }


def cmd_run(args: argparse.Namespace, color: bool) -> int:
    """Run an interactive mission session in CLI terminal."""
    yaml_path = args.mission_file
    if not os.path.exists(yaml_path):
        print(_c("31", f"[-] Mission template not found: {yaml_path}", color), file=sys.stderr)
        return 1

    try:
        mission = Mission.from_yaml_file(yaml_path)
    except (OSError, StateTransitionError, ValueError) as exc:
        print(_c("31", f"[-] Failed to load mission YAML: {exc}", color), file=sys.stderr)
        return 1

    print(_c("32", f"[+] Loaded FieldKit mission: {mission.title} ({mission.category})", color))
    print(f"Total Steps: {len(mission.ordered_step_ids)}")
    print(f"Hands-Busy Invariant: {_c('32', 'ACTIVE', color)}\n")

    while not mission.is_finished:
        curr = mission.current_step
        if not curr:
            break

        idx = mission.ordered_step_ids.index(curr.id) + 1
        print("-" * 60)
        print(f"{_c('1;36', f'[STEP {idx}/{len(mission.ordered_step_ids)}]', color)} {curr.name}")
        print(f"{_c('33', 'Audio Cue:', color)} \"{curr.prompt_speech}\"")
        if curr.expected_action:
            print(f"{_c('35', 'Target Physical Action:', color)} {curr.expected_action}")

        print("\nPress [ENTER] to confirm physical verification (or type 'abort'): ", end="", flush=True)
        user_input = sys.stdin.readline().strip().lower()

        if user_input == "abort":
            mission.abort("User triggered abort.")
            print(_c("31", "[!] Mission aborted by operator.", color))
            return 0

        mission.advance(f"Operator physical verification at {time.strftime('%X')}")
        print(_c("32", f"[✓] Verified! Progress: {mission.progress_percentage}%", color))

    print("\n" + "=" * 60)
    print(_c("1;32", "MISSION COMPLETE — All physical checkpoints verified.", color))
    print("=" * 60 + "\n")
    return 0


def cmd_test_raycast(args: argparse.Namespace, color: bool, json_mode: bool) -> int:
    """Test skeletal hand raycasting against a target bounding box."""
    target = BoundingBox(ymin=0.2, xmin=0.3, ymax=0.6, xmax=0.7, label="circuit_breaker_lever")
    thumb = LandmarkPoint(x=0.45, y=0.35, z=0.01)
    index = LandmarkPoint(x=0.47, y=0.37, z=0.01)
    result = RaycastEvaluator.evaluate_pinch_targeting(target, thumb, index)

    if json_mode:
        print(json.dumps(result, indent=2))
        return 0

    cx = result["pinch_centroid"]["x"]
    cy = result["pinch_centroid"]["y"]
    print(_c("36", "[*] Running 3D Skeletal Landmark Raycast Simulation...", color))
    print(f"Target Bounding Box: [{target.ymin}, {target.xmin}, {target.ymax}, {target.xmax}] ({target.label})")
    print(f"Pinch Centroid: ({cx:.2f}, {cy:.2f})")
    print(
        f"Physical Pinch Detected: {_c('32', str(result['raycast_hit']), color)} "
        f"(Confidence: {result['raycast_confidence'] * 100:.1f}%)"
    )
    return 0


def cmd_vault_audit(args: argparse.Namespace, color: bool, json_mode: bool) -> int:
    """Run security audit on the local Sovereign Biometric People Vault."""
    vault = (
        SovereignBiometricVault()
        if HAS_CRYPTO
        else SovereignBiometricVault(allow_insecure_simulation=True)
    )
    vault.store_identity(
        "operator-01",
        {"callsign": "1nc0gn30", "clearance": "level_5", "voice_enrolled": True},
    )
    manifest = vault.export_audit_manifest()

    if json_mode:
        print(json.dumps(manifest, indent=2))
        return 0

    print(_c("36", "[*] Inspecting On-Device Sovereign Biometric People Vault...", color))
    print(json.dumps(manifest, indent=2))
    status_line = (
        "[✓] Zero-egress on-device AES-256-GCM vault verified."
        if manifest.get("has_cryptography")
        else "[!] WARNING: cryptography unavailable — degraded simulation mode only."
    )
    print(_c("32" if manifest.get("has_cryptography") else "31", status_line, color))
    return 0


def cmd_mcp(mcp_args: List[str]) -> int:
    """Launch the FieldKit JSON-RPC 2.0 MCP server with pass-through arguments."""
    import fieldkit_mcp_server

    return int(fieldkit_mcp_server.main(mcp_args) or 0)


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="fieldkit",
        description=f"FieldKit Physical AI CLI & Runtime Runner (v{FIELDKIT_VERSION})",
    )
    parser.add_argument("--version", action="store_true", help="Print FieldKit CLI version and exit")
    parser.add_argument("--status", action="store_true", help="Show FieldKit runtime readiness summary")
    parser.add_argument("--json", action="store_true", help="Emit pure machine-readable JSON output")
    parser.add_argument("--no-color", action="store_true", help="Disable ANSI colors and ASCII art banner")

    subparsers = parser.add_subparsers(dest="command", help="Command to execute")

    p_run = subparsers.add_parser("run", help="Run a procedural FieldKit mission from YAML")
    p_run.add_argument("mission_file", help="Path to mission YAML template")

    p_ray = subparsers.add_parser("test-raycast", help="Test 3D skeletal hand raycasting geometry")
    p_ray.add_argument("--json", dest="sub_json", action="store_true", help="Emit JSON output")
    p_ray.add_argument("--no-color", dest="sub_no_color", action="store_true", help="Disable ANSI color")

    p_vault = subparsers.add_parser("vault-audit", help="Audit local sovereign biometric vault")
    p_vault.add_argument("--json", dest="sub_json", action="store_true", help="Emit JSON output")
    p_vault.add_argument("--no-color", dest="sub_no_color", action="store_true", help="Disable ANSI color")

    p_mcp = subparsers.add_parser("mcp", help="Launch the FieldKit JSON-RPC 2.0 MCP server")
    p_mcp.add_argument("mcp_args", nargs=argparse.REMAINDER, help="Arguments passed to fieldkit-mcp")

    return parser


def main(argv: Optional[List[str]] = None) -> int:
    raw_argv = list(sys.argv[1:] if argv is None else argv)

    # Fast-path direct pass-through for `fieldkit mcp ...` so `--help`/`--status`/`--json`
    # after `mcp` are handled by fieldkit_mcp_server directly.
    if raw_argv and raw_argv[0] == "mcp":
        return cmd_mcp(raw_argv[1:])

    parser = build_parser()
    args = parser.parse_args(raw_argv)

    json_mode = bool(args.json or getattr(args, "sub_json", False))
    no_color = bool(args.no_color or getattr(args, "sub_no_color", False))
    color = _use_color(no_color=no_color, json_mode=json_mode)

    if args.version:
        if json_mode:
            print(json.dumps({"name": "fieldkit", "version": FIELDKIT_VERSION, "attribution": ATTRIBUTION}))
        else:
            print(f"fieldkit {FIELDKIT_VERSION}")
        return 0

    if args.status or (json_mode and not args.command):
        payload = _status_payload()
        if json_mode:
            print(json.dumps(payload, indent=2))
        else:
            print_banner(color)
            print(
                f"FieldKit CLI v{payload['version']} ({payload['install_mode']})\n"
                f"Crypto Backend: {'AES-256-GCM' if payload['has_cryptography'] else 'UNAVAILABLE'}\n"
                f"MCP Bridge: {payload['mcp_command']}\n"
                f"Templates: {', '.join(payload['templates_available'])}\n"
                f"{payload['attribution']}"
            )
        return 0

    if args.command == "run":
        print_banner(color)
        return cmd_run(args, color)
    if args.command == "test-raycast":
        print_banner(color)
        return cmd_test_raycast(args, color, json_mode)
    if args.command == "vault-audit":
        print_banner(color)
        return cmd_vault_audit(args, color, json_mode)

    print_banner(color)
    parser.print_help()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
