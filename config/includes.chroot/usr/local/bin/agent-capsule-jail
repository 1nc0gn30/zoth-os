#!/usr/bin/env python3
"""Unified Command Line Interface for agent-capsule-jail (v2.6.0).
Engineered by Neal Frazier Tech (@1nc0gn30) • NullAI Platform.
100% Python Standard Library — Zero External Dependencies.
"""
from __future__ import annotations

import argparse
import os
import shutil
import subprocess
import sys

TOOL_ID = "agent-capsule-jail"
TOOL_NAME = "Agent Capsule Jail"
TOOL_DESC = "Ephemeral bubblewrap namespace sandbox, cgroup/rlimit quota enforcer, and SHA-256 receipt enclave."
TOOL_VERSION = "2.6.0"
TOOL_PORT = 8105
STUDIO_URL = f"http://127.0.0.1:3000/tools/{TOOL_ID}"
LOCAL_PORT_URL = f"http://127.0.0.1:{TOOL_PORT}"


def resolve_repo_dir() -> str:
    for candidate in (
        os.path.expanduser("~/NullAITech/agent-capsule-jail"),
        "/opt/agent-capsule-jail",
    ):
        if os.path.isdir(os.path.join(candidate, "src", "agent_capsule_jail")):
            return candidate
    return os.path.expanduser("~/NullAITech/agent-capsule-jail")


def run_cli_module(cli_args: list[str]) -> int:
    repo_dir = resolve_repo_dir()
    pkg_dir = os.path.join(repo_dir, "src")
    env = os.environ.copy()
    env["PYTHONPATH"] = pkg_dir + os.pathsep + env.get("PYTHONPATH", "")
    res = subprocess.run(
        [sys.executable, "-m", "agent_capsule_jail.cli"] + cli_args,
        cwd=repo_dir if os.path.isdir(repo_dir) else None,
        env=env,
    )
    return res.returncode


def main() -> int:
    args = sys.argv[1:]
    repo_dir = resolve_repo_dir()

    if "--electron" in args or (args and args[0] in ("desktop", "electron")):
        rem = [a for a in args if a not in ("--electron", "desktop", "electron")]
        elec = shutil.which("electron") or "/usr/local/bin/electron"
        return subprocess.run(
            [elec, os.path.join(repo_dir, "electron", "main.cjs")] + rem,
            cwd=repo_dir,
        ).returncode

    if "--tui" in args or (args and args[0] == "tui"):
        rem = [a for a in args if a not in ("--tui", "tui")]
        tui_bin = shutil.which(f"{TOOL_ID}-tui") or os.path.join(repo_dir, "bin", f"{TOOL_ID}-tui")
        return subprocess.run([tui_bin] + rem).returncode

    if args and args[0] in ("exec", "serve", "status", "token", "mcp", "test"):
        return run_cli_module(args)

    if args and args[0] == "--ui":
        print(f"Standalone Workbench : {LOCAL_PORT_URL}")
        print(f"Zoth Studio Route    : {STUDIO_URL}")
        return 0

    if args and args[0] in ("--version", "-V"):
        print(f"{TOOL_ID} v{TOOL_VERSION}")
        return 0

    if args and args[0] in ("--status", "--json"):
        cli_args = ["status"]
        if "--json" in args:
            cli_args.append("--json")
        for i, a in enumerate(args):
            if a in ("--port", "--host") and i + 1 < len(args):
                cli_args.extend([a, args[i + 1]])
        return run_cli_module(cli_args)

    if args and args[0] in ("-h", "--help"):
        parser = argparse.ArgumentParser(
            prog=TOOL_ID,
            description=f"{TOOL_NAME} (v{TOOL_VERSION}) — {TOOL_DESC}",
            formatter_class=argparse.RawDescriptionHelpFormatter,
            epilog=(
                "Subcommands:\n"
                "  exec [opts] -- <cmd>  Execute command/script inside ephemeral bwrap capsule\n"
                "  serve [--port 8105]   Run authenticated loopback HTTP API & Web UI\n"
                "  status [--json]       Query live daemon health, sandbox mode & stats\n"
                "  token                 Display active per-user X-Capsule-Token\n"
                "  mcp                   Run zero-dependency JSON-RPC 2.0 stdio MCP server\n"
                "  tui [--once|--json]   Launch live terminal telemetry dashboard\n"
                "  electron              Launch desktop Electron workstation wrapper\n"
                "\n"
                "Engineered by Neal Frazier Tech (@1nc0gn30) • NullAI Platform"
            ),
        )
        parser.add_argument("--version", "-V", action="store_true", help="Print unified version (2.6.0)")
        parser.add_argument("--status", action="store_true", help="Query live daemon & sandbox status")
        parser.add_argument("--json", action="store_true", help="Output live status JSON telemetry")
        parser.add_argument("--ui", action="store_true", help="Print standalone and Studio workbench URLs")
        parser.add_argument("--tui", action="store_true", help="Launch live terminal telemetry TUI")
        parser.add_argument("--electron", action="store_true", help="Launch desktop Electron wrapper")
        parser.print_help()
        return 0

    if not args:
        return run_cli_module(["status"])

    # Forward any unknown subcommand directly to cli.py so argparse returns exit code 2 cleanly
    return run_cli_module(args)


if __name__ == "__main__":
    raise SystemExit(main())
