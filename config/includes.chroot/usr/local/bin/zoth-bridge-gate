#!/usr/bin/env bash
# Sovereign Agent Bridge Mandatory Gatekeeper Wrapper
set -euo pipefail
if [[ $# -lt 2 ]]; then
  echo "Usage: zoth-bridge-gate <tool_name> <target_bin> [args...]" >&2
  exit 1
fi
TOOL_NAME="$1"
TARGET_BIN="$2"
shift 2
BRIDGE_BIN="$(command -v sovereign-agent-bridge || true)"
if [[ -z "$BRIDGE_BIN" ]]; then
  BRIDGE_BIN="${HOME}/.local/bin/sovereign-agent-bridge"
fi
exec "$BRIDGE_BIN" gatekeep "$TOOL_NAME" --target "$TARGET_BIN" -- "$@"
