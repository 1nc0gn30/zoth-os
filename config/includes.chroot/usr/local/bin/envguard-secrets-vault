#!/usr/bin/env python3
"""EnvGuard Secrets Vault (v2.6.0) — Canonical ZothOS CLI Wrapper.

Resolves runtime cleanly in priority order:
  1. /opt/envguard-secrets-vault
  2. ~/NullAITech/envguard-secrets-vault
Preserves caller working directory so relative file paths work as expected,
and never emits literal user home paths in --json output.
"""

from __future__ import annotations

import argparse
import json
import os
import shutil
import subprocess
import sys
import urllib.request
from pathlib import Path

TOOL_ID = "envguard-secrets-vault"
TOOL_NAME = "EnvGuard Secrets Vault"
TOOL_DESC = (
    "Zero-exposure .env secret scanner, PBKDF2-HMAC-SHA256 (600k) + AES-256-CTR + "
    "HMAC-SHA256 vault, GF(256) Shamir quorum, TTL rotation sentinel, and 11-tool MCP server."
)
TOOL_VERSION = "2.6.0"
TOOL_CATEGORY = "Security & Recon"
TOOL_PORT = 8088
STUDIO_URL = f"http://127.0.0.1:3000/tools/{TOOL_ID}"
LOCAL_PORT_URL = f"http://127.0.0.1:{TOOL_PORT}"


def _resolve_root() -> tuple[Path, str]:
    opt_root = Path("/opt/envguard-secrets-vault")
    if (opt_root / "src" / "envguard_secrets_vault" / "cli.py").is_file():
        return opt_root, "/opt/envguard-secrets-vault"
    repo_root = Path.home() / "NullAITech" / "envguard-secrets-vault"
    if (repo_root / "src" / "envguard_secrets_vault" / "cli.py").is_file():
        return repo_root, "~/NullAITech/envguard-secrets-vault"
    script_root = Path(__file__).resolve().parent.parent
    return script_root, "/opt/envguard-secrets-vault"


def _probe_health() -> dict:
    try:
        req = urllib.request.Request(f"{LOCAL_PORT_URL}/api/health", headers={"Host": f"127.0.0.1:{TOOL_PORT}"})
        with urllib.request.urlopen(req, timeout=1.5) as resp:
            if resp.status == 200:
                return json.loads(resp.read().decode("utf-8"))
    except Exception:
        pass
    return {}


def main() -> int:
    root_dir, display_root = _resolve_root()
    src_dir = root_dir / "src"
    args = sys.argv[1:]

    if "--electron" in args or (args and args[0] in ("desktop", "electron")):
        rem = [a for a in args if a not in ("--electron", "desktop", "electron")]
        elec = shutil.which("electron") or "/usr/local/bin/electron"
        repo_electron = Path.home() / "NullAITech" / "envguard-secrets-vault" / "electron" / "main.cjs"
        if repo_electron.is_file() and os.path.exists(elec):
            return subprocess.run([elec, str(repo_electron)] + rem).returncode
        browser = shutil.which("xdg-open")
        if browser:
            return subprocess.run([browser, LOCAL_PORT_URL]).returncode
        print(LOCAL_PORT_URL)
        return 0

    if "--tui" in args or (args and args[0] == "tui"):
        rem = [a for a in args if a not in ("--tui", "tui")]
        tui_bin = shutil.which(f"{TOOL_ID}-tui") or f"/usr/local/bin/{TOOL_ID}-tui"
        return subprocess.run([tui_bin] + rem).returncode

    # Forward all native subcommands directly to envguard_secrets_vault.cli WITHOUT changing caller cwd
    wrapper_flags = {"--status", "--info", "--ui", "--studio", "--json", "--version"}
    if args and args[0] not in wrapper_flags and (src_dir / "envguard_secrets_vault" / "cli.py").is_file():
        env = os.environ.copy()
        env["PYTHONPATH"] = str(src_dir) + (os.pathsep + env["PYTHONPATH"] if env.get("PYTHONPATH") else "")
        return subprocess.run([sys.executable, "-m", "envguard_secrets_vault.cli"] + args, env=env).returncode

    parser = argparse.ArgumentParser(
        prog=TOOL_ID,
        description=f"{TOOL_NAME} (v{TOOL_VERSION}) — {TOOL_DESC}",
    )
    parser.add_argument("--version", action="version", version=f"{TOOL_ID} v{TOOL_VERSION}")
    parser.add_argument("--status", action="store_true", help="Check local installation & :8088 daemon status")
    parser.add_argument("--json", action="store_true", help="Output deterministic JSON telemetry")
    parser.add_argument("--ui", "--studio", dest="ui", action="store_true", help="Print local workstation URLs")
    parsed, _ = parser.parse_known_args(args)

    health = _probe_health()
    payload = {
        "id": TOOL_ID,
        "name": TOOL_NAME,
        "version": TOOL_VERSION,
        "category": TOOL_CATEGORY,
        "description": TOOL_DESC,
        "cipher": "PBKDF2-HMAC-SHA256 (600,000 default) + AES-256-CTR + HMAC-SHA256",
        "mcp_tools": 11,
        "runtime_root": display_root,
        "port": TOOL_PORT,
        "local_url": LOCAL_PORT_URL,
        "studio_url": STUDIO_URL,
        "daemon_online": bool(health.get("app") == TOOL_ID),
        "daemon_version": health.get("version") or None,
    }

    if parsed.json:
        print(json.dumps(payload, indent=2))
        return 0

    if parsed.ui:
        print(f"Local Workstation: {LOCAL_PORT_URL}")
        print(f"Studio Route:      {STUDIO_URL}")
        return 0

    if parsed.status:
        state = "ONLINE" if payload["daemon_online"] else "OFFLINE"
        print(f"{TOOL_NAME} v{TOOL_VERSION} [{state}] | {LOCAL_PORT_URL} | root={display_root}")
        return 0

    parser.print_help()
    print("\nNative subcommands (forwarded preserving working directory):")
    print("  serve | scan | mask | example | encrypt | decrypt | diff | check | mcp | shamir | rotate | platform | test | tui")
    return 0


if __name__ == "__main__":
    sys.exit(main())
