#!/usr/bin/env bash
# ==============================================================================
# ZothOS Desktop Pet & HUD Launcher
# ==============================================================================
set -euo pipefail

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
    echo "Usage: zoth-pet-hud [--pet eye|aquila|draco|ignis|kitsune|lycan|workbot|azoth] [--hud]"
    exit 0
fi

# Optional: --pet NAME selects the companion before launch (used by the menu actions).
if [[ "${1:-}" == "--pet" ]]; then
    PET_ID="${2:-}"
    if [[ ! "$PET_ID" =~ ^[a-z0-9_-]{1,32}$ ]]; then
        echo "[!] Invalid pet name: '$PET_ID'" >&2
        exit 2
    fi
    mkdir -p "$HOME/.config/zothos"
    printf '{"petId":"%s"}\n' "$PET_ID" > "$HOME/.config/zothos/pet_config.json"
    shift 2
fi

if [[ "${1:-}" == "--hud" ]]; then
    shift
    exec /usr/local/bin/zoth-desktop-hud "$@"
fi

if [[ -x "/usr/local/bin/zoth-desktop-pet" && -f "/opt/zoth-desktop-pet/main.js" ]]; then
    exec /usr/local/bin/zoth-desktop-pet "$@"
elif [[ -x "/usr/local/bin/zoth-desktop-hud" ]]; then
    exec /usr/local/bin/zoth-desktop-hud "$@"
else
    echo "[!] Desktop Pet HUD not found." >&2
    exit 1
fi
