#!/usr/bin/env bash
# ==============================================================================
#  Zoth Pet HUD & Desktop Pet Companion Launcher
# ==============================================================================
set -euo pipefail

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
    echo "Usage: zoth-pet-hud [--pet lycan|kitsune|draco|workbot|azoth] [--hud]"
    exit 0
fi

if [[ "${1:-}" == "--hud" ]]; then
    shift
    exec /usr/local/bin/zoth-desktop-hud "$@"
fi

if [[ -x "/usr/local/bin/zoth-desktop-pet" && -f "/opt/zoth-desktop-pet/main.js" ]]; then
    exec /usr/local/bin/zoth-desktop-pet "$@"
elif [[ -x "/usr/local/bin/zoth-desktop-hud" ]]; then
    exec /usr/local/bin/zoth-desktop-hud "$@"
else
    echo "[!] Desktop Pet HUD not found." >&2
    exit 1
fi
