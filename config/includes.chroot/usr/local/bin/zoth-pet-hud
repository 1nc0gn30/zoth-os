#!/usr/bin/env bash
# ==============================================================================
#  ZOTHOS DESKTOP PET HUD & MASCOT COMPANION v2.0
# ==============================================================================
set -euo pipefail

PET_DIR="/opt/zoth-desktop-pet"

# Optional: --pet NAME selects the companion before launch (used by the menu actions).
if [[ "${1:-}" == "--pet" ]]; then
    PET_ID="${2:-}"
    if [[ ! "$PET_ID" =~ ^[a-z0-9_-]{1,32}$ ]]; then
        echo "[!] Invalid pet name: '$PET_ID'" >&2
        exit 2
    fi
    mkdir -p "$HOME/.config/zothos"
    printf '{"petId":"%s"}\n' "$PET_ID" > "$HOME/.config/zothos/pet_config.json"
    shift 2
fi

# Resolve Electron binary
ELECTRON_BIN=""
for e in /usr/local/bin/electron /usr/bin/electron /opt/electron/electron "$(which electron 2>/dev/null || true)"; do
    if [[ -n "$e" && -x "$e" ]]; then
        ELECTRON_BIN="$e"
        break
    fi
done

if [[ -z "$ELECTRON_BIN" ]]; then
    echo "[!] Electron binary not found." >&2
    exit 1
fi

if [[ -z "${DISPLAY:-${WAYLAND_DISPLAY:-}}" ]]; then
    echo "[!] No graphical display environment found (DISPLAY or WAYLAND_DISPLAY)." >&2
    exit 1
fi

if [[ ! -f "$PET_DIR/main.js" ]]; then
    echo "[!] Desktop pet application files not found at $PET_DIR." >&2
    exit 1
fi

exec "$ELECTRON_BIN" \
    --no-sandbox \
    --disable-dev-shm-usage \
    --disable-gpu-sandbox \
    --enable-transparent-visuals \
    "$PET_DIR" "$@"
