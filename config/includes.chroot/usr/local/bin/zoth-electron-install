#!/usr/bin/env bash
# ==============================================================================
#  Install/refresh the shared Electron runtime in /opt/electron
#  (used by /usr/local/bin/electron -> Zoth Arsenal Provisioner, Hermetic Audio
#  Studio, Desktop Pet, Maya, ...). Downloads the pinned upstream release from
#  GitHub and verifies it against the release's SHASUMS256.txt.
#  Usage: sudo zoth-electron-install [version]      (default: pinned below)
# ==============================================================================
set -euo pipefail
VERSION="${1:-${ZOTHOS_ELECTRON_VERSION:-44.4.5}}"
DEST="/opt/electron"
ARCH="x64"
case "$(uname -m)" in aarch64|arm64) ARCH="arm64" ;; esac

if [[ $EUID -ne 0 ]]; then exec sudo "$0" "$@"; fi
command -v unzip >/dev/null 2>&1 || apt-get install -y --no-install-recommends unzip
command -v curl  >/dev/null 2>&1 || apt-get install -y --no-install-recommends curl ca-certificates

base="https://github.com/electron/electron/releases/download/v${VERSION}"
zip="electron-v${VERSION}-linux-${ARCH}.zip"
tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' EXIT

echo "[*] Downloading Electron v${VERSION} (${ARCH})..."
curl -fsSL --retry 3 --connect-timeout 30 -o "$tmp/$zip" "$base/$zip"
curl -fsSL --retry 3 --connect-timeout 30 -o "$tmp/SHASUMS256.txt" "$base/SHASUMS256.txt"
echo "[*] Verifying checksum..."
( cd "$tmp" && grep " \*${zip}\$" SHASUMS256.txt | sed 's/ \*/  /' | sha256sum -c - )

rm -rf "${DEST}.new"; mkdir -p "${DEST}.new"
unzip -q "$tmp/$zip" -d "${DEST}.new"
chown -R root:root "${DEST}.new"
[[ -f "${DEST}.new/chrome-sandbox" ]] && chmod 4755 "${DEST}.new/chrome-sandbox"
rm -rf "$DEST"; mv "${DEST}.new" "$DEST"
command -v ldconfig >/dev/null 2>&1 && ldconfig || true
echo "[+] Electron $(cat "$DEST/version" 2>/dev/null) installed in $DEST"
