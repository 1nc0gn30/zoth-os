#!/usr/bin/env python3
import sys, os, json, subprocess, argparse, urllib.request, urllib.error

TOOL_ID = 'agent-egress-sentinel'
TOOL_REPO = 'agent-egress-sentinel'
TOOL_NAME = 'Agent Egress Sentinel'
TOOL_DESC = 'Autonomous zero-dependency network interceptor, TLS SNI sniffer, kinetic egress radar, and kernel quarantine.'
TOOL_VERSION = '2.5.0'
TOOL_CATEGORY = 'Security & Network'
TOOL_PORT = 8095
PROXY_PORT = 8195
REPO_DIR = os.path.expanduser('~/NullAITech/agent-egress-sentinel')
PKG_DIR = os.path.join(REPO_DIR, 'src')
SERVER_SCRIPT = os.path.join(REPO_DIR, 'server.py')
STUDIO_URL = f"http://127.0.0.1:3000/tools/{TOOL_ID}"
LOCAL_PORT_URL = f"http://127.0.0.1:{TOOL_PORT}"
PROXY_URL = f"http://127.0.0.1:{PROXY_PORT}"

def check_daemon_status():
    try:
        req = urllib.request.Request(f"{LOCAL_PORT_URL}/health", headers={"User-Agent": "ZothOS-CLI"})
        with urllib.request.urlopen(req, timeout=1.5) as resp:
            if resp.status == 200:
                data = json.loads(resp.read().decode('utf-8'))
                return True, data
    except Exception:
        pass
    return False, None

def main():
    args = sys.argv[1:]
    if '--electron' in args or (args and args[0] in ('desktop', 'electron')):
        import shutil as _sh
        rem = [a for a in args if a not in ('--electron', 'desktop', 'electron')]
        elec = _sh.which('electron') or '/usr/local/bin/electron'
        sys.exit(subprocess.run([elec, os.path.join(REPO_DIR, 'electron', 'main.cjs')] + rem, cwd=REPO_DIR).returncode)
    if '--tui' in args or (args and args[0] == 'tui'):
        rem = [a for a in args if a not in ('--tui', 'tui')]
        sys.exit(subprocess.run([f'/usr/local/bin/{TOOL_ID}-tui'] + rem).returncode)
    # Pass through subcommands to native python cli
    if args and args[0] in ('serve', 'run', 'stats', 'export', 'openapi', 'clear'):
        env = os.environ.copy()
        env['PYTHONPATH'] = PKG_DIR + os.pathsep + env.get('PYTHONPATH', '')
        res = subprocess.run([sys.executable, '-m', 'agent_egress_sentinel.cli'] + args, cwd=REPO_DIR, env=env)
        sys.exit(res.returncode)

    parser = argparse.ArgumentParser(
        prog='agent-egress-sentinel',
        description=f"{TOOL_NAME} (v{TOOL_VERSION}) — {TOOL_DESC}"
    )
    parser.add_argument('--version', action='version', version=f"{TOOL_ID} v{TOOL_VERSION}")
    parser.add_argument('--status', action='store_true', help='Check local ZothOS installation & daemon status')
    parser.add_argument('--json', action='store_true', help='Output deterministic JSON telemetry')
    parser.add_argument('--ui', action='store_true', help='Print local ZothOS workbench URL')
    parser.add_argument('--serve', action='store_true', help='Start radar server and proxy daemon')
    parser.add_argument('payload', nargs='*', help='Subcommands: serve, run, stats, export, openapi, clear')

    parsed = parser.parse_args(args)

    is_running, daemon_data = check_daemon_status()

    if parsed.serve:
        if is_running:
            print(f"Agent Egress Sentinel daemon already active on {LOCAL_PORT_URL}")
            return
        subprocess.run([sys.executable, SERVER_SCRIPT, "--web-port", str(TOOL_PORT), "--proxy-port", str(PROXY_PORT)])
        return

    info = {
        "id": TOOL_ID,
        "repo": TOOL_REPO,
        "name": TOOL_NAME,
        "version": TOOL_VERSION,
        "category": TOOL_CATEGORY,
        "installed": os.path.exists(REPO_DIR),
        "repo_path": REPO_DIR,
        "daemon_running": is_running,
        "studio_workbench_url": STUDIO_URL,
        "local_endpoint": LOCAL_PORT_URL,
        "proxy_endpoint": PROXY_URL,
        "daemon_telemetry": daemon_data,
        "license": "100% Free & Open Access (Zero Paywalls)"
    }

    if parsed.json:
        print(json.dumps(info, indent=2))
    elif parsed.ui:
        print(LOCAL_PORT_URL)
    else:
        print(f"=====================================================")
        print(f"  {TOOL_NAME} (v{TOOL_VERSION})")
        print(f"  {TOOL_DESC}")
        print(f"=====================================================")
        print(f"  Installed:       {'Yes' if info['installed'] else 'No'}")
        print(f"  Radar Server:    {LOCAL_PORT_URL} ({'Running' if is_running else 'Offline'})")
        print(f"  Proxy Tunnel:    {PROXY_URL}")
        print(f"  Studio Route:    {STUDIO_URL}")
        print(f"  License:         100% Free & Open Access (Zero Paywalls)")
        print(f"  Coffee Tip:      https://buy.stripe.com/3cIfZg27PdKo2D64Ocfw40X")
        print(f"  Solana Tip:      GG2eQbVh8ut1BK6j1A2tz7pSySdLpD38BgyEhGcxdXoK")
        print(f"-----------------------------------------------------")
        print(f"Usage:")
        print(f"  agent-egress --status")
        print(f"  agent-egress stats")
        print(f"  agent-egress run <command...>")
        print(f"  agent-egress export agent-traffic.har")
        print(f"  agent-egress --json")
        print(f"=====================================================")

if __name__ == '__main__':
    main()
