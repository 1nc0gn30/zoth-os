#!/usr/bin/env bash
# ==============================================================================
#  ZOTHOS WEB3 & SOLANA CORE STUDIO LAUNCHER
# ==============================================================================
set -euo pipefail

if [[ -n "${DISPLAY:-}" ]] && command -v electron >/dev/null 2>&1 && [[ -f "/opt/zoth-web3-app/main.js" ]]; then
    exec electron --no-sandbox --disable-dev-shm-usage --disable-gpu-sandbox /opt/zoth-web3-app "$@"
elif [[ -n "${ZOTHOS_SRC:-}" && -d "${ZOTHOS_SRC}/config/includes.chroot/opt/zoth-web3-app" ]]; then
    exec electron --no-sandbox --disable-dev-shm-usage --disable-gpu-sandbox "${ZOTHOS_SRC}/config/includes.chroot/opt/zoth-web3-app" "$@"
else
    exec konsole -qwindowtitle "Web3 Sovereign Engineering" -e zoth-tool-nexus --domain 7
fi
