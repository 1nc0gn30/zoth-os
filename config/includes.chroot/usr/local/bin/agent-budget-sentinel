#!/usr/bin/env python3
"""Agent Budget Sentinel v2.6.0 — Canonical ZothOS CLI Wrapper.
Forwards all commands (including live --status, --json, serve, run, mcp, trip, reset, set-budget)
directly to agent_budget_sentinel.cli, with helpers for --tui, --electron, and --studio.
"""
import os
import shutil
import subprocess
import sys

TOOL_ID = "agent-budget-sentinel"
TOOL_VERSION = "2.6.0"
TOOL_PORT = 8110
PROXY_PORT = 8111
REPO_DIR = os.path.expanduser("~/NullAITech/agent-budget-sentinel")
if not os.path.isdir(REPO_DIR) and os.path.isdir("/opt/agent-budget-sentinel"):
    REPO_DIR = "/opt/agent-budget-sentinel"
PKG_DIR = os.path.join(REPO_DIR, "src")
STUDIO_URL = f"http://127.0.0.1:3000/tools/{TOOL_ID}"
LOCAL_PORT_URL = f"http://127.0.0.1:{TOOL_PORT}"


def main() -> None:
    args = sys.argv[1:]

    if "--electron" in args or (args and args[0] in ("desktop", "electron")):
        rem = [a for a in args if a not in ("--electron", "desktop", "electron")]
        elec = shutil.which("electron") or "/usr/local/bin/electron"
        sys.exit(subprocess.run([elec, os.path.join(REPO_DIR, "electron", "main.cjs")] + rem, cwd=REPO_DIR).returncode)

    if "--tui" in args or (args and args[0] == "tui"):
        rem = [a for a in args if a not in ("--tui", "tui")]
        tui_bin = shutil.which(f"{TOOL_ID}-tui") or f"/usr/local/bin/{TOOL_ID}-tui"
        sys.exit(subprocess.run([tui_bin] + rem).returncode)

    if args and args[0] in ("--studio", "--ui"):
        url = STUDIO_URL if args[0] == "--studio" else LOCAL_PORT_URL
        opener = shutil.which("xdg-open")
        if opener:
            subprocess.Popen([opener, url], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        print(url)
        sys.exit(0)

    env = os.environ.copy()
    env["PYTHONPATH"] = f"{PKG_DIR}:{env['PYTHONPATH']}" if env.get("PYTHONPATH") else PKG_DIR
    res = subprocess.run([sys.executable, "-m", "agent_budget_sentinel.cli"] + args, env=env)
    sys.exit(res.returncode)


if __name__ == "__main__":
    main()
