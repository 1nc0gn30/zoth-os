#!/usr/bin/env python3
"""Anderson Security Sentinel (v2.6.0) — Unified ZothOS & Local Workstation CLI."""

from __future__ import annotations

import argparse
import json
import os
import shutil
import subprocess
import sys
import urllib.error
import urllib.request
from pathlib import Path

TOOL_ID = "anderson-security-sentinel"
TOOL_REPO = "anderson-security-sentinel"
TOOL_NAME = "Anderson Security Sentinel"
TOOL_DESC = "Autonomous biometric perimeter defense, 802.11 RF tomography, USB/BLE tripwire, and SHA-256 forensic dossier sentinel."
TOOL_VERSION = "2.6.0"
TOOL_CATEGORY = "Security & OpSec"
TOOL_PORT = int(os.environ.get("ANDERSON_PORT", "8103"))
PANEL_PORT = 8150
STUDIO_URL = f"http://127.0.0.1:3000/tools/{TOOL_ID}"
LOCAL_PORT_URL = f"http://127.0.0.1:{TOOL_PORT}"
PANEL_URL = f"http://127.0.0.1:{PANEL_PORT}"
VENV_PYTHON = "/opt/zothos-ai-env/bin/python3"


def resolve_repo_dir() -> str:
    """Probe /opt/anderson-security-sentinel first, then ~/NullAITech/anderson-security-sentinel, then relative."""
    candidates = [
        os.environ.get("ANDERSON_REPO_DIR", ""),
        "/opt/anderson-security-sentinel",
        os.path.expanduser("~/NullAITech/anderson-security-sentinel"),
        str(Path(__file__).resolve().parent.parent),
    ]
    for cand in candidates:
        if cand and os.path.isfile(os.path.join(cand, "server.py")):
            return cand
    return "/opt/anderson-security-sentinel"


def resolve_python() -> str:
    return VENV_PYTHON if os.path.isfile(VENV_PYTHON) else sys.executable


def _auth_headers(extra: dict | None = None) -> dict:
    headers = {
        "Origin": f"http://127.0.0.1:{TOOL_PORT}",
        "X-Sentinel-Action": "1",
    }
    token = os.environ.get("ANDERSON_API_TOKEN", "").strip()
    if token:
        headers["Authorization"] = f"Bearer {token}"
    if extra:
        headers.update(extra)
    return headers


def check_daemon() -> dict | None:
    try:
        req = urllib.request.Request(f"http://127.0.0.1:{TOOL_PORT}/health", headers=_auth_headers())
        with urllib.request.urlopen(req, timeout=1.5) as resp:
            if resp.status == 200:
                return json.loads(resp.read().decode("utf-8"))
    except Exception:
        pass
    return None


def api_get(endpoint: str) -> dict:
    try:
        req = urllib.request.Request(f"http://127.0.0.1:{TOOL_PORT}{endpoint}", headers=_auth_headers())
        with urllib.request.urlopen(req, timeout=3.0) as resp:
            return json.loads(resp.read().decode("utf-8"))
    except Exception as exc:
        return {"error": str(exc)}


def api_post(endpoint: str, data: dict | None = None) -> dict:
    try:
        req_data = json.dumps(data).encode("utf-8") if data is not None else b"{}"
        req = urllib.request.Request(
            f"http://127.0.0.1:{TOOL_PORT}{endpoint}",
            data=req_data,
            headers=_auth_headers({"Content-Type": "application/json"}),
            method="POST",
        )
        with urllib.request.urlopen(req, timeout=3.0) as resp:
            return json.loads(resp.read().decode("utf-8"))
    except Exception as exc:
        return {"error": str(exc)}


def main() -> int:
    repo_dir = resolve_repo_dir()
    control_cli = os.path.join(repo_dir, "control", "sentinel")
    py_bin = resolve_python()
    args = sys.argv[1:]

    if "--electron" in args or (args and args[0] in ("desktop", "electron")):
        rem = [a for a in args if a not in ("--electron", "desktop", "electron")]
        elec = shutil.which("electron") or "/usr/local/bin/electron"
        return subprocess.run([elec, os.path.join(repo_dir, "electron", "main.cjs")] + rem, cwd=repo_dir).returncode

    if "--tui" in args or (args and args[0] == "tui"):
        rem = [a for a in args if a not in ("--tui", "tui")]
        tui_bin = shutil.which(f"{TOOL_ID}-tui") or os.path.join(repo_dir, "bin", f"{TOOL_ID}-tui")
        return subprocess.run([tui_bin] + rem).returncode

    if args and args[0] == "serve":
        rem = args[1:]
        cmd = [py_bin, os.path.join(repo_dir, "server.py")]
        if "--host" not in rem:
            cmd += ["--host", "127.0.0.1"]
        if "--port" not in rem and "-p" not in rem:
            cmd += ["--port", str(TOOL_PORT)]
        cmd += rem
        return subprocess.run(cmd, cwd=repo_dir).returncode

    if args and args[0] == "mcp":
        mcp_script = os.path.join(repo_dir, "engine", "mcp_server.py")
        return subprocess.run([py_bin, mcp_script], cwd=repo_dir).returncode

    parser = argparse.ArgumentParser(
        prog=TOOL_ID,
        description=f"{TOOL_NAME} (v{TOOL_VERSION}) — {TOOL_DESC}",
    )
    parser.add_argument("--version", "-v", action="version", version=f"{TOOL_ID} v{TOOL_VERSION}")
    parser.add_argument("--status", action="store_true", help="Check local daemon & panel status")
    parser.add_argument("--json", action="store_true", help="Output deterministic JSON telemetry")
    parser.add_argument("--ui", action="store_true", help="Print local Zoth Studio workbench URL")
    parser.add_argument("--arm", action="store_true", help="Arm the biometric security perimeter")
    parser.add_argument("--disarm", action="store_true", help="Disarm the biometric security perimeter")
    parser.add_argument("--lockdown", action="store_true", help="Trigger emergency workstation lockdown")
    parser.add_argument(
        "subcommand",
        nargs="?",
        choices=[
            "serve", "status", "xray", "dossier", "mcp", "desktop", "tui",
            "on", "off", "restart", "arm", "disarm", "lockdown",
        ],
        help="Tactical command (serve, status, xray, dossier, mcp, desktop, tui, arm, disarm, lockdown, on, off, restart)",
    )
    parsed, _ = parser.parse_known_args(args)

    if parsed.subcommand in ("on", "off", "restart"):
        if os.path.isfile(control_cli):
            return subprocess.run([control_cli, parsed.subcommand], text=True).returncode
        print(json.dumps({"error": f"control script not found at {control_cli}"}))
        return 1

    daemon_status = check_daemon()

    if parsed.arm or parsed.subcommand == "arm":
        res = api_post("/api/arm")
        print(json.dumps(res, indent=2) if parsed.json else f"✦ Anderson Sentinel: Perimeter ARMED -> {json.dumps(res)}")
        return 0

    if parsed.disarm or parsed.subcommand == "disarm":
        res = api_post("/api/disarm")
        print(json.dumps(res, indent=2) if parsed.json else f"✦ Anderson Sentinel: Perimeter DISARMED -> {json.dumps(res)}")
        return 0

    if parsed.subcommand == "xray":
        res = api_get("/api/wifi_xray")
        if "error" in res:
            print(json.dumps({"daemon_online": False, "error": res["error"]}, indent=2))
            return 1
        bp = res.get("building_perimeter") if isinstance(res.get("building_perimeter"), dict) else {}
        summary = {
            "active": bool(res.get("active", True)),
            "ambient_node_count": len(res.get("nodes", [])),
            "disturbance_index": res.get("disturbance_index", 0.0),
            "room_bounds": res.get("room_bounds", {}),
            "tomography_grid": bool(res.get("tomography_grid")),
            "building_perimeter": {
                "footprint_sqm": bp.get("footprint_sqm"),
                "building_width_m": bp.get("building_width_m"),
                "building_length_m": bp.get("building_length_m"),
                "estimated_partitions": bp.get("estimated_partitions"),
            },
            "cameras_detected": len(res.get("cameras", [])),
        }
        print(json.dumps(summary, indent=2))
        return 0

    if parsed.subcommand == "dossier":
        res = api_get("/api/export_dossier")
        if "error" in res:
            print(json.dumps({"daemon_online": False, "error": res["error"]}, indent=2))
            return 1
        summary = {
            "dossier_id": res.get("dossier_id"),
            "generated_at": res.get("generated_at"),
            "sentinel_version": res.get("sentinel_version"),
            "system_state": res.get("system_state"),
            "chain_of_custody": res.get("chain_of_custody"),
            "hardware_security": res.get("hardware_security"),
            "cryptographic_seal": res.get("cryptographic_seal"),
        }
        print(json.dumps(summary, indent=2))
        return 0

    if parsed.lockdown or parsed.subcommand == "lockdown":
        res = api_post("/api/lockdown")
        print(json.dumps(res, indent=2) if parsed.json else f"✦ Anderson Sentinel: Workstation LOCKDOWN -> {json.dumps(res)}")
        return 0

    info = {
        "id": TOOL_ID,
        "repo": TOOL_REPO,
        "name": TOOL_NAME,
        "version": TOOL_VERSION,
        "category": TOOL_CATEGORY,
        "installed": os.path.isdir(repo_dir),
        "repo_path": repo_dir,
        "native_cli": control_cli,
        "studio_workbench_url": STUDIO_URL,
        "local_endpoint": LOCAL_PORT_URL,
        "control_panel_url": PANEL_URL,
        "mcp_command": f"{TOOL_ID} mcp",
        "daemon_online": daemon_status is not None,
        "daemon_info": daemon_status,
        "license": "100% Free & Open Access (Zero Paywalls)",
        "support": {
            "stripe_buy_coffee": "https://buy.stripe.com/3cIfZg27PdKo2D64Ocfw40X",
            "solana_wallet": "GG2eQbVh8ut1BK6j1A2tz7pSySdLpD38BgyEhGcxdXoK",
        },
        "status": "ONLINE" if daemon_status else "READY",
    }

    if parsed.json:
        print(json.dumps(info, indent=2))
        return 0

    if parsed.ui:
        print(STUDIO_URL)
        return 0

    if parsed.status or parsed.subcommand == "status":
        state = "ONLINE" if daemon_status else "OFFLINE"
        print(f"✦ {TOOL_NAME} v{TOOL_VERSION} Daemon Status: {state} (:{TOOL_PORT}) | Control Panel: {PANEL_URL}")
        if daemon_status:
            print(f"  Armed State    : {daemon_status.get('armed')}")
            print(f"  Security State : {daemon_status.get('security_status')}")
            print(f"  Enrolled Faces : {daemon_status.get('enrolled_count')}")
            print(f"  Camera Active  : {daemon_status.get('camera_active')}")
        return 0

    print(f"✦ {TOOL_NAME} (v{TOOL_VERSION}) — [{TOOL_CATEGORY}]")
    print(f"  Install Path  : {repo_dir}")
    print(f"  Workbench     : {STUDIO_URL}")
    print(f"  Tactical Port : {LOCAL_PORT_URL}")
    print(f"  Control Panel : {PANEL_URL}")
    print(f"  MCP Server    : {TOOL_ID} mcp (4 JSON-RPC 2.0 tools)")
    print(f"  Daemon        : {'ONLINE' if daemon_status else 'OFFLINE'}")
    print("  Access        : 100% Free & Open Access (☕ https://buy.stripe.com/3cIfZg27PdKo2D64Ocfw40X)")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
