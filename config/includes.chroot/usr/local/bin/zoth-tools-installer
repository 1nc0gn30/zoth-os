#!/usr/bin/env bash
# ==============================================================================
#  ZOTH ARSENAL PROVISIONER & TOOL NEXUS — Electron GUI
#  Unified Sovereign Tool Provisioner (Kali, Parrot, Dev, AI, Web3 Bundles)
# ==============================================================================
set -euo pipefail

APP_DIR="/opt/zoth-nexus-app"

fail() {
    echo "[-] $1" >&2
    notify-send -u critical "Zoth Arsenal Provisioner" "$1" 2>/dev/null || true
    exit 1
}

if [[ -z "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]]; then
    echo "[-] No graphical display detected; redirecting to sovereign CLI..." >&2
    exec /usr/local/bin/zoth-tool-nexus --install-all
fi

[[ -d "$APP_DIR" ]] || fail "$APP_DIR not found."
[[ -x /usr/local/bin/electron ]] || fail "Electron runtime not installed (/usr/local/bin/electron)."

# Launch into Curated Bundles view
exec /usr/local/bin/electron "$APP_DIR" --bundle "$@"
