#!/usr/bin/env bash
# ==============================================================================
#  ZOTH RECOMMENDED TOOLS INSTALLER — Electron GUI
#  One-click install of curated Kali / Parrot / Zoth extra tool bundles.
# ==============================================================================
set -euo pipefail

APP="zoth-tools-installer"
APP_DIR="/opt/$APP"

fail() {
    echo "[-] $1" >&2
    notify-send -u critical "Zoth Arsenal Provisioner" "$1" 2>/dev/null || true
    exit 1
}

if [[ -z "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]]; then
    echo "[-] No DISPLAY; the tools installer needs a desktop session." >&2
    echo "    Run from the terminal instead: ape install <bundle|tool>  or  zoth install <pkg>" >&2
    exit 1
fi

[[ -d "$APP_DIR" ]] || fail "$APP_DIR not found."
# /usr/local/bin/electron wraps /opt/electron/electron and adds the
# sandbox + GPU-compatibility flags (software rendering on VMs).
[[ -x /opt/electron/electron ]] || fail "Electron runtime not installed (/opt/electron/electron)."

exec /usr/local/bin/electron "$APP_DIR" "$@"
