#!/usr/bin/env python3
"""
⚡ ZothOS AI Telemetry Emitter CLI
Sends real-time telemetry packets to the Zoth Math Pillar HUD via HTTP or UDP.
Usage:
    zoth-telemetry --agent Antigravity --phase REASONING --tok-sec 85 --entropy 0.14 --note "Planning step 3"
"""

import sys
import json
import argparse
import urllib.request

def main():
    parser = argparse.ArgumentParser(description="ZothOS Math Pillar Telemetry Emitter")
    parser.add_argument("--agent", default="CustomAgent", help="Agent or model name")
    parser.add_argument("--model", default=None, help="Underlying model name")
    parser.add_argument("--phase", default="EXEC", help="Operational phase (PREFILL, REASONING, TOOL_DISPATCH, SYNTHESIS, IDLE)")
    parser.add_argument("--tok-sec", type=float, default=None, help="Tokens per second")
    parser.add_argument("--context-used", type=int, default=None, help="Context tokens used")
    parser.add_argument("--context-max", type=int, default=None, help="Maximum context window")
    parser.add_argument("--entropy", type=float, default=None, help="Reasoning dispersion / entropy (0.0 to 1.0)")
    parser.add_argument("--confidence", type=float, default=None, help="Confidence probability (0.0 to 1.0)")
    parser.add_argument("--latency", type=int, default=None, help="Execution latency in ms")
    parser.add_argument("--tool", default=None, help="Tool invoked")
    parser.add_argument("--note", default=None, help="Mathematical / reasoning explanation note")
    parser.add_argument("--host", default="127.0.0.1", help="Telemetry host")
    parser.add_argument("--port", type=int, default=9995, help="Telemetry port")

    args = parser.parse_args()

    payload = {
        "agent": args.agent,
        "phase": args.phase
    }
    if args.model: payload["model"] = args.model
    if args.tok_sec is not None: payload["tokensSec"] = args.tok_sec
    if args.context_used is not None: payload["contextUsed"] = args.context_used
    if args.context_max is not None: payload["contextMax"] = args.context_max
    if args.entropy is not None: payload["entropy"] = args.entropy
    if args.confidence is not None: payload["confidence"] = args.confidence
    if args.latency is not None: payload["latencyMs"] = args.latency
    if args.tool: payload["tool"] = args.tool
    if args.note: payload["reasoning"] = args.note

    data = json.dumps(payload).encode('utf-8')
    req = urllib.request.Request(
        f"http://{args.host}:{args.port}/telemetry",
        data=data,
        headers={"Content-Type": "application/json"},
        method="POST"
    )

    try:
        with urllib.request.urlopen(req, timeout=1.0) as resp:
            if resp.status == 200:
                print(f"[✓] Telemetry dispatched to Math Pillar ({args.agent} / {args.phase})")
                return 0
    except Exception as e:
        # Silently exit or print debug if Math Pillar isn't currently open
        if "--verbose" in sys.argv:
            print(f"[!] Math Pillar not reachable: {e}", file=sys.stderr)
        return 0

if __name__ == "__main__":
    sys.exit(main())
