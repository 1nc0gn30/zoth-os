#!/usr/bin/env bash
# ==============================================================================
#  🜂 ZOTHOS REALITY SWITCHER CLI v2.0 🜄
# ==============================================================================
#  Switches between the 4 operating realities:
#    1. gold   - Azoth Sovereign Sanctum (Gold Master, Sanctum Chime)
#    2. matrix - Hermetic Matrix (Digital Rain, Phosphor Emerald, Cyber Chirp)
#    3. ghost  - NullAI Ghostmode (Spectral Cyan & Torified Amnesic, Vapor Cue)
#    4. win11  - Incognito Chameleon (Windows 11 Fluent Disguise, Fluent Cue)
# ==============================================================================

set -euo pipefail

STATE_FILE="$HOME/.config/zothos/reality.state"
mkdir -p "$HOME/.config/zothos"

GOLD="\033[38;2;255;215;0m"
CYAN="\033[38;2;0;229;255m"
GREEN="\033[38;2;0;255;157m"
YELLOW="\033[38;2;255;204;0m"
RED="\033[38;2;255;51;85m"
GRAY="\033[38;2;120;140;160m"
BOLD="\033[1m"
RESET="\033[0m"

WP_DIR="/usr/share/backgrounds/zothos"
if [[ ! -d "$WP_DIR" && -d "${ZOTH_HOME}/zothos/config/includes.chroot/usr/share/backgrounds/zothos" ]]; then
    WP_DIR="${ZOTH_HOME}/zothos/config/includes.chroot/usr/share/backgrounds/zothos"
fi

SOUND_DIR="/usr/share/sounds/zothos"
if [[ ! -d "$SOUND_DIR" && -d "${ZOTH_HOME}/zothos/config/includes.chroot/usr/share/sounds/zothos" ]]; then
    SOUND_DIR="${ZOTH_HOME}/zothos/config/includes.chroot/usr/share/sounds/zothos"
fi

apply_wallpaper() {
    local wp="$1"
    if [[ ! -f "$wp" ]]; then
        return 0
    fi

    # KDE Plasma CLI
    if command -v plasma-apply-wallpaperimage >/dev/null 2>&1; then
        plasma-apply-wallpaperimage "$wp" 2>/dev/null || true
    fi

    # KDE Plasma Live DBus Script
    if command -v qdbus >/dev/null 2>&1; then
        qdbus org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.evaluateScript "
        var allDesktops = desktops();
        for (var i = 0; i < allDesktops.length; i++) {
            var d = allDesktops[i];
            d.wallpaperPlugin = 'org.kde.image';
            d.currentConfigGroup = ['Wallpaper', 'org.kde.image', 'General'];
            d.writeConfig('Image', 'file://${wp}');
            if (typeof d.reloadConfig === 'function') {
                d.reloadConfig();
            }
        }
        " 2>/dev/null || true
    fi

    # XFCE4
    if command -v xfconf-query >/dev/null 2>&1; then
        for prop in $(xfconf-query -c xfce4-desktop -l 2>/dev/null | grep "last-image" || true); do
            xfconf-query -c xfce4-desktop -p "$prop" -s "$wp" 2>/dev/null || true
        done
    fi

    # Feh / X11 fallback
    if command -v feh >/dev/null 2>&1 && [[ -n "${DISPLAY:-}" ]]; then
        feh --bg-fill "$wp" 2>/dev/null || true
    fi
}

play_cue() {
    local cue="$1"
    if [[ -f "$cue" ]] && command -v paplay >/dev/null 2>&1; then
        paplay "$cue" 2>/dev/null &
    elif [[ -f "$cue" ]] && command -v aplay >/dev/null 2>&1; then
        aplay -q "$cue" 2>/dev/null &
    fi
}

MODE="${1:-}"

if [[ -z "$MODE" ]]; then
    echo -e "${GOLD}${BOLD}ZOTHOS REALITY TRANSMUTATION${RESET}"
    echo -e "Current Reality: ${CYAN}$(cat "$STATE_FILE" 2>/dev/null || echo "gold")${RESET}"
    echo ""
    echo -e "Usage: ${BOLD}zoth-mode <gold|matrix|ghost|win11>${RESET}"
    echo ""
    echo -e "  ${GOLD}gold${RESET}   - 🜂 Azoth Sovereign Sanctum (Default)"
    echo -e "  ${GREEN}matrix${RESET} - 🜄 Hermetic Matrix & Phosphor Emerald"
    echo -e "  ${CYAN}ghost${RESET}  - 🜁 NullAI Ghostmode & Amnesic Tor"
    echo -e "  ${YELLOW}win11${RESET}  - 🜃 Incognito Windows 11 Chameleon"
    exit 0
fi

case "$MODE" in
    gold|sanctum|default)
        echo -e "${GOLD}[🜂] Shifting to Azoth Sovereign Sanctum Reality...${RESET}"
        apply_wallpaper "$WP_DIR/zoth-gold-master.jpg"
        play_cue "$SOUND_DIR/gold-sanctum.wav"
        echo "gold" > "$STATE_FILE"
        echo -e "${GOLD}[✓] Reality: 24K Alchemical Gold Sanctum Engaged.${RESET}"
        ;;
    matrix|hacker|green)
        echo -e "${GREEN}[🜄] Shifting to Hermetic Matrix Phosphor Rain Reality...${RESET}"
        apply_wallpaper "$WP_DIR/hermetic-matrix.png"
        play_cue "$SOUND_DIR/matrix-chirp.wav"
        echo "matrix" > "$STATE_FILE"
        echo -e "${GREEN}[✓] Reality: Hermetic Matrix Engaged.${RESET}"
        ;;
    ghost|stealth|amnesic)
        echo -e "${CYAN}[🜁] Shifting to NullAI Ghostmode Amnesic Reality...${RESET}"
        apply_wallpaper "$WP_DIR/ghostmode-nullai.png"
        play_cue "$SOUND_DIR/ghost-vapor.wav"
        echo "ghost" > "$STATE_FILE"
        echo -e "${CYAN}[✓] Reality: NullAI Ghostmode Engaged.${RESET}"
        ;;
    win11|windows|undercover)
        echo -e "${YELLOW}[🜃] Shifting to Windows 11 Incognito Chameleon Reality...${RESET}"
        apply_wallpaper "$WP_DIR/win11-bloom.jpg"
        play_cue "$SOUND_DIR/win11-fluent.wav"
        echo "win11" > "$STATE_FILE"
        echo -e "${YELLOW}[✓] Reality: Windows 11 Chameleon Engaged.${RESET}"
        ;;
    *)
        echo -e "${RED}[!] Unknown reality mode: $MODE${RESET}"
        echo -e "Supported modes: gold, matrix, ghost, win11"
        exit 1
        ;;
esac
