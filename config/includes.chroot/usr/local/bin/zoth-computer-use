#!/usr/bin/env python3
# ==============================================================================
#  zoth-computer-use — Autonomous Multi-Agent Desktop Action Dispatcher
#  Supports direct manual commands, high-level natural language prompts with
#  UI-TARS or Claude Computer Use, and preset replay with vision verification.
# ==============================================================================

import sys
import os
import json
import urllib.request
import urllib.error

API_URL = "http://127.0.0.1:9990"

def usage():
    print("""Usage: zoth-computer-use <command> [arguments]

Low-Level Actions:
  move <x> <y> [agent]          Move agent cursor to coordinates
  click [left|right] [x] [y]    Click at coordinates or current position
  type <text>                   Type keyboard string
  key <key_combination>         Send key combination (e.g. Return, ctrl+c, super)
  screenshot [path]             Take full screen capture
  status                        Check daemon health & active cursors

High-Level Autonomous VLM Actions:
  prompt "<instruction>" [agent] [model]
                                Run autonomous VLM vision-action step
                                Model options: ui-tars (default) | claude

Workflow Presets:
  run <preset_name> [agent]     Run recorded preset with pre-analysis protection

Examples:
  zoth-computer-use move 960 540 1nc0gn30
  zoth-computer-use click left 1400 420 1nc0gn30
  zoth-computer-use type "cargo test --release"
  zoth-computer-use key Return
  zoth-computer-use prompt "Click the terminal new tab button" 1nc0gn30
""")
    sys.exit(1)

def req(endpoint, data=None, method="GET"):
    url = f"{API_URL}{endpoint}"
    try:
        body = json.dumps(data).encode("utf-8") if data else None
        headers = {"Content-Type": "application/json"} if data else {}
        r = urllib.request.Request(url, data=body, headers=headers, method=method)
        with urllib.request.urlopen(r, timeout=10) as resp:
            return json.loads(resp.read().decode("utf-8"))
    except Exception as e:
        print(f"Error reaching zoth-cursorz daemon on {API_URL}: {e}")
        print("Tip: Start the daemon with 'zoth-cursorz daemon'.")
        sys.exit(1)

def main():
    if len(sys.argv) < 2:
        usage()

    cmd = sys.argv[1]

    if cmd == "status":
        print(json.dumps(req("/api/health"), indent=2))

    elif cmd == "screenshot":
        path = sys.argv[2] if len(sys.argv) > 2 else "/tmp/zoth_screen.png"
        res = req("/api/screenshot")
        print(f"Screenshot saved: {res.get('path', path)}")

    elif cmd == "move":
        if len(sys.argv) < 4:
            usage()
        x = float(sys.argv[2])
        y = float(sys.argv[3])
        agent = sys.argv[4] if len(sys.argv) > 4 else "1nc0gn30"
        res = req("/api/action", {"action": "move", "x": x, "y": y, "agent_id": agent}, method="POST")
        print(f"Dispatched move for {agent} -> ({x}, {y})")

    elif cmd == "click":
        btn = sys.argv[2] if len(sys.argv) > 2 else "left"
        x = float(sys.argv[3]) if len(sys.argv) > 3 and sys.argv[3].isdigit() else None
        y = float(sys.argv[4]) if len(sys.argv) > 4 and sys.argv[4].isdigit() else None
        agent = sys.argv[5] if len(sys.argv) > 5 else "1nc0gn30"
        payload = {"action": "click", "button": btn, "agent_id": agent}
        if x is not None and y is not None:
            payload["x"] = x
            payload["y"] = y
        res = req("/api/action", payload, method="POST")
        print(f"Dispatched click ({btn}) for {agent}")

    elif cmd == "type":
        if len(sys.argv) < 3:
            usage()
        text = " ".join(sys.argv[2:])
        agent = "1nc0gn30"
        res = req("/api/action", {"action": "type", "text": text, "agent_id": agent}, method="POST")
        print(f"Dispatched typing: '{text}'")

    elif cmd == "key":
        if len(sys.argv) < 3:
            usage()
        key = sys.argv[2]
        res = req("/api/action", {"action": "key", "key": key}, method="POST")
        print(f"Dispatched key: '{key}'")

    elif cmd == "run":
        if len(sys.argv) < 3:
            usage()
        preset = sys.argv[2]
        agent = sys.argv[3] if len(sys.argv) > 3 else "1nc0gn30"
        from training.preset_runner import PresetRunner
        runner = PresetRunner(preset_name=preset, agent_id=agent, strict_layout_check=True)
        runner.run()

    elif cmd == "prompt":
        if len(sys.argv) < 3:
            usage()
        instruction = sys.argv[2]
        agent = sys.argv[3] if len(sys.argv) > 3 else "1nc0gn30"
        model = sys.argv[4] if len(sys.argv) > 4 else "ui-tars"

        # Capture live screen
        shot_res = req("/api/screenshot")
        shot_path = shot_res.get("path", "/tmp/zoth_screen.png")

        print(f"✦ [VLM Agent] Evaluating '{instruction}' with model '{model}'...")

        if model == "claude":
            from adapters.claude_adapter import ClaudeComputerUseAdapter
            adapter = ClaudeComputerUseAdapter()
            step = adapter.execute_step(instruction, shot_path)
        else:
            from adapters.ui_tars_adapter import UITarsAdapter
            adapter = UITarsAdapter()
            step = adapter.predict_action(shot_path, instruction)

        print(f"  Thought: {step.get('thought')}")
        print(f"  Target: ({step.get('x')}, {step.get('y')}) | Action: {step.get('action')}")

        # Execute on host
        req("/api/action", {
            "action": step.get("action", "click"),
            "x": step.get("x", 960),
            "y": step.get("y", 540),
            "text": step.get("text", ""),
            "agent_id": agent
        }, method="POST")

    else:
        usage()

if __name__ == "__main__":
    main()
