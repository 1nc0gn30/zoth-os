#!/usr/bin/env bash
# ==============================================================================
# Etsy POD Forge CLI Wrapper
# Engineered by Neal Frazier Tech (@1nc0gn30) • NullAI Platform
# ==============================================================================
set -e

if [ -f /etc/zothos/paths.sh ]; then
  # shellcheck disable=SC1091
  . /etc/zothos/paths.sh
fi
: "${ZOTH_USER:=zoth}"
: "${AZOTH_USER:=azoth}"
: "${ZOTH_HOME:=/home/${ZOTH_USER}}"
: "${AZOTH_HOME:=/home/${AZOTH_USER}}"
: "${ZOTH_ACTIVE_HOME:=${HOME:-${ZOTH_HOME}}}"
: "${ZOTH_SRC_ROOT:=${ZOTH_ACTIVE_HOME}/NullAITech}"

PRIMARY_BIN="${ZOTH_SRC_ROOT}/etsy-pod-forge/bin/etsy-pod-forge"
REPO_DIR="${ZOTH_SRC_ROOT}/etsy-pod-forge"

if [[ -x "$PRIMARY_BIN" ]]; then
    exec "$PRIMARY_BIN" "$@"
elif [[ -d "$REPO_DIR/src/etsy_pod_forge" ]]; then
    export PYTHONPATH="$REPO_DIR/src:${PYTHONPATH:-}"
    exec python3 -m etsy_pod_forge.cli "$@"
else
    echo "Error: etsy-pod-forge not found in $PRIMARY_BIN or $REPO_DIR" >&2
    exit 1
fi
