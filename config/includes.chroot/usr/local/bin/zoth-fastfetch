#!/usr/bin/env bash
# ==============================================================================
#  🜂 ZOTHOS FASTFETCH HUD v5.0 — Sovereign Alchemical Telemetry Deck 🜄
#  Engineered by NullAI Tech (https://nullai.tech · @NullAITech)
#  Reactive reality prompt, git status telemetry, exit code tracking, alchemical glyphs
# ==============================================================================

set -euo pipefail

# ── Mode-aware Color Palette ────────────────────────────────────────────────
get_mode() {
    local mode="matrix"
    if [[ -f "$HOME/.config/zothos/current_mode" ]]; then
        mode=$(cat "$HOME/.config/zothos/current_mode" 2>/dev/null || echo "matrix")
    fi
    echo "$mode"
}

MODE_NAME=$(get_mode)

case "$MODE_NAME" in
    matrix)
        C_BANNER1="38;2;0;255;128"      # Bright Emerald
        C_BANNER2="38;2;16;185;129"     # Emerald Green
        C_BANNER3="38;2;5;150;105"      # Deep Emerald
        C_PRIMARY="38;5;48"             # Emerald
        C_ACCENT="38;5;214"            # Radiant Gold
        C_CYAN="38;5;51"               # Cyan
        C_DIM="38;5;241"               # Slate Gray
        C_TEXT="38;5;255"              # Crisp White
        MODE_DISPLAY="\e[1;${C_PRIMARY}mHermetic Matrix \e[0;${C_CYAN}m[Emerald Phosphor Glass]\e[0m"
        ;;
    ghost)
        C_BANNER1="38;2;244;63;94"      # Rose / Neon Crimson
        C_BANNER2="38;2;225;29;72"      # Deep Crimson
        C_BANNER3="38;2;190;18;60"      # Dark Blood Crimson
        C_PRIMARY="38;5;196"            # Neon Crimson
        C_ACCENT="38;5;177"            # Mystic Violet
        C_CYAN="38;5;135"              # Ghost Purple
        C_DIM="38;5;240"               # Dark Charcoal
        C_TEXT="38;5;255"              # Crisp White
        MODE_DISPLAY="\e[1;${C_PRIMARY}mGhostmode NullAI \e[0;${C_ACCENT}m[Tor Cloaked · Amnesic]\e[0m"
        ;;
    gold)
        C_BANNER1="38;2;255;215;0"      # Bright Solar Gold
        C_BANNER2="38;2;245;158;11"     # Amber Gold
        C_BANNER3="38;2;217;119;6"      # Deep Burnished Gold
        C_PRIMARY="38;5;220"            # Bright Gold
        C_ACCENT="38;5;214"            # Amber Gold
        C_CYAN="38;5;51"               # Cyan Glow
        C_DIM="38;5;241"               # Warm Slate
        C_TEXT="38;5;255"              # Crisp White
        MODE_DISPLAY="\e[1;${C_PRIMARY}mAzoth Gold Sanctum \e[0;${C_ACCENT}m[Radiant Solar Alchemy]\e[0m"
        ;;
    incognito|win11)
        C_BANNER1="38;2;56;189;248"     # Light Azure
        C_BANNER2="38;2;0;120;212"      # Windows Blue
        C_BANNER3="38;2;30;58;138"      # Deep Blue
        C_PRIMARY="38;5;39"             # Windows 11 Fluent Blue
        C_ACCENT="38;5;214"            # Gold
        C_CYAN="38;5;51"               # Azure Cyan
        C_DIM="38;5;242"               # Slate Gray
        C_TEXT="38;5;255"              # Crisp White
        MODE_DISPLAY="\e[1;${C_PRIMARY}mIncognito Chameleon \e[0;${C_DIM}m[Windows 11 Corporate Disguise]\e[0m"
        ;;
    *)
        C_BANNER1="38;2;255;215;0"
        C_BANNER2="38;2;245;158;11"
        C_BANNER3="38;2;217;119;6"
        C_PRIMARY="38;5;214"
        C_ACCENT="38;5;220"
        C_CYAN="38;5;51"
        C_DIM="38;5;241"
        C_TEXT="38;5;255"
        MODE_DISPLAY="\e[1;${C_PRIMARY}mHermetic Matrix \e[0;${C_CYAN}m[Emerald Phosphor Glass]\e[0m"
        ;;
esac

B1="\e[${C_BANNER1}m"
B2="\e[${C_BANNER2}m"
B3="\e[${C_BANNER3}m"
P="\e[${C_PRIMARY}m"
A="\e[${C_ACCENT}m"
C="\e[${C_CYAN}m"
D="\e[${C_DIM}m"
W="\e[${C_TEXT}m"
B="\e[1m"
R="\e[0m"

# ── Live Telemetry Data Collection ──────────────────────────────────────────
KERNEL="$(uname -r 2>/dev/null || echo '6.12.9') ($(uname -m 2>/dev/null || echo 'x86_64'))"
HOST_LABEL="$(hostname 2>/dev/null || echo 'zothos')"
UPTIME="$(uptime -p 2>/dev/null | sed 's/up //' || uptime | awk -F',' '{print $1}' | xargs)"

# Planetary Hours & Elements
PLANETS=("☉ Sol" "♀ Venus" "☿ Mercury" "☽ Luna" "♄ Saturn" "♃ Jupiter" "♂ Mars")
ELEMENTS=("🜂 Fire" "🜁 Air" "🜄 Water" "🜃 Earth" "🜀 Quintessence")
H=$(date +%H)
P_IDX=$(( 10#$H % 7 ))
E_IDX=$(( 10#$H % 5 ))
PLANETARY_HOUR="${A}${PLANETS[$P_IDX]} ${D}· ${C}${ELEMENTS[$E_IDX]}${R}"

# Memory Usage & Bar
MEM_USED=$(free -m 2>/dev/null | awk '/Mem:/ {printf "%.0f", $3}' || echo "1024")
MEM_TOTAL=$(free -m 2>/dev/null | awk '/Mem:/ {printf "%.0f", $2}' || echo "8192")
MEM_PCT=$(( MEM_USED * 100 / (MEM_TOTAL > 0 ? MEM_TOTAL : 1) ))
filled_mem=$(( MEM_PCT / 10 ))
[[ $filled_mem -gt 10 ]] && filled_mem=10
empty_mem=$(( 10 - filled_mem ))
MEM_BAR="${P}[$(printf '▓%.0s' $(seq 1 $filled_mem 2>/dev/null || true))${D}$(printf '░%.0s' $(seq 1 $empty_mem 2>/dev/null || true))${P}] ${W}${MEM_PCT}%${R} ${D}(${MEM_USED}MB / ${MEM_TOTAL}MB)${R}"

# CPU Usage & Bar
CPU_PCT=$(top -bn1 2>/dev/null | grep "Cpu(s)" | awk '{print int($2)}' || echo "0")
filled_cpu=$(( CPU_PCT / 10 ))
[[ $filled_cpu -gt 10 ]] && filled_cpu=10
empty_cpu=$(( 10 - filled_cpu ))
CPU_CORES=$(nproc 2>/dev/null || echo "4")
CPU_BAR="${A}[$(printf '▓%.0s' $(seq 1 $filled_cpu 2>/dev/null || true))${D}$(printf '░%.0s' $(seq 1 $empty_cpu 2>/dev/null || true))${A}] ${W}${CPU_PCT}%${R} ${D}(${CPU_CORES} Cores Active)${R}"

# Security & Network Posture
SEC_POSTURE="${P}● Dual Kali + Parrot Repos ${D}[750+ Tools Locked]${R}"

TOR_STATUS="${D}Direct Loopback / Clearnet${R}"
if [[ -f "/run/zoth_ghostmode.state" ]] || systemctl is-active --quiet tor 2>/dev/null; then
    TOR_STATUS="${P}● Torified & MAC Spoofed [Ghost Active]${R}"
fi

# Frontier AI Engine & Model Status
AI_ENGINES=()
if pgrep -x "ollama" >/dev/null 2>&1; then
    AI_ENGINES+=("Ollama [Online]")
fi
if pgrep -x "vllm" >/dev/null 2>&1; then
    AI_ENGINES+=("vLLM [Active]")
fi
if pgrep -f "litellm" >/dev/null 2>&1; then
    AI_ENGINES+=("LiteLLM")
fi

if [[ ${#AI_ENGINES[@]} -gt 0 ]]; then
    AI_STATUS="${P}● $(IFS=" · "; echo "${AI_ENGINES[*]}") [Ready]${R}"
else
    AI_STATUS="${C}● Local Neural Stack Standby [Ollama / vLLM]${R}"
fi

# Comms & Bridge Daemons
COMMS_STATUS="${P}● SimpleX (:5225) ${D}· ${P}Signal Bridge (:8765) ${D}· ${P}API (:8767)${R}"

# Studio Status
STUDIO_STATUS="${A}● Zoth Studio v2 ${D}[React 18 · Vite · 37 Workstations]${R}"

# ── Render Master ASCII Welcome HUD ─────────────────────────────────────────
echo -e ""
echo -e "${B1}  ███████╗ ██████╗ ████████╗██╗  ██╗ ██████╗ ███████╗${R}"
echo -e "${B1}  ╚══███╔╝██╔═══██╗╚══██╔══╝██║  ██║██╔═══██╗██╔════╝${R}"
echo -e "${B2}    ███╔╝ ██║   ██║   ██║   ███████║██║   ██║███████╗${R}"
echo -e "${B2}   ███╔╝  ██║   ██║   ██║   ██╔══██║██║   ██║╚════██║${R}"
echo -e "${B3}  ███████╗╚██████╔╝   ██║   ██║  ██║╚██████╔╝███████║${R}"
echo -e "${B3}  ╚══════╝ ╚═════╝    ╚═╝   ╚═╝  ╚═╝ ╚═════╝ ╚══════╝${R}"
echo -e "  ${B}${A}⚡ SOVEREIGN AI OPERATING SYSTEM ${D}◈${A} ENGINEERED BY NULLAI TECH ${D}◈${C} NULLAI.TECH${R}"
echo -e "  ${D}─────────────────────────────────────────────────────────────────────────────${R}"
echo -e "  ${B}${P}◈ OS Reality:       ${W}${MODE_DISPLAY}"
echo -e "  ${B}${P}◈ Hermetic Axiom:   ${A}\"As above, so below; as code, so mind.\"${R}"
echo -e "  ${B}${P}◈ Engineering:      ${A}NullAI Tech ${D}· ${C}https://nullai.tech ${D}(@NullAITech)${R}"
echo -e "  ${B}${P}◈ Kernel & Host:    ${W}${KERNEL} ${D}· ${C}${HOST_LABEL}${R}"
echo -e "  ${B}${P}◈ Planetary Hour:   ${PLANETARY_HOUR}"
echo -e "  ${B}${P}◈ Memory Vitals:    ${MEM_BAR}"
echo -e "  ${B}${P}◈ CPU & Cores:      ${CPU_BAR}"
echo -e "  ${B}${P}◈ Local AI Engine:  ${AI_STATUS} ${D}[Zero Cloud Telemetry]${R}"
echo -e "  ${B}${P}◈ Security Arsenal: ${SEC_POSTURE}"
echo -e "  ${B}${P}◈ Sovereign Comms:  ${COMMS_STATUS}"
echo -e "  ${B}${P}◈ Studio Cockpit:   ${STUDIO_STATUS}"
echo -e "  ${B}${P}◈ System Uptime:    ${W}${UPTIME}${R}"
echo -e "  ${D}─────────────────────────────────────────────────────────────────────────────${R}"
echo -e "  ${B}${W}Quick Commands:${R}  ${A}zoth${D}:${W}pkg-mgr  ${A}studio${D}:${W}v2-app  ${A}ai${D}:${W}models  ${A}sec${D}:${W}arsenal  ${A}heal${D}:${W}repair"
echo -e "  ${B}${W}Reality Modes:${R}   ${P}matrix${R} ${D}·${R} ${A}gold${R} ${D}·${R} \e[38;2;239;68;68mghost\e[0m ${D}·${R} \e[38;2;59;130;246mwin11\e[0m  ${D}|${R}  ${B}${W}Screensaver:${R} ${A}rain${R}"
echo -e ""
