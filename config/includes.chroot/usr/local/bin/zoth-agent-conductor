#!/usr/bin/env bash
# ==============================================================================
# ZothOS Sovereign Agent Conductor CLI Wrapper
# Engineered by Neal Frazier Tech (@1nc0gn30) • NullAI Platform
# ==============================================================================
set -e

PRIMARY_BIN="${ZOTH_SRC_ROOT}/bin/zoth-agent-conductor"
REPO_DIR="${ZOTH_SRC_ROOT}"

if [[ -x "$PRIMARY_BIN" ]]; then
    exec "$PRIMARY_BIN" "$@"
elif [[ -d "$REPO_DIR/src/conductor" ]]; then
    export PYTHONPATH="$REPO_DIR/src:${PYTHONPATH:-}"
    exec python3 -m conductor "$@"
else
    echo "Error: zoth-agent-conductor not found in $PRIMARY_BIN or $REPO_DIR/src" >&2
    exit 1
fi
