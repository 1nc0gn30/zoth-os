#!/usr/bin/env python3
import time
import json
import tkinter

root = tkinter.Tk()
root.withdraw()

sw = root.winfo_screenwidth()
sh = root.winfo_screenheight()

while True:
    try:
        x, y = root.winfo_pointerxy()
        data = {
            "x": x,
            "y": y,
            "screen_w": sw,
            "screen_h": sh,
            "timestamp": time.time()
        }
        with open("/tmp/zoth_cursor.json.tmp", "w") as f:
            json.dump(data, f)
        import os
        os.replace("/tmp/zoth_cursor.json.tmp", "/tmp/zoth_cursor.json")
    except Exception:
        pass
    time.sleep(0.05)
