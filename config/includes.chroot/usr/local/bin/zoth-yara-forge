#!/usr/bin/env python3
"""
zoth-yara-forge — Sovereign YARA-X & Sigma Threat Rule Compiler & Local Scanner for ZothOS v3.2
Engineered by Neal Frazier Tech (@1nc0gn30) • NullAI Platform
"""
import argparse
import json
import math
import os
import re
import sys
from datetime import datetime

BUILTIN_RULES = [
    {
        "id": "ZOTH_PHP_CGI_Arg_Injection_RCE",
        "cve": "CVE-2024-4577",
        "mitre": ["T1190", "T1059.004"],
        "severity": "CRITICAL",
        "patterns": [
            ("$soft_hyphen", r"%ADd"),
            ("$allow_url", r"allow_url_include"),
            ("$auto_prepend", r"auto_prepend_file"),
            ("$php_input", r"php://input"),
            ("$shell_exec", r"(system|passthru|shell_exec|popen)\s*\("),
        ],
        "min_matches": 2,
    },
    {
        "id": "ZOTH_Agent_MCP_Credential_Exfil",
        "cve": "ZOTH-AGENT-001",
        "mitre": ["T1552.001", "T1048"],
        "severity": "HIGH",
        "patterns": [
            ("$env_file", r"\.env"),
            ("$ssh_key", r"id_ed25519|id_rsa"),
            ("$curl_exfil", r"curl\s+-[a-zA-Z]*\s+https?://"),
            ("$b64_pipe", r"base64\s+-w0"),
        ],
        "min_matches": 2,
    },
    {
        "id": "ZOTH_ELF64_Memfd_Reflective_Loader",
        "cve": "ZOTH-ELF-002",
        "mitre": ["T1620", "T1027"],
        "severity": "CRITICAL",
        "patterns": [
            ("$elf_magic", r"\x7fELF|\\x7fELF"),
            ("$memfd", r"memfd_create"),
            ("$fexecve", r"fexecve|execveat"),
            ("$proc_self_fd", r"/proc/self/fd/"),
        ],
        "min_matches": 2,
    },
]


def shannon_entropy(data: bytes) -> float:
    if not data:
        return 0.0
    freq = {}
    for b in data:
        freq[b] = freq.get(b, 0) + 1
    n = len(data)
    return round(-sum((c / n) * math.log2(c / n) for c in freq.values()), 3)


def emit_yara(rule: dict) -> str:
    strings_block = "\n".join(
        f'        {pid} = /{pat}/ nocase' for pid, pat in rule["patterns"]
    )
    return f"""rule {rule["id"]} {{
    meta:
        author = "Neal Frazier Tech (@1nc0gn30) • ZothOS YARA-Sigma Forge"
        cve = "{rule["cve"]}"
        mitre_attack = "{", ".join(rule["mitre"])}"
        severity = "{rule["severity"]}"
        date = "{datetime.utcnow().strftime("%Y-%m-%d")}"
    strings:
{strings_block}
    condition:
        {rule["min_matches"]} of them
}}"""


def scan_bytes(raw: bytes, label: str) -> dict:
    text = raw.decode("utf-8", errors="replace")
    entropy = shannon_entropy(raw)
    detections = []
    for rule in BUILTIN_RULES:
        hits = []
        for pid, pat in rule["patterns"]:
            matches = list(re.finditer(pat, text, flags=re.IGNORECASE))
            if matches:
                hits.append({
                    "pattern": pid,
                    "count": len(matches),
                    "first_offset": f"0x{matches[0].start():X}",
                    "sample": matches[0].group(0)[:32],
                })
        if len(hits) >= rule["min_matches"]:
            detections.append({
                "rule": rule["id"],
                "cve": rule["cve"],
                "severity": rule["severity"],
                "mitre": rule["mitre"],
                "hits": hits,
            })
    return {
        "target": label,
        "bytes": len(raw),
        "shannon_entropy": entropy,
        "status": "TRIGGERED" if detections else "CLEAN",
        "detections": detections,
    }


def main():
    parser = argparse.ArgumentParser(description="ZothOS YARA-X & Sigma Threat Rule Forge & Scanner")
    parser.add_argument("--scan", metavar="PATH", help="Scan a file or '-' for stdin")
    parser.add_argument("--emit-yara", action="store_true", help="Output compiled YARA ruleset to stdout")
    parser.add_argument("--json", action="store_true", help="Format scan output as JSON")
    args = parser.parse_args()

    if args.emit_yara:
        print("\n\n".join(emit_yara(r) for r in BUILTIN_RULES))
        return

    if args.scan:
        if args.scan == "-":
            raw = sys.stdin.buffer.read()
            res = scan_bytes(raw, "stdin")
        else:
            with open(args.scan, "rb") as f:
                raw = f.read()
            res = scan_bytes(raw, args.scan)
    else:
        demo = b'POST /index.php?%ADd+allow_url_include%3d1+%ADd+auto_prepend_file%3dphp://input HTTP/1.1\n<?php system("id"); ?>'
        res = scan_bytes(demo, "builtin-cve-2024-4577-self-test")

    if args.json:
        print(json.dumps(res, indent=2))
    else:
        print(f"╔══ ZOTH YARA-SIGMA FORGE // TARGET: {res['target']} ({res['bytes']}B, H={res['shannon_entropy']}) ══╗")
        print(f"║ STATUS: {res['status']}")
        for det in res["detections"]:
            print(f"╠── [{det['severity']}] {det['rule']} ({det['cve']}) • MITRE: {', '.join(det['mitre'])}")
            for h in det["hits"]:
                print(f"║     • {h['pattern']} @ {h['first_offset']} ({h['count']}x): {h['sample']!r}")
        print("╚══════════════════════════════════════════════════════════════════════════╝")


if __name__ == "__main__":
    main()
