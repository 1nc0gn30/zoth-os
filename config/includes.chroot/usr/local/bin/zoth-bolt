#!/usr/bin/env python3
"""
Zoth Bolt (zoth-bolt / bolt.diy) — Sovereign Full-Stack AI Web & Motion Architect CLI
Engineered by 1nc0gn30 (@1nc0gn30) • NullAI Platform
100% Free & Open Access

This launcher ONLY ever starts the real bolt.diy fork (Remix/Vite workbench).
The legacy server.py braille stand-in is never spawned.
"""
import sys, os, json, subprocess, argparse, urllib.request, urllib.error, time, shutil

TOOL_ID = 'zoth-bolt'
TOOL_ALIAS = 'bolt.diy'
TOOL_REPO = 'bolt.diy'
TOOL_NAME = 'Zoth Bolt'
TOOL_DESC = 'Flagship sovereign full-stack AI web, 3D shader, and motion architect on :5173 with local Ollama, 19+ LLM providers, and WebContainer live synthesis.'
TOOL_VERSION = '3.6.0'
TOOL_CATEGORY = 'AI Agents & Dev'
TOOL_PORT = 5173


def _repo_candidates():
    return [
        os.path.expanduser('~/NullAITech/bolt.diy'),
        '/opt/bolt.diy',
        '/opt/zoth-bolt',
        os.path.expanduser('~/bolt.diy'),
    ]


def find_repo():
    for c in _repo_candidates():
        if os.path.isfile(os.path.join(c, 'package.json')):
            return c
    return _repo_candidates()[0]


REPO_DIR = find_repo()
ELECTRON_MAIN = os.path.join(REPO_DIR, 'electron', 'main.cjs')
STUDIO_URL = "http://127.0.0.1:3000/tools/zoth-bolt"
LOCAL_PORT_URL = f"http://127.0.0.1:{TOOL_PORT}"


def check_daemon():
    """Online means the REAL bolt.diy engine answered — not any HTTP 200."""
    try:
        req = urllib.request.Request(f"{LOCAL_PORT_URL}/api/health")
        with urllib.request.urlopen(req, timeout=1.5) as resp:
            body = json.loads(resp.read().decode("utf-8", errors="ignore"))
            if body.get("engine") == "bolt.diy":
                return body
    except Exception:
        pass
    return None


def _runner():
    return shutil.which('pnpm') or shutil.which('npm')


def ensure_daemon(port=TOOL_PORT):
    status = check_daemon()
    if status is not None:
        return status
    if not os.path.isfile(os.path.join(REPO_DIR, 'package.json')):
        return None
    runner = _runner()
    if not runner:
        return None
    env = dict(os.environ, PORT=str(port))
    subprocess.Popen(
        [runner, 'run', 'dev', '--', '--port', str(port), '--host', '127.0.0.1'],
        cwd=REPO_DIR,
        stdout=open("/tmp/zoth-bolt.log", "a"),
        stderr=subprocess.STDOUT,
        start_new_session=True,
        env=env,
    )
    for _ in range(150):
        time.sleep(0.4)
        status = check_daemon()
        if status is not None:
            return status
    return None


def api_get(endpoint):
    try:
        req = urllib.request.Request(f"{LOCAL_PORT_URL}{endpoint}")
        with urllib.request.urlopen(req, timeout=3.0) as resp:
            return json.loads(resp.read().decode("utf-8"))
    except Exception as e:
        return {"error": str(e)}


def launch_electron(extra_args=None):
    ensure_daemon(TOOL_PORT)
    electron_bin = shutil.which("electron") or "/usr/local/bin/electron"
    cmd = [electron_bin, ELECTRON_MAIN] + (extra_args or [])
    res = subprocess.run(cmd, cwd=REPO_DIR)
    sys.exit(res.returncode)


def launch_tui(extra_args=None):
    tui_bin = shutil.which("zoth-bolt-tui") or "/usr/local/bin/zoth-bolt-tui"
    res = subprocess.run([tui_bin] + (extra_args or []))
    sys.exit(res.returncode)


def main():
    args = sys.argv[1:]

    if "--electron" in args:
        rem = [a for a in args if a != "--electron"]
        launch_electron(rem)
    if "--tui" in args:
        rem = [a for a in args if a != "--tui"]
        launch_tui(rem)

    parser = argparse.ArgumentParser(
        prog="zoth-bolt",
        description=f"{TOOL_NAME} (v{TOOL_VERSION}) — {TOOL_DESC}",
    )
    parser.add_argument("--version", "-v", action="version", version=f"zoth-bolt v{TOOL_VERSION}")
    parser.add_argument("--status", action="store_true", help="Check local Zoth Bolt daemon status")
    parser.add_argument("--json", action="store_true", help="Output deterministic JSON telemetry")
    parser.add_argument("--ui", action="store_true", help="Print local Zoth Bolt workbench URL")
    parser.add_argument("--port", type=int, default=TOOL_PORT, help="Port for serve/dev subcommands")
    parser.add_argument("--prompt", type=str, default="", help="Prompt forwarded into the live Zoth Bolt workbench")
    parser.add_argument("--provider", type=str, default="Ollama", help="LLM Provider")
    parser.add_argument("--model", type=str, default="qwen2.5-coder:32b", help="Model ID")
    parser.add_argument("--name", type=str, default="", help="Company name for oneshot local business site")
    parser.add_argument("--tagline", type=str, default="", help="Tagline for oneshot local business site")
    parser.add_argument("--primary", type=str, default="#0E4B39", help="Primary brand hex color for oneshot")
    parser.add_argument("--accent", type=str, default="#D6A24A", help="Accent brand hex color for oneshot")
    parser.add_argument("--category", type=str, default="home-services", help="Industry category for oneshot")
    parser.add_argument("--style", type=str, default="editorial-light", help="Theme archetype (editorial-light|coastal-sand|obsidian-noir)")
    parser.add_argument("--city", type=str, default="Virginia Beach, VA", help="City/State for oneshot")
    parser.add_argument("--zip", dest="zip_code", type=str, default="23451", help="ZIP code for oneshot")
    parser.add_argument("--phone", type=str, default="", help="Business phone for oneshot NAP/SMS")
    parser.add_argument("--email", type=str, default="", help="Business email for oneshot")
    parser.add_argument("--out-dir", type=str, default="", help="Output directory for oneshot bundle")
    parser.add_argument("--deploy", action="store_true", help="Deploy generated oneshot site to Netlify production")
    parser.add_argument(
        "subcommand",
        nargs="?",
        choices=[
            "status", "providers", "models", "bridge", "synthesize", "oneshot",
            "serve", "dev", "ollama", "desktop", "electron", "tui"
        ],
        help="Subcommand (status, oneshot, serve, dev, ollama, desktop, electron, tui, providers, models, bridge, synthesize)",
    )
    parsed, unknown = parser.parse_known_args(args)

    if parsed.subcommand in ("desktop", "electron"):
        launch_electron(unknown)

    if parsed.subcommand == "tui":
        launch_tui(unknown + (["--json"] if parsed.json else []))

    if parsed.subcommand == "serve":
        runner = _runner()
        if not runner or not os.path.isfile(os.path.join(REPO_DIR, 'package.json')):
            print("✗ Real bolt.diy fork not found (package.json missing) — refusing to start any stand-in.", file=sys.stderr)
            sys.exit(1)
        os.chdir(REPO_DIR)
        os.environ['PORT'] = str(parsed.port)
        os.execv(runner, [runner, 'run', 'dev', '--', '--port', str(parsed.port), '--host', '127.0.0.1'])

    if parsed.subcommand in ("dev", "ollama"):
        daemon_status = ensure_daemon(parsed.port)
        mode_label = "Ollama Local Sovereign (http://127.0.0.1:11434)" if parsed.subcommand == "ollama" else "Full-Stack Workbench"
        if parsed.json:
            print(json.dumps({
                "tool": TOOL_ID,
                "name": TOOL_NAME,
                "mode": mode_label,
                "url": LOCAL_PORT_URL,
                "studio_url": STUDIO_URL,
                "daemon_online": daemon_status is not None,
                "status": "READY" if daemon_status else "STARTING"
            }, indent=2))
            return
        print(f"✦ {TOOL_NAME} [{mode_label}] is LIVE at {LOCAL_PORT_URL}")
        print(f"  Studio Enclave : {STUDIO_URL}")
        print(f"  TUI Command    : zoth-bolt-tui")
        print(f"  Desktop App    : zoth-bolt desktop")
        return

    daemon_status = ensure_daemon(TOOL_PORT)

    if parsed.subcommand == "providers":
        print(json.dumps(api_get("/api/configured-providers"), indent=2))
        return

    if parsed.subcommand == "models":
        print(json.dumps(api_get("/api/local-models"), indent=2))
        return

    if parsed.subcommand == "bridge":
        print(json.dumps(api_get("/api/zoth/bridge"), indent=2))
        return

    if parsed.subcommand == "oneshot":
        if not parsed.name.strip():
            print("✗ --name \"Company Name\" is required for `zoth-bolt oneshot`.", file=sys.stderr)
            sys.exit(2)
        payload = {
            "companyName": parsed.name.strip(),
            "tagline": parsed.tagline.strip(),
            "primaryColor": parsed.primary,
            "accentColor": parsed.accent,
            "category": parsed.category,
            "heroStyle": parsed.style,
            "city": parsed.city,
            "zip": parsed.zip_code,
            "phone": parsed.phone,
            "email": parsed.email,
        }
        try:
            req = urllib.request.Request(
                f"{LOCAL_PORT_URL}/api/zoth/local-business",
                data=json.dumps(payload).encode("utf-8"),
                headers={"Content-Type": "application/json"},
                method="POST",
            )
            with urllib.request.urlopen(req, timeout=15.0) as resp:
                res = json.loads(resp.read().decode("utf-8"))
        except Exception as e:
            print(json.dumps({"ok": False, "error": str(e)}, indent=2))
            sys.exit(1)

        slug = res.get("slug") or "local-business"
        out_dir = parsed.out_dir.strip() or os.path.expanduser(f"~/NullAITech/bolt-sites/{slug}")
        os.makedirs(out_dir, exist_ok=True)
        for rel_path, content in (res.get("files") or {}).items():
            dest = os.path.join(out_dir, rel_path.lstrip("/"))
            os.makedirs(os.path.dirname(dest), exist_ok=True)
            with open(dest, "w", encoding="utf-8") as fh:
                fh.write(content)

        deploy_info = None
        if parsed.deploy:
            netlify_bin = shutil.which("netlify")
            if not netlify_bin:
                deploy_info = {"ok": False, "error": "netlify CLI not found in PATH"}
            else:
                site_flag = os.path.join(out_dir, ".netlify", "state.json")
                if not os.path.isfile(site_flag):
                    subprocess.run(
                        [netlify_bin, "sites:create", "--name", f"{slug}-{int(time.time()) % 10000}"],
                        cwd=out_dir, capture_output=True, text=True, check=False,
                    )
                proc = subprocess.run(
                    [netlify_bin, "deploy", "--prod", "--dir", out_dir, "--json"],
                    cwd=out_dir, capture_output=True, text=True, check=False,
                )
                try:
                    deploy_info = json.loads(proc.stdout)
                except Exception:
                    deploy_info = {"returncode": proc.returncode, "stdout": proc.stdout[-400:], "stderr": proc.stderr[-400:]}

        summary = {
            "ok": True,
            "engine": "bolt.diy",
            "slug": slug,
            "out_dir": out_dir,
            "files": res.get("fileNames", []),
            "deploy": deploy_info,
        }
        if parsed.json:
            print(json.dumps(summary, indent=2))
        else:
            print(f"✦ Zoth Bolt One-Shot Site Ready: {parsed.name} ({slug})")
            print(f"  Output Dir : {out_dir}")
            print(f"  Files      : {', '.join(summary['files'])}")
            if isinstance(deploy_info, dict) and (deploy_info.get('url') or deploy_info.get('deploy_url')):
                print(f"  Live URL   : {deploy_info.get('url') or deploy_info.get('deploy_url')}")
        return

    if parsed.subcommand == "synthesize" or parsed.prompt:
        prompt_text = parsed.prompt or "Build a dark glassmorphic AI telemetry dashboard with real-time charts"
        try:
            req_data = json.dumps({
                "action": "prompt_and_build",
                "prompt": prompt_text,
                "provider": parsed.provider,
                "model": parsed.model,
            }).encode("utf-8")
            req = urllib.request.Request(
                f"{LOCAL_PORT_URL}/api/webgen/control",
                data=req_data,
                headers={"Content-Type": "application/json"},
            )
            with urllib.request.urlopen(req, timeout=5.0) as resp:
                res = json.loads(resp.read().decode("utf-8"))
        except Exception as e:
            res = {"error": str(e)}
        print(json.dumps(res, indent=2))
        return

    info = {
        "id": TOOL_ID,
        "alias": TOOL_ALIAS,
        "repo": TOOL_REPO,
        "name": TOOL_NAME,
        "version": TOOL_VERSION,
        "category": TOOL_CATEGORY,
        "installed": os.path.isfile(os.path.join(REPO_DIR, 'package.json')),
        "repo_path": REPO_DIR,
        "engine": "bolt.diy (real Remix/Vite fork)",
        "electron_main": ELECTRON_MAIN,
        "studio_workbench_url": STUDIO_URL,
        "local_endpoint": LOCAL_PORT_URL,
        "daemon_online": daemon_status is not None,
        "daemon_info": daemon_status,
        "license": "100% Free & Open Access (Zero Paywalls)",
        "support": {
            "stripe_buy_coffee": "https://buy.stripe.com/3cIfZg27PdKo2D64Ocfw40X",
            "solana_wallet": "GG2eQbVh8ut1BK6j1A2tz7pSySdLpD38BgyEhGcxdXoK"
        },
        "status": "READY"
    }

    if parsed.json:
        print(json.dumps(info, indent=2))
        return

    if parsed.ui:
        print(LOCAL_PORT_URL)
        return

    if parsed.status or parsed.subcommand == "status":
        state = "ONLINE" if daemon_status else "OFFLINE"
        print(f"✦ {TOOL_NAME} Daemon Status: {state} (:{TOOL_PORT}) | Workbench: {LOCAL_PORT_URL}")
        if isinstance(daemon_status, dict):
            print(f"  Engine        : {daemon_status.get('engine', 'bolt.diy')}")
        return

    print(f"✦ {TOOL_NAME} (v{TOOL_VERSION}) — [{TOOL_CATEGORY}]")
    print(f"  Repository    : {REPO_DIR}")
    print(f"  Studio Route  : {STUDIO_URL}")
    print(f"  Local Port    : {LOCAL_PORT_URL}")
    print(f"  Daemon        : {'ONLINE' if daemon_status else 'OFFLINE'}")
    print(f"  Commands      : zoth-bolt [status|oneshot|dev|ollama|desktop|tui|providers|models|bridge|synthesize]")
    print(f"  Access        : 100% Free & Open Access (☕ https://buy.stripe.com/3cIfZg27PdKo2D64Ocfw40X | ◎ GG2eQbVh8ut1BK6j1A2tz7pSySdLpD38BgyEhGcxdXoK)")


if __name__ == "__main__":
    main()
