#!/usr/bin/env python3
"""
==============================================================================
 * ZOTH STUDIO PRO — NATIVE DESKTOP APPLICATION RUNTIME v3.0 *
 Hardware-Accelerated 3D WebGL Alchemical Cockpit & OS Orchestrator.
 WebKit2GTK / Chromium / Electron Multi-Tier Standalone App Architecture.
==============================================================================
"""

import sys
import os
import shutil
import time
import signal
import socket
import threading
import subprocess
import http.server
import socketserver
import urllib.request
import urllib.error

# Discovery of Studio Root directory
CANDIDATE_ROOTS = [
    os.environ.get("STUDIO_ROOT", ""),
    "/opt/zoth-studio",
    "/usr/share/zoth-studio",
    os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "share/zoth-studio"),
    os.path.expanduser("~/zoth-studio"),
]

STUDIO_ROOT = "/opt/zoth-studio"
for r in CANDIDATE_ROOTS:
    if r and os.path.isdir(r) and (os.path.exists(os.path.join(r, "dist/index.html")) or os.path.exists(os.path.join(r, "index.html")) or os.path.exists(os.path.join(r, "public/index.html"))):
        STUDIO_ROOT = r
        break

if os.path.exists(os.path.join(STUDIO_ROOT, "dist", "index.html")):
    SERVE_ROOT = os.path.join(STUDIO_ROOT, "dist")
elif os.path.exists(os.path.join(STUDIO_ROOT, "public", "index.html")):
    SERVE_ROOT = os.path.join(STUDIO_ROOT, "public")
else:
    SERVE_ROOT = STUDIO_ROOT
STUDIO_PUBLIC = SERVE_ROOT
ICON_PATH = "/usr/share/pixmaps/zoth-studio.png"
if not os.path.exists(ICON_PATH):
    appdir_icon = os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "share/pixmaps/zoth-studio.png")
    if os.path.exists(appdir_icon):
        ICON_PATH = appdir_icon

PREFERRED_PORTS = [8088, 8080, 3000, 8008, 8090, 8099] + list(range(8100, 8150))
PID_FILE = os.path.expanduser("~/.zoth-studio/zoth-studio.pid")


class QuietHTTPHandler(http.server.SimpleHTTPRequestHandler):
    def __init__(self, *args, **kwargs):
        super().__init__(*args, directory=SERVE_ROOT, **kwargs)

    def log_message(self, format, *args):
        pass

    def end_headers(self):
        self.send_header('Access-Control-Allow-Origin', '*')
        self.send_header('Access-Control-Allow-Methods', 'GET, POST, OPTIONS')
        self.send_header('Access-Control-Allow-Headers', 'Content-Type, Authorization')
        self.send_header('Cache-Control', 'no-cache, no-store, must-revalidate')
        super().end_headers()

    def do_OPTIONS(self):
        self.send_response(200)
        self.end_headers()


def is_port_in_use(port):
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
        s.settimeout(0.2)
        return s.connect_ex(('127.0.0.1', port)) == 0


def is_zoth_studio_server(port):
    try:
        url = f"http://127.0.0.1:{port}/index.html"
        req = urllib.request.Request(url, headers={'User-Agent': 'ZothStudio-Healthcheck'})
        with urllib.request.urlopen(req, timeout=0.6) as response:
            if response.status == 200:
                body = response.read(2048).decode('utf-8', errors='ignore')
                if "Zoth" in body or "zoth" in body or "<html" in body.lower():
                    return True
    except Exception:
        pass
    return False


def start_local_asset_server():
    # 1. Check if an existing Zoth Studio instance is already serving
    for p in PREFERRED_PORTS:
        if is_port_in_use(p) and is_zoth_studio_server(p):
            return p

    # 2. Find first available free port and bind
    for p in PREFERRED_PORTS:
        if not is_port_in_use(p):
            try:
                httpd = socketserver.TCPServer(("127.0.0.1", p), QuietHTTPHandler)
                t = threading.Thread(target=httpd.serve_forever, daemon=True)
                t.start()
                # Verify server responsiveness
                time.sleep(0.1)
                return p
            except OSError:
                continue

    # Fallback to ephemeral port
    httpd = socketserver.TCPServer(("127.0.0.1", 0), QuietHTTPHandler)
    allocated_port = httpd.server_address[1]
    t = threading.Thread(target=httpd.serve_forever, daemon=True)
    t.start()
    return allocated_port


def launch_gui(port):
    studio_url = f"http://127.0.0.1:{port}/index.html"

    # Hardware acceleration & rendering tuning
    os.environ.setdefault("WEBKIT_DISABLE_COMPOSITING_MODE", "0")
    os.environ.setdefault("GDK_BACKEND", "wayland,x11")
    os.environ["PORT"] = str(port)

    # 1. Try native Electron standalone app first
    electron_candidates = [
        "/usr/local/bin/electron",
        "/opt/electron/electron",
        "/usr/bin/electron",
        "/opt/maya-linux/node_modules/.bin/electron"
    ]
    electron_bin = None
    for el in electron_candidates:
        if os.path.exists(el) and os.access(el, os.X_OK):
            electron_bin = el
            break

    entry_found = any(os.path.exists(os.path.join(STUDIO_ROOT, f)) for f in ["main.cjs", "main.js"])
    if electron_bin and entry_found:
        try:
            electron_flags = [
                electron_bin,
                "--no-sandbox",
                "--disable-dev-shm-usage",
                "--disable-gpu-sandbox",
                "--ozone-platform-hint=auto",
                STUDIO_ROOT
            ]
            proc = subprocess.Popen(electron_flags, env=os.environ.copy())
            time.sleep(1.2)
            if proc.poll() is None:
                # Electron is running steadily
                proc.wait()
                return
            elif proc.returncode == 0:
                return
            # Non-zero returncode means crash/exit early
        except Exception:
            pass

    # 2. Try WebKit2GTK native standalone window
    try:
        import gi
        gi.require_version('Gtk', '3.0')
        gi.require_version('Gdk', '3.0')
        try:
            gi.require_version('WebKit2', '4.1')
        except ValueError:
            gi.require_version('WebKit2', '4.0')
        from gi.repository import Gtk, Gdk, WebKit2, GLib

        class ZothStudioApp(Gtk.Window):
            def __init__(self):
                super().__init__(type=Gtk.WindowType.TOPLEVEL)
                self.set_title("ZOTH STUDIO PRO // SOVEREIGN COCKPIT")
                self.set_default_size(1440, 960)
                self.set_position(Gtk.WindowPosition.CENTER)
                if os.path.exists(ICON_PATH):
                    self.set_icon_from_file(ICON_PATH)

                self.webview = WebKit2.WebView()
                settings = self.webview.get_settings()
                settings.set_enable_webgl(True)
                settings.set_enable_accelerated_2d_canvas(True)
                settings.set_enable_smooth_scrolling(True)
                settings.set_enable_javascript(True)
                settings.set_enable_developer_extras(True)
                if hasattr(settings, 'set_enable_media_stream'):
                    settings.set_enable_media_stream(True)

                box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
                self.add(box)
                box.pack_start(self.webview, True, True, 0)
                self.webview.load_uri(studio_url)
                self.connect("delete-event", lambda *a: Gtk.main_quit())

        signal.signal(signal.SIGINT, lambda *a: Gtk.main_quit())
        signal.signal(signal.SIGTERM, lambda *a: Gtk.main_quit())
        app = ZothStudioApp()
        app.show_all()
        Gtk.main()
        return
    except Exception:
        pass

    # 3. Dedicated application window mode fallback (Chrome / Chromium / Firefox)
    browser_commands = [
        ["google-chrome-stable", "--no-sandbox", f"--app={studio_url}", "--start-maximized", "--class=zoth-studio"],
        ["google-chrome", "--no-sandbox", f"--app={studio_url}", "--start-maximized", "--class=zoth-studio"],
        ["chromium", "--no-sandbox", f"--app={studio_url}", "--start-maximized", "--class=zoth-studio", "--disable-extensions", "--disable-default-apps"],
        ["firefox-esr", "--new-window", studio_url],
        ["firefox", "--new-window", studio_url],
    ]
    for b_cmd in browser_commands:
        if subprocess.run(["which", b_cmd[0]], capture_output=True).returncode == 0:
            subprocess.run(b_cmd)
            return

    subprocess.run(["xdg-open", studio_url])


def main():
    if len(sys.argv) > 1 and sys.argv[1] in ["--update", "-u", "update"]:
        updater = shutil.which("zoth-update-studio") or "/usr/local/bin/zoth-update-studio"
        if os.path.exists(updater):
            os.execv(updater, [updater] + sys.argv[2:])
        else:
            print("[!] zoth-update-studio not found in PATH.")
            sys.exit(1)

    signal.signal(signal.SIGINT, lambda *a: sys.exit(0))
    signal.signal(signal.SIGTERM, lambda *a: sys.exit(0))

    os.makedirs(os.path.expanduser("~/.zoth-studio"), exist_ok=True)
    with open(PID_FILE, "w") as f:
        f.write(str(os.getpid()))

    port = start_local_asset_server()
    launch_gui(port)


if __name__ == "__main__":
    main()
