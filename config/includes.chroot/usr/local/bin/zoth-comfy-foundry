#!/usr/bin/env bash
set -euo pipefail

# Zoth Comfy Cloud Foundry — Chroot CLI Wrapper
if command -v zoth-comfy >/dev/null 2>&1; then
  exec zoth-comfy "$@"
fi

SCRIPT_PATH=""
for candidate in \
  "/opt/zoth-comfy-foundry/comfy_foundry.py" \
  "$HOME/NullAITech/zoth-comfy-foundry/comfy_foundry.py"
do
  if [[ -f "$candidate" ]]; then
    SCRIPT_PATH="$candidate"
    break
  fi
done

if [[ -z "$SCRIPT_PATH" ]]; then
  echo "zoth-comfy-foundry: comfy_foundry.py not found in /opt/zoth-comfy-foundry or \$HOME/NullAITech/zoth-comfy-foundry" >&2
  exit 1
fi

PYTHON_BIN="python3"
if [[ -x "/opt/zothos-ai-env/bin/python3" ]]; then
  PYTHON_BIN="/opt/zothos-ai-env/bin/python3"
fi

exec "$PYTHON_BIN" "$SCRIPT_PATH" "$@"
