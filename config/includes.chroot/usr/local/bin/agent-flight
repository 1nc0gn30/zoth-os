#!/usr/bin/env bash
set -e
REPO_DIR="${ZOTH_SRC_ROOT:-$HOME/NullAITech}/agent-flight-recorder"
[[ ! -d "$REPO_DIR" ]] && REPO_DIR="/opt/agent-flight-recorder"
PRIMARY_BIN="$REPO_DIR/bin/agent-flight"
if [[ -x "$PRIMARY_BIN" ]]; then
    exec "$PRIMARY_BIN" "$@"
elif [[ -d "$REPO_DIR/src" ]]; then
    export PYTHONPATH="$REPO_DIR/src:${PYTHONPATH:-}"
    pkg=$(ls "$REPO_DIR/src" | grep -v egg | head -n1)
    exec python3 -m "${pkg}.cli" "$@"
else
    echo "Error: agent-flight-recorder not found in $REPO_DIR" >&2
    exit 1
fi
