#!/usr/bin/env bash
# ==============================================================================
# Agent Flight Recorder CLI Wrapper
# Engineered by Neal Frazier Tech (@1nc0gn30) • NullAI Platform
# ==============================================================================
set -e

PRIMARY_BIN="${ZOTH_SRC_ROOT}/agent-flight-recorder/bin/agent-flight"
REPO_DIR="${ZOTH_SRC_ROOT}/agent-flight-recorder"

if [[ -x "$PRIMARY_BIN" ]]; then
    exec "$PRIMARY_BIN" "$@"
elif [[ -d "$REPO_DIR/src/agent_flight_recorder" ]]; then
    export PYTHONPATH="$REPO_DIR/src:${PYTHONPATH:-}"
    exec python3 -m agent_flight_recorder.cli "$@"
else
    echo "Error: agent-flight not found in $PRIMARY_BIN or $REPO_DIR" >&2
    exit 1
fi
