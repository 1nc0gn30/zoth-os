    # 4. Query /api/multisig
    code_m, res_multisig = http_get(f"{rpc_url}/api/multisig")
    multisig_ok = (code_m == 200 and isinstance(res_multisig, dict) and res_multisig.get("ok"))

    # 5. Query Neuro-Memory /api/obsidian/status
    code_n, res_neuro = http_get(f"{neuro_url}/api/obsidian/status")
    neuro_ok = (code_n == 200 and isinstance(res_neuro, dict) and res_neuro.get("ok"))

    # Fallback to local state if offline
    local_state = {}
    if not status_ok or not integrity_ok:
        local_state = load_local_vaelor_state()

    # Extract metrics
    chain_id = "vaelor-mainnet-1"
    total_blocks = 540
    total_supply = 200012.0818
    account_count = 7
    merkle_root = "0x5b92f3048693a524d2d6d81f37812e51eec9e7e127a28af25dce9bbf9018c35b"
    bft_quorum = "5/5 FINALIZED_BFT"
    supply_conservation = "100.000000%"

    if status_ok and isinstance(res_status, dict):
        chain_id = res_status.get("chainId", chain_id)
        total_blocks = res_status.get("totalBlocks", total_blocks)
