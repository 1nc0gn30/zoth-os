            {"handle": "@zoth", "name": "Neal Master Cockpit", "endpoint": rpc_url, "status": "CONNECTED", "role": "COCKPIT_ORCHESTRATOR"},
            {"handle": "@zoth-rig2", "name": "24/7 AI Laptop", "endpoint": rpc_url, "status": "CONNECTED", "role": "AI_FLEET_WORKER"},
            {"handle": "@neal", "name": "Neal Primary", "endpoint": rpc_url, "status": "CONNECTED", "role": "SOVEREIGN_OPERATOR"}
        ]
        bft_validators = [
            {"validatorId": "val-alpha-virginia", "name": "US-East Sovereign Validator", "flag": "🇺🇸", "latencyMs": 1.37, "status": "ONLINE"},
            {"validatorId": "val-beta-frankfurt", "name": "EU-Central Sovereign Validator", "flag": "🇩🇪", "latencyMs": 14.85, "status": "ONLINE"},
            {"validatorId": "val-gamma-tokyo", "name": "Asia-East Sovereign Validator", "flag": "🇯🇵", "latencyMs": 22.62, "status": "ONLINE"},
            {"validatorId": "val-delta-zothos-local", "name": "ZothOS Edge Micro-Validator", "flag": "⚡", "latencyMs": 0.42, "status": "ONLINE"},
            {"validatorId": "val-epsilon-nullai-core", "name": "NullAI Sovereign Consensus Core", "flag": "🌐", "latencyMs": 0.84, "status": "ONLINE"}
        ]

    # Multisig
    vault_info = {
        "address": "vlr1_multisig_corp_treasury",
        "policy": "2-of-3",
        "balanceVlr": 25000.0,
        "signers": ["@zoth", "@neal", "@zoth-rig2"],
        "activeProposalsCount": 0
