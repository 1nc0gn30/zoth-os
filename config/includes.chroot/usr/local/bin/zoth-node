    code_s, res_status = http_get(f"{rpc_url}/api/status")
    status_ok = (code_s == 200 and isinstance(res_status, dict) and res_status.get("ok"))

    # 2. Query /api/ledger/verify-integrity
    code_i, res_integrity = http_get(f"{rpc_url}/api/ledger/verify-integrity")
