#!/usr/bin/env python3
import sys, os, json, subprocess, argparse, urllib.request, urllib.error, socket, time

TOOL_ID = 'osint-scout-skill'
TOOL_REPO = 'osint-scout-skill'
TOOL_NAME = 'Domain Intel OSINT Scout'
TOOL_DESC = '100% in-browser passive domain intelligence & attack surface reconnaissance engine auditing Certificate Transparency logs, DoH DNS records, and SPF/DMARC posture — free to use; optional tips welcome.'
TOOL_VERSION = '2.5.0'
TOOL_CATEGORY = 'Security & Recon'
TOOL_PORT = 8085
REPO_DIR = os.path.expanduser('~/NullAITech/osint-scout-skill')
SERVER_PY = os.path.expanduser('~/NullAITech/osint-scout-skill/server.py')
STUDIO_URL = f"http://127.0.0.1:3000/tools/{TOOL_ID}"
LOCAL_PORT_URL = f"http://127.0.0.1:{TOOL_PORT}"

def query_health():
    try:
        req = urllib.request.Request(f"{LOCAL_PORT_URL}/health", headers={'User-Agent': 'ZothOS-CLI'})
        with urllib.request.urlopen(req, timeout=2.0) as r:
            return json.loads(r.read().decode('utf-8'))
    except Exception as e:
        return {"status": "offline", "error": str(e)}

def scan_domain(domain):
    domain = domain.strip().lower().replace('https://', '').replace('http://', '').split('/')[0]
    # Check if local server endpoint is active
    try:
        req = urllib.request.Request(f"{LOCAL_PORT_URL}/api/recon?domain={domain}", headers={'User-Agent': 'ZothOS-CLI'})
        with urllib.request.urlopen(req, timeout=3.5) as r:
            return json.loads(r.read().decode('utf-8'))
    except Exception:
        # Direct fallback socket resolution
        results = {
            "target": domain,
            "timestamp": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
            "records": {},
            "status": "success (direct passive socket)"
        }
        try:
            addr = socket.getaddrinfo(domain, 80, socket.AF_INET, socket.SOCK_STREAM)
            results["records"]["A"] = sorted(list(set(item[4][0] for item in addr)))
        except Exception as e:
            results["records"]["A"] = []
        return results

def main():
    args = sys.argv[1:]

    parser = argparse.ArgumentParser(
        prog=TOOL_ID,
        description=f"{TOOL_NAME} (v{TOOL_VERSION}) — {TOOL_DESC}"
    )
    parser.add_argument('--version', action='version', version=f"{TOOL_ID} v{TOOL_VERSION}")
    parser.add_argument('--status', action='store_true', help='Check local ZothOS installation & daemon status')
    parser.add_argument('--json', action='store_true', help='Output deterministic JSON telemetry')
    parser.add_argument('--ui', action='store_true', help='Print local ZothOS workbench URL')

    subparsers = parser.add_subparsers(dest='subcommand', help='Subcommands')
    
    scan_p = subparsers.add_parser('scan', help='Passive DNS and attack surface reconnaissance on domain')
    scan_p.add_argument('domain', type=str, help='Target domain to audit (e.g. nullai.tech)')

    serve_p = subparsers.add_parser('serve', help='Run OSINT Scout server')
    serve_p.add_argument('--port', type=int, default=TOOL_PORT, help='Port to bind')

    parsed, unknown = parser.parse_known_args(args)

    if parsed.subcommand == 'serve':
        cmd = [sys.executable, SERVER_PY, '--port', str(parsed.port or TOOL_PORT)]
        proc = subprocess.run(cmd, cwd=REPO_DIR)
        sys.exit(proc.returncode)

    if parsed.subcommand == 'scan':
        res = scan_domain(parsed.domain)
        print(json.dumps(res, indent=2))
        sys.exit(0)

    health = query_health()

    info = {
        "id": TOOL_ID,
        "repo": TOOL_REPO,
        "name": TOOL_NAME,
        "version": TOOL_VERSION,
        "category": TOOL_CATEGORY,
        "installed": os.path.exists(REPO_DIR),
        "repo_path": REPO_DIR,
        "studio_workbench_url": STUDIO_URL,
        "local_endpoint": LOCAL_PORT_URL,
        "daemon_active": health.get("status") == "healthy",
        "license": "100% Free & Open Access (Zero Paywalls)",
        "support": {
            "stripe_buy_coffee": "https://buy.stripe.com/3cIfZg27PdKo2D64Ocfw40X",
            "solana_wallet": "GG2eQbVh8ut1BK6j1A2tz7pSySdLpD38BgyEhGcxdXoK"
        },
        "status": "READY"
    }

    if parsed.json:
        print(json.dumps(info, indent=2))
        return

    print(f"✦ {TOOL_NAME} (v{TOOL_VERSION}) — [{TOOL_CATEGORY}]")
    print(f"  Repository : {REPO_DIR}")
    print(f"  Workbench  : {STUDIO_URL}")
    print(f"  Local Port : {LOCAL_PORT_URL}")
    print(f"  Daemon     : {'ONLINE (Healthy)' if health.get('status') == 'healthy' else 'OFFLINE'}")
    print(f"  Access     : 100% Free & Open Access (☕ https://buy.stripe.com/3cIfZg27PdKo2D64Ocfw40X | ◎ GG2eQbVh8ut1BK6j1A2tz7pSySdLpD38BgyEhGcxdXoK)")

if __name__ == '__main__':
    main()
