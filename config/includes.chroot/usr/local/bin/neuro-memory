#!/usr/bin/env bash
# ==============================================================================
# ZothOS Neuro-Memory Biological Substrate & Daemon CLI Wrapper
# Engineered by Neal Frazier Tech (@1nc0gn30) • NullAI Platform
# ==============================================================================
set -e

if [ -f /etc/zothos/paths.sh ]; then
  # shellcheck disable=SC1091
  . /etc/zothos/paths.sh
fi
: "${ZOTH_USER:=zoth}"
: "${AZOTH_USER:=azoth}"
: "${ZOTH_HOME:=/home/${ZOTH_USER}}"
: "${AZOTH_HOME:=/home/${AZOTH_USER}}"
: "${ZOTH_ACTIVE_HOME:=${HOME:-${ZOTH_HOME}}}"
: "${ZOTH_SRC_ROOT:=${ZOTH_ACTIVE_HOME}/NullAITech}"

REPO_DIR="${ZOTH_SRC_ROOT}/neuro-memory-daemon"
PRIMARY_BIN="$REPO_DIR/bin/neuro-memory.js"

if [[ -d "$REPO_DIR/src/neuro_memory_daemon" ]]; then
    export PYTHONPATH="$REPO_DIR/src:${PYTHONPATH:-}"
    exec python3 -m neuro_memory_daemon.cli "$@"
elif [[ -x "$PRIMARY_BIN" ]]; then
    exec "$PRIMARY_BIN" "$@"
else
    echo "Error: neuro-memory not found in $REPO_DIR" >&2
    exit 1
fi
