#!/usr/bin/env python3
"""EnvGuard Secrets Vault (v2.6.0) — Unicode U+2800 Braille Telemetry TUI.

Queries live loopback :8088 (/api/health, /api/diagnostics) and runs an actual
in-process .env posture check (zero synthetic math.sin curves, zero literal
home-directory path leaks).
"""

from __future__ import annotations

import argparse
import json
import os
import sys
import urllib.request
from pathlib import Path

TOOL_ID = "envguard-secrets-vault"
TOOL_NAME = "EnvGuard Secrets Vault"
TOOL_VERSION = "2.6.0"
TOOL_PORT = 8088
BASE_URL = f"http://127.0.0.1:{TOOL_PORT}"
BRAILLE_BARS = " ⣀⣤⣶⣿"


def _ensure_import_path() -> str:
    for candidate, display in (
        (Path("/opt/envguard-secrets-vault/src"), "/opt/envguard-secrets-vault"),
        (Path.home() / "NullAITech" / "envguard-secrets-vault" / "src", "~/NullAITech/envguard-secrets-vault"),
    ):
        if (candidate / "envguard_secrets_vault" / "mcp_server.py").is_file():
            if str(candidate) not in sys.path:
                sys.path.insert(0, str(candidate))
            return display
    return "/opt/envguard-secrets-vault"


def _http_get_json(path: str) -> dict:
    try:
        req = urllib.request.Request(f"{BASE_URL}{path}", headers={"Host": f"127.0.0.1:{TOOL_PORT}"})
        with urllib.request.urlopen(req, timeout=1.5) as resp:
            if resp.status == 200:
                return json.loads(resp.read().decode("utf-8"))
    except Exception:
        pass
    return {}


def _braille_meter(ratio: float, width: int = 20) -> str:
    clamped = max(0.0, min(1.0, float(ratio)))
    filled = int(round(clamped * width))
    return ("⣿" * filled) + ("⣀" * (width - filled))


def collect_telemetry() -> dict:
    runtime_root = _ensure_import_path()
    health = _http_get_json("/api/health")
    diag = _http_get_json("/api/diagnostics")

    local_scan = {}
    try:
        from envguard_secrets_vault.mcp_server import (
            MCP_TOOLS_DEFINITIONS,
            PBKDF2_ITERATIONS,
            SECRET_DETECTORS,
            scan_secrets,
        )

        probe_sample = "PORT=8088\nNODE_ENV=production\nAPP_URL=http://127.0.0.1:8088\n"
        cwd_env = Path.cwd() / ".env"
        source_label = "cwd:.env" if cwd_env.is_file() else "self-probe"
        content = cwd_env.read_text(encoding="utf-8", errors="replace") if cwd_env.is_file() else probe_sample
        res = scan_secrets(content, source=source_label)
        local_scan = {
            "source": source_label,
            "score": res["score"],
            "grade": res["grade"],
            "findings_count": len(res["findings"]),
            "detectors_loaded": len(SECRET_DETECTORS),
            "mcp_tools_count": len(MCP_TOOLS_DEFINITIONS),
            "kdf_iterations": PBKDF2_ITERATIONS,
        }
    except Exception as exc:
        local_scan = {"source": "unavailable", "error": str(exc), "score": 0, "grade": "?", "findings_count": 0}

    daemon_online = bool(health.get("app") == TOOL_ID)
    crypto = diag.get("crypto_suite", {})
    return {
        "id": TOOL_ID,
        "name": TOOL_NAME,
        "version": TOOL_VERSION,
        "runtime_root": runtime_root,
        "daemon_url": BASE_URL,
        "daemon_online": daemon_online,
        "daemon_status": health.get("status", "offline"),
        "daemon_version": health.get("version"),
        "cipher": crypto.get("cipher", "AES-256-CTR (NIST FIPS 197)"),
        "kdf": crypto.get("key_derivation", "PBKDF2-HMAC-SHA256"),
        "kdf_iterations": crypto.get("kdf_iterations", local_scan.get("kdf_iterations", 600000)),
        "mac": crypto.get("mac_algorithm", "HMAC-SHA256 (Encrypt-then-MAC)"),
        "total_detectors": diag.get("total_detectors", local_scan.get("detectors_loaded", 0)),
        "mcp_tools": local_scan.get("mcp_tools_count", 11),
        "posture": local_scan,
    }


def render_braille_dashboard(data: dict) -> str:
    score = int(data["posture"].get("score", 0))
    meter = _braille_meter(score / 100.0, width=24)
    status = "ONLINE" if data["daemon_online"] else "OFFLINE"
    lines = [
        "⣿" * 64,
        f"  {data['name']} v{data['version']} — Live Braille Telemetry",
        "⣀" * 64,
        f"  Daemon (:8088) : {status} ({data['daemon_url']})",
        f"  Runtime Root   : {data['runtime_root']}",
        f"  Cipher Suite   : {data['kdf']} ({data['kdf_iterations']:,} rounds) + {data['cipher']}",
        f"  MAC Integrity  : {data['mac']}",
        f"  Detectors / MCP: {data['total_detectors']} regex rules  |  {data['mcp_tools']} stdio MCP tools",
        f"  Posture ({data['posture'].get('source')}): {score:3d}/100 ({data['posture'].get('grade')})  [{meter}]",
        f"  Findings       : {data['posture'].get('findings_count', 0)} active findings",
        "⣿" * 64,
    ]
    return "\n".join(lines)


def main() -> int:
    parser = argparse.ArgumentParser(
        prog=f"{TOOL_ID}-tui",
        description=f"{TOOL_NAME} v{TOOL_VERSION} — Live Unicode Braille Telemetry TUI",
    )
    parser.add_argument("--once", action="store_true", help="Render one snapshot and exit")
    parser.add_argument("--status", action="store_true", help="Print concise one-line status and exit")
    parser.add_argument("--json", action="store_true", help="Emit live telemetry as JSON")
    args, _ = parser.parse_known_args()

    data = collect_telemetry()
    if args.json:
        print(json.dumps(data, indent=2))
        return 0
    if args.status:
        state = "ONLINE" if data["daemon_online"] else "OFFLINE"
        print(
            f"{TOOL_ID} v{TOOL_VERSION} [{state}] port={TOOL_PORT} "
            f"kdf={data['kdf_iterations']} detectors={data['total_detectors']} mcp={data['mcp_tools']}"
        )
        return 0

    print(render_braille_dashboard(data))
    return 0


if __name__ == "__main__":
    sys.exit(main())
