#!/bin/bash
set +e

CHROOT=$(mount | grep proc | grep calamares | awk '{print $3}' | sed -e "s#/proc##g")

if [ -z "$CHROOT" ] || [ ! -d "$CHROOT" ]; then
    echo "calamares-bootloader-config: CHROOT not found, skipping."
    exit 0
fi

# Ensure DNS resolution is copied into target chroot if available on live system
if [ -f /etc/resolv.conf ]; then
    cp -L /etc/resolv.conf "$CHROOT/etc/resolv.conf" 2>/dev/null || true
fi

# Install luks utilities if needed.
if [ "$(mount | grep "$CHROOT " | cut -c -16)" = "/dev/mapper/luks" ]; then
    echo "UMASK=0077" > "$CHROOT/etc/initramfs-tools/conf.d/initramfs-permissions"
    DEBIAN_FRONTEND=noninteractive chroot "$CHROOT" apt-get -y --no-install-recommends install cryptsetup-initramfs cryptsetup keyutils 2>/dev/null || true
fi

echo "Running bootloader-config..."

# Try installing grub package matching target firmware via apt (uses cache or network)
if [ -d /sys/firmware/efi/efivars ]; then
    echo " * Installing grub-efi (uefi)..."
    DEBIAN_FRONTEND=noninteractive chroot "$CHROOT" apt-get -y --no-install-recommends install grub-efi 2>/dev/null || \
    DEBIAN_FRONTEND=noninteractive chroot "$CHROOT" apt-get -y --no-install-recommends install grub-efi-amd64 2>/dev/null || true
else
    echo " * Installing grub-pc (bios)..."
    DEBIAN_FRONTEND=noninteractive chroot "$CHROOT" apt-get -y --no-install-recommends install grub-pc 2>/dev/null || true
fi

# Fallback: install cached grub deb packages directly via dpkg if grub-install is still missing
if [ ! -x "$CHROOT/usr/sbin/grub-install" ]; then
    echo " * Installing grub packages from cache..."
    chroot "$CHROOT" dpkg -i --force-depends /var/cache/apt/archives/grub-*.deb 2>/dev/null || true
fi

# Re-enable os-prober in /etc/default/grub:
if [ -f "$CHROOT/etc/default/grub" ]; then
    sed -i "s/#GRUB_DISABLE_OS_PROBER=false/# OS_PROBER re-enabled by ZothOS Calamares installation:\nGRUB_DISABLE_OS_PROBER=false/g" "$CHROOT/etc/default/grub"
fi

# Run update-grub if available
if [ -x "$CHROOT/usr/sbin/update-grub" ]; then
    echo " * Running update-grub..."
    chroot "$CHROOT" /usr/sbin/update-grub 2>/dev/null || true
fi

exit 0
