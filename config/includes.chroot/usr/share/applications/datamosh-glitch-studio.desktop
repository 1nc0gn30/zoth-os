[Desktop Entry]
Version=1.0
Type=Application
Name=Datamosh Glitch Studio
Comment=100% in-browser parametric video datamosh synthesizer, H.264 I-frame drop corruption, CRT scanlines, procedural cassette brand media, and li
Exec=/usr/local/bin/datamosh-glitch-studio desktop
TryExec=/usr/local/bin/datamosh-glitch-studio
Icon=datamosh-glitch-studio
Terminal=false
Categories=Development;Utility;ArtificialIntelligence;
StartupNotify=true
Actions=TUI;WebApp;

[Desktop Action TUI]
Name=Launch Datamosh Glitch Studio Braille TUI
Exec=/usr/local/bin/zoth-konsole --title "Datamosh Glitch Studio TUI" -e /usr/local/bin/datamosh-glitch-studio-tui

[Desktop Action WebApp]
Name=Open Local Web Workstation (:8081)
Exec=xdg-open http://127.0.0.1:8081
