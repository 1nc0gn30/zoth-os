[Desktop Entry]
Version=1.0
Type=Application
Name=GhidraMCP Binary Reverse Engineering Bridge
Comment=Local Model Context Protocol (MCP) binary reverse engineering bridge for ELF/PE/Mach-O/WASM inspection, disassembly, decompilation, and Shannon entropy analysis.
Exec=/usr/local/bin/ghidra-mcp-bridge desktop
TryExec=/usr/local/bin/ghidra-mcp-bridge
Icon=ghidra-mcp-bridge
Terminal=false
Categories=Development;Security;X-Zoth-Security;
StartupNotify=true
Actions=TUI;WebApp;

[Desktop Action TUI]
Name=Launch GhidraMCP Telemetry TUI
Exec=/usr/local/bin/zoth-konsole --title "GhidraMCP Binary Reverse Engineering Bridge TUI" -- /usr/local/bin/ghidra-mcp-bridge-tui

[Desktop Action WebApp]
Name=Open Local Web Workstation (:8131)
Exec=xdg-open http://127.0.0.1:8131
