[Desktop Entry]
Version=1.0
Type=Application
Name=Zoth AppImages
Comment=Curated Standalone Tools & Desktop Installer
Exec=/usr/local/bin/zoth-konsole --pause --title "Zoth AppImages" -- bash -c "zoth appimage list; echo; echo 'Usage: zoth appimage install <app_id> (e.g. zoth appimage install obsidian)'"
Icon=start-here
Terminal=false
Categories=Application;Development;System;
StartupNotify=true
