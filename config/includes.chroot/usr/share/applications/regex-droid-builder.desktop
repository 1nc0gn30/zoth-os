[Desktop Entry]
Version=1.0
Type=Application
Name=Regex Droid Studio
Comment=100% in-browser visual regular expression builder, AST breakdown, railroad vector diagrams, multi-language code generator, and static ReDoS 
Exec=/usr/local/bin/regex-droid-builder desktop
TryExec=/usr/local/bin/regex-droid-builder
Icon=regex-droid-builder
Terminal=false
Categories=Development;Utility;ArtificialIntelligence;
StartupNotify=true
Actions=TUI;WebApp;

[Desktop Action TUI]
Name=Launch Regex Droid Studio Braille TUI
Exec=/usr/local/bin/zoth-konsole --title "Regex Droid Studio TUI" -e /usr/local/bin/regex-droid-builder-tui

[Desktop Action WebApp]
Name=Open Local Web Workstation (:8101)
Exec=xdg-open http://127.0.0.1:8101
