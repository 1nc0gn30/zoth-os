[Desktop Entry]
Version=1.0
Type=Application
Name=Agent Voice Call
Comment=Autonomous sovereign real-time voice cockpit, live audio WebSocket streaming, multi-persona voice synthesizer, and zero-telemetry call proto
Exec=/usr/local/bin/agent-voice-call desktop
TryExec=/usr/local/bin/agent-voice-call
Icon=agent-voice-call
Terminal=false
Categories=Development;Utility;ArtificialIntelligence;
StartupNotify=true
Actions=TUI;WebApp;

[Desktop Action TUI]
Name=Launch Agent Voice Call Braille TUI
Exec=/usr/local/bin/zoth-konsole --title "Agent Voice Call TUI" -e /usr/local/bin/agent-voice-call-tui

[Desktop Action WebApp]
Name=Open Local Web Workstation (:8114)
Exec=xdg-open http://127.0.0.1:8114
