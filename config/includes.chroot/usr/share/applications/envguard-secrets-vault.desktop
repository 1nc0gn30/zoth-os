[Desktop Entry]
Version=1.0
Type=Application
Name=EnvGuard Secrets Vault
Comment=Argon2id + AES-256-GCM hardware vault for zero-cloud secret storage, Shamir quorum splitting, and leak scanning.
Exec=/usr/local/bin/envguard-secrets-vault desktop
TryExec=/usr/local/bin/envguard-secrets-vault
Icon=envguard-secrets-vault
Terminal=false
Categories=Development;Utility;ArtificialIntelligence;
StartupNotify=true
Actions=TUI;WebApp;

[Desktop Action TUI]
Name=Launch EnvGuard Secrets Vault Braille TUI
Exec=/usr/local/bin/zoth-konsole --title "EnvGuard Secrets Vault TUI" -e /usr/local/bin/envguard-secrets-vault-tui

[Desktop Action WebApp]
Name=Open Local Web Workstation (:8088)
Exec=xdg-open http://127.0.0.1:8088
