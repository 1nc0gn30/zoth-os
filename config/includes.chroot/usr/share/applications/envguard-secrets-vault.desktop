[Desktop Entry]
Version=1.0
Type=Application
Name=EnvGuard Secrets Vault
Comment=Zero-exposure .env secret scanner, PBKDF2 + AES-256-CTR-HMAC vault, Shamir quorum & 11-tool MCP server
Exec=/usr/local/bin/envguard-secrets-vault desktop
TryExec=/usr/local/bin/envguard-secrets-vault
Icon=envguard-secrets-vault
Terminal=false
Categories=X-Zoth-Security;Development;Utility;
StartupNotify=true
Actions=TUI;WebApp;

[Desktop Action TUI]
Name=Launch EnvGuard Secrets Vault Braille TUI
Exec=/usr/local/bin/zoth-konsole --title "EnvGuard Secrets Vault TUI" -- /usr/local/bin/envguard-secrets-vault-tui

[Desktop Action WebApp]
Name=Open Local Web Workstation (:8088)
Exec=xdg-open http://127.0.0.1:8088
