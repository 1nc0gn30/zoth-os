[Desktop Entry]
Version=1.0
Type=Application
Name=Domain Intel OSINT Scout
Comment=100% in-browser passive domain intelligence & attack surface reconnaissance engine auditing Certificate Transparency logs, DoH DNS records, 
Exec=/usr/local/bin/osint-scout-skill desktop
TryExec=/usr/local/bin/osint-scout-skill
Icon=osint-scout-skill
Terminal=false
Categories=Development;Utility;ArtificialIntelligence;
StartupNotify=true
Actions=TUI;WebApp;

[Desktop Action TUI]
Name=Launch Domain Intel OSINT Scout Braille TUI
Exec=/usr/local/bin/zoth-konsole --title "Domain Intel OSINT Scout TUI" -e /usr/local/bin/osint-scout-skill-tui

[Desktop Action WebApp]
Name=Open Local Web Workstation (:8085)
Exec=xdg-open http://127.0.0.1:8085
