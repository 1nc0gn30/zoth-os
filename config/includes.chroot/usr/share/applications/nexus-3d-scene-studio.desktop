[Desktop Entry]
Version=1.0
Type=Application
Name=Nexus 3D Scene Studio
Comment=100% in-browser WebGL mathematical 3D geometry engine, 4D Tesseract, parametric surfaces, FastMCP server, procedural tesseract brand media, 
Exec=/usr/local/bin/nexus-3d-scene-studio desktop
TryExec=/usr/local/bin/nexus-3d-scene-studio
Icon=nexus-3d-scene-studio
Terminal=false
Categories=Development;Utility;ArtificialIntelligence;
StartupNotify=true
Actions=TUI;WebApp;

[Desktop Action TUI]
Name=Launch Nexus 3D Scene Studio Braille TUI
Exec=/usr/local/bin/zoth-konsole --title "Nexus 3D Scene Studio TUI" -e /usr/local/bin/nexus-3d-scene-studio-tui

[Desktop Action WebApp]
Name=Open Local Web Workstation (:8082)
Exec=xdg-open http://127.0.0.1:8082
