[Desktop Entry]
Version=1.0
Type=Application
Name=Zoth QuickSite Starter
Comment=Simple 3-step static template & 1-click Netlify launcher on 127.0.0.1:8092. Pick a ready-made template, preview live, and export HTML/ZIP or
Exec=/usr/local/bin/zoth-webgen desktop
TryExec=/usr/local/bin/zoth-webgen
Icon=zoth-webgen
Terminal=false
Categories=Development;Utility;ArtificialIntelligence;
StartupNotify=true
Actions=TUI;WebApp;

[Desktop Action TUI]
Name=Launch Zoth QuickSite Starter Braille TUI
Exec=/usr/local/bin/zoth-konsole --title "Zoth QuickSite Starter TUI" -e /usr/local/bin/zoth-webgen-tui

[Desktop Action WebApp]
Name=Open Local Web Workstation (:8092)
Exec=xdg-open http://127.0.0.1:8092
