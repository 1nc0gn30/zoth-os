[Desktop Entry]
Version=1.0
Type=Application
Name=Agent God's Eye
Comment=Autonomous zero-dependency Shodan OSINT tactical radar, 3D kinetic planetary attack surface reconnaissance, and threat scoring.
Exec=/usr/local/bin/agent-gods-eye desktop
TryExec=/usr/local/bin/agent-gods-eye
Icon=agent-gods-eye
Terminal=false
Categories=Development;Utility;ArtificialIntelligence;
StartupNotify=true
Actions=TUI;WebApp;

[Desktop Action TUI]
Name=Launch Agent God's Eye Braille TUI
Exec=/usr/local/bin/zoth-konsole --title "Agent God's Eye TUI" -e /usr/local/bin/agent-gods-eye-tui

[Desktop Action WebApp]
Name=Open Local Web Workstation (:8112)
Exec=xdg-open http://127.0.0.1:8112
