[Desktop Entry]
Version=1.0
Type=Application
Name=Shopify Connector
Comment=Shopify GraphQL Admin API & POD sync engine with 1-click Etsy listing transpiler, net profit simulator, and Antigravity MCP suite.
Exec=/usr/local/bin/shopify-connector desktop
TryExec=/usr/local/bin/shopify-connector
Icon=shopify-connector
Terminal=false
Categories=Development;Utility;ArtificialIntelligence;
StartupNotify=true
Actions=TUI;WebApp;

[Desktop Action TUI]
Name=Launch Shopify Connector Braille TUI
Exec=/usr/local/bin/zoth-konsole --title "Shopify Connector TUI" -e /usr/local/bin/shopify-connector-tui

[Desktop Action WebApp]
Name=Open Local Web Workstation (:8113)
Exec=xdg-open http://127.0.0.1:8113
