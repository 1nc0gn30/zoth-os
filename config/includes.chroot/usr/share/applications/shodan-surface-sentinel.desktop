[Desktop Entry]
Version=1.0
Type=Application
Name=Shodan Attack Surface Sentinel
Comment=Zero-egress defensive asset auditor and InternetDB engine. Inspects open ports, CPE software stacks, and confirmed CVE exposures for your in
Exec=/usr/local/bin/shodan-surface-sentinel desktop
TryExec=/usr/local/bin/shodan-surface-sentinel
Icon=shodan-surface-sentinel
Terminal=false
Categories=Development;Utility;ArtificialIntelligence;
StartupNotify=true
Actions=TUI;WebApp;

[Desktop Action TUI]
Name=Launch Shodan Attack Surface Sentinel Braille TUI
Exec=/usr/local/bin/zoth-konsole --title "Shodan Attack Surface Sentinel TUI" -e /usr/local/bin/shodan-surface-sentinel-tui

[Desktop Action WebApp]
Name=Open Local Web Workstation (:8130)
Exec=xdg-open http://127.0.0.1:8130
