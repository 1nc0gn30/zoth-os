[Desktop Entry]
Version=1.0
Type=Application
Name=Zoth Tool Nexus
Comment=Kali and Parrot security tools, AI & sovereign runtimes orchestrator
Exec=/usr/local/bin/zoth-tool-nexus --gui
Icon=/usr/share/pixmaps/zoth-tool-nexus.png
Terminal=false
Categories=System;Development;Security;Pentesting;
StartupNotify=true
Actions=Terminal;Doctor;InstallAll;

[Desktop Action Terminal]
Name=Open in Terminal (TUI)
Exec=/usr/local/bin/zoth-konsole --title "ZOTHOS Tool Nexus" -- zoth-tool-nexus --tui

[Desktop Action Doctor]
Name=Run System Diagnostics
Exec=/usr/local/bin/zoth-konsole --pause --title "ZOTHOS Doctor" -- zoth-tool-nexus --doctor

[Desktop Action InstallAll]
Name=Batch Install All Missing Arsenal
Exec=/usr/local/bin/zoth-konsole --pause --title "ZOTHOS Provisioner" -- zoth-tool-nexus --install-all
