[Desktop Entry]
Version=1.0
Type=Application
Name=PromptMaster Studio
Comment=100% in-browser prompt engineering and meta-optimization studio with real-time AST linting, multi-model rewrites (Claude, ChatGPT, Gemini), 
Exec=/usr/local/bin/promptmaster-studio desktop
TryExec=/usr/local/bin/promptmaster-studio
Icon=promptmaster-studio
Terminal=false
Categories=Development;Utility;ArtificialIntelligence;
StartupNotify=true
Actions=TUI;WebApp;

[Desktop Action TUI]
Name=Launch PromptMaster Studio Braille TUI
Exec=/usr/local/bin/zoth-konsole --title "PromptMaster Studio TUI" -e /usr/local/bin/promptmaster-studio-tui

[Desktop Action WebApp]
Name=Open Local Web Workstation (:8123)
Exec=xdg-open http://127.0.0.1:8123
