[Desktop Entry]
Version=1.0
Type=Application
Name=MCP Lens
Comment=Zero-dependency real-time stdio/SSE traffic sniffer, token weight auditor, and visual playground for Model Context Protocol.
Exec=/usr/local/bin/mcp-lens desktop
TryExec=/usr/local/bin/mcp-lens
Icon=mcp-lens
Terminal=false
Categories=Development;Utility;ArtificialIntelligence;
StartupNotify=true
Actions=TUI;WebApp;

[Desktop Action TUI]
Name=Launch MCP Lens Braille TUI
Exec=/usr/local/bin/zoth-konsole --title "MCP Lens TUI" -e /usr/local/bin/mcp-lens-tui

[Desktop Action WebApp]
Name=Open Local Web Workstation (:8109)
Exec=xdg-open http://127.0.0.1:8109
