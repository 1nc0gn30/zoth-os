[Desktop Entry]
Version=1.0
Type=Application
Name=AZOTH Local Archon Agent
Comment=Archon Orchestrator core agent for local zero-telemetry task dispatching and subagent delegation.
Exec=/usr/local/bin/azoth-local-agent desktop
TryExec=/usr/local/bin/azoth-local-agent
Icon=azoth-local-agent
Terminal=false
Categories=Development;Utility;ArtificialIntelligence;
StartupNotify=true
Actions=TUI;WebApp;

[Desktop Action TUI]
Name=Launch AZOTH Local Archon Agent Braille TUI
Exec=/usr/local/bin/zoth-konsole --title "AZOTH Local Archon Agent TUI" -e /usr/local/bin/azoth-local-agent-tui

[Desktop Action WebApp]
Name=Open Local Web Workstation (:8136)
Exec=xdg-open http://127.0.0.1:8136
