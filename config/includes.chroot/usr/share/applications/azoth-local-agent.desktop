[Desktop Entry]
Version=1.0
Type=Application
Name=AZOTH Local Archon Agent
GenericName=Autonomous Local Archon Agent & Multi-Engine Orchestrator
Comment=Local-first Autonomous Archon Agent, Hardened FastAPI Cockpit (:8136), Sandboxed Browser, VM Bridge & MCP Server
Exec=/usr/local/bin/azoth-local-agent desktop
TryExec=/usr/local/bin/azoth-local-agent
Icon=azoth-local-agent
Terminal=false
Categories=X-Zoth-AI;Development;Utility;ArtificialIntelligence;
StartupNotify=true
Actions=TUI;WebApp;

[Desktop Action TUI]
Name=Launch AZOTH Local Archon Agent TUI
Exec=/usr/local/bin/zoth-konsole --title "AZOTH Local Archon Agent TUI" -- /usr/local/bin/azoth-local-agent-tui

[Desktop Action WebApp]
Name=Open Local Web Cockpit (Port 8136)
Exec=xdg-open http://127.0.0.1:8136
