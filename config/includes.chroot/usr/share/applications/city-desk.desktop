[Desktop Entry]
Version=1.0
Type=Application
Name=City Desk
Comment=One studio writes the finished page for a trade and a city. 1,000 localized service pages across 20 trades and 50 mid-size cities with live 
Exec=/usr/local/bin/city-desk desktop
TryExec=/usr/local/bin/city-desk
Icon=city-desk
Terminal=false
Categories=Development;Utility;ArtificialIntelligence;
StartupNotify=true
Actions=TUI;WebApp;

[Desktop Action TUI]
Name=Launch City Desk Braille TUI
Exec=/usr/local/bin/zoth-konsole --title "City Desk TUI" -e /usr/local/bin/city-desk-tui

[Desktop Action WebApp]
Name=Open Local Web Workstation (:8087)
Exec=xdg-open http://127.0.0.1:8087
