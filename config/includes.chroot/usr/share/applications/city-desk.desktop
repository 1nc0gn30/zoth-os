[Desktop Entry]
Version=1.0
Type=Application
Name=City Desk
Comment=Deterministic 1,000-page local trade offer compiler (20 trades x 50 US cities) with live synthesizer and standalone HTML export.
Exec=/usr/local/bin/city-desk desktop
TryExec=/usr/local/bin/city-desk
Icon=city-desk
Terminal=false
Categories=X-Zoth-Dev;Development;Utility;
StartupNotify=true
Actions=TUI;WebApp;

[Desktop Action TUI]
Name=Launch City Desk Inventory TUI
Exec=/usr/local/bin/zoth-konsole --title "City Desk TUI" -- /usr/local/bin/city-desk-tui

[Desktop Action WebApp]
Name=Open Local Web Workstation (:8087)
Exec=xdg-open http://127.0.0.1:8087
