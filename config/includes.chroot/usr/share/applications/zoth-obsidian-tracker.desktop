[Desktop Entry]
Version=1.0
Type=Application
Name=Zoth Obsidian Tracker
Comment=Sovereign Second Brain, 5 Ecosystem Pillars & Arsenal Verification Web App (:8151)
Exec=/usr/local/bin/zoth-obsidian-tracker --open
TryExec=/usr/local/bin/zoth-obsidian-tracker
Icon=obsidian
Terminal=false
Categories=Development;Documentation;System;
StartupNotify=true
Actions=WebApp;TUI;

[Desktop Action WebApp]
Name=Open Local Web Workstation (:8151)
Exec=xdg-open http://127.0.0.1:8151

[Desktop Action TUI]
Name=Launch Braille TUI
Exec=x-terminal-emulator -e /usr/local/bin/zoth-obsidian-tracker-tui
