[Desktop Entry]
Version=1.0
Type=Application
Name=DeepSearch Research Agent & Studio
GenericName=Multi-Source Grounded Research Workstation
Comment=Zero-dependency 5-stage Tree-of-Thought research agent with citation provenance graphs, contradiction detection, MCP server, and BibTeX exports.
Exec=/usr/local/bin/deepsearch-research-agent desktop
Icon=/opt/deepsearch-research-agent/public/icon.png
Terminal=false
Categories=Development;Science;Education;Network;X-Zoth-AI;
Keywords=deepsearch;research;citations;bibtex;mcp;zothos;nullai;
StartupNotify=true
Actions=TUI;

[Desktop Action TUI]
Name=Launch Braille Citation-DAG TUI
Exec=konsole -- /usr/local/bin/deepsearch-research-agent-tui --once
