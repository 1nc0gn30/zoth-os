[Desktop Entry]
Version=1.0
Type=Application
Name=Bitwarden Vault
Comment=Access and manage your Bitwarden vault CLI
Exec=/usr/local/bin/zoth-konsole --title "Bitwarden Vault" -- /usr/local/bin/zoth-vault bw
