[Desktop Entry]
Version=1.0
Type=Application
Name=Cyber Turtle Studio
GenericName=L-System Fractal & CNC Plotter Workstation
Comment=Zero-egress L-System fractal synthesizer (28 presets), bounded Logo DSL, 2-Opt TSP optimizer, and CNC G-Code / SVG / Braille workstation.
Exec=/usr/local/bin/cyber-turtle-studio desktop
TryExec=/usr/local/bin/cyber-turtle-studio
Icon=cyber-turtle-studio
Terminal=false
Categories=X-Zoth-Media;Development;Graphics;VectorGraphics;Utility;
StartupNotify=true
Actions=TUI;WebApp;

[Desktop Action TUI]
Name=Launch Cyber Turtle Studio Braille TUI
Exec=/usr/local/bin/zoth-konsole --title "Cyber Turtle Studio TUI" -- /usr/local/bin/cyber-turtle-studio-tui --once

[Desktop Action WebApp]
Name=Open Local Web Workstation (:8129)
Exec=xdg-open http://127.0.0.1:8129
