[Desktop Entry]
Version=1.0
Type=Application
Name=POD Mockup Forge
Comment=Autonomous photorealistic mockup studio with 60fps Lumen Matrix, fabric ink blending, and Etsy 2026 photo standards compliance auditor.
Exec=/usr/local/bin/pod-mockup-forge desktop
TryExec=/usr/local/bin/pod-mockup-forge
Icon=pod-mockup-forge
Terminal=false
Categories=Development;Utility;ArtificialIntelligence;
StartupNotify=true
Actions=TUI;WebApp;

[Desktop Action TUI]
Name=Launch POD Mockup Forge Braille TUI
Exec=/usr/local/bin/zoth-konsole --title "POD Mockup Forge TUI" -e /usr/local/bin/pod-mockup-forge-tui

[Desktop Action WebApp]
Name=Open Local Web Workstation (:8119)
Exec=xdg-open http://127.0.0.1:8119
