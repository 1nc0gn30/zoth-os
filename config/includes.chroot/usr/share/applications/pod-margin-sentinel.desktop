[Desktop Entry]
Version=1.0
Type=Application
Name=POD Margin Sentinel
Comment=Autonomous real-time profit sentinel, break-even solver, and 2026 fee simulator across Etsy (Organic & 15% Ads), Shopify, and TikTok Shop.
Exec=/usr/local/bin/pod-margin-sentinel desktop
TryExec=/usr/local/bin/pod-margin-sentinel
Icon=pod-margin-sentinel
Terminal=false
Categories=Development;Utility;ArtificialIntelligence;
StartupNotify=true
Actions=TUI;WebApp;

[Desktop Action TUI]
Name=Launch POD Margin Sentinel Braille TUI
Exec=/usr/local/bin/zoth-konsole --title "POD Margin Sentinel TUI" -e /usr/local/bin/pod-margin-sentinel-tui

[Desktop Action WebApp]
Name=Open Local Web Workstation (:8120)
Exec=xdg-open http://127.0.0.1:8120
