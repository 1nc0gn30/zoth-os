[Desktop Entry]
Version=1.0
Type=Application
Name=Likeness Desk (AI Video Double)
Comment=Local video double on GPU; Chatterbox Turbo voice cloning and Wav2Lip photorealistic mouth animation on Quadro P1000 with zero cloud leakage
Exec=/usr/local/bin/likeness-desk desktop
TryExec=/usr/local/bin/likeness-desk
Icon=likeness-desk
Terminal=false
Categories=Development;Utility;ArtificialIntelligence;
StartupNotify=true
Actions=TUI;WebApp;

[Desktop Action TUI]
Name=Launch Likeness Desk (AI Video Double) Braille TUI
Exec=/usr/local/bin/zoth-konsole --title "Likeness Desk (AI Video Double) TUI" -e /usr/local/bin/likeness-desk-tui

[Desktop Action WebApp]
Name=Open Local Web Workstation (:9395)
Exec=xdg-open http://127.0.0.1:9395
