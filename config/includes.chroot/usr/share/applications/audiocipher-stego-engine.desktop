[Desktop Entry]
Version=1.0
Type=Application
Name=AudioCipher Stego Studio
Comment=100% in-browser acoustic cryptography, PCM audio LSB steganography, DTMF Goertzel decoder, ITU Morse synthesizer, and ultrasonic BFSK air-ga
Exec=/usr/local/bin/audiocipher-stego-engine desktop
TryExec=/usr/local/bin/audiocipher-stego-engine
Icon=audiocipher-stego-engine
Terminal=false
Categories=Development;Utility;ArtificialIntelligence;
StartupNotify=true
Actions=TUI;WebApp;

[Desktop Action TUI]
Name=Launch AudioCipher Stego Studio Braille TUI
Exec=/usr/local/bin/zoth-konsole --title "AudioCipher Stego Studio TUI" -e /usr/local/bin/audiocipher-stego-engine-tui

[Desktop Action WebApp]
Name=Open Local Web Workstation (:8096)
Exec=xdg-open http://127.0.0.1:8096
