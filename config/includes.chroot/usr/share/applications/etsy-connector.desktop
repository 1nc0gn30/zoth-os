[Desktop Entry]
Version=1.0
Type=Application
Name=Etsy Connector
Comment=Etsy Open API v3 & Antigravity MCP bridge with 13-tag SEO auditor, fee/profit calculator, and Printify payload generator.
Exec=/usr/local/bin/etsy-connector desktop
TryExec=/usr/local/bin/etsy-connector
Icon=etsy-connector
Terminal=false
Categories=Development;Utility;ArtificialIntelligence;
StartupNotify=true
Actions=TUI;WebApp;

[Desktop Action TUI]
Name=Launch Etsy Connector Braille TUI
Exec=/usr/local/bin/zoth-konsole --title "Etsy Connector TUI" -e /usr/local/bin/etsy-connector-tui

[Desktop Action WebApp]
Name=Open Local Web Workstation (:8108)
Exec=xdg-open http://127.0.0.1:8108
