[Desktop Entry]
Version=1.0
Type=Application
Name=Zoth OSINT Workstation
Comment=Sovereign open-source intelligence, passive reconnaissance, and forensic dossier compiler
Exec=/usr/local/bin/zoth-osint desktop
TryExec=/usr/local/bin/zoth-osint
Icon=zoth-osint
Terminal=false
Categories=Security;Network;Development;
StartupNotify=true
Actions=TUI;WebApp;

[Desktop Action TUI]
Name=Launch Zoth OSINT Braille TUI
Exec=/usr/local/bin/zoth-konsole --title "Zoth OSINT TUI" -e /usr/local/bin/zoth-osint-tui

[Desktop Action WebApp]
Name=Open Local Web Workstation (:8149)
Exec=xdg-open http://127.0.0.1:8149
