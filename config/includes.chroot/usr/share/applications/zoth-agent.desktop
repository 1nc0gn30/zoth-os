[Desktop Entry]
Version=1.0
Type=Application
Name=Zoth Agent CLI
Comment=Autonomous OS Agent CLI Interface
Exec=/usr/local/bin/zoth-konsole --title "ZOTHOS Agent Terminal" -- zoth-agent-os
