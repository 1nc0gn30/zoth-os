[Desktop Entry]
Version=1.0
Type=Application
Name=HexStrike Security Arsenal
GenericName=Local-First Defensive & Red-Team Terminal
Comment=156-tool security catalog, HTTP header & Shannon entropy auditor, loopback socket probe, and 8-tool MCP server
Exec=/usr/local/bin/zoth-konsole --title "HexStrike Security Arsenal" -- /usr/local/bin/hexstrike-arsenal status
TryExec=/usr/local/bin/hexstrike-arsenal
Icon=hexstrike-arsenal
Terminal=false
Categories=X-Zoth-Security;Security;Development;System;Network;
StartupNotify=true
Actions=TUI;WebApp;

[Desktop Action TUI]
Name=Open HexStrike Braille Monitor (TUI)
Exec=/usr/local/bin/zoth-konsole --title "HexStrike Braille Monitor" -- /usr/local/bin/hexstrike-arsenal-tui --status

[Desktop Action WebApp]
Name=Start Loopback Web Workstation (:8138)
Exec=/usr/local/bin/zoth-konsole --title "HexStrike Daemon :8138" -- /usr/local/bin/hexstrike-arsenal serve --port 8138
