[Desktop Entry]
Version=1.0
Type=Application
Name=Zoth Sovereign Vault
Comment=Sovereign zero-leak secrets manager (Argon2id Rust Vault, Bitwarden, KeePassXC, UNIX Pass)
Exec=/usr/local/bin/zoth-konsole --title "Zoth Sovereign Vault" -- /usr/local/bin/zoth-vault
Icon=security-high
Terminal=false
Categories=Utility;Security;System;
StartupNotify=true
GenericName=Multi-Vault Secrets Manager
