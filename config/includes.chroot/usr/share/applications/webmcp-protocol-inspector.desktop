[Desktop Entry]
Version=1.0
Type=Application
Name=WebMCP Protocol Suite
Comment=In-browser Model Context Protocol (MCP) JSON-RPC 2.0 inspector, tool schema dispatcher, and Zoth OS bare-metal video showcase.
Exec=/usr/local/bin/webmcp-protocol-inspector desktop
TryExec=/usr/local/bin/webmcp-protocol-inspector
Icon=webmcp-protocol-inspector
Terminal=false
Categories=Development;Utility;ArtificialIntelligence;
StartupNotify=true
Actions=TUI;WebApp;

[Desktop Action TUI]
Name=Launch WebMCP Protocol Suite Braille TUI
Exec=/usr/local/bin/zoth-konsole --title "WebMCP Protocol Suite TUI" -e /usr/local/bin/webmcp-protocol-inspector-tui

[Desktop Action WebApp]
Name=Open Local Web Workstation (:8142)
Exec=xdg-open http://127.0.0.1:8142
