[Desktop Entry]
Version=1.0
Type=Application
Name=Agent Policy Auditor
Comment=Autonomous capability leaser, permission broker, and OWASP LLM manifest security auditor with dual Stripe + Solana rails.
Exec=/usr/local/bin/agent-policy-auditor desktop
TryExec=/usr/local/bin/agent-policy-auditor
Icon=agent-policy-auditor
Terminal=false
Categories=Development;Utility;ArtificialIntelligence;
StartupNotify=true
Actions=TUI;WebApp;

[Desktop Action TUI]
Name=Launch Agent Policy Auditor Braille TUI
Exec=/usr/local/bin/zoth-konsole --title "Agent Policy Auditor TUI" -e /usr/local/bin/agent-policy-auditor-tui

[Desktop Action WebApp]
Name=Open Local Web Workstation (:8106)
Exec=xdg-open http://127.0.0.1:8106
