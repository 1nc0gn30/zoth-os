# ==============================================================================
#  ZOTHOS Linux 3.0 - Sovereign Master Boot Splash (Cinematic Intro Edition)
#  Features:
#  - High-Fidelity 24K Celtic Gold & Platinum Letter Intro Sequence
#  - Sequential Letter Staggered Fade-in (Z - O - T - H - O - S)
#  - Luminous Specular Caustic Gleam Sweep
#  - Sovereign Intelligence Golden Subtitle Plate
#  - Minimalist Hairline Progress Bar & Live Kernel State Telemetry
#  - LUKS Full-Disk Encryption & Crypt Password Prompt Support
# ==============================================================================

# Background gradient: deep obsidian to black
Window.SetBackgroundTopColor(0.015, 0.024, 0.020);
Window.SetBackgroundBottomColor(0.000, 0.000, 0.000);

screen_width = Window.GetWidth();
screen_height = Window.GetHeight();
screen_x = Window.GetX();
screen_y = Window.GetY();
cx = screen_x + screen_width / 2;
cy = screen_y + screen_height / 2;

# 1. Clean Obsidian Vignette Background
bg.orig = Image("bg.png");
if (bg.orig != null) {
    bg.image = bg.orig.Scale(screen_width, screen_height);
    bg.sprite = Sprite(bg.image);
    bg.sprite.SetPosition(screen_x, screen_y, 0);
    bg.sprite.SetOpacity(1.0);
}

# 2. Floating Golden Stardust Embers (Pre-allocated)
STAR_COUNT = 30;
for (i = 0; i < STAR_COUNT; i++) {
    star[i].x = Math.Random() * screen_width;
    star[i].y = Math.Random() * screen_height;
    star[i].speed = Math.Random() * 0.8 + 0.3;
    star[i].phase = Math.Random() * 6.28;
    star[i].image = Image.Point(2, 2);
    star[i].sprite = Sprite(star[i].image);
    star[i].sprite.SetPosition(star[i].x, star[i].y, 5);
    star[i].sprite.SetColor(0.98, 0.84, 0.20, 0.40);
}

# 3. Typography & Letter Geometry Layout
# Master word bounding box: native aspect ratio = 2170 / 495 = 4.3838
word_w = screen_width * 0.58;
if (word_w > 1060) word_w = 1060;
if (word_w < 460) word_w = 460;
word_h = word_w / 4.3838;

word_x = cx - word_w / 2;
word_y = cy - word_h / 2 - 45;

# Ambient Center Bloom
glow.orig = Image("glow.png");
if (glow.orig != null) {
    glow.size = word_w * 0.75;
    glow.image = glow.orig.Scale(glow.size, glow.size);
    glow.sprite = Sprite(glow.image);
    glow.sprite.SetPosition(cx - glow.size / 2, cy - glow.size / 2 - 45, 10);
    glow.sprite.SetOpacity(0.0);
}

# Letter Z (24K Celtic Gold)
letter_z.orig = Image("letter_z.png");
letter_z.w = 0.1613 * word_w;
letter_z.h = 0.9798 * word_h;
letter_z.x = word_x + 0.0000 * word_w;
letter_z.y = word_y + 0.0202 * word_h;
letter_z.image = letter_z.orig.Scale(letter_z.w, letter_z.h);
letter_z.sprite = Sprite(letter_z.image);
letter_z.sprite.SetPosition(letter_z.x, letter_z.y, 30);
letter_z.sprite.SetOpacity(0.0);

# Letter O1 (24K Celtic Gold)
letter_o1.orig = Image("letter_o1.png");
letter_o1.w = 0.1797 * word_w;
letter_o1.h = 1.0000 * word_h;
letter_o1.x = word_x + 0.1613 * word_w;
letter_o1.y = word_y;
letter_o1.image = letter_o1.orig.Scale(letter_o1.w, letter_o1.h);
letter_o1.sprite = Sprite(letter_o1.image);
letter_o1.sprite.SetPosition(letter_o1.x, letter_o1.y, 30);
letter_o1.sprite.SetOpacity(0.0);

# Letter T (24K Celtic Gold)
letter_t.orig = Image("letter_t.png");
letter_t.w = 0.1521 * word_w;
letter_t.h = 0.9798 * word_h;
letter_t.x = word_x + 0.3410 * word_w;
letter_t.y = word_y + 0.0202 * word_h;
letter_t.image = letter_t.orig.Scale(letter_t.w, letter_t.h);
letter_t.sprite = Sprite(letter_t.image);
letter_t.sprite.SetPosition(letter_t.x, letter_t.y, 30);
letter_t.sprite.SetOpacity(0.0);

# Letter H (24K Celtic Gold)
letter_h.orig = Image("letter_h.png");
letter_h.w = 0.1797 * word_w;
letter_h.h = 0.9798 * word_h;
letter_h.x = word_x + 0.4931 * word_w;
letter_h.y = word_y + 0.0202 * word_h;
letter_h.image = letter_h.orig.Scale(letter_h.w, letter_h.h);
letter_h.sprite = Sprite(letter_h.image);
letter_h.sprite.SetPosition(letter_h.x, letter_h.y, 30);
letter_h.sprite.SetOpacity(0.0);

# Letter O2 (Platinum / Silver)
letter_o2.orig = Image("letter_o2.png");
letter_o2.w = 0.1843 * word_w;
letter_o2.h = 1.0000 * word_h;
letter_o2.x = word_x + 0.6728 * word_w;
letter_o2.y = word_y;
letter_o2.image = letter_o2.orig.Scale(letter_o2.w, letter_o2.h);
letter_o2.sprite = Sprite(letter_o2.image);
letter_o2.sprite.SetPosition(letter_o2.x, letter_o2.y, 30);
letter_o2.sprite.SetOpacity(0.0);

# Letter S (Platinum / Silver)
letter_s.orig = Image("letter_s.png");
letter_s.w = 0.1429 * word_w;
letter_s.h = 1.0000 * word_h;
letter_s.x = word_x + 0.8571 * word_w;
letter_s.y = word_y;
letter_s.image = letter_s.orig.Scale(letter_s.w, letter_s.h);
letter_s.sprite = Sprite(letter_s.image);
letter_s.sprite.SetPosition(letter_s.x, letter_s.y, 30);
letter_s.sprite.SetOpacity(0.0);

# 4. Specular Caustic Sheen Beam
sheen.orig = Image("sheen.png");
if (sheen.orig != null) {
    sheen.w = word_h * 0.55;
    sheen.h = word_h;
    sheen.image = sheen.orig.Scale(sheen.w, sheen.h);
    sheen.sprite = Sprite(sheen.image);
    sheen.sprite.SetPosition(word_x - sheen.w, word_y, 40);
    sheen.sprite.SetOpacity(0.0);
}

# 5. Golden Subtitle Plate
subtitle.orig = Image("subtitle.png");
if (subtitle.orig != null) {
    subtitle.w = word_w * 0.80;
    if (subtitle.w > 720) subtitle.w = 720;
    subtitle.h = subtitle.w * 0.14;
    subtitle.image = subtitle.orig.Scale(subtitle.w, subtitle.h);
    subtitle.sprite = Sprite(subtitle.image);
    subtitle.sprite.SetPosition(cx - subtitle.w / 2, word_y + word_h + 24, 35);
    subtitle.sprite.SetOpacity(0.0);
}

# 6. Minimalist Progress Bar
bar_w = word_w * 0.44;
if (bar_w > 420) bar_w = 420;
bar_h = 4;
bar_x = cx - bar_w / 2;
bar_y = word_y + word_h + 95;

bar_bg.image = Image.Rectangle(bar_w, bar_h);
bar_bg.sprite = Sprite(bar_bg.image);
bar_bg.sprite.SetPosition(bar_x, bar_y, 50);
bar_bg.sprite.SetColor(0.08, 0.08, 0.08, 0.70);

bar_fill.image = Image.Rectangle(1, bar_h);
bar_fill.sprite = Sprite(bar_fill.image);
bar_fill.sprite.SetPosition(bar_x, bar_y, 55);
bar_fill.sprite.SetColor(0.98, 0.84, 0.14, 0.95);

status.sprite = Sprite();
status.sprite.SetPosition(bar_x, bar_y + 16, 60);

# 7. Crypt / LUKS Dialog Setup
lock.orig = Image("lock.png");
if (lock.orig != null) {
    lock.sprite = Sprite(lock.orig);
    lock.sprite.SetPosition(cx - 32, cy - 120, 500);
    lock.sprite.SetOpacity(0.0);
}

box.orig = Image("box.png");
if (box.orig != null) {
    box.sprite = Sprite(box.orig);
    box.sprite.SetPosition(cx - 170, cy - 40, 500);
    box.sprite.SetOpacity(0.0);
}

prompt.sprite = Sprite();
prompt.sprite.SetPosition(cx - 160, cy - 75, 510);
prompt.sprite.SetOpacity(0.0);

bullet.orig = Image("bullet.png");

# Global Boot State
global.time = 0.0;
global.boot_progress = 0.0;
global.smooth_progress = 0.0;
global.status_msg = "✦ INITIALIZING SOVEREIGN KERNEL";
global.mode = "boot";

# 8. Animation Refresh Callback (~50 FPS)
fun refresh_callback () {
    global.time += 0.02;
    t = global.time;

    # Embers Drift
    for (i = 0; i < STAR_COUNT; i++) {
        star[i].y -= star[i].speed;
        if (star[i].y < 0) {
            star[i].y = screen_height;
            star[i].x = Math.Random() * screen_width;
        }
        star[i].sprite.SetPosition(star[i].x, star[i].y, 5);
        star[i].sprite.SetOpacity(0.20 + Math.Sin(t * 2.5 + star[i].phase) * 0.25);
    }

    # Center Bloom
    if (glow.orig != null) {
        if (t < 0.6) {
            glow.sprite.SetOpacity(t * 0.6);
        } else {
            pulse = 0.38 + Math.Sin(t * 1.8) * 0.12;
            glow.sprite.SetOpacity(pulse);
        }
    }

    # Sequential Letter Entrance
    # Z (0.35s - 0.75s)
    if (t < 0.35) {
        letter_z.sprite.SetOpacity(0.0);
    } else {
        p = (t - 0.35) / 0.40;
        if (p > 1.0) p = 1.0;
        inv = 1.0 - p;
        letter_z.sprite.SetOpacity(1.0 - inv * inv * inv);
    }

    # O1 (0.65s - 1.05s)
    if (t < 0.65) {
        letter_o1.sprite.SetOpacity(0.0);
    } else {
        p = (t - 0.65) / 0.40;
        if (p > 1.0) p = 1.0;
        inv = 1.0 - p;
        letter_o1.sprite.SetOpacity(1.0 - inv * inv * inv);
    }

    # T (0.95s - 1.35s)
    if (t < 0.95) {
        letter_t.sprite.SetOpacity(0.0);
    } else {
        p = (t - 0.95) / 0.40;
        if (p > 1.0) p = 1.0;
        inv = 1.0 - p;
        letter_t.sprite.SetOpacity(1.0 - inv * inv * inv);
    }

    # H (1.25s - 1.65s)
    if (t < 1.25) {
        letter_h.sprite.SetOpacity(0.0);
    } else {
        p = (t - 1.25) / 0.40;
        if (p > 1.0) p = 1.0;
        inv = 1.0 - p;
        letter_h.sprite.SetOpacity(1.0 - inv * inv * inv);
    }

    # O2 (1.55s - 1.95s)
    if (t < 1.55) {
        letter_o2.sprite.SetOpacity(0.0);
    } else {
        p = (t - 1.55) / 0.40;
        if (p > 1.0) p = 1.0;
        inv = 1.0 - p;
        letter_o2.sprite.SetOpacity(1.0 - inv * inv * inv);
    }

    # S (1.85s - 2.25s)
    if (t < 1.85) {
        letter_s.sprite.SetOpacity(0.0);
    } else {
        p = (t - 1.85) / 0.40;
        if (p > 1.0) p = 1.0;
        inv = 1.0 - p;
        letter_s.sprite.SetOpacity(1.0 - inv * inv * inv);
    }

    # Specular Sheen Beam (2.40s - 3.60s)
    if (sheen.orig != null) {
        if (t < 2.40) {
            sheen.sprite.SetOpacity(0.0);
        } else if (t <= 3.60) {
            sp = (t - 2.40) / 1.20;
            sp_eased = sp * sp * (3.0 - 2.0 * sp);
            cur_x = word_x - sheen.w + sp_eased * (word_w + sheen.w * 2);
            sheen.sprite.SetX(cur_x);
            sheen.sprite.SetOpacity(Math.Sin(sp * 3.14159) * 0.85);
        } else {
            sheen.sprite.SetOpacity(0.0);
        }
    }

    # Subtitle Materialization (3.10s - 4.00s)
    if (subtitle.orig != null) {
        if (t < 3.10) {
            subtitle.sprite.SetOpacity(0.0);
        } else {
            sub_p = (t - 3.10) / 0.90;
            if (sub_p > 1.0) sub_p = 1.0;
            subtitle.sprite.SetOpacity(sub_p * sub_p * (3.0 - 2.0 * sub_p) * 0.95);
        }
    }

    # Boot Progress
    global.smooth_progress += (global.boot_progress - global.smooth_progress) * 0.12;
    if (global.smooth_progress > 1.0) global.smooth_progress = 1.0;
    if (global.smooth_progress < 0.0) global.smooth_progress = 0.0;

    fill_w = bar_w * global.smooth_progress;
    if (fill_w < 1) fill_w = 1;

    bar_fill.image = Image.Rectangle(fill_w, bar_h);
    bar_fill.sprite.SetImage(bar_fill.image);
    bar_fill.sprite.SetPosition(bar_x, bar_y, 55);

    # Status Telemetry
    if (global.smooth_progress < 0.20) {
        global.status_msg = "✦ INITIALIZING SOVEREIGN KERNEL";
    } else if (global.smooth_progress < 0.40) {
        global.status_msg = "✦ VERIFYING SYSTEM INTEGRITY";
    } else if (global.smooth_progress < 0.60) {
        global.status_msg = "✦ LOADING CRYPTOGRAPHIC VAULT";
    } else if (global.smooth_progress < 0.80) {
        global.status_msg = "✦ MOUNTING IMMUTABLE ROOT";
    } else {
        global.status_msg = "✦ STARTING SOVEREIGN DESKTOP";
    }

    text_alpha = 0.75 + Math.Sin(t * 3.0) * 0.20;
    status.image = Image.Text(global.status_msg, 0.98, 0.84, 0.20, text_alpha, "DejaVu Sans Mono Bold 10");
    status.sprite.SetImage(status.image);
    status.sprite.SetX(cx - status.image.GetWidth() / 2);
}

Plymouth.SetRefreshFunction(refresh_callback);

# 9. Progress Callback
fun boot_progress_callback (duration, progress) {
    global.boot_progress = progress;
}
Plymouth.SetBootProgressFunction(boot_progress_callback);

# 10. Message Callback
fun message_callback (text) {
    global.status_msg = text;
}
Plymouth.SetMessageFunction(message_callback);

# 11. Password / Crypt LUKS Callback
fun display_password_callback (prompt_str, bullets_count) {
    global.mode = "password";
    if (lock.orig != null) lock.sprite.SetOpacity(0.95);
    if (box.orig != null) box.sprite.SetOpacity(0.90);

    prompt.image = Image.Text(prompt_str, 0.98, 0.84, 0.14, 0.95, "DejaVu Sans Mono Bold 12");
    prompt.sprite.SetImage(prompt.image);
    prompt.sprite.SetOpacity(0.95);
    prompt.sprite.SetPosition(cx - 160, cy - 75, 510);

    bar_bg.sprite.SetOpacity(0.0);
    bar_fill.sprite.SetOpacity(0.0);
    status.sprite.SetOpacity(0.0);

    entry_x = cx - 145;
    entry_y = cy - 32;
    for (i = 0; i < 24; i++) {
        if (i < bullets_count) {
            if (bullet[i].sprite == null && bullet.orig != null) {
                bullet[i].sprite = Sprite(bullet.orig);
                bullet[i].sprite.SetPosition(entry_x + i * 12, entry_y, 520);
                bullet[i].sprite.SetOpacity(1.0);
            }
        } else {
            if (bullet[i].sprite != null) {
                bullet[i].sprite = null;
            }
        }
    }
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);

# 12. Normal Display Callback
fun display_normal_callback () {
    global.mode = "boot";
    if (lock.orig != null) lock.sprite.SetOpacity(0.0);
    if (box.orig != null) box.sprite.SetOpacity(0.0);
    prompt.sprite.SetOpacity(0.0);
    for (i = 0; i < 24; i++) bullet[i].sprite = null;

    bar_bg.sprite.SetOpacity(0.70);
    bar_fill.sprite.SetOpacity(0.95);
    status.sprite.SetOpacity(0.90);
}
Plymouth.SetDisplayNormalFunction(display_normal_callback);

# 13. Quit Callback
fun quit_callback () {
}
Plymouth.SetQuitFunction(quit_callback);
