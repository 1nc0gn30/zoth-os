[Desktop Entry]
Version=1.0
Type=Application
Name=ZothOS Cockpit Pro
GenericName=System Operations Deck & Telemetry
Comment=Flagship Sovereign System Telemetry, 21-Agent Swarm Deck & Control Panel
Exec=/usr/local/bin/zoth-cockpit
Icon=/usr/share/pixmaps/zoth-cockpit.png
Terminal=false
Categories=System;Settings;Monitor;
Keywords=cockpit;dashboard;diagnostics;system;monitor;telemetry;zoth;os;swarm;agents;
MimeType=application/x-zoth-cockpit;
StartupNotify=true
Actions=TUI;Status;Doctor;ModeGold;ModeGhost;ModeMatrix;Studio;

[Desktop Action TUI]
Name=Launch Classic Curses TUI
Exec=konsole --title "ZothOS Cockpit TUI" -e /usr/local/bin/zoth-cockpit --tui

[Desktop Action Status]
Name=Telemetry Snapshot (Headless)
Exec=konsole --hold -e /usr/local/bin/zoth-cockpit --status

[Desktop Action Doctor]
Name=Run Zoth System Doctor (Auditor)
Exec=konsole --hold -e /usr/local/bin/zoth-doctor

[Desktop Action ModeGold]
Name=Engage Sovereign Gold Master
Exec=/usr/local/bin/zoth-mode gold

[Desktop Action ModeGhost]
Name=Engage Ghostmode Stealth
Exec=/usr/local/bin/zoth-mode ghost

[Desktop Action ModeMatrix]
Name=Engage Hermetic Matrix
Exec=/usr/local/bin/zoth-mode matrix

[Desktop Action Studio]
Name=Launch Zoth Studio Pro
Exec=/usr/local/bin/zoth-studio
