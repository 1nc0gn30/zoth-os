[Desktop Entry]
Version=1.0
Type=Application
Name=Zoth QuickSite Starter
Comment=Simple 3-step static template and 1-click Netlify launcher on :8092
Exec=/usr/local/bin/zoth-konsole --title 'Zoth QuickSite Starter' -- /usr/local/bin/zoth-webgen
Icon=zoth-webgen
Terminal=false
Categories=Development;ArtificialIntelligence;Utility;
Keywords=webgen;generator;website;ast;foundry;ai;frontend;
MimeType=application/x-zoth-webgen;
StartupNotify=true
