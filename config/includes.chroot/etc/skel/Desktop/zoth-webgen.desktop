[Desktop Entry]
Version=1.0
Type=Application
Name=Zoth WebGen Foundry
GenericName=Autonomous Website Generator
Comment=Autonomous sovereign website generator and multi-model AST engine by NullAI Tech
Exec=/usr/local/bin/zoth-konsole --title "Zoth WebGen Foundry" -- /usr/local/bin/zoth-webgen
Icon=/usr/share/pixmaps/zoth-webgen.png
Terminal=false
Categories=Development;ArtificialIntelligence;Utility;
Keywords=webgen;generator;website;ast;foundry;ai;frontend;
StartupNotify=true
Actions=Web;CLI;Desktop;

[Desktop Action Web]
Name=Launch WebGen Web Studio (:8092)
Exec=/usr/local/bin/zoth-webgen web

[Desktop Action CLI]
Name=WebGen CLI Engine
Exec=/usr/local/bin/zoth-konsole --title "WebGen CLI" -- /usr/local/bin/zoth-webgen --help

[Desktop Action Desktop]
Name=WebGen Desktop Workstation
Exec=/usr/local/bin/zoth-webgen desktop
