[Desktop Entry]
Version=1.0
Type=Application
Name=ZothOS Desktop Pet HUD
GenericName=Alchemical AI Companion & Mascot
Comment=Interactive Celestial Griffin, Dragon, Phoenix & All-Seeing Eye Companion
Exec=/usr/local/bin/zoth-pet-hud
Icon=/usr/share/pixmaps/zoth-pet-hud.png
Terminal=false
Categories=Utility;Amusement;ArtificialIntelligence;
Keywords=pet;hud;companion;eye;mascot;aquila;draco;phoenix;ai;
MimeType=application/x-zoth-pet-hud;
StartupNotify=true
Actions=Eye;Aquila;Draco;Ignis;Kitsune;Lycan;

[Desktop Action Eye]
Name=Summon All-Seeing Eye
Exec=/usr/local/bin/zoth-pet-hud --pet eye

[Desktop Action Aquila]
Name=Summon Celestial Griffin (Aquila)
Exec=/usr/local/bin/zoth-pet-hud --pet aquila

[Desktop Action Draco]
Name=Summon Alchemical Dragon (Draco)
Exec=/usr/local/bin/zoth-pet-hud --pet draco

[Desktop Action Ignis]
Name=Summon Fire Phoenix (Ignis)
Exec=/usr/local/bin/zoth-pet-hud --pet ignis

[Desktop Action Kitsune]
Name=Summon Cyber Fox (Kitsune)
Exec=/usr/local/bin/zoth-pet-hud --pet kitsune

[Desktop Action Lycan]
Name=Summon Cyber Wolf (Lycan)
Exec=/usr/local/bin/zoth-pet-hud --pet lycan
