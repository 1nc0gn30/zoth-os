filters:
  and:
    - file.inFolder("OS/Packages")
    - file.hasTag("package")
properties:
  title:
    displayName: Package
  file.tags:
    displayName: Tags
views:
  - type: table
    name: Table
    order:
      - file.name
      - title
      - file.tags
  - type: cards
    name: Cards
    order:
      - file.name
      - title
