[Unit]
Description=Chronicle Vault — Contained Hermes + AGY Memory & Pattern Ledger (:8161)
Documentation=https://github.com/1nc0gn30/zoth-memory-vault
After=network.target
ConditionPathExists=/usr/local/bin/zoth-memory-vault

[Service]
Type=simple
ExecStart=/usr/local/bin/zoth-memory-vault serve --port 8161 --host 127.0.0.1
Restart=on-failure
RestartSec=3
KillMode=control-group
NoNewPrivileges=yes
PrivateTmp=yes
UMask=0077
MemoryMax=1G
CPUQuota=200%
SyslogIdentifier=chronicle-vault

[Install]
WantedBy=default.target
