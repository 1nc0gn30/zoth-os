[Unit]
Description=ZothOS Agent Flight Recorder & Telemetry Forensics Hub
After=network.target multi-user.target
Wants=network.target

[Service]
Type=simple
User=zoth
EnvironmentFile=-/etc/zothos/paths.conf
WorkingDirectory=%h
ExecStart=/usr/local/bin/zoth-run-repo agent-flight-recorder /opt/zothos-ai-env/bin/python3 -m agent_flight_recorder.cli serve --host 127.0.0.1 --port 8104
Restart=always
RestartSec=3
KillMode=process
StandardOutput=journal
StandardError=journal
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
