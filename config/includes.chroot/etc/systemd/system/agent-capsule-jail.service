[Unit]
Description=ZothOS Agent Capsule Jail & Ephemeral Process Enclave (v2.6.0)
After=network.target

[Service]
Type=simple
User=zoth
EnvironmentFile=-/etc/zothos/paths.conf
WorkingDirectory=%h
ExecStart=/usr/local/bin/zoth-run-repo agent-capsule-jail /opt/zothos-ai-env/bin/python3 -m agent_capsule_jail.cli serve --host 127.0.0.1 --port 8105
Restart=on-failure
RestartSec=3
KillMode=control-group
NoNewPrivileges=yes
ProtectSystem=strict
PrivateTmp=yes
ReadWritePaths=/tmp %h/.config/agent-capsule-jail
StandardOutput=journal
StandardError=journal
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
