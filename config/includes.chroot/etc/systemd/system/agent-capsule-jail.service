[Unit]
Description=ZothOS Agent Capsule Jail & Ephemeral Process Enclave
After=network.target multi-user.target
Wants=network.target

[Service]
Type=simple
User=zoth
EnvironmentFile=-/etc/zothos/paths.conf
WorkingDirectory=%h
ExecStart=/usr/local/bin/zoth-run-repo agent-capsule-jail /opt/zothos-ai-env/bin/python3 -m agent_capsule_jail.cli serve --host 127.0.0.1 --port 8105
Restart=always
RestartSec=3
KillMode=process
StandardOutput=journal
StandardError=journal
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
