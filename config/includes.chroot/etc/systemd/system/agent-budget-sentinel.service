[Unit]
Description=ZothOS Agent Budget Sentinel - Autonomous Token Cost Circuit Breaker & Guardrail
After=network.target multi-user.target
Wants=network.target

[Service]
Type=simple
User=zoth
EnvironmentFile=-/etc/zothos/paths.conf
WorkingDirectory=%h
ExecStart=/usr/local/bin/zoth-run-repo agent-budget-sentinel /usr/bin/python3 bin/agent-budget serve --web-port 8110 --proxy-port 8111
Restart=always
RestartSec=3
KillMode=process
StandardOutput=journal
StandardError=journal
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
