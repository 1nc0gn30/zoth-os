[Unit]
Description=ZothOS Agent Prompt Firewall & Security Radar (v2.6.0)
After=network.target multi-user.target
Wants=network.target

[Service]
Type=simple
User=zoth
EnvironmentFile=-/etc/zothos/paths.conf
WorkingDirectory=/var/lib/zoth-firewall
StateDirectory=zoth-firewall
StateDirectoryMode=0700
ExecStart=/usr/local/bin/zoth-run-repo agent-prompt-firewall /opt/zothos-ai-env/bin/python3 -m agent_prompt_firewall.cli serve --host 127.0.0.1 --web-port 8098 --proxy-port 8198 --db /var/lib/zoth-firewall/firewall.db
Restart=always
RestartSec=3
KillMode=control-group
StandardOutput=journal
StandardError=journal
Environment=PYTHONUNBUFFERED=1
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/zoth-firewall /tmp
MemoryMax=512M
CPUQuota=75%

[Install]
WantedBy=multi-user.target
