[Unit]
Description=ZothOS Etsy Print-on-Demand Studio & Listing Synthesizer
After=network.target multi-user.target
Wants=network.target

[Service]
Type=simple
User=zoth
EnvironmentFile=-/etc/zothos/paths.conf
WorkingDirectory=%h
ExecStart=/usr/local/bin/zoth-run-repo etsy-pod-forge /usr/bin/python3 -m etsy_pod_forge.server --host 127.0.0.1 --port 8107
Restart=always
RestartSec=3
KillMode=process
StandardOutput=journal
StandardError=journal
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
