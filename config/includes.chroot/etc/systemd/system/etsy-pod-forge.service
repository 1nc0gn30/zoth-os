[Unit]
Description=ZothOS Etsy POD Forge — 300-DPI Print Canvas, Mockup & Listing Studio (v2.6.0)
After=network.target multi-user.target
Wants=network.target

[Service]
Type=simple
User=zoth
WorkingDirectory=/opt/etsy-pod-forge
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/opt/etsy-pod-forge/src
ExecStart=/usr/bin/python3 /opt/etsy-pod-forge/server.py --host 127.0.0.1 --port 8107
Restart=always
RestartSec=3
KillMode=process
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
