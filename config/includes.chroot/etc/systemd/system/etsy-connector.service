[Unit]
Description=ZothOS Etsy Connector & Antigravity MCP Bridge
After=network.target multi-user.target
Wants=network.target

[Service]
Type=simple
User=zoth
EnvironmentFile=-/etc/zothos/paths.conf
WorkingDirectory=%h
ExecStart=/usr/local/bin/zoth-run-repo etsy-connector /usr/bin/python3 -m etsy_connector.web_cockpit --host 127.0.0.1 --port 8108
Restart=always
RestartSec=3
KillMode=process
StandardOutput=journal
StandardError=journal
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
