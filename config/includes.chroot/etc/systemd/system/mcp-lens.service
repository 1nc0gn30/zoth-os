[Unit]
Description=ZothOS MCP Lens - Model Context Protocol Traffic Sniffer & Token Weight Auditor
After=network.target multi-user.target
Wants=network.target

[Service]
Type=simple
User=zoth
WorkingDirectory=${ZOTH_SRC_ROOT}/mcp-lens
ExecStart=/usr/bin/python3 ${ZOTH_SRC_ROOT}/mcp-lens/bin/mcp-lens serve --host 127.0.0.1 --port 8109
Restart=always
RestartSec=3
KillMode=process
StandardOutput=journal
StandardError=journal
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=${ZOTH_SRC_ROOT}/mcp-lens/src

[Install]
WantedBy=multi-user.target
