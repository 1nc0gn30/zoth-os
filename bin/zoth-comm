# ANSI Styling Tokens
BOLD = "\033[1m"
DIM = "\033[2m"
RESET = "\033[0m"
GREEN = "\033[38;2;16;185;129m"
CYAN = "\033[38;2;6;182;212m"
GOLD = "\033[38;2;245;158;11m"
PURPLE = "\033[38;2;168;85;247m"
RED = "\033[38;2;239;68;68m"
GRAY = "\033[38;2;148;163;184m"

DEFAULT_RPC_URL = "http://127.0.0.1:8140"
DEFAULT_NEURO_URL = "http://127.0.0.1:8094"
VAULT_DIR = Path.home() / "Documents" / "Obsidian Vault"
TELEMETRY_COMM_NOTE = VAULT_DIR / "05-Telemetry" / "ZothNet Encrypted Comms.md"
CONF_DIR = Path.home() / ".config" / "zoth-comm"

# Cryptography AEAD import
try:
    from cryptography.hazmat.primitives.ciphers.aead import AESGCM
    HAS_AESGCM = True
except ImportError:
    HAS_AESGCM = False


def ensure_config_dir() -> Path:
    CONF_DIR.mkdir(parents=True, exist_ok=True)
    try:
        os.chmod(CONF_DIR, 0o700)
    except Exception:
        pass
    return CONF_DIR


def derive_pbkdf2_key(passphrase: str, salt_bytes: bytes, iterations: int = 100000) -> bytes:
    """Derive 256-bit cryptographic key from passphrase and salt."""
    return hashlib.pbkdf2_hmac("sha256", passphrase.encode("utf-8"), salt_bytes, iterations, dklen=32)


def encrypt_payload_aes_gcm(plaintext_str: str, key_bytes: bytes) -> tuple[str, str, str]:
    """Encrypts plaintext with AES-256-GCM. Returns (ciphertext_hex, nonce_hex, tag_hex)."""
    nonce = os.urandom(12)
    data = plaintext_str.encode("utf-8")
    if HAS_AESGCM:
        aesgcm = AESGCM(key_bytes)
        # AESGCM.encrypt returns ciphertext + 16-byte tag
        ct_tag = aesgcm.encrypt(nonce, data, None)
        ct = ct_tag[:-16]
        tag = ct_tag[-16:]
        return ct.hex(), nonce.hex(), tag.hex()
    else:
        # Fallback to HMAC-SHA256 authenticated XOR stream
        keystream = hashlib.sha256(key_bytes + nonce).digest()
        while len(keystream) < len(data):
            keystream += hashlib.sha256(keystream + key_bytes).digest()
        ct = bytes(a ^ b for a, b in zip(data, keystream[:len(data)]))
        tag = hashlib.sha256(ct + key_bytes + nonce).digest()[:16]
        return ct.hex(), nonce.hex(), tag.hex()


def decrypt_payload_aes_gcm(ct_hex: str, nonce_hex: str, tag_hex: str, key_bytes: bytes) -> str:
    """Decrypts AES-256-GCM ciphertext. Raises Exception on auth tag failure."""
    nonce = bytes.fromhex(nonce_hex)
    ct = bytes.fromhex(ct_hex)
    tag = bytes.fromhex(tag_hex)
    if HAS_AESGCM:
        aesgcm = AESGCM(key_bytes)
        pt = aesgcm.decrypt(nonce, ct + tag, None)
        return pt.decode("utf-8", errors="replace")
    else:
        expected_tag = hashlib.sha256(ct + key_bytes + nonce).digest()[:16]
        if expected_tag != tag:
            raise ValueError("Authentication tag mismatch: Invalid passphrase or corrupted ciphertext")
        keystream = hashlib.sha256(key_bytes + nonce).digest()
        while len(keystream) < len(ct):
            keystream += hashlib.sha256(keystream + key_bytes).digest()
        pt = bytes(a ^ b for a, b in zip(ct, keystream[:len(ct)]))
        return pt.decode("utf-8", errors="replace")


def normalize_handle(handle: str) -> str:
    h = handle.strip()
    if not h.startswith("@"):
        h = "@" + h
    return h


def rpc_request(url: str, endpoint: str, method: str = "GET", payload: dict | None = None, timeout: float = 4.0) -> dict:
    """Dispatches HTTP JSON request to Vaelor Lattice RPC endpoint."""
    full_url = f"{url.rstrip('/')}{endpoint}"
    data_bytes = None
    headers = {"User-Agent": "zoth-comm/1.0", "Accept": "application/json"}
    if payload is not None:
        headers["Content-Type"] = "application/json"
        data_bytes = json.dumps(payload).encode("utf-8")

    req = urllib.request.Request(full_url, data=data_bytes, headers=headers, method=method)
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            body = resp.read().decode("utf-8")
            return json.loads(body)
    except urllib.error.HTTPError as e:
        body = e.read().decode("utf-8")
        try:
            err_json = json.loads(body)
            err_json["_status_code"] = e.code
            return err_json
        except Exception:
            return {"ok": False, "error": f"HTTP {e.code}: {e.reason}", "_status_code": e.code}
    except Exception as ex:
        return {"ok": False, "error": str(ex), "_status_code": 0}


# ==============================================================================
# Local Storage Fallback Engine
# ==============================================================================
def get_local_store_file(filename: str) -> Path:
    cd = ensure_config_dir()
    p = cd / filename
    if not p.exists():
        p.write_text("{}", encoding="utf-8")
        try:
            os.chmod(p, 0o600)
        except Exception:
            pass
    return p


def read_local_store(filename: str) -> dict:
    f = get_local_store_file(filename)
    try:
        return json.loads(f.read_text(encoding="utf-8"))
    except Exception:
        return {}


def write_local_store(filename: str, data: dict) -> None:
    f = get_local_store_file(filename)
    f.write_text(json.dumps(data, indent=2), encoding="utf-8")
    try:
        os.chmod(f, 0o600)
    except Exception:
        pass


