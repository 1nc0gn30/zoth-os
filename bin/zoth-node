# ==============================================================================
# Subcommand 2: AUDIT
# ==============================================================================

def cmd_audit(args) -> int:
    rpc_url = args.rpc or DEFAULT_VAELOR_RPC
    code, res = http_get(f"{rpc_url}/api/ledger/verify-integrity")

    chains = []
    merkle_root = ""
    total_blocks = 0
    conservation = "100.000000%"
    all_valid = True

    if code == 200 and isinstance(res, dict) and res.get("ok"):
        chains = res.get("chains", [])
        merkle_root = res.get("merkleStateRoot", "")
        total_blocks = res.get("totalBlocks", 0)
        conservation = res.get("supplyConservationPct", "100.000000%")
        all_valid = res.get("verified", True)
    else:
        # Fallback to local state audit
        local_state = load_local_vaelor_state()
        if not local_state:
            print(f"{RED}[✗] Error: Unable to query Vaelor RPC and no local state found at {VAELOR_STATE_PATH}{RESET}")
            return 1
        computed_root, chains = calculate_merkle_state_root(local_state.get("accounts", {}))
        merkle_root = computed_root
        total_blocks = local_state.get("totalBlocks", sum(c["blocks"] for c in chains))
        all_valid = all(c["chainIntegrity"] == "VERIFIED" for c in chains)

    if args.json:
        data = {
            "ok": True,
            "verified": all_valid,
            "merkleStateRoot": merkle_root,
            "totalBlocks": total_blocks,
            "accountChainsVerified": len(chains),
            "supplyConservationPct": conservation,
            "chains": chains,
            "timestamp": datetime.now(timezone.utc).isoformat()
        }
        print(json.dumps(data, indent=2))
        return 0

    print(f"\n{BOLD}{CYAN}╔═══════════════════════════════════════════════════════════════════════════════════════════╗{RESET}")
    print(f"{BOLD}{CYAN}║   ◈ VAELOR LAYER-1 GENESIS-TO-HEAD CRYPTOGRAPHIC LEDGER AUDITOR                           ║{RESET}")
    print(f"{BOLD}{CYAN}╚═══════════════════════════════════════════════════════════════════════════════════════════╝{RESET}")
    print(f"  {BOLD}Binary Merkle State Root:{RESET} {CYAN}{BOLD}{merkle_root}{RESET}")
    print(f"  {BOLD}DAG Total Blocks Audited:{RESET} {GOLD}{total_blocks:,}{RESET}")
    print(f"  {BOLD}Supply Conservation:{RESET}      {GREEN}{BOLD}{conservation}{RESET}")
    print(f"  {BOLD}Consensus Quorum:{RESET}         {GREEN}5/5 FINALIZED_BFT (Zero Double-Spend Risk){RESET}")

    print(f"\n  {BOLD}{'ACCOUNT HANDLE':<18} {'ADDRESS':<36} {'BLOCKS':<8} {'BALANCE (VLR)':<16} {'CHAIN INTEGRITY':<16}{RESET}")
    print(f"  {DIM}{'─'*18} {'─'*36} {'─'*8} {'─'*16} {'─'*16}{RESET}")

    for c in chains:
        h = c.get("handle", "@unknown")
        addr = c.get("address", "")
        blks = str(c.get("blocks", 0))
        bal = f"{c.get('balanceVlr', 0.0):,.4f} VLR"
        status = c.get("chainIntegrity", "VERIFIED")
        st_color = GREEN if status == "VERIFIED" else RED
        print(f"  {CYAN}{BOLD}{h:<18}{RESET} {GRAY}{addr:<36}{RESET} {GOLD}{blks:<8}{RESET} {GOLD}{bal:<16}{RESET} {st_color}{status:<16}{RESET}")

    print(f"\n  {GREEN}{BOLD}[✓] AUDIT PASSED:{RESET} Every Ed25519 microchain is continuous, hash-linked, and mathematically sound.\n")
    return 0


# ==============================================================================
# Subcommand 3: CLUSTER
# ==============================================================================

def cmd_cluster(args) -> int:
    action = args.action.lower()
    rpc_url = args.rpc or DEFAULT_VAELOR_RPC

    if action == "list":
        code, res = http_get(f"{rpc_url}/api/p2p/peers")
        peers = []
        validators = []
        if code == 200 and isinstance(res, dict) and res.get("ok"):
            peers = res.get("clusterPeers", [])
            validators = res.get("bftValidators", [])
        else:
            peers = [
                {"handle": "@zoth", "name": "Neal Master Cockpit", "endpoint": rpc_url, "status": "CONNECTED", "role": "COCKPIT_ORCHESTRATOR"},
                {"handle": "@zoth-rig2", "name": "24/7 AI Laptop", "endpoint": rpc_url, "status": "CONNECTED", "role": "AI_FLEET_WORKER"},
                {"handle": "@neal", "name": "Neal Primary", "endpoint": rpc_url, "status": "CONNECTED", "role": "SOVEREIGN_OPERATOR"}
            ]

        if args.json:
            print(json.dumps({"ok": True, "clusterPeers": peers, "bftValidators": validators}, indent=2))
            return 0

        print(f"\n{BOLD}{CYAN}╔═══════════════════════════════════════════════════════════════════════════════════════════╗{RESET}")
        print(f"{BOLD}{CYAN}║   🌐 ZOTHNET P2P CLUSTER MESH TOPOLOGY                                                    ║{RESET}")
        print(f"{BOLD}{CYAN}╚═══════════════════════════════════════════════════════════════════════════════════════════╝{RESET}")
        print(f"  {BOLD}{'NODE HANDLE':<16} {'DISPLAY NAME':<22} {'ENDPOINT':<28} {'ROLE':<20} {'STATUS':<10}{RESET}")
        print(f"  {DIM}{'─'*16} {'─'*22} {'─'*28} {'─'*20} {'─'*10}{RESET}")
        for p in peers:
            h = p.get("handle", "@unknown")
            nm = p.get("name", "Node")[:20]
            ep = p.get("endpoint", "")[:26]
            role = p.get("role", "PEER_NODE")[:18]
            st = p.get("status", "CONNECTED")
            print(f"  {CYAN}{BOLD}{h:<16}{RESET} {nm:<22} {GRAY}{ep:<28}{RESET} {PURPLE}{role:<20}{RESET} {GREEN}{st:<10}{RESET}")
        print()
        return 0

    elif action == "join":
        peer_url = args.peer_url or "http://127.0.0.1:8140"
        handle = args.handle or "@zoth-rig2"
        name = args.name or f"ZothOS Node {handle}"

        payload = {"peerUrl": peer_url, "handle": handle, "name": name}
        code, res = http_post(f"{rpc_url}/api/p2p/connect", payload)

        if code == 200 and isinstance(res, dict) and res.get("ok"):
            print(f"\n{BOLD}{GREEN}[✓] Successfully Connected & Clustered ZothOS Node!{RESET}")
            print(f"  {BOLD}Handle:{RESET}       {CYAN}{handle}{RESET}")
            print(f"  {BOLD}Display Name:{RESET} {name}")
            print(f"  {BOLD}Peer URL:{RESET}     {peer_url}")
            print(f"  {BOLD}BFT Quorum:{RESET}   {GREEN}5/5 FINALIZED_BFT Consensus Active{RESET}")
            print(f"  {BOLD}Topology:{RESET}     Bi-directional P2P Mesh Lattice Connected\n")
            return 0
        else:
            print(f"\n{RED}[!] Failed to join cluster: {res}{RESET}\n")
            return 1

    elif action == "sync":
        peer_url = args.peer_url or rpc_url
        code, res = http_get(f"{peer_url}/api/p2p/delta")

        if code == 200 and isinstance(res, dict) and res.get("ok"):
            print(f"\n{BOLD}{GREEN}[✓] ZothOS Cluster Node Block Delta Synchronized!{RESET}")
            print(f"  {BOLD}Chain ID:{RESET}          {GOLD}{res.get('chainId', 'vaelor-mainnet-1')}{RESET}")
            print(f"  {BOLD}Current Head Height:{RESET}{GOLD} Block #{res.get('currentBlockHeight', 540)}{RESET}")
            print(f"  {BOLD}Merkle State Root:{RESET}  {CYAN}{res.get('merkleStateRoot')}{RESET}")
            print(f"  {BOLD}Delta Blocks Pulled:{RESET}{GREEN} {len(res.get('deltaBlocks', []))} verified blocks{RESET}")
            print(f"  {BOLD}Consensus State:{RESET}    {GREEN}5/5 BFT Quorum Synchronized & Sealed{RESET}\n")
            return 0
        else:
            print(f"\n{RED}[!] Cluster sync failed: {res}{RESET}\n")
            return 1

    else:
        print(f"{RED}Unknown cluster action '{action}'. Valid actions: list, join, sync{RESET}")
        return 1


# ==============================================================================
# Subcommand 4: MULTISIG
# ==============================================================================

def cmd_multisig(args) -> int:
    action = args.action.lower()
    rpc_url = args.rpc or DEFAULT_VAELOR_RPC

    if action == "list":
        code, res = http_get(f"{rpc_url}/api/multisig")
        if code != 200 or not isinstance(res, dict) or not res.get("ok"):
            print(f"{RED}[!] Failed to query multisig vault: {res}{RESET}")
            return 1

        vault = res.get("vault", {})
        proposals = res.get("proposals", [])

        if args.json:
            print(json.dumps(res, indent=2))
            return 0

        print(f"\n{BOLD}{CYAN}╔═══════════════════════════════════════════════════════════════════════════════════════════╗{RESET}")
        print(f"{BOLD}{CYAN}║   🏛️ ZOTHOS ENTERPRISE M-OF-N CORPORATE TREASURY VAULT                                    ║{RESET}")
        print(f"{BOLD}{CYAN}╚═══════════════════════════════════════════════════════════════════════════════════════════╝{RESET}")
        print(f"  {BOLD}Vault Address:{RESET}    {CYAN}{vault.get('address')}{RESET}")
        print(f"  {BOLD}Policy Scheme:{RESET}    {GOLD}{vault.get('policy', '2-of-3')} Multi-Signature{RESET}")
        print(f"  {BOLD}Treasury Balance:{RESET} {GOLD}{vault.get('balanceVlr', 25000.0):,.2f} ◈ VLR{RESET}")
        print(f"  {BOLD}Signer Keys:{RESET}      {', '.join(vault.get('signers', []))}")

        print(f"\n  {BOLD}{'PROPOSAL ID':<18} {'TITLE':<32} {'AMOUNT':<12} {'APPROVALS':<14} {'STATUS':<12}{RESET}")
        print(f"  {DIM}{'─'*18} {'─'*32} {'─'*12} {'─'*14} {'─'*12}{RESET}")

        for p in proposals:
            pid = p.get("id", "")[:16]
            title = p.get("title", "")[:30]
            amt = f"{p.get('amountVlr', 0):,.1f} VLR"
            apps = f"{len(p.get('approvals', []))}/{p.get('requiredApprovals', 2)}"
            st = p.get("status", "PENDING")
            st_color = GREEN if st in ("APPROVED", "EXECUTED") else GOLD
            print(f"  {GOLD}{pid:<18}{RESET} {title:<32} {GOLD}{amt:<12}{RESET} {PURPLE}{apps:<14}{RESET} {st_color}{st:<12}{RESET}")

        print()
        return 0

    elif action == "propose":
        if not args.title or not args.recipient or not args.amount:
            print(f"{RED}Usage: zoth-node multisig propose <title> <recipient> <amount_vlr> [reason]{RESET}")
            return 1

        payload = {
            "title": args.title,
            "recipient": args.recipient,
            "amountVlr": float(args.amount),
            "proposer": args.signer or "@zoth",
            "reason": args.reason or "Enterprise compute infrastructure allocation"
        }
        code, res = http_post(f"{rpc_url}/api/multisig/propose", payload)

        if code == 200 and isinstance(res, dict) and res.get("ok"):
            prop = res.get("proposal", {})
            print(f"\n{BOLD}{GREEN}[✓] Multisig Treasury Proposal Created!{RESET}")
            print(f"  {BOLD}Proposal ID:{RESET}   {GOLD}{prop.get('id')}{RESET}")
            print(f"  {BOLD}Title:{RESET}         {prop.get('title')}")
            print(f"  {BOLD}Recipient:{RESET}     {CYAN}{prop.get('recipient')}{RESET}")
            print(f"  {BOLD}Amount:{RESET}        {GOLD}{prop.get('amountVlr'):,.2f} ◈ VLR{RESET}")
            print(f"  {BOLD}Approvals:{RESET}     {PURPLE}1/2 (Proposer {prop.get('proposer')} Signed){RESET}")
            print(f"  {BOLD}Status:{RESET}        {GOLD}PENDING (Awaiting 2nd Quorum Signer){RESET}\n")
            return 0
        else:
            print(f"\n{RED}[!] Proposal failed: {res}{RESET}\n")
            return 1

    elif action == "approve":
        if not args.proposal_id:
            print(f"{RED}Usage: zoth-node multisig approve <proposal_id> [--signer @signer]{RESET}")
            return 1

        signer = args.signer or "@neal"
        payload = {"proposalId": args.proposal_id, "signer": signer}
        code, res = http_post(f"{rpc_url}/api/multisig/approve", payload)

        if code == 200 and isinstance(res, dict) and res.get("ok"):
            prop = res.get("proposal", {})
            print(f"\n{BOLD}{GREEN}[✓] Proposal Cryptographically Approved!{RESET}")
            print(f"  {BOLD}Proposal ID:{RESET}   {GOLD}{prop.get('id')}{RESET}")
            print(f"  {BOLD}Signed By:{RESET}     {CYAN}{signer}{RESET}")
            print(f"  {BOLD}Approvals:{RESET}     {GREEN}{len(prop.get('approvals', []))}/{prop.get('requiredApprovals', 2)} Quorum Achieved{RESET}")
            print(f"  {BOLD}New Status:{RESET}    {GREEN}{BOLD}{prop.get('status')}{RESET}\n")
            return 0
        else:
            print(f"\n{RED}[!] Approval failed: {res}{RESET}\n")
            return 1

    else:
        print(f"{RED}Unknown multisig action '{action}'. Valid: list, propose, approve{RESET}")
        return 1


# ==============================================================================
# Subcommand 5: METRICS
# ==============================================================================

def cmd_metrics(args) -> int:
    rpc_url = args.rpc or DEFAULT_VAELOR_RPC
    code, res = http_get(f"{rpc_url}/metrics")

    if code == 200 and isinstance(res, str):
        if args.raw:
            sys.stdout.write(res)
            return 0

        print(f"\n{BOLD}{CYAN}╔═══════════════════════════════════════════════════════════════════════════════════════════╗{RESET}")
        print(f"{BOLD}{CYAN}║   📊 LIVE PROMETHEUS / OPENTELEMETRY METRICS ({rpc_url}/metrics)                         ║{RESET}")
        print(f"{BOLD}{CYAN}╚═══════════════════════════════════════════════════════════════════════════════════════════╝{RESET}")

        lines = res.strip().split("\n")
        for line in lines:
            if line.startswith("# HELP"):
                print(f"  {DIM}{line}{RESET}")
            elif line.startswith("# TYPE"):
                continue
            elif line.strip():
                parts = line.split()
                if len(parts) == 2:
                    k, v = parts
                    print(f"  {GOLD}{k:<38}{RESET} {GREEN}{BOLD}{v:>20}{RESET}")
        print()
        return 0
    else:
        print(f"{RED}[!] Failed to fetch Prometheus metrics: {res}{RESET}")
        return 1


# ==============================================================================
# Subcommand 6: THERMALS (Hardware Sensor & PoUW Governor Telemetry)
# ==============================================================================

def cmd_thermals(args) -> int:
    max_temp = float(getattr(args, "max_temp", 76.0) or 76.0)
    thermals = read_hardware_thermals(max_temp)
    if getattr(args, "json", False):
        print(json.dumps({"ok": True, "thermals": thermals}, indent=2))
        return 0

    gov_color = RED if thermals["throttled"] else (GOLD if "WARM" in thermals["governorState"] else GREEN)
    pkg = thermals["packageTempC"]
    print(f"\n{BOLD}{CYAN}╔═══════════════════════════════════════════════════════════════════════════════════════════╗{RESET}")
    print(f"{BOLD}{CYAN}║   🌡️ ZOTH-NODE HARDWARE THERMAL SENSORS & PoUW MINING GOVERNOR                            ║{RESET}")
    print(f"{BOLD}{CYAN}╚═══════════════════════════════════════════════════════════════════════════════════════════╝{RESET}")
    print(f"  {BOLD}Governor State:{RESET}     {gov_color}{BOLD}{thermals['governorState']}{RESET} (Max Ceiling: {max_temp}°C • Headroom: +{thermals['headroomC']}°C)")
    print(f"  {BOLD}CPU Package (id 0):{RESET} {gov_color}{BOLD}{pkg:>5.1f}°C{RESET}  [{render_braille_bar(pkg, 100.0, 20)}]  (Crit: 100.0°C)")
    for c in thermals.get("cores", []):
        ct = c["tempC"]
        c_col = RED if ct >= max_temp else (GOLD if ct >= max_temp - 6 else GREEN)
        print(f"  {BOLD}{c['label']:<19}:{RESET} {c_col}{ct:>5.1f}°C{RESET}  [{render_braille_bar(ct, 100.0, 20)}]")
    print(f"  {BOLD}NVMe SSD Composite:{RESET} {GREEN}{thermals['nvmeTempC']:>5.1f}°C{RESET}  [{render_braille_bar(thermals['nvmeTempC'], 85.0, 20)}]  (High: 79.8°C)")
    print(f"  {BOLD}PCH / WiFi Sensors:{RESET} {CYAN}{thermals['pchTempC']:>5.1f}°C{RESET} (PCH) • {CYAN}{thermals['wifiTempC']:>5.1f}°C{RESET} (ath10k WiFi)")
    print(f"  {BOLD}Dual Cooling Fans:{RESET}  {CYAN}{BOLD}{thermals['fan1Rpm']} RPM{RESET} (Fan 1) • {CYAN}{BOLD}{thermals['fan2Rpm']} RPM{RESET} (Fan 2) [Max: 5100 RPM]")
    la = thermals["loadAvg"]
    print(f"  {BOLD}System Load Avg:{RESET}    {GOLD}{la['load1']} (1m) • {la['load5']} (5m) • {la['load15']} (15m){RESET}\n")
    return 0


# ==============================================================================
# Subcommand 7: MINE (Thermal-Governed Proof-of-Useful-Work Miner)
# ==============================================================================

def cmd_mine(args) -> int:
    rpc_url = args.rpc or DEFAULT_VAELOR_RPC
    worker = args.worker or "@zoth"
    if not worker.startswith("@") and not worker.startswith("vlr1_"):
        worker = f"@{worker}"
    task_type = (args.task or "SECURITY_ENTROPY_SCAN").upper()
    blocks = max(1, min(10, int(args.blocks or 1)))
    max_temp = float(args.max_temp or 76.0)

    minted_blocks = []
    total_reward = 0.0

    for idx in range(blocks):
        pre_t = read_hardware_thermals(max_temp)
        if pre_t["throttled"]:
            if args.json:
                print(json.dumps({
                    "ok": False,
                    "throttled": True,
                    "reason": f"CPU Package {pre_t['packageTempC']}°C >= ceiling {max_temp}°C",
                    "thermals": pre_t,
                    "mintedBlocks": minted_blocks
                }, indent=2))
                return 0
            print(f"\n{RED}{BOLD}[⚠ THERMAL GUARD TRIGGERED]{RESET} CPU Package ({pre_t['packageTempC']}°C) >= ceiling ({max_temp}°C). Pausing PoUW mining to protect hardware!\n")
            return 0

        payload = {
            "worker": worker,
            "workType": task_type,
            "maxTempC": max_temp,
            "taskLabel": f"Zoth-Node PoUW #{idx + 1}/{blocks} ({task_type}) @ {pre_t['packageTempC']}°C"
        }
        code, res = http_post(f"{rpc_url}/api/pouw/mine-governed", payload)
        if code == 200 and isinstance(res, dict) and res.get("ok"):
            if res.get("throttled"):
                print(f"{GOLD}[⚠ THERMAL GUARD]{RESET} {res.get('reason')}")
                break
            mb = res.get("mintBlock") or {}
            rc = res.get("receipt") or {}
            rew = float(res.get("rewardVlr", rc.get("rewardVlr", 5.0)))
            total_reward += rew
            minted_blocks.append({
                "blockHash": mb.get("hash"),
                "height": mb.get("height"),
                "rewardVlr": rew,
                "balanceAfterVlr": mb.get("balanceAfterVlr"),
                "workNonce": (mb.get("data") or {}).get("workNonce", rc.get("workNonce", 0)),
                "cpuTempC": (res.get("thermals") or pre_t).get("packageTempC")
            })
        else:
            print(f"{RED}[!] PoUW RPC error: {res}{RESET}")
            return 1

        if blocks > 1 and idx < blocks - 1:
            time.sleep(0.35)

    post_t = read_hardware_thermals(max_temp)
    if args.json:
        print(json.dumps({
            "ok": True,
            "worker": worker,
            "workType": task_type,
            "blocksMined": len(minted_blocks),
            "totalRewardVlr": round(total_reward, 4),
            "blocks": minted_blocks,
            "thermals": post_t
        }, indent=2))
        return 0

    print(f"\n{BOLD}{CYAN}╔═══════════════════════════════════════════════════════════════════════════════════════════╗{RESET}")
    print(f"{BOLD}{CYAN}║   ⛏️  ZOTH-NODE THERMAL-GOVERNED PROOF-OF-USEFUL-WORK (PoUW) MINER                        ║{RESET}")
    print(f"{BOLD}{CYAN}╚═══════════════════════════════════════════════════════════════════════════════════════════╝{RESET}")
    print(f"  {BOLD}Miner Identity:{RESET}   {CYAN}{worker}{RESET} • Useful Work Task: {GOLD}{task_type}{RESET}")
    print(f"  {BOLD}Blocks Minted:{RESET}    {GREEN}{len(minted_blocks)}{RESET} • Total Minted Reward: {GOLD}{BOLD}+{total_reward:,.4f} ◈ VLR{RESET} ($0.00 Gas)")
    print(f"  {BOLD}Thermal Guard:{RESET}    {GREEN}CPU {post_t['packageTempC']}°C / {max_temp}°C Ceiling ({post_t['governorState']} • {post_t['fan1Rpm']} RPM){RESET}")
    print(f"  {DIM}{'─'*87}{RESET}")
    for b in minted_blocks:
        bh = str(b.get("blockHash") or "")[:36] + "…"
        print(f"  {GREEN}✓ Block #{b.get('height')}{RESET} │ Hash: {CYAN}{bh}{RESET} │ Reward: {GOLD}+{b.get('rewardVlr')} VLR{RESET} │ Balance: {GOLD}{b.get('balanceAfterVlr', 0):,.4f} VLR{RESET} │ {b.get('cpuTempC')}°C")
    if minted_blocks:
        print(render_braille_seal_from_hex(minted_blocks[-1].get("blockHash", "")))
    print(f"  {GREEN}{BOLD}[5/5 FINALIZED_BFT]{RESET} Attested by US-East, EU-Central, Asia-East, ZothOS-Edge & NullAI-Core.\n")
    return 0


# ==============================================================================
# Subcommand 8: WALLET / BALANCES (Account-Lattice Inspector)
# ==============================================================================

def cmd_wallet(args) -> int:
    rpc_url = args.rpc or DEFAULT_VAELOR_RPC
    handle = getattr(args, "handle", None)

    if handle:
        clean = handle if handle.startswith("@") or handle.startswith("vlr1_") else f"@{handle}"
        code, res = http_get(f"{rpc_url}/api/account/{urllib.parse.quote(clean)}")
        if code != 200 or not isinstance(res, dict) or not res.get("ok"):
            print(f"{RED}[!] Account '{clean}' not found: {res}{RESET}")
            return 1
        acc = res.get("account", {})
        if args.json:
            print(json.dumps(res, indent=2))
            return 0
        bal_vlr = (acc.get("balanceVael", 0) or 0) / 1_000_000.0
        staked_vlr = (acc.get("stakedBalanceVael", 0) or 0) / 1_000_000.0
        escrow_vlr = (acc.get("lockedEscrowVael", 0) or 0) / 1_000_000.0
        chain = acc.get("chain", [])
        print(f"\n{BOLD}{CYAN}╔═══════════════════════════════════════════════════════════════════════════════════════════╗{RESET}")
        print(f"{BOLD}{CYAN}║   ◈ VAELOR L1 ACCOUNT-LATTICE WALLET INSPECTOR — {acc.get('handle', clean):<36} ║{RESET}")
        print(f"{BOLD}{CYAN}╚═══════════════════════════════════════════════════════════════════════════════════════════╝{RESET}")
        print(f"  {BOLD}Account Handle:{RESET}   {CYAN}{BOLD}{acc.get('handle')}{RESET} ({acc.get('displayName', '')})")
        print(f"  {BOLD}L1 Address:{RESET}       {GOLD}{acc.get('address')}{RESET}")
        print(f"  {BOLD}Ed25519 PubKey:{RESET}   {GRAY}{str(acc.get('rawPublicKeyHex') or acc.get('publicKeyHex', ''))[:64]}{RESET}")
        print(f"  {BOLD}Liquid Balance:{RESET}   {GOLD}{BOLD}{bal_vlr:,.4f} ◈ VLR{RESET} • Staked: {GREEN}{staked_vlr:,.2f} VLR{RESET} • Escrow: {PURPLE}{escrow_vlr:,.2f} VLR{RESET}")
        print(f"  {BOLD}Chain Height:{RESET}     {CYAN}{len(chain)} blocks{RESET} • PoUW Mined: {GREEN}{acc.get('pouwBlocksMined', 0)} blocks{RESET}")
        print(f"\n  {BOLD}RECENT MICRO-CHAIN BLOCKS (Last 6):{RESET}")
        print(f"  {DIM}{'─'*87}{RESET}")
        for b in reversed(chain[-6:]):
            print(f"  #{b.get('height'):<5} {GOLD}{b.get('type'):<14}{RESET} {CYAN}{str(b.get('hash', ''))[:28]}…{RESET} Bal: {GOLD}{b.get('balanceAfterVlr', 0):,.2f} VLR{RESET}")
        print()
        return 0

    code, res = http_get(f"{rpc_url}/api/explorer/blocks?limit=10")
    if code != 200 or not isinstance(res, dict) or not res.get("ok"):
        print(f"{RED}[!] Unable to query Vaelor L1 account chains: {res}{RESET}")
        return 1
    chains = res.get("accountChains", [])
    if args.json:
        print(json.dumps({"ok": True, "accountChains": chains}, indent=2))
        return 0

    print(f"\n{BOLD}{CYAN}╔═══════════════════════════════════════════════════════════════════════════════════════════╗{RESET}")
    print(f"{BOLD}{CYAN}║   ◈ VAELOR L1 ACCOUNT-LATTICE WALLETS & MICRO-CHAIN BALANCES                              ║{RESET}")
    print(f"{BOLD}{CYAN}╚═══════════════════════════════════════════════════════════════════════════════════════════╝{RESET}")
    print(f"  {BOLD}{'HANDLE':<20} {'ADDRESS':<36} {'HEIGHT':<8} {'LIQUID VLR':<16} {'STAKED VLR':<12}{RESET}")
    print(f"  {DIM}{'─'*20} {'─'*36} {'─'*8} {'─'*16} {'─'*12}{RESET}")
    for c in chains:
        h = c.get("handle", "@unknown")
        addr = c.get("address", "")[:34]
        ht = str(c.get("height", 0))
        bal = f"{c.get('balanceVlr', 0):,.4f} VLR"
        stk = f"{c.get('stakedBalanceVlr', 0):,.2f} VLR"
        print(f"  {CYAN}{BOLD}{h:<20}{RESET} {GRAY}{addr:<36}{RESET} {PURPLE}{ht:<8}{RESET} {GOLD}{BOLD}{bal:<16}{RESET} {GREEN}{stk:<12}{RESET}")
    print()
    return 0


# ==============================================================================
# Subcommand 9: TRANSFER / SEND (Feeless L1 Account-Lattice Transfer)
# ==============================================================================

def cmd_transfer(args) -> int:
    rpc_url = args.rpc or DEFAULT_VAELOR_RPC
    sender = args.sender
    recipient = args.recipient
    amount = float(args.amount)
    memo = args.memo or "Zoth-Node Sovereign L1 Feeless Transfer"

    payload = {"from": sender, "to": recipient, "amountVlr": amount, "memo": memo}
    code, res = http_post(f"{rpc_url}/api/transfer", payload)
    if code != 200 or not isinstance(res, dict) or not res.get("ok"):
        print(f"{RED}[!] Transfer failed: {res}{RESET}")
        return 1

    if args.json:
        print(json.dumps(res, indent=2))
        return 0

    tx_res = res.get("result") or res
    sb = tx_res.get("sendBlock") or {}
    rb = tx_res.get("receiveBlock") or {}
    bh = sb.get("hash") or rb.get("hash") or ""
    print(f"\n{BOLD}{GREEN}[✓] VAELOR L1 FEELESS TRANSFER FINALIZED IN SUB-15MS (5/5 BFT QUORUM){RESET}")
    print(f"  {BOLD}From -> To:{RESET}       {CYAN}{sender}{RESET} ──({GOLD}{BOLD}{amount:,.4f} ◈ VLR{RESET})──▶ {CYAN}{recipient}{RESET}")
    print(f"  {BOLD}Gas Fee:{RESET}          {GREEN}$0.00 (Feeless Account-Lattice Micro-Work){RESET}")
    print(f"  {BOLD}Send Block:{RESET}       #{sb.get('height')} • {CYAN}{str(sb.get('hash', ''))[:44]}…{RESET}")
    print(f"  {BOLD}Receive Block:{RESET}    #{rb.get('height')} • {CYAN}{str(rb.get('hash', ''))[:44]}…{RESET}")
    print(f"  {BOLD}Sender Balance:{RESET}   {GOLD}{sb.get('balanceAfterVlr', 0):,.4f} ◈ VLR{RESET}")
    print(f"  {BOLD}Receiver Balance:{RESET} {GOLD}{rb.get('balanceAfterVlr', 0):,.4f} ◈ VLR{RESET}")
    if bh:
        print(render_braille_seal_from_hex(bh))
    print()
    return 0


# ==============================================================================
# Subcommand 10: EXPLORER (Live DAG Block Explorer & Cryptographic Verifier)
# ==============================================================================

def cmd_explorer(args) -> int:
    rpc_url = args.rpc or DEFAULT_VAELOR_RPC
    if args.verify:
        code, res = http_post(f"{rpc_url}/api/explorer/verify-block", {"hash": args.verify})
        if code != 200 or not isinstance(res, dict) or not res.get("ok"):
            print(f"{RED}[!] Block verification failed: {res}{RESET}")
            return 1
        if args.json:
            print(json.dumps(res, indent=2))
            return 0
        blk = res.get("block", {})
        vf = res.get("verification", {})
        print(f"\n{BOLD}{CYAN}╔═══════════════════════════════════════════════════════════════════════════════════════════╗{RESET}")
        print(f"{BOLD}{CYAN}║   🔍 VAELOR L1 CRYPTOGRAPHIC BLOCK & 5/5 BFT QUORUM PROOF VERIFIER                        ║{RESET}")
        print(f"{BOLD}{CYAN}╚═══════════════════════════════════════════════════════════════════════════════════════════╝{RESET}")
        print(f"  {BOLD}Block Hash:{RESET}       {CYAN}{blk.get('hash')}{RESET}")
        print(f"  {BOLD}Account / Height:{RESET} {GOLD}{blk.get('handle')}{RESET} • Height #{blk.get('height')} • Type: {PURPLE}{blk.get('type')}{RESET}")
        print(f"  {BOLD}Previous Hash:{RESET}    {GRAY}{blk.get('previousHash')}{RESET}")
        print(f"  {BOLD}SHA-256 Hash OK:{RESET}  {GREEN}✓ {vf.get('sha256Matches')}{RESET}")
        print(f"  {BOLD}Ed25519 Sig OK:{RESET}   {GREEN}✓ {vf.get('ed25519Valid')}{RESET}")
        print(f"  {BOLD}5/5 BFT Quorum:{RESET}   {GREEN}✓ {vf.get('bftStatus', 'FINALIZED_BFT')} ({vf.get('bftApprovals', 5)}/5 Validators){RESET}")
        print(render_braille_seal_from_hex(blk.get("hash", "")))
        print()
        return 0

    limit = max(1, min(50, int(args.limit or 10)))
    q_handle = f"&handle={urllib.parse.quote(args.handle)}" if args.handle else ""
    code, res = http_get(f"{rpc_url}/api/explorer/blocks?limit={limit}{q_handle}")
    if code != 200 or not isinstance(res, dict) or not res.get("ok"):
        print(f"{RED}[!] Failed to fetch DAG blocks: {res}{RESET}")
        return 1
    if args.json:
        print(json.dumps(res, indent=2))
        return 0

    blocks = res.get("blocks", [])
    print(f"\n{BOLD}{CYAN}╔═══════════════════════════════════════════════════════════════════════════════════════════╗{RESET}")
    print(f"{BOLD}{CYAN}║   ⛓️  VAELOR L1 LIVE ACCOUNT-LATTICE DAG EXPLORER (Total: {res.get('totalBlocks', 0):,} Blocks)                 ║{RESET}")
    print(f"{BOLD}{CYAN}╚═══════════════════════════════════════════════════════════════════════════════════════════╝{RESET}")
    print(f"  {BOLD}{'HEIGHT':<8} {'HANDLE':<18} {'TYPE':<16} {'BLOCK HASH':<28} {'BALANCE AFTER':<16}{RESET}")
    print(f"  {DIM}{'─'*8} {'─'*18} {'─'*16} {'─'*28} {'─'*16}{RESET}")
    for b in blocks:
        ht = f"#{b.get('height', 0)}"
        h = str(b.get("handle", "@unknown"))[:16]
        tp = str(b.get("type", "TX"))[:14]
        bh = str(b.get("hash", ""))[:24] + "…"
        bal = f"{b.get('balanceAfterVlr', 0):,.2f} VLR"
        print(f"  {PURPLE}{ht:<8}{RESET} {CYAN}{BOLD}{h:<18}{RESET} {GOLD}{tp:<16}{RESET} {GRAY}{bh:<28}{RESET} {GREEN}{bal:<16}{RESET}")
    print()
    return 0


# ==============================================================================
# Main Parser & Dispatcher
# ==============================================================================

def main():
    parser = argparse.ArgumentParser(
        prog="zoth-node",
        description="ZothOS Enterprise Node, Thermal-Governed PoUW Miner & Vaelor L1 Controller"
    )
    parser.add_argument("--rpc", default=DEFAULT_VAELOR_RPC, help=f"Vaelor RPC URL (default: {DEFAULT_VAELOR_RPC})")
    parser.add_argument("--neuro", default=DEFAULT_NEURO_RPC, help=f"Neuro-Memory RPC URL (default: {DEFAULT_NEURO_RPC})")

    subparsers = parser.add_subparsers(dest="subcommand", help="Available subcommands")

    # status
    p_status = subparsers.add_parser("status", help="Display executive node, thermal governor & cluster dashboard")
    p_status.add_argument("--json", action="store_true", help="Output machine-readable JSON")

    # thermals
    p_thermals = subparsers.add_parser("thermals", help="Inspect CPU/Core/NVMe temperatures, fan RPMs & PoUW thermal governor")
    p_thermals.add_argument("--max-temp", type=float, default=76.0, help="Thermal throttling ceiling in °C (default: 76.0)")
    p_thermals.add_argument("--json", action="store_true", help="Output machine-readable JSON")

    # mine
    p_mine = subparsers.add_parser("mine", help="Execute thermal-governed Proof-of-Useful-Work (PoUW) mining")
    p_mine.add_argument("--worker", default="@zoth", help="Miner account handle (default: @zoth)")
    p_mine.add_argument("--task", default="SECURITY_ENTROPY_SCAN", help="PoUW task type (SECURITY_ENTROPY_SCAN, STDP_VECTOR_INDEXING, MERKLE_STATE_AUDIT)")
    p_mine.add_argument("--blocks", type=int, default=1, help="Number of PoUW blocks to mine (1-10)")
    p_mine.add_argument("--max-temp", type=float, default=76.0, help="Max CPU Package temperature ceiling in °C (default: 76.0)")
    p_mine.add_argument("--json", action="store_true", help="Output machine-readable JSON")

    # wallet / balances
    for w_cmd in ("wallet", "balances"):
        p_wallet = subparsers.add_parser(w_cmd, help="Inspect Vaelor L1 Account-Lattice wallets & micro-chain balances")
        p_wallet.add_argument("handle", nargs="?", default=None, help="Optional @handle to inspect in detail")
        p_wallet.add_argument("--json", action="store_true", help="Output machine-readable JSON")

    # transfer / send
    for t_cmd in ("transfer", "send"):
        p_tx = subparsers.add_parser(t_cmd, help="Execute a feeless ($0 gas) Vaelor L1 Account-Lattice transfer")
        p_tx.add_argument("sender", help="Sender @handle (e.g. @neal or @zoth)")
        p_tx.add_argument("recipient", help="Recipient @handle (e.g. @zoth or @zoth-rig2)")
        p_tx.add_argument("amount", type=float, help="Amount in VLR")
        p_tx.add_argument("memo", nargs="?", default="Zoth-Node Sovereign L1 Feeless Transfer", help="Optional transfer memo")
        p_tx.add_argument("--json", action="store_true", help="Output machine-readable JSON")

    # explorer
    p_exp = subparsers.add_parser("explorer", help="Explore live Account-Lattice DAG blocks or cryptographically verify a block hash")
    p_exp.add_argument("--limit", type=int, default=10, help="Number of latest blocks to show")
    p_exp.add_argument("--handle", default=None, help="Filter blocks by @handle")
    p_exp.add_argument("--verify", default=None, help="Block hash prefix to cryptographically verify (SHA-256 + Ed25519 + 5/5 BFT)")
    p_exp.add_argument("--json", action="store_true", help="Output machine-readable JSON")

    # audit
    p_audit = subparsers.add_parser("audit", help="Execute Genesis-to-Head cryptographic chain & Merkle audit")
    p_audit.add_argument("--json", action="store_true", help="Output machine-readable JSON")

    # cluster
    p_cluster = subparsers.add_parser("cluster", help="Manage P2P cluster peers, join nodes, and sync state")
    p_cluster.add_argument("action", choices=["list", "join", "sync"], help="Action: list, join, sync")
    p_cluster.add_argument("peer_url", nargs="?", default="http://127.0.0.1:8140", help="Remote peer endpoint")
    p_cluster.add_argument("--handle", default="@zoth-rig2", help="Peer handle")
    p_cluster.add_argument("--name", default=None, help="Display name for peer")
    p_cluster.add_argument("--json", action="store_true", help="Output machine-readable JSON")

    # multisig
    p_multisig = subparsers.add_parser("multisig", help="Manage M-of-N corporate treasury proposals")
    p_multisig.add_argument("action", choices=["list", "propose", "approve"], help="Action: list, propose, approve")
    p_multisig.add_argument("title", nargs="?", default="", help="Proposal title")
    p_multisig.add_argument("recipient", nargs="?", default="", help="Recipient @handle")
    p_multisig.add_argument("amount", nargs="?", default=0, help="Amount in VLR")
    p_multisig.add_argument("reason", nargs="?", default="", help="Proposal reason / memo")
    p_multisig.add_argument("--proposal-id", default=None, help="Proposal ID to approve")
    p_multisig.add_argument("--signer", default=None, help="Signer handle (@zoth, @neal, @zoth-rig2)")
    p_multisig.add_argument("--json", action="store_true", help="Output machine-readable JSON")

    # metrics
    p_metrics = subparsers.add_parser("metrics", help="Fetch and format live Prometheus metrics")
    p_metrics.add_argument("--raw", action="store_true", help="Output raw Prometheus exposition format")

    args = parser.parse_args()

    if not args.subcommand or args.subcommand == "status":
        args.json = getattr(args, "json", False)
        return cmd_status(args)
    elif args.subcommand == "thermals":
        return cmd_thermals(args)
    elif args.subcommand == "mine":
        return cmd_mine(args)
    elif args.subcommand in ("wallet", "balances"):
        return cmd_wallet(args)
    elif args.subcommand in ("transfer", "send"):
        return cmd_transfer(args)
    elif args.subcommand == "explorer":
        return cmd_explorer(args)
    elif args.subcommand == "audit":
        return cmd_audit(args)
    elif args.subcommand == "cluster":
        return cmd_cluster(args)
    elif args.subcommand == "multisig":
        return cmd_multisig(args)
    elif args.subcommand == "metrics":
        return cmd_metrics(args)
    else:
        parser.print_help()
        return 0


if __name__ == "__main__":
    sys.exit(main())
