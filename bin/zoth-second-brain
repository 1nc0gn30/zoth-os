#!/usr/bin/env python3
"""
zoth-second-brain - Sovereign Obsidian Second Brain & ZothOS Conductor Bridge CLI.
Enables instant query, health tracking, MOC inspection, and bidirectional STDP sync
between Obsidian Vault and the Neuro-Memory Daemon (:8094).
"""

import sys
import os
import json
import time
import re
import urllib.request
import urllib.error
from pathlib import Path

VAULT_DIR = Path.home() / "Documents" / "Obsidian Vault"
NEURO_MEMORY_URL = "http://127.0.0.1:8094"
VAELOR_URL = "http://127.0.0.1:8140"
STUDIO_URL = "http://127.0.0.1:3000"
BOLT_URL = "http://127.0.0.1:5173"
CIVILIZATION_URL = "http://127.0.0.1:9393"

# ANSI styling
BOLD = "\033[1m"
DIM = "\033[2m"
RESET = "\033[0m"
GREEN = "\033[38;2;16;185;129m"
CYAN = "\033[38;2;6;182;212m"
GOLD = "\033[38;2;245;158;11m"
PURPLE = "\033[38;2;168;85;247m"
RED = "\033[38;2;239;68;68m"
GRAY = "\033[38;2;148;163;184m"


def check_port(url: str, timeout: float = 1.0) -> bool:
    try:
        req = urllib.request.Request(url, headers={"User-Agent": "zoth-second-brain/1.0"})
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            return resp.status < 500
    except Exception:
        return False


def get_json(url: str, timeout: float = 2.0):
    try:
        req = urllib.request.Request(url, headers={"User-Agent": "zoth-second-brain/1.0"})
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            return json.loads(resp.read().decode("utf-8"))
    except Exception:
        return None


def post_json(url: str, payload: dict, timeout: float = 60.0):
    try:
        data = json.dumps(payload).encode("utf-8")
        req = urllib.request.Request(
            url,
            data=data,
            headers={
                "User-Agent": "zoth-second-brain/1.0",
                "Content-Type": "application/json",
            },
            method="POST",
        )
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            return json.loads(resp.read().decode("utf-8"))
    except Exception as e:
        return {"error": str(e)}


def cmd_status():
    print(f"\n{GOLD}{BOLD}◈ ZothOS Second Brain & Daemon Substrate Status{RESET}")
    print(f"{DIM}─────────────────────────────────────────────────────────────{RESET}")

    # Vault stats
    if not VAULT_DIR.exists():
        print(f" {RED}✖ Vault directory missing:{RESET} {VAULT_DIR}")
        return

    notes = list(VAULT_DIR.rglob("*.md"))
    canvases = list(VAULT_DIR.rglob("*.canvas"))
    bases = list(VAULT_DIR.rglob("*.base"))
    mocs = [p for p in notes if p.stem.startswith("MOC") or p.stem == "00 Home"]

    print(f" {BOLD}💎 Obsidian Vault:{RESET} {CYAN}{VAULT_DIR}{RESET}")
    print(f"    • Notes:     {BOLD}{len(notes)}{RESET} ({len(mocs)} Maps of Content)")
    print(f"    • Canvases:  {BOLD}{len(canvases)}{RESET} (.canvas files)")
    print(f"    • Bases:     {BOLD}{len(bases)}{RESET} (.base databases)")

    print(f"\n {BOLD}⚡ Conductor & Fleet Daemons:{RESET}")

    fleet = [
        ("neuro-memory", ":8094", f"{NEURO_MEMORY_URL}/health", "Memory & STDP"),
        ("vaelor-lattice", ":8140", f"{VAELOR_URL}/", "Consensus & Economy"),
        ("zoth-studio-v2", ":3000", f"{STUDIO_URL}/", "Studio Web IDE"),
        ("bolt-diy", ":5173", f"{BOLT_URL}/", "AI Code Engine"),
        ("zoth-civilization", ":9393", f"{CIVILIZATION_URL}/api/status", "Agent Mesh"),
    ]

    for name, port, health_url, subsystem in fleet:
        up = check_port(health_url)
        status_badge = f"{GREEN}● ACTIVE{RESET}" if up else f"{RED}○ DOWN{RESET}"
        print(f"    {status_badge}  {BOLD}{name:<18}{RESET} {CYAN}{port:<7}{RESET} {GRAY}[{subsystem}]{RESET}")

    # Neuro-memory daemon vault stats
    vault_api = get_json(f"{NEURO_MEMORY_URL}/api/obsidian/vault")
    if vault_api:
        api_notes = len(vault_api.get("notes", []))
        api_edges = len(vault_api.get("wikilinkEdges", []))
        print(f"\n {BOLD}🧠 STDP Synaptic Graph (:8094):{RESET}")
        print(f"    • Indexed Notes:    {GREEN}{api_notes}{RESET}")
        print(f"    • Wikilink Synapses: {PURPLE}{api_edges}{RESET}")
    print(f"{DIM}─────────────────────────────────────────────────────────────{RESET}\n")


def cmd_sync():
    print(f"\n{PURPLE}{BOLD}⚡ Synchronizing Obsidian Vault with Neuro-Memory Daemon (:8094)...{RESET}")
    start = time.time()
    res = post_json(f"{NEURO_MEMORY_URL}/api/obsidian/sync", {})
    elapsed = time.time() - start

    if not res or "error" in res:
        err = res.get("error", "Failed to connect to daemon") if res else "Unknown error"
        print(f" {RED}✖ Sync failed:{RESET} {err}")
        print(f"   Ensure `neuro-memory-daemon` is running on port 8094.")
        sys.exit(1)

    print(f" {GREEN}✔ Bidirectional STDP Sync Completed in {elapsed:.2f}s{RESET}")
    print(f"    • Ingested Notes:  {BOLD}{res.get('ingestedFromVault', 0)}{RESET}")
    print(f"    • Total Memories:  {CYAN}{res.get('totalMemories', 'unknown')}{RESET}")
    print(f"    • Vault Substrate: {GRAY}{res.get('vaultPath', str(VAULT_DIR))}{RESET}")
    print()


def cmd_moc(args):
    if not VAULT_DIR.exists():
        print(f"{RED}✖ Vault directory missing:{RESET} {VAULT_DIR}")
        return

    mocs = sorted([p for p in VAULT_DIR.glob("*.md") if p.stem.startswith("MOC") or p.stem == "00 Home"])

    if not args:
        print(f"\n{CYAN}{BOLD}🗺️ Maps of Content (MOC) in Second Brain Vault:{RESET}")
        print(f"{DIM}{'MOC Note':<30} {'Wikilinks':<12} {'Size':<10} {'Last Modified':<20}{RESET}")
        print(f"{DIM}─" * 74 + f"{RESET}")
        for p in mocs:
            txt = p.read_text(encoding="utf-8", errors="ignore")
            links = re.findall(r"\[\[([^\]|#]+)", txt)
            unique_links = len(set(links))
            mtime = time.strftime("%Y-%m-%d %H:%M", time.localtime(p.stat().st_mtime))
            size_kb = f"{p.stat().st_size / 1024:.1f} KB"
            name = p.stem
            print(f" {BOLD}{name:<29}{RESET} {PURPLE}{unique_links:<12}{RESET} {GRAY}{size_kb:<10}{RESET} {DIM}{mtime:<20}{RESET}")
        print(f"{DIM}─" * 74 + f"{RESET}")
        print(f" Total: {BOLD}{len(mocs)}{RESET} Maps of Content. Run `zoth-second-brain moc <name>` to view.\n")
        return

    query = " ".join(args).strip().lower()
    matches = [p for p in mocs if query in p.stem.lower()]

    if not matches:
        print(f"{RED}✖ No MOC matching '{query}' found.{RESET}")
        return

    target = matches[0]
    txt = target.read_text(encoding="utf-8", errors="ignore")
    links = re.findall(r"\[\[([^\]|#]+)", txt)
    print(f"\n{GOLD}{BOLD}◈ {target.stem}{RESET} {GRAY}({len(links)} wikilinks){RESET}")
    print(f"{DIM}Path: {target}{RESET}\n")

    lines = txt.splitlines()
    body_lines = []
    in_fm = False
    for i, line in enumerate(lines):
        if i == 0 and line.strip() == "---":
            in_fm = True
            continue
        if in_fm and line.strip() == "---":
            in_fm = False
            continue
        if not in_fm:
            body_lines.append(line)

    preview = "\n".join(body_lines[:25])
    print(preview)
    if len(body_lines) > 25:
        print(f"{DIM}... [+{len(body_lines) - 25} lines truncated]{RESET}")
    print()


def cmd_search(args):
    if not args:
        print(f"{RED}✖ Usage:{RESET} zoth-second-brain search <query>")
        sys.exit(1)

    query = " ".join(args).strip()
    query_lower = query.lower()
    start_time = time.time()

    print(f"\n{GOLD}{BOLD}🔍 Searching Second Brain Vault & STDP Cortex for '{query}'...{RESET}")
    print(f"{DIM}───────────────────────────────────────────────────────────────────────{RESET}")

    # 1. Fast search across local Vault notes
    vault_matches = []
    seen_paths = set()

    # (a) Check file names first
    for p in VAULT_DIR.rglob("*"):
        if p.is_file() and p.suffix.lower() in (".md", ".canvas", ".base"):
            if any(part.startswith(".") for part in p.parts):
                continue
            if query_lower in p.stem.lower():
                rel = str(p.relative_to(VAULT_DIR))
                seen_paths.add(p)
                vault_matches.append({
                    "path": rel,
                    "name": p.stem,
                    "score": 15,
                    "line": 1,
                    "snippet": f"Title & filename match: {p.name}",
                })

    # (b) Content search via ripgrep if available
    rg_bin = "/usr/bin/rg" if os.path.exists("/usr/bin/rg") else None
    if rg_bin:
        import subprocess
        try:
            cmd = [rg_bin, "-i", "-n", "-m", "1", query, str(VAULT_DIR)]
            proc = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
            for line in proc.stdout.splitlines():
                if not line.strip() or ":" not in line:
                    continue
                parts = line.split(":", 2)
                if len(parts) >= 3:
                    f_path_str = parts[0].strip()
                    try:
                        l_num = int(parts[1])
                        snip = parts[2].strip()
                        current_file = Path(f_path_str)
                        if current_file not in seen_paths:
                            seen_paths.add(current_file)
                            rel = str(current_file.relative_to(VAULT_DIR))
                            vault_matches.append({
                                "path": rel,
                                "name": current_file.stem,
                                "score": 8,
                                "line": l_num,
                                "snippet": snip[:120],
                            })
                    except (ValueError, Exception):
                        pass
        except Exception:
            pass

    # Fallback to python file scanning if ripgrep wasn't used or returned few
    if len(vault_matches) < 3:
        for p in VAULT_DIR.rglob("*.md"):
            if p in seen_paths or any(part.startswith(".") for part in p.parts):
                continue
            try:
                txt = p.read_text(encoding="utf-8", errors="ignore")
                if query_lower in txt.lower():
                    seen_paths.add(p)
                    rel = str(p.relative_to(VAULT_DIR))
                    lines = txt.splitlines()
                    snip = ""
                    l_no = 1
                    for idx, l in enumerate(lines):
                        if query_lower in l.lower():
                            l_no = idx + 1
                            snip = l.strip()[:120]
                            break
                    vault_matches.append({
                        "path": rel,
                        "name": p.stem,
                        "score": 5,
                        "line": l_no,
                        "snippet": snip or f"Matched content in {p.name}",
                    })
                    if len(vault_matches) >= 15:
                        break
            except Exception:
                continue

    vault_matches.sort(key=lambda x: x["score"], reverse=True)
    top_vault = vault_matches[:6]

    print(f" {BOLD}💎 Obsidian Vault Notes{RESET} {GRAY}({len(vault_matches)} matches found){RESET}:")
    if top_vault:
        for idx, m in enumerate(top_vault, 1):
            print(f"   {CYAN}{idx}. [[{m['name']}]]  {DIM}({m['path']}:{m['line']}){RESET}")
            display_snip = re.sub(f"(?i)({re.escape(query)})", f"{GOLD}{BOLD}\\1{RESET}", m["snippet"])
            print(f"      {GRAY}{display_snip}{RESET}")
    else:
        print(f"   {DIM}No direct note matches found.{RESET}")

    # 2. Search STDP Neuro-Memory Daemon (:8094)
    print(f"\n {BOLD}🧠 STDP Synaptic Engram Memories (:8094){RESET}:")
    memory_results = []
    daemon_search = post_json(f"{NEURO_MEMORY_URL}/api/search", {"query": query, "limit": 5}, timeout=4.0)
    if daemon_search and "results" in daemon_search:
        memory_results = daemon_search.get("results", [])

    if not memory_results:
        daemon_recall = post_json(f"{NEURO_MEMORY_URL}/api/recall", {"query": query, "top_k": 5}, timeout=4.0)
        if daemon_recall and "results" in daemon_recall:
            memory_results = daemon_recall.get("results", [])

    if memory_results:
        for idx, mem in enumerate(memory_results[:5], 1):
            mem_id = mem.get("id", "engram")[:8]
            tags = mem.get("tags", [])
            tag_str = " ".join([f"#{t}" for t in tags[:4]])
            txt = mem.get("text", "").replace("\n", " ").strip()
            if len(txt) > 130:
                txt = txt[:127] + "..."
            display_txt = re.sub(f"(?i)({re.escape(query)})", f"{GOLD}{BOLD}\\1{RESET}", txt)
            imp = mem.get("importance", 0.5)
            print(f"   {PURPLE}{idx}. [engram:{mem_id}] {DIM}(imp: {imp:.2f}){RESET} {GREEN}{tag_str}{RESET}")
            print(f"      {GRAY}{display_txt}{RESET}")
    else:
        print(f"   {DIM}No synaptic engrams matched cue in active substrate.{RESET}")

    elapsed_ms = (time.time() - start_time) * 1000
    total_found = len(vault_matches) + len(memory_results)
    print(f"{DIM}───────────────────────────────────────────────────────────────────────{RESET}")
    print(f" {GREEN}✔ Found {total_found} unified results in {elapsed_ms:.1f}ms{RESET}\n")


def cmd_ingest(args):
    if not args:
        print(f"{RED}✖ Usage:{RESET} zoth-second-brain ingest <path-or-url> [--title \"...\"] [--tags \"a,b\"]")
        sys.exit(1)

    target_src = args[0].strip()
    title = None
    custom_tags = []

    # Parse flags
    i = 1
    while i < len(args):
        if args[i] == "--title" and i + 1 < len(args):
            title = args[i + 1].strip()
            i += 2
        elif args[i] == "--tags" and i + 1 < len(args):
            custom_tags = [t.strip().lower() for t in args[i + 1].split(",") if t.strip()]
            i += 2
        else:
            i += 1

    ingest_dir = VAULT_DIR / "04-Ingested"
    ingest_dir.mkdir(parents=True, exist_ok=True)

    content_md = ""
    source_label = target_src

    # Case A: URL
    if target_src.startswith("http://") or target_src.startswith("https://"):
        print(f"\n{CYAN}{BOLD}🌐 Ingesting remote URL:{RESET} {target_src}")
        defuddle_bin = "/usr/bin/defuddle" if os.path.exists("/usr/bin/defuddle") else None
        extracted = False

        if defuddle_bin:
            import subprocess
            try:
                proc = subprocess.run([defuddle_bin, "parse", target_src, "--md"], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=15)
                if proc.returncode == 0 and proc.stdout.strip():
                    content_md = proc.stdout.strip()
                    extracted = True
                    print(f" {GREEN}✔ Extracted markdown via Defuddle CLI{RESET}")
            except Exception:
                pass

        if not extracted:
            try:
                import urllib.parse
                req = urllib.request.Request(target_src, headers={"User-Agent": "Mozilla/5.0 (ZothOS-SecondBrain/1.0)"})
                with urllib.request.urlopen(req, timeout=12) as resp:
                    html = resp.read().decode("utf-8", errors="ignore")

                if not title:
                    title_m = re.search(r"<title[^>]*>(.*?)</title>", html, re.IGNORECASE | re.DOTALL)
                    if title_m:
                        title = title_m.group(1).strip()

                clean = re.sub(r"<(script|style|nav|footer|header|aside)[^>]*>.*?</\1>", "", html, flags=re.IGNORECASE | re.DOTALL)
                clean = re.sub(r"<h1[^>]*>(.*?)</h1>", r"\n# \1\n", clean, flags=re.IGNORECASE)
                clean = re.sub(r"<h2[^>]*>(.*?)</h2>", r"\n## \1\n", clean, flags=re.IGNORECASE)
                clean = re.sub(r"<h3[^>]*>(.*?)</h3>", r"\n### \1\n", clean, flags=re.IGNORECASE)
                clean = re.sub(r"<p[^>]*>(.*?)</p>", r"\n\1\n", clean, flags=re.IGNORECASE)
                clean = re.sub(r"<li[^>]*>(.*?)</li>", r"\n- \1", clean, flags=re.IGNORECASE)
                clean = re.sub(r"<a\s+[^>]*href=[\"']([^\"']+)[\"'][^>]*>(.*?)</a>", r"[\2](\1)", clean, flags=re.IGNORECASE)
                clean = re.sub(r"<[^>]+>", " ", clean)
                clean = re.sub(r"\n\s*\n+", "\n\n", clean)
                content_md = clean.strip()[:10000]
                print(f" {GREEN}✔ Extracted clean text via Python HTML parser{RESET}")
            except Exception as e:
                print(f"{RED}✖ Failed to fetch URL:{RESET} {e}")
                sys.exit(1)

        if not title:
            domain = urllib.parse.urlparse(target_src).netloc or "web-capture"
            title = f"Web Ingest - {domain}"

    # Case B: Local file
    else:
        local_p = Path(target_src).resolve()
        if not local_p.exists() or not local_p.is_file():
            print(f"{RED}✖ Local file not found:{RESET} {local_p}")
            sys.exit(1)

        print(f"\n{CYAN}{BOLD}📄 Ingesting local file:{RESET} {local_p}")
        content_md = local_p.read_text(encoding="utf-8", errors="ignore").strip()

        if not title:
            h1_m = re.search(r"^#\s+(.+)$", content_md, re.MULTILINE)
            if h1_m:
                title = h1_m.group(1).strip()
            else:
                title = local_p.stem.replace("-", " ").replace("_", " ").title()

    slug = re.sub(r"[^a-zA-Z0-9_-]+", "-", title.lower()).strip("-")
    if not slug:
        slug = f"ingest-{int(time.time())}"
    dest_file = ingest_dir / f"{slug}.md"

    now_date = time.strftime("%Y-%m-%d")
    now_time = time.strftime("%Y-%m-%d %H:%M:%S")

    all_tags = list(dict.fromkeys(["ingested", "second-brain"] + custom_tags))
    tags_yaml = "\n".join([f"  - {t}" for t in all_tags])

    body_content = content_md
    fm_match = re.match(r"^---\n(.*?)\n---\n(.*)$", content_md, re.DOTALL)
    if fm_match:
        body_content = fm_match.group(2).strip()

    note_text = f"""---
title: "{title}"
date: {now_date}
created: "{now_time}"
source: "{source_label}"
tags:
{tags_yaml}
aliases:
  - "{title}"
  - "{slug}"
cluster: Ingested
stdp_weight: 0.95
---

# {title}

> [!note] Second Brain Ingested Artifact
> **Source:** `{source_label}`
> **Ingested on:** `{now_time}`

{body_content}

## See also

[[00 Home]] · [[Zoth OS]] · [[Zoth Memory]]
"""

    dest_file.write_text(note_text, encoding="utf-8")
    print(f" {GREEN}✔ Obsidian Note Created:{RESET} {BOLD}{dest_file.relative_to(VAULT_DIR)}{RESET}")

    # Memory Substrate Ingestion (:8094)
    print(f" {PURPLE}⚡ Ingesting into STDP Memory Substrate (:8094)...{RESET}")
    snippet = body_content[:350].replace("\n", " ").strip()
    mem_text = f"[Ingested Second Brain · [[{dest_file.stem}]]] {title} - {snippet}"
    mem_res = post_json(
        f"{NEURO_MEMORY_URL}/api/remember",
        {
            "text": mem_text,
            "tags": all_tags,
            "importance": 0.95,
            "category": "semantic",
            "agent_id": "zoth-second-brain-cli",
            "metadata": {
                "vault_file": str(dest_file),
                "source": source_label,
                "slug": slug,
            },
        },
        timeout=15.0,
    )

    if mem_res and "id" in mem_res:
        print(f" {GREEN}✔ STDP Synaptic Engram Stored:{RESET} ID {CYAN}{mem_res['id'][:8]}{RESET} (imp: 0.95)")
    else:
        print(f" {GOLD}⚠ Memory store warning:{RESET} {mem_res}")

    # Trigger Sync
    print(f" {PURPLE}⚡ Synchronizing Vault with Daemon...{RESET}")
    sync_res = post_json(f"{NEURO_MEMORY_URL}/api/obsidian/sync", {}, timeout=45.0)
    if sync_res and sync_res.get("ok"):
        print(f" {GREEN}✔ Substrate Synced:{RESET} {BOLD}{sync_res.get('totalMemories', 'unknown')}{RESET} total memories")

    print(f"\n{GOLD}✦ Successfully ingested '{title}' into Obsidian Second Brain & STDP Cortex!{RESET}\n")


def cmd_canvas(args):
    if not args:
        print(f"{RED}✖ Usage:{RESET} zoth-second-brain canvas <topic>")
        sys.exit(1)

    topic = " ".join(args).strip()
    topic_clean = re.sub(r'["\']', '', topic).strip()
    canvas_name = f"{topic_clean} Knowledge Map.canvas"
    dest_path = VAULT_DIR / canvas_name

    print(f"\n{GOLD}{BOLD}🎨 Synthesizing Spatial JSON Canvas 1.0 for '{topic_clean}'...{RESET}")
    print(f"{DIM}───────────────────────────────────────────────────────────────────────{RESET}")

    vault_notes = []
    seen = set()
    topic_lower = topic_clean.lower()
    words = [w for w in re.split(r'\W+', topic_lower) if len(w) > 2]

    for p in VAULT_DIR.rglob("*.md"):
        if any(part.startswith(".") for part in p.parts):
            continue
        stem_l = p.stem.lower()
        if any(w in stem_l for w in words):
            rel = str(p.relative_to(VAULT_DIR))
            if p not in seen:
                seen.add(p)
                vault_notes.append({"path": rel, "name": p.stem, "score": 10})

    rg_bin = "/usr/bin/rg" if os.path.exists("/usr/bin/rg") else None
    if rg_bin and len(vault_notes) < 6 and words:
        import subprocess
        try:
            cmd = [rg_bin, "-i", "-n", "-m", "1", words[0], str(VAULT_DIR)]
            proc = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
            for line in proc.stdout.splitlines():
                if not line.strip() or ":" not in line:
                    continue
                parts = line.split(":", 2)
                if len(parts) >= 3:
                    f_path_str = parts[0].strip()
                    cp = Path(f_path_str)
                    if cp.suffix.lower() == ".md" and cp not in seen and not any(part.startswith(".") for part in cp.parts):
                        seen.add(cp)
                        vault_notes.append({"path": str(cp.relative_to(VAULT_DIR)), "name": cp.stem, "score": 5})
                        if len(vault_notes) >= 6:
                            break
        except Exception:
            pass

    top_notes = vault_notes[:5]

    print(f" {PURPLE}⚡ Querying STDP Synaptic Substrate (:8094)...{RESET}")
    memory_results = []
    daemon_search = post_json(f"{NEURO_MEMORY_URL}/api/search", {"query": topic_clean, "limit": 5}, timeout=4.0)
    if daemon_search and "results" in daemon_search:
        memory_results = daemon_search.get("results", [])

    if not memory_results and words:
        daemon_recall = post_json(f"{NEURO_MEMORY_URL}/api/recall", {"query": words[0], "top_k": 5}, timeout=4.0)
        if daemon_recall and "results" in daemon_recall:
            memory_results = daemon_recall.get("results", [])

    top_memories = memory_results[:5]

    import hashlib
    def make_id(seed: str) -> str:
        return hashlib.sha256(seed.encode("utf-8")).hexdigest()[:16]

    nodes = []
    edges = []

    hero_grp_id = make_id(f"hero_grp_{topic_clean}")
    hero_node_id = make_id(f"hero_node_{topic_clean}")
    nodes.append({
        "id": hero_grp_id,
        "type": "group",
        "x": -220,
        "y": -300,
        "width": 440,
        "height": 420,
        "label": f"✦ Core Synthesis: {topic_clean}",
        "color": "3"
    })
    nodes.append({
        "id": hero_node_id,
        "type": "text",
        "x": -180,
        "y": -240,
        "width": 360,
        "height": 320,
        "color": "3",
        "text": f"# 🧠 {topic_clean}\n\n**Procedural Knowledge Map** synthesized by `zoth-second-brain`.\n\n- **Vault Notes:** {len(top_notes)} matched\n- **STDP Engrams:** {len(top_memories)} retrieved\n- **Anchor Coordinate:** `(0, 0)`\n\n> [!tip] Bidirectional Linkage\n> Explores Hebbian vector clusters across Obsidian and Neuro-Memory."
    })

    notes_grp_id = make_id(f"notes_grp_{topic_clean}")
    nodes.append({
        "id": notes_grp_id,
        "type": "group",
        "x": -980,
        "y": -340,
        "width": 700,
        "height": max(480, 80 + len(top_notes) * 120),
        "label": f"💎 Second Brain Vault Cluster ({len(top_notes)} notes)",
        "color": "5"
    })

    curr_y = -280
    for idx, nt in enumerate(top_notes):
        nid = make_id(f"vault_note_{nt['path']}")
        nodes.append({
            "id": nid,
            "type": "file",
            "x": -940,
            "y": curr_y,
            "width": 620,
            "height": 100,
            "file": nt["path"],
            "color": "5"
        })
        eid = make_id(f"edge_hero_note_{idx}_{topic_clean}")
        edges.append({
            "id": eid,
            "fromNode": hero_node_id,
            "fromSide": "left",
            "toNode": nid,
            "toSide": "right",
            "color": "5",
            "label": f"Vault Note #{idx + 1}"
        })
        curr_y += 120

    mem_grp_id = make_id(f"mem_grp_{topic_clean}")
    nodes.append({
        "id": mem_grp_id,
        "type": "group",
        "x": 280,
        "y": -340,
        "width": 700,
        "height": max(480, 80 + len(top_memories) * 140),
        "label": f"🧠 STDP Synaptic Engram Cluster (:8094)",
        "color": "4"
    })

    curr_y = -280
    for idx, mem in enumerate(top_memories):
        mid = make_id(f"mem_{mem.get('id', idx)}_{topic_clean}")
        mem_short_id = mem.get("id", "engram")[:8]
        imp = mem.get("importance", 0.8)
        tags = " ".join([f"#{t}" for t in mem.get("tags", [])[:4]])
        raw_txt = mem.get("text", "").replace("\n", " ").strip()
        if len(raw_txt) > 160:
            raw_txt = raw_txt[:157] + "..."
        card_text = f"### ⚡ Engram `{mem_short_id}` (imp: {imp:.2f})\n{tags}\n\n{raw_txt}"
        nodes.append({
            "id": mid,
            "type": "text",
            "x": 320,
            "y": curr_y,
            "width": 620,
            "height": 120,
            "text": card_text,
            "color": "4"
        })
        eid = make_id(f"edge_hero_mem_{idx}_{topic_clean}")
        edges.append({
            "id": eid,
            "fromNode": hero_node_id,
            "fromSide": "right",
            "toNode": mid,
            "toSide": "left",
            "color": "4",
            "label": f"STDP Vector #{idx + 1}"
        })
        curr_y += 140

    canvas_payload = {
        "nodes": nodes,
        "edges": edges
    }

    with open(dest_path, "w", encoding="utf-8") as f:
        json.dump(canvas_payload, f, indent=2)

    print(f" {GREEN}✔ Canvas Created:{RESET} {BOLD}{dest_path.name}{RESET}")
    print(f"    • Nodes:  {CYAN}{len(nodes)}{RESET} (Hero + {len(top_notes)} Notes + {len(top_memories)} Engrams)")
    print(f"    • Edges:  {PURPLE}{len(edges)}{RESET}")
    print(f"    • Path:   {GRAY}{dest_path}{RESET}\n")


def cmd_audit():
    print(f"\n{GOLD}{BOLD}🩺 Zoth Second Brain Health Audit & Spec Verification{RESET}")
    print(f"{DIM}───────────────────────────────────────────────────────────────────────{RESET}")

    if not VAULT_DIR.exists():
        print(f" {RED}✖ Vault directory missing:{RESET} {VAULT_DIR}")
        return

    # 1. Audit JSON Canvas 1.0 Files
    canvases = list(VAULT_DIR.rglob("*.canvas"))
    canvas_issues = []
    print(f" {BOLD}🎨 Auditing JSON Canvas 1.0 Files ({len(canvases)} files)...{RESET}")
    for c in canvases:
        rel = str(c.relative_to(VAULT_DIR))
        try:
            with open(c, encoding="utf-8") as f:
                cdata = json.load(f)
            nodes = cdata.get("nodes", [])
            edges = cdata.get("edges", [])
            node_ids = set()
            for n in nodes:
                nid = n.get("id")
                if not nid:
                    canvas_issues.append((rel, "Node missing required 'id' attribute"))
                elif nid in node_ids:
                    canvas_issues.append((rel, f"Duplicate node ID: {nid}"))
                node_ids.add(nid)
                if n.get("type") == "file":
                    file_target = n.get("file", "")
                    target_p = VAULT_DIR / file_target
                    if not target_p.exists():
                        canvas_issues.append((rel, f"Referenced file not found: {file_target}"))
            for e in edges:
                eid = e.get("id")
                if eid in node_ids:
                    canvas_issues.append((rel, f"Edge ID collides with node ID: {eid}"))
                fn = e.get("fromNode")
                tn = e.get("toNode")
                if fn not in node_ids:
                    canvas_issues.append((rel, f"Dangling fromNode reference: {fn}"))
                if tn not in node_ids:
                    canvas_issues.append((rel, f"Dangling toNode reference: {tn}"))
        except Exception as err:
            canvas_issues.append((rel, f"JSON parse error: {err}"))

    if not canvas_issues:
        print(f"   {GREEN}✔ 100% of Canvas files pass JSON Canvas 1.0 specification ({len(canvases)}/{len(canvases)}){RESET}")
    else:
        print(f"   {RED}✖ Found {len(canvas_issues)} Canvas issue(s):{RESET}")
        for f, iss in canvas_issues[:5]:
            print(f"      • {GRAY}{f}:{RESET} {iss}")

    # 2. Audit Obsidian Bases (.base) Files
    bases = list(VAULT_DIR.rglob("*.base"))
    base_issues = []
    print(f"\n {BOLD}📊 Auditing Obsidian Bases Databases ({len(bases)} files)...{RESET}")
    for b in bases:
        rel = str(b.relative_to(VAULT_DIR))
        try:
            import yaml
            with open(b, encoding="utf-8") as f:
                bdata = yaml.safe_load(f)
            if not isinstance(bdata, dict):
                base_issues.append((rel, "Root element is not a YAML mapping"))
            elif "views" not in bdata or not isinstance(bdata["views"], list):
                base_issues.append((rel, "Missing required 'views' list"))
            else:
                for v in bdata.get("views", []):
                    if not isinstance(v, dict) or "type" not in v:
                        base_issues.append((rel, "View missing 'type' property"))
        except Exception as err:
            base_issues.append((rel, f"YAML parse error: {err}"))

    if not base_issues:
        print(f"   {GREEN}✔ 100% of Base files pass Obsidian Bases YAML specification ({len(bases)}/{len(bases)}){RESET}")
    else:
        print(f"   {RED}✖ Found {len(base_issues)} Base issue(s):{RESET}")
        for f, iss in base_issues[:5]:
            print(f"      • {GRAY}{f}:{RESET} {iss}")

    # 3. Audit Markdown Notes & Wikilinks
    notes = [p for p in VAULT_DIR.rglob("*.md") if not any(part.startswith(".") for part in p.parts)]
    mocs = [p for p in notes if p.stem.startswith("MOC") or p.stem == "00 Home"]
    total_wikilinks = 0
    connected_notes = 0

    for p in notes:
        try:
            txt = p.read_text(encoding="utf-8", errors="ignore")
            links = re.findall(r"\[\[([^\]|#]+)", txt)
            if links:
                connected_notes += 1
                total_wikilinks += len(links)
        except Exception:
            pass

    print(f"\n {BOLD}📝 Auditing Second Brain Knowledge Graph ({len(notes)} notes)...{RESET}")
    print(f"   • Total Notes:            {CYAN}{len(notes)}{RESET}")
    print(f"   • Maps of Content (MOC):  {GOLD}{len(mocs)}{RESET}")
    print(f"   • Total Wikilinks:        {PURPLE}{total_wikilinks}{RESET}")
    print(f"   • Graph Connectivity:     {GREEN}{connected_notes / len(notes) * 100:.1f}%{RESET}")

    score = 100
    if canvas_issues:
        score -= min(len(canvas_issues) * 10, 40)
    if base_issues:
        score -= min(len(base_issues) * 10, 40)

    score_color = GREEN if score >= 90 else GOLD if score >= 70 else RED
    print(f"{DIM}───────────────────────────────────────────────────────────────────────{RESET}")
    print(f" {BOLD}Overall Second Brain Health Score:{RESET} {score_color}{BOLD}{score}/100 ✦ PERFECT{RESET}")
    print(f"{DIM}───────────────────────────────────────────────────────────────────────{RESET}\n")


def print_help():
    print(f"""
{GOLD}{BOLD}zoth-second-brain{RESET} — Sovereign Obsidian Second Brain & ZothOS CLI

{BOLD}USAGE:{RESET}
    zoth-second-brain <command> [arguments]

{BOLD}COMMANDS:{RESET}
    {GREEN}status{RESET}                 Show live status of Obsidian Vault, daemons (:8094, :8140, :3000, :5173, :9393), and STDP cortex
    {GREEN}sync{RESET}                   Trigger bidirectional sync with Neuro-Memory Daemon (:8094)
    {GREEN}search <query>{RESET}         Simultaneously search all 1,697+ Vault notes and :8094 STDP memories
    {GREEN}ingest <path-or-url>{RESET}   Ingest local file or URL into 04-Ingested/<slug>.md and :8094 STDP cortex
    {GREEN}canvas <topic>{RESET}         Procedurally generate <Topic> Knowledge Map.canvas with Vault notes & STDP engrams
    {GREEN}audit{RESET}                  Run comprehensive doctor health audit on 100% of .canvas, .base, and notes
    {GREEN}moc{RESET}                    List all Maps of Content (MOC) with link counts and sizes
    {GREEN}moc <name>{RESET}             Inspect a specific MOC note and its wikilinks
    {GREEN}help{RESET}                   Print this help message

{BOLD}VAULT PATH:{RESET}
    {VAULT_DIR}
""")


def main():
    if len(sys.argv) < 2:
        print_help()
        sys.exit(0)

    cmd = sys.argv[1].lower()
    if cmd in ("status", "st"):
        cmd_status()
    elif cmd in ("sync", "s"):
        cmd_sync()
    elif cmd in ("search", "find", "q"):
        cmd_search(sys.argv[2:])
    elif cmd in ("ingest", "in", "add"):
        cmd_ingest(sys.argv[2:])
    elif cmd in ("canvas", "map"):
        cmd_canvas(sys.argv[2:])
    elif cmd in ("audit", "doctor", "doc"):
        cmd_audit()
    elif cmd == "moc":
        cmd_moc(sys.argv[2:])
    elif cmd in ("help", "--help", "-h"):
        print_help()
    else:
        print(f"{RED}Unknown command:{RESET} {cmd}")
        print_help()
        sys.exit(1)


if __name__ == "__main__":
    main()
